<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Content -->
        <ScrollViewer
            x:Name="ContentScroll"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">

            <StackPanel>
                <!-- Backdrop hero area: 60% of viewport height -->
                <Grid x:Name="BackdropContainer" MinHeight="300">
                    <controls:BackdropImage
                        x:Name="BackdropImage"
                        AnchorY="0.2" />

                    <!-- Brightness overlay: web uses brightness(0.4), so ~60% darkening -->
                    <Border Background="#101722" Opacity="0.6" />

                    <!-- Bottom-to-top gradient (hero-gradient) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.0" />
                                <GradientStop Color="#33101722" Offset="0.25" />
                                <GradientStop Color="#8C101722" Offset="0.5" />
                                <GradientStop Color="#EB101722" Offset="0.8" />
                                <GradientStop Color="#101722" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Left-to-right gradient (hero-gradient-left) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#101722" Offset="0.0" />
                                <GradientStop Color="#CC101722" Offset="0.2" />
                                <GradientStop Color="#66101722" Offset="0.4" />
                                <GradientStop Color="Transparent" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Vignette: combined left + bottom gradient -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#66101722" Offset="0.0" />
                                <GradientStop Color="#33101722" Offset="0.3" />
                                <GradientStop Color="Transparent" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Back button -->
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource GhostButtonStyle}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="16,16,0,0"
                        Click="BackButton_Click"
                        Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Back" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Title overlay at bottom-left -->
                    <StackPanel
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Margin="48,0,0,24"
                        MaxWidth="600"
                        Spacing="6">
                        <TextBlock
                            x:Name="TitleText"
                            Style="{StaticResource DisplayTextStyle}"
                            FontSize="36"
                            TextWrapping="Wrap"
                            MaxLines="2" />

                        <TextBlock
                            x:Name="TaglineText"
                            Style="{StaticResource SecondaryTextStyle}"
                            FontStyle="Italic"
                            TextWrapping="Wrap"
                            MaxLines="2" />
                    </StackPanel>
                </Grid>

                <!-- Detail content below backdrop -->
                <StackPanel Padding="48,0,48,48" Spacing="16">

                    <!-- Metadata row: year · content rating pill · runtime · TMDB score + quality badges -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <TextBlock x:Name="YearText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock x:Name="MetaDot1" Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed" />
                            <!-- Content rating in a pill badge -->
                            <Border x:Name="ContentRatingBadge" CornerRadius="4" Padding="8,2,8,2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ContentRatingText" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                            <TextBlock x:Name="MetaDot2" Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="RuntimeText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Scores: IMDb / TMDB / RT inline with metadata -->
                        <StackPanel x:Name="ScoresPanel" Orientation="Horizontal" Spacing="16" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" />
                            <!-- IMDb score -->
                            <StackPanel x:Name="ImdbScorePanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="IMDb" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ImdbScoreText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="/10" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- TMDB score -->
                            <StackPanel x:Name="TmdbScorePanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TmdbScoreText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="/10" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- RT Critic score -->
                            <StackPanel x:Name="RtCriticPanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="&#x1F345;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="RtCriticText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- RT Audience score -->
                            <StackPanel x:Name="RtAudiencePanel" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                                <TextBlock Text="&#x1F37F;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="RtAudienceText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Quality badges (populated in code-behind from version info) -->
                        <StackPanel x:Name="QualityBadgesPanel" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Genres line: "Crime · Drama · History" (above overview) -->
                    <TextBlock
                        x:Name="GenresText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Action buttons row -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

                        <!-- Split play button: [Play / Resume ... | dropdown] -->
                        <Grid x:Name="SplitPlayButton" CornerRadius="22" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Accent background spanning both columns -->
                            <Border Grid.ColumnSpan="2" Background="{StaticResource AccentBrush}" CornerRadius="22" />

                            <!-- Progress bar overlay -->
                            <Border x:Name="PlayProgressBar" Grid.ColumnSpan="2" CornerRadius="22"
                                    HorizontalAlignment="Left" Width="0" Opacity="0.2" IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource AccentForegroundColor}" />
                                </Border.Background>
                            </Border>

                            <!-- Main play/resume button -->
                            <Button Grid.Column="0" Click="PlayButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="24,10" CornerRadius="22,0,0,22">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="{StaticResource AccentForegroundBrush}" />
                                    <TextBlock x:Name="PlayButtonText" Text="Play" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" FontSize="15" />
                                    <TextBlock x:Name="PlayQualityText" Text="" Foreground="{StaticResource AccentForegroundBrush}" Opacity="0.6" FontSize="15" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>

                            <!-- Dropdown arrow for versions -->
                            <Button x:Name="VersionDropdownButton" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                Padding="12,10" CornerRadius="0,22,22,0" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE70D;" FontSize="12" Foreground="{StaticResource AccentForegroundBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout x:Name="VersionFlyout" />
                                </Button.Flyout>
                            </Button>

                            <!-- Left border separator between play and dropdown -->
                            <Border x:Name="VersionSeparator" Grid.Column="1" Width="1" Opacity="0.3" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource AccentForegroundColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Watched toggle button -->
                        <Button
                            x:Name="WatchedButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="WatchedButton_Click"
                            Padding="16,10"
                            CornerRadius="22">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="WatchedText" Text="Mark as Watched" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Favorite button (icon only, pill) -->
                        <Button
                            x:Name="FavoriteButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="FavoriteButton_Click"
                            Padding="12,10"
                            CornerRadius="22"
                            ToolTipService.ToolTip="Favorite">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xE734;" FontSize="18"
                                      Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>

                        <!-- Star rating: 5 stars -->
                        <StackPanel x:Name="StarRatingPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="Star1" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" Tag="1">
                                <FontIcon x:Name="Star1Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                            <Button x:Name="Star2" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" Tag="2">
                                <FontIcon x:Name="Star2Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                            <Button x:Name="Star3" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" Tag="3">
                                <FontIcon x:Name="Star3Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                            <Button x:Name="Star4" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" Tag="4">
                                <FontIcon x:Name="Star4Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                            <Button x:Name="Star5" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" Tag="5">
                                <FontIcon x:Name="Star5Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                        </StackPanel>

                        <!-- Watchlist button (moved to overflow) -->
                        <Button
                            x:Name="WatchlistButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="WatchlistButton_Click"
                            Padding="16,10"
                            CornerRadius="22">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="WatchlistIcon" Glyph="&#xE8B7;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="WatchlistText" Text="Watchlist" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Download button -->
                        <Button
                            x:Name="DownloadButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DownloadButton_Click"
                            Padding="16,10"
                            CornerRadius="22"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Download" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Match button (admin only) -->
                        <Button
                            x:Name="MatchButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="MatchButton_Click"
                            Padding="16,10"
                            CornerRadius="22"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71C;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Match" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Overview -->
                    <TextBlock
                        x:Name="OverviewText"
                        Style="{StaticResource BodyTextStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        LineHeight="24"
                        FontSize="15" />

                    <!-- Cast section -->
                    <TextBlock
                        x:Name="CastHeader"
                        Text="Cast"
                        Style="{StaticResource TitleTextStyle}"
                        Visibility="Collapsed"
                        Margin="0,12,0,0" />

                    <ScrollViewer
                        x:Name="CastScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        Visibility="Collapsed">
                        <StackPanel x:Name="CastPanel" Orientation="Horizontal" Spacing="16" />
                    </ScrollViewer>

                    <!-- Crew section (directors + writers) -->
                    <StackPanel x:Name="CrewSection" Visibility="Collapsed" Spacing="4" Margin="0,8,0,0">
                        <StackPanel x:Name="DirectorsPanel" Orientation="Horizontal" Spacing="0" Visibility="Collapsed">
                            <TextBlock Text="Directed by  " FontSize="13" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="DirectorNamesPanel" Orientation="Horizontal" Spacing="0" />
                        </StackPanel>
                        <StackPanel x:Name="WritersPanel" Orientation="Horizontal" Spacing="0" Visibility="Collapsed">
                            <TextBlock Text="Written by  " FontSize="13" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="WriterNamesPanel" Orientation="Horizontal" Spacing="0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Studios row -->
                    <TextBlock
                        x:Name="StudiosText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Networks row (series only) -->
                    <TextBlock
                        x:Name="NetworksText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Countries row -->
                    <TextBlock
                        x:Name="CountriesText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Subtitles section (downloaded subs for the current file) -->
                    <StackPanel x:Name="SubtitlesSection" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock
                            Text="Subtitles"
                            Style="{StaticResource TitleTextStyle}"
                            FontSize="18" />
                        <StackPanel x:Name="SubtitlesList" Spacing="6" />
                    </StackPanel>

                    <!-- Seasons (for series only) -->
                    <StackPanel x:Name="SeasonsSection" Visibility="Collapsed" Spacing="12" Margin="0,16,0,0">
                        <TextBlock Text="Seasons" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                        <ProgressRing
                            x:Name="SeasonsLoadingRing"
                            IsActive="False"
                            Visibility="Collapsed"
                            Width="32" Height="32"
                            HorizontalAlignment="Left" />
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="SeasonsPanel" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Episodes (shown when a season is selected) -->
                    <StackPanel x:Name="EpisodesSection" Visibility="Collapsed" Spacing="8" Margin="0,16,0,0">
                        <TextBlock x:Name="EpisodesHeader" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                        <ProgressRing
                            x:Name="EpisodesLoadingRing"
                            IsActive="False"
                            Visibility="Collapsed"
                            Width="32" Height="32"
                            HorizontalAlignment="Left" />
                        <StackPanel x:Name="EpisodesPanel" Spacing="8" />
                    </StackPanel>

                    <!-- More Like This section -->
                    <StackPanel x:Name="SimilarSection" Visibility="Collapsed" Spacing="12" Margin="0,24,0,0">
                        <TextBlock Text="More Like This" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                        <ScrollViewer
                            x:Name="SimilarScrollViewer"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="SimilarPanel" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
