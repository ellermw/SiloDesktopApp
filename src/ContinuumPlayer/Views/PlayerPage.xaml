<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#101722"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Grid x:Name="RootGrid">
        <!-- Loading overlay (shown while preparing playback) -->
        <Grid
            x:Name="LoadingOverlay"
            Background="#101722"
            Visibility="Visible">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock
                    Text="Preparing playback..."
                    Foreground="White"
                    FontSize="16"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Playing state: mpv has its own fullscreen window on top -->
        <Grid
            x:Name="PlayingOverlay"
            Background="#101722"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <FontIcon Glyph="&#xE768;" FontSize="48" Foreground="#999999" />
                <TextBlock
                    x:Name="NowPlayingText"
                    Text=""
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="500" />
                <TextBlock
                    x:Name="PlaybackInfoText"
                    Text=""
                    Foreground="#999999"
                    FontSize="14"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="mpv is playing in fullscreen. Press ESC or Q in the player to exit."
                    Foreground="#666666"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Margin="0,16,0,0" />
                <Button
                    Content="Stop Playback"
                    HorizontalAlignment="Center"
                    Click="StopButton_Click"
                    Padding="20,10"
                    Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Error overlay -->
        <Grid
            x:Name="ErrorOverlay"
            Background="#101722"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                MaxWidth="500">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF4444" />
                <TextBlock
                    x:Name="ErrorText"
                    Text=""
                    Foreground="#FF4444"
                    FontSize="16"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
                <Button
                    Content="Go Back"
                    HorizontalAlignment="Center"
                    Click="GoBackButton_Click"
                    Padding="20,10" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
