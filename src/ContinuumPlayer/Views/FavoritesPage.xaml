<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Sort pill ComboBox (reuse library page pattern) -->
        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6,8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Order toggle button -->
        <Style x:Key="OrderToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: large title + subtitle + item count panel -->
        <Grid Grid.Row="0" Margin="40,24,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title + subtitle -->
            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock
                    Text="Favorites"
                    FontSize="{StaticResource FontSizeDisplayLarge}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    Text="Movies and series you've marked as favorites."
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <!-- Item count panel (web: surface-panel-subtle rounded-[1.35rem]) -->
            <Border
                x:Name="CountPanel"
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Padding="20,16"
                MinWidth="140"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock
                        Text="FAVORITES"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="160"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="ItemCountText"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,4,0,0" />
                    <TextBlock
                        x:Name="ItemCountLabel"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sort bar -->
        <StackPanel
            x:Name="SortBar"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Margin="40,0,40,16"
            Visibility="Collapsed">

            <!-- Sort by -->
            <ComboBox
                x:Name="SortComboBox"
                Style="{StaticResource PillComboBoxStyle}"
                Width="150"
                SelectionChanged="SortComboBox_SelectionChanged"
                PlaceholderText="Sort by">
                <ComboBoxItem Content="Title" Tag="title" IsSelected="True" />
                <ComboBoxItem Content="Year" Tag="year" />
                <ComboBoxItem Content="Date Added" Tag="added_at" />
            </ComboBox>

            <!-- Order toggle -->
            <Button
                x:Name="OrderButton"
                Style="{StaticResource OrderToggleButtonStyle}"
                Click="OrderButton_Click"
                ToolTipService.ToolTip="Toggle sort order">
                <FontIcon x:Name="OrderIcon" Glyph="&#xE74A;" FontSize="12"
                          Foreground="{StaticResource SecondaryTextBrush}" />
            </Button>
        </StackPanel>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="2"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="2"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Content grid -->
        <ScrollViewer Grid.Row="2" Padding="40,0,40,24"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <ItemsRepeater x:Name="PosterRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="{StaticResource PosterCardWidth}"
                            MinItemHeight="{StaticResource PosterCardTotalHeight}"
                            MinColumnSpacing="12"
                            MinRowSpacing="16"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <controls:PosterCard MediaItem="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state (web: centered icon + title + subtitle) -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE734;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="No favorites yet"
                FontSize="{StaticResource FontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Heart the movies and shows you love to see them here."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>
    </Grid>
</Page>
