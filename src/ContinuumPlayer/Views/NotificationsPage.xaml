<Page
    x:Class="ContinuumPlayer.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="Notifications"
                           Style="{StaticResource HeaderTextStyle}" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource OutlineButtonStyle}"
                    Command="{Binding LoadCommand}" />
            <Button Grid.Column="2"
                    Content="Mark all read"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding MarkAllReadCommand}" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnSpacing="24"
              Margin="0,28,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}"
                    Padding="0">
                <Grid>
                    <ProgressRing IsActive="{Binding IsLoading}"
                                  Width="32"
                                  Height="32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />

                    <ListView x:Name="NotificationsList"
                              ItemsSource="{Binding Notifications}"
                              IsItemClickEnabled="True"
                              ItemClick="NotificationsList_ItemClick"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,14"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="10"
                                            Height="10"
                                            CornerRadius="5"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Top"
                                            Margin="0,6,0,0"
                                            Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   Style="{StaticResource SubtitleTextStyle}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CreatedAt}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TertiaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1"
                        Spacing="16">
                <Border Style="{StaticResource CardStyle}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Profile Preferences"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />

                        <ToggleSwitch Header="Enable notifications"
                                      IsOn="{Binding Preferences.Enabled, Mode=TwoWay}" />
                        <ToggleSwitch Header="Favorites"
                                      IsOn="{Binding Preferences.NotifyFavorites, Mode=TwoWay}" />
                        <ToggleSwitch Header="Watchlist"
                                      IsOn="{Binding Preferences.NotifyWatchlist, Mode=TwoWay}" />
                        <ToggleSwitch Header="Continue watching"
                                      IsOn="{Binding Preferences.NotifyContinueWatching, Mode=TwoWay}" />
                        <ToggleSwitch Header="Next up"
                                      IsOn="{Binding Preferences.NotifyNextUp, Mode=TwoWay}" />

                        <Button Content="Save preferences"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SavePreferencesCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
