<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:vm="using:ContinuumPlayer.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Tab button styles -->
        <Style x:Key="HistoryTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="HistoryTabActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: large title + subtitle + tabs + item count panel -->
        <Grid Grid.Row="0" Margin="40,24,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock
                        Text="Watch History"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />

                    <!-- Tab pills -->
                    <Border
                        CornerRadius="20"
                        Padding="4"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="InProgressTab"
                                Content="In Progress"
                                Style="{StaticResource HistoryTabActiveStyle}"
                                Click="Tab_Click"
                                Tag="in_progress" />
                            <Button
                                x:Name="AllHistoryTab"
                                Content="All History"
                                Style="{StaticResource HistoryTabStyle}"
                                Click="Tab_Click"
                                Tag="all" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock
                    x:Name="SubtitleText"
                    Text="Pick up where you left off."
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Border
                x:Name="CountPanel"
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Padding="20,16"
                MinWidth="140"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock
                        x:Name="CountLabel"
                        Text="IN PROGRESS"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="160"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="ItemCountText"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,4,0,0" />
                    <TextBlock
                        x:Name="ItemCountLabel"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Content: history cards with infinite scroll -->
        <ScrollViewer
            x:Name="HistoryScrollViewer"
            Grid.Row="1"
            Padding="40,0,40,24"
            ViewChanged="HistoryScrollViewer_ViewChanged"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <StackPanel x:Name="HistoryCardsPanel" Spacing="10" />

                <!-- Loading more indicator -->
                <ProgressRing
                    x:Name="LoadMoreRing"
                    IsActive="False"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Margin="0,16,0,16"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE81C;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptyTitle"
                Text="Nothing in progress"
                FontSize="{StaticResource FontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="EmptySubtitle"
                Text="Start watching something and it will appear here so you can pick up where you left off."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="420" />
        </StackPanel>
    </Grid>
</Page>
