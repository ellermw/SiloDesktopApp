<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:vm="using:ContinuumPlayer.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Text="Continue Watching"
            Style="{StaticResource HeaderTextStyle}"
            Margin="24,24,24,16" />

        <!-- Loading -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <ItemsRepeater x:Name="HistoryRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryDisplayItem">
                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="16,12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Play icon -->
                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="&#xE768;"
                                    FontSize="20"
                                    Foreground="{StaticResource AccentBrush}"
                                    VerticalAlignment="Center" />

                                <!-- Title and progress -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        Style="{StaticResource SubtitleTextStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <ProgressBar
                                        Value="{x:Bind ProgressPercent}"
                                        Maximum="100"
                                        Height="4"
                                        Foreground="{StaticResource AccentBrush}"
                                        Background="{StaticResource SurfaceBrush}" />
                                    <TextBlock
                                        Text="{x:Bind ProgressText}"
                                        Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>

                                <!-- Year -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind Year}"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE81C;"
                FontSize="48"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="No viewing history yet"
                Style="{StaticResource SecondaryTextStyle}"
                FontSize="16"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
