<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.PersonDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Filter tab button styles -->
        <Style x:Key="FilterTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,8,16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="FilterTabActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,8,16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Content -->
        <ScrollViewer
            x:Name="ContentScroll"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">

            <StackPanel Padding="40,24,40,48">

                <!-- Back button -->
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="BackButton_Click"
                    Padding="8,6"
                    Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Back" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Header: photo + info -->
                <Grid ColumnSpacing="24" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Photo (2:3 aspect, rounded) -->
                    <Border
                        x:Name="PersonPhotoBorder"
                        Grid.Column="0"
                        Width="180"
                        Height="270"
                        CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}">
                        <!-- Initials fallback -->
                        <TextBlock
                            x:Name="InitialsText"
                            FontSize="48"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Info column -->
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Margin="0,8,0,0">

                        <!-- Name + refresh button row -->
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PersonName"
                                FontSize="{StaticResource FontSizeDisplayLarge}"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}" />

                            <TextBlock
                                x:Name="AgeText"
                                FontSize="20"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                VerticalAlignment="Center" />

                            <!-- Admin refresh button -->
                            <Button
                                x:Name="RefreshButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                CornerRadius="16"
                                Padding="12,6"
                                Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Refresh Metadata"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="Refresh Metadata" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ProgressRing
                                x:Name="RefreshRing"
                                IsActive="False"
                                Width="20" Height="20"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Dates line -->
                        <TextBlock
                            x:Name="DatesText"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />

                        <!-- Birthplace line -->
                        <TextBlock
                            x:Name="BirthplaceText"
                            FontSize="14"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            Visibility="Collapsed" />

                        <!-- Bio -->
                        <TextBlock
                            x:Name="BioText"
                            Style="{StaticResource BodyTextStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="700"
                            HorizontalAlignment="Left"
                            LineHeight="22"
                            FontSize="14"
                            MaxLines="8"
                            Margin="0,8,0,0" />

                        <!-- Show more toggle -->
                        <Button
                            x:Name="ShowMoreBioButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ShowMoreBio_Click"
                            Padding="0,4"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ShowMoreBioText"
                                Text="Show more"
                                FontSize="13"
                                Foreground="{StaticResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filmography section -->
                <StackPanel Spacing="16">

                    <!-- Title + filter tabs + count -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Filmography"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center" />

                        <!-- Filter tabs -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="FilterAllButton"
                                Content="All"
                                Style="{StaticResource FilterTabActiveStyle}"
                                Click="FilterTab_Click"
                                Tag="all" />
                            <Button
                                x:Name="FilterMoviesButton"
                                Content="Movies"
                                Style="{StaticResource FilterTabStyle}"
                                Click="FilterTab_Click"
                                Tag="movie" />
                            <Button
                                x:Name="FilterSeriesButton"
                                Content="Series"
                                Style="{StaticResource FilterTabStyle}"
                                Click="FilterTab_Click"
                                Tag="series" />
                        </StackPanel>

                        <!-- Item count -->
                        <TextBlock
                            x:Name="FilmographyCountText"
                            Grid.Column="3"
                            FontSize="13"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Filmography grid -->
                    <ItemsRepeater x:Name="FilmographyRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="{StaticResource PosterCardWidth}"
                                MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                MinColumnSpacing="12"
                                MinRowSpacing="16"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <controls:PosterCard MediaItem="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty state -->
                    <TextBlock
                        x:Name="FilmographyEmptyText"
                        Text="No items found in filmography."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
