<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminSectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Scope pill-tab button style -->
        <Style x:Key="ScopeTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="Sections"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="SubtitleText"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="RestoreDefaultsButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RestoreDefaultsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Restore Defaults" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="AddSectionButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddSectionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add Section" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Status banner placeholder (moved to overlay) -->

                <!-- ===== Scope Picker ===== -->
                <StackPanel Spacing="16">
                    <!-- Scope tab buttons -->
                    <Border
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="12"
                        Padding="4"
                        HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="ScopeHomeButton"
                                Content="Home"
                                Style="{StaticResource ScopeTabButtonStyle}"
                                Click="ScopeHomeButton_Click" />
                            <Button
                                x:Name="ScopeLibraryButton"
                                Content="Library"
                                Style="{StaticResource ScopeTabButtonStyle}"
                                Click="ScopeLibraryButton_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Library picker (visible when scope=library) -->
                    <StackPanel
                        x:Name="LibraryPickerPanel"
                        Orientation="Horizontal"
                        Spacing="10"
                        Visibility="Collapsed">
                        <TextBlock
                            Text="Library"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="LibraryPicker"
                            MinWidth="220"
                            CornerRadius="8"
                            FontSize="13"
                            SelectionChanged="LibraryPicker_SelectionChanged" />
                        <TextBlock
                            x:Name="NoLibrariesText"
                            Text="Create a library before configuring Library sections."
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Reorder hint ===== -->
                <TextBlock
                    x:Name="ReorderHintText"
                    Text="Use the arrow buttons to change section order."
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Visibility="Collapsed" />

                <!-- ===== Sections Table — surface-panel, no border, CornerRadius=26 ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="16"
                    BorderThickness="0"
                    Padding="0">
                    <StackPanel>
                        <!-- Table header -->
                        <Grid Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />   <!-- Move buttons -->
                                <ColumnDefinition Width="2*" />   <!-- Title -->
                                <ColumnDefinition Width="2.5*" /> <!-- Type -->
                                <ColumnDefinition Width="60" />   <!-- Items -->
                                <ColumnDefinition Width="72" />   <!-- Featured -->
                                <ColumnDefinition Width="72" />   <!-- Enabled -->
                                <ColumnDefinition Width="80" />   <!-- Actions -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="" />
                            <TextBlock Grid.Column="1" Text="Title" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="TYPE" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="Items" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="FEATURED" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="ENABLED" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="6" Text="Actions" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Inline loading indicator -->
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Width="32" Height="32" />

                        <!-- Inline error state -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="400" />
                            <Button
                                Content="Retry"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.LoadCommand}" />
                        </StackPanel>

                        <!-- Section rows — populated in code-behind -->
                        <StackPanel x:Name="SectionsPanel" Spacing="0" />

                        <!-- Empty state -->
                        <Border x:Name="EmptyState" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                x:Name="EmptyStateText"
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Toast overlay (sonner-style, floats above content) -->
        <Border
            x:Name="StatusBanner"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Padding="16,10"
            CornerRadius="12"
            Background="#22C55E"
            Visibility="Collapsed">
            <TextBlock
                x:Name="StatusBannerText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White" />
        </Border>
    </Grid>
</Page>
