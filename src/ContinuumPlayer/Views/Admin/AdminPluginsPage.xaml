<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminPluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- Header — matches web AdminPlugins: title/subtitle left, Check for updates button right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock
                            Text="Plugins"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Extend Continuum with community and first-party plugins."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button
                        x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Click="CheckUpdatesButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status banner -->
                <Border
                    x:Name="StatusBanner"
                    Background="{StaticResource AccentBackgroundBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusBannerText"
                        FontSize="13"
                        Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- Tab bar -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="TabInstalled"
                        Content="Installed"
                        Click="TabInstalled_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        CornerRadius="8" />
                    <Button
                        x:Name="TabAvailable"
                        Content="Available"
                        Click="TabAvailable_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        CornerRadius="8" />
                </StackPanel>

                <!-- Installed plugins -->
                <StackPanel x:Name="InstalledPanel" Spacing="12">
                    <StackPanel x:Name="InstalledCards" Spacing="8" />
                    <Border x:Name="InstalledEmpty" Padding="20,40" Visibility="Collapsed">
                        <TextBlock
                            Text="No plugins installed."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Available plugins tab content — matches web: Catalog section, then Repositories section -->
                <StackPanel x:Name="AvailablePanel" Spacing="24" Visibility="Collapsed">

                    <!-- Catalog section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Catalog"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="AvailableCards" Spacing="8" />
                        <Border x:Name="AvailableEmpty" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No plugins available. Add a repository to browse available plugins."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Repositories section -->
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Repositories"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Sources for discovering plugins."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                x:Name="AddRepoButton"
                                Click="AddRepoButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="24"
                            BorderThickness="0"
                            Padding="0">
                            <StackPanel>
                                <StackPanel x:Name="RepoRows" Spacing="0" />
                                <Border x:Name="RepoEmpty" Padding="20,30" Visibility="Collapsed">
                                    <TextBlock
                                        Text="No repositories configured."
                                        FontSize="13"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
