<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Filter toggle button style -->
        <Style x:Key="FilterToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <!-- Title row with session count badge -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock
                                Text="Activity"
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <!-- Live badge — populated in code-behind -->
                            <Border
                                x:Name="LiveBadge"
                                Background="{StaticResource AccentBackgroundBrush}"
                                CornerRadius="12"
                                Padding="10,4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="LiveBadgeText"
                                    Text="0 live"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="SubtitleText"
                            Text="0 active streams"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </Grid>

                <!-- ===== IP Lookup Panel ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock
                            Text="IP Lookup"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />

                        <!-- Input row -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="IpLookupBox"
                                Grid.Column="0"
                                PlaceholderText="IP lookup (e.g. 203.0.113.50)"
                                Text="{x:Bind ViewModel.IpLookupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="IpLookupBox_KeyDown"
                                FontSize="13"
                                CornerRadius="8" />
                            <Button
                                Grid.Column="1"
                                Content="Lookup"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.LookupIPCommand}"
                                IsEnabled="{x:Bind ViewModel.IpLookupLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>

                        <!-- IP results table — built in code-behind -->
                        <StackPanel x:Name="IpResultsPanel" Spacing="0" Visibility="Collapsed">
                            <!-- Header row -->
                            <Grid x:Name="IpResultsHeader" Padding="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="User" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="First Seen" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Last Seen" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Requests" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                            <StackPanel x:Name="IpResultsRows" Spacing="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Play Method Distribution ===== -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Stream Methods"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />

                        <!-- Proportional bar -->
                        <Grid x:Name="MethodBar" Height="8" CornerRadius="4">
                            <!-- Filled in code-behind with colored Border segments -->
                        </Grid>

                        <!-- Method toggle buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnFilterDirect" Click="BtnFilterDirect_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#3FB950" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BtnDirectText" Text="Direct · 0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnFilterRemux" Click="BtnFilterRemux_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#388BFD" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BtnRemuxText" Text="Remux · 0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnFilterTranscode" Click="BtnFilterTranscode_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="#DB6D28" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BtnTranscodeText" Text="Transcode · 0" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Filter Bar ===== -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search box with icon -->
                    <Grid Grid.Column="0">
                        <TextBox
                            x:Name="SearchBox"
                            PlaceholderText="Filter by user or media..."
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13"
                            CornerRadius="8"
                            Padding="36,8,8,8" />
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="14"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            IsHitTestVisible="False" />
                    </Grid>

                    <!-- Movies toggle -->
                    <Button
                        x:Name="BtnTypeMovie"
                        Grid.Column="1"
                        Content="Movies"
                        Click="BtnTypeMovie_Click"
                        Style="{StaticResource FilterToggleButtonStyle}" />

                    <!-- Series toggle -->
                    <Button
                        x:Name="BtnTypeSeries"
                        Grid.Column="2"
                        Content="Series"
                        Click="BtnTypeSeries_Click"
                        Style="{StaticResource FilterToggleButtonStyle}" />

                    <!-- Clear button -->
                    <Button
                        x:Name="BtnClearFilters"
                        Grid.Column="3"
                        Content="Clear"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="BtnClearFilters_Click" />

                    <!-- Count label -->
                    <TextBlock
                        x:Name="FilterCountText"
                        Grid.Column="4"
                        Text="Showing 0 of 0 streams"
                        FontSize="12"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- ===== Streams Table ===== -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                    <StackPanel>
                        <!-- Table header -->
                        <Grid x:Name="TableHeader" Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="USER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="STREAM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="VIDEO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="AUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="NODE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="TIME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Stream rows — populated in code-behind -->
                        <StackPanel x:Name="StreamsPanel" Spacing="0" />

                        <!-- Empty state -->
                        <Border x:Name="EmptyState" Padding="20,40" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon
                                    Glyph="&#xEA62;"
                                    FontSize="32"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No active streams"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="Streams will appear here when users are watching content."
                                    FontSize="13"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
