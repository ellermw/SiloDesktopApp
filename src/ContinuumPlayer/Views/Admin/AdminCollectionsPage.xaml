<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminCollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="Collections"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Curate library shelves and sync them from MDBList or TMDB trending."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Library picker + Add Collection button (top-right) -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <ComboBox
                            x:Name="LibraryPicker"
                            MinWidth="180"
                            CornerRadius="8"
                            FontSize="13"
                            SelectionChanged="LibraryPicker_SelectionChanged" />
                        <Button
                            x:Name="AddCollectionButton"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Click="AddCollectionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add Collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Collections Table ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="26"
                    BorderThickness="0"
                    Padding="0">
                    <StackPanel>
                        <!-- Table header -->
                        <Grid Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TITLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="SOURCE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="ITEMS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="SYNC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="UPDATED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Collection rows — populated in code-behind -->
                        <StackPanel x:Name="CollectionsPanel" Spacing="0" />

                        <!-- Empty state -->
                        <Border x:Name="EmptyState" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No collections found for this library yet."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
