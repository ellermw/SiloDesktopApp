<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Admin Sidebar ===== -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Margin="16,20,16,16"
                    HorizontalAlignment="Left">
                    <Image
                        x:Name="AdminSiloBrandImage"
                        Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                        Width="112"
                        Height="48"
                        Stretch="Uniform"
                        AutomationProperties.Name="Silo" />
                </Grid>

                <!-- Scrollable Nav Sections -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,4,0,4" Spacing="0">

                        <!-- === OVERVIEW === -->
                        <TextBlock
                            Text="OVERVIEW"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="20,12,16,4" />

                        <Button
                            x:Name="NavDashboard"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavDashboard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Active indicator bar (hidden by default) -->
                                <Border
                                    x:Name="NavDashboardBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavDashboardIcon"
                                        Glyph="&#xE80F;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavDashboardText"
                                        Text="Dashboard"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavActivity"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavActivity_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavActivityBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavActivityIcon"
                                        Glyph="&#xE716;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavActivityText"
                                        Text="Activity"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                    <Border
                                        x:Name="NavActivityBadge"
                                        Background="{StaticResource ErrorBrush}"
                                        CornerRadius="8"
                                        Padding="6,2"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="NavActivityBadgeText"
                                            Text="0 live"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
