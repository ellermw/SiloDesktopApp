                    <!-- Back to App button -->
                    <Button
                        x:Name="BackToAppButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,1"
                        CornerRadius="12"
                        Click="BackToApp_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="Back to App"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Server status card -->
                    <Border
                        Margin="8,4,8,0"
                        Padding="12,10"
                        CornerRadius="12"
                        Background="{StaticResource SidebarAccentBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Green status dot -->
                            <Ellipse
                                Width="8" Height="8"
                                Fill="#22C55E"
                                VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="Silo"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Server Online"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ===== Content Area ===== -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header strip: server activity popover button (right-aligned).
                 Mirrors webui AdminLayout header. -->
            <Border
                Grid.Row="0"
                Padding="20,14"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Reserved left side (currently empty — mirrors webui which
                         only shows breadcrumbs here, rarely used) -->

                    <!-- Server Activity button (reusable control). Always visible in
                         the admin header. HideWhenEmpty set in XAML so it's established
                         before the control's OnLoaded runs — a code-behind set after
                         Loaded would leave the button Collapsed until the next poll. -->
                    <controls:ServerActivityButton
                        x:Name="AdminServerActivityButton"
                        Grid.Column="1"
                        HideWhenEmpty="False" />
                </Grid>
            </Border>

            <!-- Admin page content frame -->
            <Frame
                x:Name="AdminContentFrame"
                Grid.Row="1"
                Background="{StaticResource AppBackgroundBrush}" />
        </Grid>

    </Grid>
</Page>
