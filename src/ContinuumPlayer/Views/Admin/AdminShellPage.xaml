<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Admin Sidebar ===== -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBackgroundBrush}"
            BorderBrush="{StaticResource SidebarBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Branding -->
                <StackPanel
                    Grid.Row="0"
                    Margin="16,20,16,16"
                    Orientation="Horizontal"
                    Spacing="10">

                    <!-- Play triangle icon in rounded box -->
                    <Border
                        Width="40" Height="40"
                        CornerRadius="12"
                        Background="{StaticResource SidebarAccentBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            Text="&#x25B6;"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Branding text -->
                    <StackPanel VerticalAlignment="Center" Spacing="0">
                        <TextBlock
                            Text="Continuum"
                            FontSize="{StaticResource FontSizeBrandingTitle}"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="10" />
                        <TextBlock
                            Text="Admin Panel"
                            FontSize="{StaticResource FontSizeBrandingSubtitle}"
                            FontWeight="Medium"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Scrollable Nav Sections -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="0,4,0,4" Spacing="0">

                        <!-- === OVERVIEW === -->
                        <TextBlock
                            Text="OVERVIEW"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="20,12,16,4" />

                        <Button
                            x:Name="NavDashboard"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavDashboard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Active indicator bar (hidden by default) -->
                                <Border
                                    x:Name="NavDashboardBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavDashboardIcon"
                                        Glyph="&#xE80F;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavDashboardText"
                                        Text="Dashboard"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavActivity"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavActivity_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavActivityBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavActivityIcon"
                                        Glyph="&#xE716;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavActivityText"
                                        Text="Activity"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavLogs"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavLogs_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavLogsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavLogsIcon"
                                        Glyph="&#xE8FD;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavLogsText"
                                        Text="Logs"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- === CONTENT === -->
                        <TextBlock
                            Text="CONTENT"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="20,12,16,4" />

                        <Button
                            x:Name="NavLibraries"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavLibraries_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavLibrariesBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavLibrariesIcon"
                                        Glyph="&#xE8F1;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavLibrariesText"
                                        Text="Libraries"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavCollections"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavCollections_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavCollectionsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavCollectionsIcon"
                                        Glyph="&#xECA5;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavCollectionsText"
                                        Text="Collections"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavSections"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavSections_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavSectionsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavSectionsIcon"
                                        Glyph="&#xE8A9;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavSectionsText"
                                        Text="Sections"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- === USERS === -->
                        <TextBlock
                            Text="USERS"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="20,12,16,4" />

                        <Button
                            x:Name="NavUsers"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavUsers_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavUsersBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavUsersIcon"
                                        Glyph="&#xE77B;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavUsersText"
                                        Text="Users"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavPlaybackHistory"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavPlaybackHistory_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavPlaybackHistoryBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavPlaybackHistoryIcon"
                                        Glyph="&#xE81C;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavPlaybackHistoryText"
                                        Text="Playback History"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- === SERVER === -->
                        <TextBlock
                            Text="SERVER"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            Margin="20,12,16,4" />

                        <Button
                            x:Name="NavScheduledTasks"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavScheduledTasks_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavScheduledTasksBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavScheduledTasksIcon"
                                        Glyph="&#xE823;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavScheduledTasksText"
                                        Text="Scheduled Tasks"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavNodes"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavNodes_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavNodesBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavNodesIcon"
                                        Glyph="&#xE774;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavNodesText"
                                        Text="Nodes"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavMaintenance"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavMaintenance_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavMaintenanceBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavMaintenanceIcon"
                                        Glyph="&#xE90F;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavMaintenanceText"
                                        Text="Maintenance"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavPlugins"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavPlugins_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavPluginsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavPluginsIcon"
                                        Glyph="&#xE74C;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavPluginsText"
                                        Text="Plugins"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavSettings"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavSettings_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavSettingsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavSettingsIcon"
                                        Glyph="&#xE713;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavSettingsText"
                                        Text="Settings"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavRecommendations"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavRecommendations_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavRecommendationsBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavRecommendationsIcon"
                                        Glyph="&#xE8E1;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavRecommendationsText"
                                        Text="Recommendations"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button
                            x:Name="NavApiKeys"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,10"
                            Margin="4,1"
                            CornerRadius="12"
                            Click="NavApiKeys_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="NavApiKeysBar"
                                    Grid.Column="0"
                                    Width="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        x:Name="NavApiKeysIcon"
                                        Glyph="&#xE8D7;"
                                        FontSize="16"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock
                                        x:Name="NavApiKeysText"
                                        Text="API Keys"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Medium" />
                                </StackPanel>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12" Spacing="4">

                    <!-- Top border separator -->
                    <Border
                        Height="1"
                        Background="{StaticResource SidebarBorderBrush}"
                        Margin="12,0,12,4"
                        Opacity="0.7" />

                    <!-- Back to App button -->
                    <Button
                        x:Name="BackToAppButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,1"
                        CornerRadius="12"
                        Click="BackToApp_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="Back to App"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Server status card -->
                    <Border
                        Margin="8,4,8,0"
                        Padding="12,10"
                        CornerRadius="12"
                        Background="{StaticResource SidebarAccentBrush}"
                        BorderBrush="{StaticResource SidebarBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- Green status dot -->
                            <Ellipse
                                Width="8" Height="8"
                                Fill="#22C55E"
                                VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    Text="Continuum"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Server Online"
                                    FontSize="10"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ===== Content Area ===== -->
        <Frame
            x:Name="AdminContentFrame"
            Grid.Column="1"
            Background="{StaticResource AppBackgroundBrush}" />

    </Grid>
</Page>
