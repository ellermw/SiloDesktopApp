<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminSettingsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error message (show only when loading failed and no content visible) -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <Grid
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                IsScrollInertiaEnabled="True"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Padding="40,28,40,40" Spacing="24">

                    <!-- Header -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Settings"
                            FontSize="{StaticResource FontSizeDisplayLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Configure server-wide settings. Most changes require a server restart to take effect."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Outer surface panel containing tabs + content -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="28"
                        Padding="0"
                        MinHeight="500">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tab navigation row -->
                            <Border
                                Grid.Row="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,8,8,0">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled">
                                    <StackPanel
                                        x:Name="TabBar"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Padding="4,0,4,8" />
                                </ScrollViewer>
                            </Border>

                            <!-- Content area -->
                            <ScrollViewer
                                Grid.Row="1"
                                VerticalScrollBarVisibility="Auto"
                                Padding="24,20,24,24">
                                <StackPanel
                                    x:Name="ContentPanel"
                                    Spacing="20" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Save bar (bottom, visible when dirty) -->
            <Border
                x:Name="SaveBar"
                Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14"
                Visibility="{x:Bind ViewModel.HasDirtyChanges, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status text -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="DirtyCountText"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            Text="Server restart may be required for changes to take effect."
                            FontSize="11"
                            Foreground="{StaticResource TertiaryTextBrush}" />
                    </StackPanel>

                    <!-- Discard button -->
                    <Button
                        Grid.Column="1"
                        Content="Discard"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.DiscardCommand}"
                        Click="DiscardButton_Click" />

                    <!-- Save button -->
                    <Button
                        Grid.Column="2"
                        x:Name="SaveButton"
                        Content="Save Changes"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Click="SaveButton_Click" />
                </Grid>
            </Border>

            <!-- Status message toast -->
            <Border
                x:Name="StatusToast"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-40,0,0"
                Padding="16,10"
                CornerRadius="12"
                Background="#22C55E"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="StatusToastText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </Border>
        </Grid>
    </Grid>
</Page>
