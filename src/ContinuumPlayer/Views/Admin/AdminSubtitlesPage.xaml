<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminSubtitlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" Spacing="20">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Subtitles"
                    Style="{StaticResource TitleTextStyle}"
                    FontSize="42"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Manage stored subtitle files across the library - user uploads and provider downloads."
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL STORED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="TotalStoredText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="USER UPLOADS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="UploadsText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PROVIDER DOWNLOADS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="ProviderDownloadsText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="LANGUAGES ON PAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="LanguagesText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowSpacing="12" ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ProviderFilterComboBox" Grid.Row="0" Grid.Column="0" Header="Provider" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All providers" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="User uploads" Tag="upload" />
                        <ComboBoxItem Content="OpenSubtitles" Tag="opensubtitles" />
                        <ComboBoxItem Content="SubDL" Tag="subdl" />
                        <ComboBoxItem Content="SubSource" Tag="subsource" />
                    </ComboBox>

                    <ComboBox x:Name="LanguageFilterComboBox" Grid.Row="0" Grid.Column="1" Header="Language" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All languages" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Spanish" Tag="es" />
                        <ComboBoxItem Content="French" Tag="fr" />
                        <ComboBoxItem Content="German" Tag="de" />
                        <ComboBoxItem Content="Italian" Tag="it" />
                        <ComboBoxItem Content="Portuguese" Tag="pt" />
                        <ComboBoxItem Content="Dutch" Tag="nl" />
                        <ComboBoxItem Content="Polish" Tag="pl" />
                        <ComboBoxItem Content="Japanese" Tag="ja" />
                    </ComboBox>

                    <ComboBox x:Name="UserFilterComboBox" Grid.Row="0" Grid.Column="2" Header="Uploader" SelectionChanged="Filter_Changed" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Row="0"
                        Grid.Column="3"
                        Header="Search"
                        PlaceholderText="Title, file path, or release"
                        TextChanged="SearchBox_TextChanged" />

                    <Button
                        Grid.Row="0"
                        Grid.Column="4"
                        Content="Reset"
                        VerticalAlignment="Bottom"
                        Click="ResetFilters_Click" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="5"
                        Content="Refresh"
                        VerticalAlignment="Bottom"
                        Click="Refresh_Click" />

                    <TextBlock
                        x:Name="StatusText"
                        Grid.Row="1"
                        Grid.ColumnSpan="6"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <ProgressRing
                        x:Name="LoadingRing"
                        IsActive="False"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="SubtitlesListView"
                        SelectionMode="None"
                        IsItemClickEnabled="False" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PageSummaryText"
                    Grid.Column="0"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />
                <ComboBox x:Name="PageSizeComboBox" Grid.Column="1" SelectionChanged="PageSize_Changed">
                    <ComboBoxItem Content="25 / page" Tag="25" IsSelected="True" />
                    <ComboBoxItem Content="50 / page" Tag="50" />
                    <ComboBoxItem Content="100 / page" Tag="100" />
                </ComboBox>
                <Button x:Name="PrevPageButton" Grid.Column="2" Content="Previous" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" Grid.Column="3" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                <Button x:Name="NextPageButton" Grid.Column="4" Content="Next" Click="NextPage_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
