<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- surface-panel rounded-[1.6rem] border-0 -->
        <Style x:Key="SurfacePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- surface-panel-subtle rounded-[1.4rem] p-3 -->
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Table card (no border, rounded top for header)
             B26: 24 was 3x too round; web `rounded-lg`=8. -->
        <Style x:Key="TableCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Playback summary card -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="TabPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="FilterBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Detail panel style -->
        <Style x:Key="DetailPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header: title + subtitle left, stream state right ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock
                            Text="Logs"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Search application logs and request audit trails without leaving the admin UI."
                            FontSize="15"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                        <TextBlock
                            Text="STREAM"
                            FontSize="11"
                            CharacterSpacing="200"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Right" />
                        <TextBlock
                            x:Name="StreamStateText"
                            Text="{x:Bind ViewModel.ConnectionState, Mode=OneWay}"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right" />
                        <!-- Error text shown below connection state -->
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                            FontSize="11"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Right"
                            TextWrapping="Wrap"
                            MaxWidth="300" />
                    </StackPanel>
                </Grid>

                <!-- ===== Playback Session Filter ===== -->
                <Border Style="{StaticResource SurfacePanelStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="PlaybackSessionBox"
                            PlaceholderText="Playback Session ID"
                            Width="380"
                            FontFamily="Consolas"
                            FontSize="12"
                            Style="{StaticResource FilterBoxStyle}"
                            Text="{x:Bind ViewModel.PlaybackSessionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="PlaybackSessionBox_KeyDown" />
                        <!-- Tag showing short ID when filled -->
                        <Border
                            x:Name="PlaybackSessionTag"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="PlaybackSessionTagText"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Playback Session Summary (visible when playback session ID is set) ===== -->
                <Border
                    x:Name="PlaybackSummaryPanel"
                    Style="{StaticResource SummaryCardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="SummaryMetricsPanel" Orientation="Horizontal" Spacing="24" Grid.Column="0">
                            <!-- Metrics populated in code-behind -->
                        </StackPanel>

                        <Button
                            x:Name="BtnFilterFfmpeg"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Click="BtnFilterFfmpeg_Click">
                            <TextBlock
                                x:Name="BtnFilterFfmpegText"
                                Text="Open ffmpeg logs"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Tab Bar ===== -->
                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="4"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="TabAppBtn"
                            Content="Application"
                            Style="{StaticResource TabPillStyle}"
                            Click="TabApp_Click" />
                        <Button
                            x:Name="TabAuditBtn"
                            Content="Audit"
                            Style="{StaticResource TabPillStyle}"
                            Click="TabAudit_Click" />
                    </StackPanel>
                </Border>

                <!-- ===== Application Logs Tab ===== -->
                <StackPanel x:Name="AppLogsPanel" Spacing="16">

                    <!-- Filter bar: Request ID, Message contains, Component -->
                    <Border Style="{StaticResource SubtlePanelStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="AppRequestIdBox"
                                PlaceholderText="Request ID"
                                Width="220"
                                FontFamily="Consolas"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AppRequestId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="FilterBox_KeyDown" />
                            <TextBox
                                x:Name="AppMessageBox"
                                PlaceholderText="Message contains..."
                                Width="260"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AppMessageQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="FilterBox_KeyDown" />
                            <TextBox
                                x:Name="AppComponentBox"
                                PlaceholderText="Component"
                                Width="180"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AppComponent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="FilterBox_KeyDown" />
                        </StackPanel>
                    </Border>

                    <!-- App Logs Table -->
                    <Border Style="{StaticResource TableCardStyle}">
                        <StackPanel>
                            <!-- Column header — matches web: Time / Level / Component / Status / Duration / Message -->
                            <Grid
                                Padding="16,10"
                                ColumnSpacing="8"
                                CornerRadius="8,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Level" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Component" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="Status" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Duration" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="Message" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>

                            <!-- Rows -->
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <StackPanel x:Name="AppLogsPanel_Rows" Spacing="0" />

                                    <!-- Cursor-pagination footer: Load more button + status. -->
                                    <StackPanel
                                        x:Name="AppLogsLoadMorePanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        Padding="0,16,0,16"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="AppLogsLoadMoreButton"
                                            Content="Load more"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Click="AppLogsLoadMore_Click" />
                                        <ProgressRing
                                            x:Name="AppLogsLoadMoreRing"
                                            IsActive="False"
                                            Width="18" Height="18"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Empty / loading states -->
                            <TextBlock
                                x:Name="AppLogsEmpty"
                                Text="No application logs matched the current filters."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="AppLogsLoading"
                                Text="Loading logs..."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Detail panel (shown when row selected) -->
                    <Border
                        x:Name="AppDetailPanel"
                        Style="{StaticResource DetailPanelStyle}"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="AppDetailContent" Grid.Column="0" Spacing="16" />

                            <!-- Close button -->
                            <Button
                                x:Name="BtnCloseDetail"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                Click="BtnCloseDetail_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- ===== Audit Logs Tab ===== -->
                <StackPanel x:Name="AuditLogsPanel" Spacing="16" Visibility="Collapsed">

                    <!-- Filter bar: Request ID, Method, Client IP -->
                    <Border Style="{StaticResource SubtlePanelStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="AuditRequestIdBox"
                                PlaceholderText="Request ID"
                                Width="220"
                                FontFamily="Consolas"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AuditRequestId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="AuditFilterBox_KeyDown" />
                            <TextBox
                                x:Name="AuditMethodBox"
                                PlaceholderText="Method"
                                Width="120"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AuditMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="AuditFilterBox_KeyDown" />
                            <TextBox
                                x:Name="AuditClientIpBox"
                                PlaceholderText="Client IP"
                                Width="200"
                                FontFamily="Consolas"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AuditClientIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="AuditFilterBox_KeyDown" />
                        </StackPanel>
                    </Border>

                    <!-- Audit Logs Table -->
                    <Border Style="{StaticResource TableCardStyle}">
                        <StackPanel>
                            <!-- Column header -->
                            <Grid
                                Padding="16,10"
                                ColumnSpacing="8"
                                CornerRadius="8,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Method" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Path" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="Status" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Client" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="User" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="6" Text="Session" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="7" Text="Playback" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="8" Text="Request" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>

                            <!-- Rows -->
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <StackPanel x:Name="AuditLogsPanel_Rows" Spacing="0" />

                                    <!-- Cursor-pagination footer. -->
                                    <StackPanel
                                        x:Name="AuditLogsLoadMorePanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10"
                                        Padding="0,16,0,16"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="AuditLogsLoadMoreButton"
                                            Content="Load more"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Click="AuditLogsLoadMore_Click" />
                                        <ProgressRing
                                            x:Name="AuditLogsLoadMoreRing"
                                            IsActive="False"
                                            Width="18" Height="18"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Empty / loading states -->
                            <TextBlock
                                x:Name="AuditLogsEmpty"
                                Text="No audit logs matched the current filters."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="AuditLogsLoading"
                                Text="Loading logs..."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
