<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="TabPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        </Style>

        <Style x:Key="FilterBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>

        <!-- Main content (always visible while not loading) -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Logs"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Search application logs and request audit trails without leaving the admin UI."
                        FontSize="15"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- ===== Tab Bar ===== -->
                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24"
                    Padding="4"
                    HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="TabAppBtn"
                            Content="Application"
                            Style="{StaticResource TabPillStyle}"
                            Click="TabApp_Click" />
                        <Button
                            x:Name="TabAuditBtn"
                            Content="Audit"
                            Style="{StaticResource TabPillStyle}"
                            Click="TabAudit_Click" />
                    </StackPanel>
                </Border>

                <!-- ===== Application Logs Tab ===== -->
                <StackPanel x:Name="AppLogsPanel" Spacing="16">

                    <!-- Filter bar -->
                    <Border
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16"
                        Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="AppLevelBox"
                                PlaceholderText="Level (info, warn, error, debug)"
                                Width="220"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AppLevelFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="FilterBox_KeyDown" />
                            <TextBox
                                x:Name="AppComponentBox"
                                PlaceholderText="Component"
                                Width="180"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AppComponent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="FilterBox_KeyDown" />
                            <Button
                                x:Name="BtnSearchApp"
                                Content="Search"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnSearchApp_Click" />
                        </StackPanel>
                    </Border>

                    <!-- App Logs Table -->
                    <Border Style="{StaticResource SectionCardStyle}" Padding="0">

                        <!-- Column header -->
                        <StackPanel>
                            <Grid
                                Padding="16,10"
                                ColumnSpacing="8"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="24,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Level" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Component" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="User" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Session" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="Playback" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="6" Text="Method" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="7" Text="Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="8" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="9" Text="Duration" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="10" Text="Message" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="11" Text="Request" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Grid>

                            <!-- Rows go here -->
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AppLogsPanel_Rows" Spacing="0" />
                            </ScrollViewer>

                            <!-- Empty state -->
                            <TextBlock
                                x:Name="AppLogsEmpty"
                                Text="No application logs. Use the filters above and click Search."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- Detail panel (shown when row selected) -->
                    <Border
                        x:Name="AppDetailPanel"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed">
                        <StackPanel x:Name="AppDetailContent" Spacing="16" />
                    </Border>

                </StackPanel>

                <!-- ===== Audit Logs Tab ===== -->
                <StackPanel x:Name="AuditLogsPanel" Spacing="16" Visibility="Collapsed">

                    <!-- Filter bar -->
                    <Border
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="16"
                        Padding="16,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="AuditUserIdBox"
                                PlaceholderText="User ID (number)"
                                Width="200"
                                Style="{StaticResource FilterBoxStyle}"
                                Text="{x:Bind ViewModel.AuditUserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="AuditFilterBox_KeyDown" />
                            <Button
                                x:Name="BtnSearchAudit"
                                Content="Search"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnSearchAudit_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Audit Logs Table -->
                    <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                        <StackPanel>

                            <!-- Column header -->
                            <Grid
                                Padding="16,10"
                                ColumnSpacing="8"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="24,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Time" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Method" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Path" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Client" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="User" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="6" Text="Session" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="7" Text="Playback" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="8" Text="Request" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Grid>

                            <!-- Rows -->
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="AuditLogsPanel_Rows" Spacing="0" />
                            </ScrollViewer>

                            <!-- Empty state -->
                            <TextBlock
                                x:Name="AuditLogsEmpty"
                                Text="No audit logs. Enter a User ID filter and click Search."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center"
                                Padding="0,24"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
