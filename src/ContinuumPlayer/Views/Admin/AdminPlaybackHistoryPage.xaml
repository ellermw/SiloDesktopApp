<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminPlaybackHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="Playback History"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Review playback sessions across all users and profiles."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </Grid>

                <!-- ===== Filter Controls ===== -->
                <StackPanel Orientation="Horizontal" Spacing="8" x:Name="FilterRow">

                    <!-- User ComboBox -->
                    <ComboBox
                        x:Name="UserComboBox"
                        MinWidth="180"
                        PlaceholderText="All Users"
                        SelectionChanged="UserComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Users" Tag="" />
                    </ComboBox>

                    <!-- Profile ComboBox -->
                    <ComboBox
                        x:Name="ProfileComboBox"
                        MinWidth="180"
                        PlaceholderText="All Profiles"
                        SelectionChanged="ProfileComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Profiles" Tag="" />
                    </ComboBox>

                    <!-- Status ComboBox -->
                    <ComboBox
                        x:Name="StatusComboBox"
                        MinWidth="160"
                        SelectedIndex="0"
                        SelectionChanged="StatusComboBox_SelectionChanged">
                        <ComboBoxItem Content="All Attempts" Tag="all" />
                        <ComboBoxItem Content="Completed" Tag="true" />
                        <ComboBoxItem Content="Partial" Tag="false" />
                    </ComboBox>

                    <!-- Reset button -->
                    <Button
                        x:Name="ResetButton"
                        Content="Reset"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="Collapsed"
                        Click="ResetButton_Click" />
                </StackPanel>

                <!-- ===== Stat Cards ===== -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Visible Rows -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="VISIBLE ROWS"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="TotalCountText"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Completed -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="COMPLETED"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="CompletedCountText"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="#3FB950" />
                        </StackPanel>
                    </Border>

                    <!-- Partial -->
                    <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="PARTIAL"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="PartialCountText"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== History Table ===== -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                    <StackPanel>

                        <!-- Table header -->
                        <Grid x:Name="TableHeader" Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MEDIA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="USER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="PROFILE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="METHOD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="WATCH TIME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="6" Text="ENDED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Rows populated in code-behind -->
                        <StackPanel x:Name="HistoryRowsPanel" Spacing="0" />

                        <!-- Empty state -->
                        <Border x:Name="EmptyState" Padding="20,48" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE916;"
                                    FontSize="32"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No playback history"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No playback history matches the current filters."
                                    FontSize="13"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
