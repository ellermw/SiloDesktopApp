<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminPlaybackHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- B26: shadcn `rounded-lg`=8 — was 24/26, way too round. -->
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TableCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="PageTitle"
                            Text="Playback History"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Finalized playback attempts across all users and profiles."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Filter controls in header row -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <!-- User ComboBox -->
                        <ComboBox
                            x:Name="UserComboBox"
                            MinWidth="220"
                            PlaceholderText="All users"
                            SelectionChanged="UserComboBox_SelectionChanged">
                            <ComboBoxItem Content="All users" Tag="" />
                        </ComboBox>

                        <!-- Profile ComboBox -->
                        <ComboBox
                            x:Name="ProfileComboBox"
                            MinWidth="220"
                            PlaceholderText="All profiles"
                            SelectionChanged="ProfileComboBox_SelectionChanged">
                            <ComboBoxItem Content="All profiles" Tag="" />
                        </ComboBox>

                        <!-- Completion status ComboBox -->
                        <ComboBox
                            x:Name="StatusComboBox"
                            MinWidth="180"
                            SelectedIndex="0"
                            SelectionChanged="StatusComboBox_SelectionChanged">
                            <ComboBoxItem Content="All attempts" Tag="all" />
                            <ComboBoxItem Content="Completed" Tag="true" />
                            <ComboBoxItem Content="Partial" Tag="false" />
                        </ComboBox>

                        <!-- Reset button -->
                        <Button
                            x:Name="ResetButton"
                            Content="Reset"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="ResetButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- ===== Stat Cards ===== -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Visible Rows -->
                    <Border Grid.Column="0" Style="{StaticResource InfoCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Visible Rows"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="TotalCountText"
                                Text="0"
                                FontSize="24"
                                FontWeight="ExtraBold"
                                CharacterSpacing="-25"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Completed -->
                    <Border Grid.Column="1" Style="{StaticResource InfoCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Completed"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="CompletedCountText"
                                Text="0"
                                FontSize="24"
                                FontWeight="ExtraBold"
                                CharacterSpacing="-25"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Partial -->
                    <Border Grid.Column="2" Style="{StaticResource InfoCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Partial"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="PartialCountText"
                                Text="0"
                                FontSize="24"
                                FontWeight="ExtraBold"
                                CharacterSpacing="-25"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== History Table Card ===== -->
                <Border Style="{StaticResource TableCardStyle}">
                    <StackPanel>

                        <!-- Card header: "Recent Playback" + refresh status -->
                        <Grid Padding="20,16,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Recent Playback"
                                FontSize="13"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="RefreshStatusText"
                                Grid.Column="1"
                                Text="Auto-refreshing"
                                FontSize="12"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                VerticalAlignment="Center" />
                        </Grid>

                        <!-- Table header row -->
                        <Grid x:Name="TableHeader" Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="User" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="Profile" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="Method" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="Watch Time" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="Status" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="6" Text="Ended" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="7" Text="Logs" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Inline loading indicator -->
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Width="32" Height="32" />

                        <!-- Inline error state -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="400" />
                            <Button
                                Content="Retry"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.LoadCommand}" />
                        </StackPanel>

                        <!-- Rows populated in code-behind -->
                        <StackPanel x:Name="HistoryRowsPanel" Spacing="0" />

                        <!-- Empty state — webui: Filter icon + two-line text -->
                        <Border x:Name="EmptyState" Padding="20,48" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon
                                    Glyph="&#xE71C;"
                                    FontSize="32"
                                    Opacity="0.2"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="No playback history found"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Text="Try adjusting your filters or date range."
                                    FontSize="13"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    HorizontalAlignment="Center"
                                    TextAlignment="Center"
                                    MaxWidth="400" />
                            </StackPanel>
                        </Border>

                        <!-- Pagination bar -->
                        <Border x:Name="PaginationBar"
                                Padding="8,16,8,16"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                    <TextBlock x:Name="PageRangeText"
                                               FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="PageSizeCombo"
                                              SelectedIndex="0"
                                              MinWidth="100"
                                              SelectionChanged="PageSizeCombo_SelectionChanged">
                                        <ComboBoxItem Content="25 rows" Tag="25" />
                                        <ComboBoxItem Content="50 rows" Tag="50" />
                                        <ComboBoxItem Content="100 rows" Tag="100" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="PrevPageButton"
                                            Content="Previous"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Height="32" FontSize="12" Padding="12,0"
                                            Click="PrevPageButton_Click" />
                                    <Button x:Name="NextPageButton"
                                            Content="Next"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Height="32" FontSize="12" Padding="12,0"
                                            Click="NextPageButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
