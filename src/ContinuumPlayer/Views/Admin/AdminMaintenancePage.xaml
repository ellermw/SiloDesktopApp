<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminMaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="48" Height="48" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
            <Button Content="Retry" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="48,28,48,48" Spacing="24" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- ===== Page header ===== -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Maintenance"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Operational tools that affect the whole catalog live here. Use this page for bulk import/export workflows and other future maintenance actions."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="820" />
                </StackPanel>

                <!-- Status banner (transient) -->
                <Border
                    x:Name="StatusBanner"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Background="#22C55E"
                    CornerRadius="10"
                    Padding="14,10">
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>

                <!-- ===== Catalog Import & Export — actions bar ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="Catalog Import &amp; Export"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Queue full catalog exports, import seeds from uploads or S3, and watch background job progress in one place."
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                                MaxWidth="640" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">
                            <Button
                                x:Name="StartExportButton"
                                Click="StartExport_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock Text="Start Export" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ImportCatalogButton"
                                Click="ImportCatalog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                                    <TextBlock Text="Import Catalog" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Recent Catalog Imports ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Recent Catalog Imports"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Imports run in the background so progress stays visible while validation and writes are in flight."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RefreshImports_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <StackPanel x:Name="ImportJobsPanel" />
                    </StackPanel>
                </Border>

                <!-- ===== Recent Catalog Exports ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Recent Catalog Exports"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Export jobs run in the background and upload finished seeds to the operational S3 bucket."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RefreshExports_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <StackPanel x:Name="ExportJobsPanel" />
                    </StackPanel>
                </Border>

                <!-- ===== Job History ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Job History"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Recent background jobs across all types."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="RefreshAllJobs_Click"
                                    Background="Transparent" BorderThickness="0" Padding="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"
                                          Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.6" />
                        <StackPanel x:Name="AllJobsPanel" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
