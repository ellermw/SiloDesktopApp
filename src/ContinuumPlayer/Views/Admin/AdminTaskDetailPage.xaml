<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminTaskDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                x:Name="RetryButton"
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button -->
                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Width="36" Height="36"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="18"
                        VerticalAlignment="Top"
                        Margin="0,4,12,0"
                        ToolTipService.ToolTip="Back to Scheduled Tasks">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Button>

                    <!-- Title area -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <!-- Name + category badge row (populated in code-behind) -->
                        <StackPanel x:Name="TitleBadgeRow" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
                        <!-- Description -->
                        <TextBlock
                            x:Name="DescriptionText"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!-- Action button (Run / Cancel) -->
                    <Button
                        x:Name="ActionButton"
                        Grid.Column="2"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center" />
                </Grid>

                <!-- ===== Progress section (running only) ===== -->
                <Border
                    x:Name="ProgressSection"
                    Style="{StaticResource CardStyle}"
                    Padding="20,16"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <ProgressBar
                            x:Name="TaskProgressBar"
                            Minimum="0"
                            Maximum="100"
                            Height="6"
                            Foreground="{StaticResource AccentBrush}" />
                        <TextBlock
                            x:Name="ProgressMessageText"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- ===== Schedule card ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <!-- Card header -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,14">
                            <TextBlock
                                Text="Schedule"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </Border>
                        <!-- Trigger rows (populated in code-behind) -->
                        <StackPanel x:Name="TriggersPanel" />
                        <!-- Empty state -->
                        <Border x:Name="NoTriggersMessage" Padding="20,20" Visibility="Collapsed">
                            <TextBlock
                                Text="No triggers configured."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Execution History card ===== -->
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <!-- Card header -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14,20,14">
                            <TextBlock
                                Text="Execution History"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </Border>

                        <!-- Table column headers -->
                        <Grid Padding="20,10,20,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STARTED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="DURATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="ERROR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- History rows (populated in code-behind) -->
                        <StackPanel x:Name="HistoryRowsPanel" />

                        <!-- Empty state -->
                        <Border x:Name="NoHistoryMessage" Padding="20,32" Visibility="Collapsed">
                            <TextBlock
                                Text="No execution history."
                                FontSize="13"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
