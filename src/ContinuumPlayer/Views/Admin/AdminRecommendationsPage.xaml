<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminRecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer IsScrollInertiaEnabled="True">
            <StackPanel Padding="40,28,40,40" Spacing="32">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Recommendations"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Configure and manage the recommendation engine, embeddings, and taste profiles."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- ===== Status banner ===== -->
                <Border
                    x:Name="StatusBanner"
                    Background="{StaticResource AccentBackgroundBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusBannerText"
                        FontSize="13"
                        Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- ===== Job Cards (2x2 grid) ===== -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Jobs"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}" />

                    <Grid ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card 1: Embeddings -->
                        <Border
                            Grid.Row="0" Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="22"
                            Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE8F4;"
                                        FontSize="24"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        Text="Embeddings"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="Generate vector embeddings for all catalog items"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />

                                <!-- Run button -->
                                <Button
                                    x:Name="RunEmbeddingsButton"
                                    Grid.Row="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="RunEmbeddingsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            x:Name="RunEmbeddingsIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunEmbeddingsText" Text="Run" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Taste Profiles -->
                        <Border
                            Grid.Row="0" Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="22"
                            Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE716;"
                                        FontSize="24"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        Text="Taste Profiles"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="Build user taste profiles from watch history"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />

                                <!-- Run button -->
                                <Button
                                    x:Name="RunTasteProfilesButton"
                                    Grid.Row="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="RunTasteProfilesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            x:Name="RunTasteProfilesIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunTasteProfilesText" Text="Run" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 3: Co-Watch Matrix -->
                        <Border
                            Grid.Row="1" Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="22"
                            Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE8EF;"
                                        FontSize="24"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        Text="Co-Watch Matrix"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="Calculate co-watch correlations between items"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />

                                <!-- Run button -->
                                <Button
                                    x:Name="RunCowatchButton"
                                    Grid.Row="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="RunCowatchButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            x:Name="RunCowatchIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunCowatchText" Text="Run" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 4: Recommendations -->
                        <Border
                            Grid.Row="1" Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="22"
                            Padding="20">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon + Title -->
                                <StackPanel Grid.Row="0" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE735;"
                                        FontSize="24"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Left" />
                                    <TextBlock
                                        Text="Recommendations"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock
                                    Grid.Row="1"
                                    Text="Generate personalized recommendations for all users"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />

                                <!-- Run button -->
                                <Button
                                    x:Name="RunRecommendationsButton"
                                    Grid.Row="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Click="RunRecommendationsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            x:Name="RunRecommendationsIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunRecommendationsText" Text="Run" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
