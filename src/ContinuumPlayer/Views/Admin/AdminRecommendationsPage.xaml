<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminRecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>

        <!-- Main content -->
        <ScrollViewer IsScrollInertiaEnabled="True">
            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Recommendations"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Configure the AI-powered recommendation engine. Requires pgvector and an OpenAI-compatible embedding endpoint."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- ===== Restart-required banner ===== -->
                <Border
                    x:Name="RestartBanner"
                    MaxWidth="1080"
                    HorizontalAlignment="Left"
                    Background="#1AF59E0B"
                    BorderBrush="#4DF59E0B"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16,12"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            Glyph="&#xE7BA;"
                            FontSize="16"
                            Foreground="#F59E0B"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="One or more settings were changed. A server restart is required for changes to take effect."
                            FontSize="13"
                            Foreground="#F59E0B"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ===== Job status section ===== -->
                <StackPanel
                    x:Name="JobStatusSection"
                    Spacing="12"
                    Visibility="Collapsed">

                    <TextBlock
                        Text="Job status"
                        FontSize="18"
                        FontWeight="Medium"
                        Foreground="{StaticResource PrimaryTextBrush}" />

                    <!-- 4-column job card grid (webui: grid gap-3 lg:grid-cols-4) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Embeddings -->
                        <Border
                            x:Name="EmbeddingsCard"
                            Grid.Column="0"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <!-- Title + count -->
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Embeddings"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock
                                        x:Name="EmbeddingsCountText"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>

                                <!-- Run button (full width, outline) -->
                                <Button
                                    x:Name="RunEmbeddingsButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,7"
                                    FontSize="13"
                                    Click="RunEmbeddingsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="RunEmbeddingsIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunEmbeddingsText" Text="Run" />
                                    </StackPanel>
                                </Button>

                                <!-- Progress bar (shown only when total > 0) -->
                                <StackPanel
                                    x:Name="EmbeddingsProgressPanel"
                                    Spacing="4"
                                    Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="EmbeddingsProgressBar"
                                        Height="8"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        Foreground="{StaticResource AccentBrush}"
                                        Minimum="0"
                                        Maximum="100" />
                                    <TextBlock
                                        x:Name="EmbeddingsPctText"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Taste Profiles -->
                        <Border
                            x:Name="TasteProfilesCard"
                            Grid.Column="1"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Taste Profiles"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock
                                        x:Name="TasteProfilesCountText"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button
                                    x:Name="RunTasteProfilesButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,7"
                                    FontSize="13"
                                    Click="RunTasteProfilesButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="RunTasteProfilesIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunTasteProfilesText" Text="Run" />
                                    </StackPanel>
                                </Button>
                                <!-- Taste profiles has no total — progress panel always hidden -->
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Co-Watch Matrix -->
                        <Border
                            x:Name="CowatchCard"
                            Grid.Column="2"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Co-Watch Matrix"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock
                                        x:Name="CowatchCountText"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button
                                    x:Name="RunCowatchButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,7"
                                    FontSize="13"
                                    Click="RunCowatchButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="RunCowatchIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunCowatchText" Text="Run" />
                                    </StackPanel>
                                </Button>
                                <StackPanel
                                    x:Name="CowatchProgressPanel"
                                    Spacing="4"
                                    Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="CowatchProgressBar"
                                        Height="8"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        Foreground="{StaticResource AccentBrush}"
                                        Minimum="0"
                                        Maximum="100" />
                                    <TextBlock
                                        x:Name="CowatchPctText"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Recommendations -->
                        <Border
                            x:Name="RecommendationsCard"
                            Grid.Column="3"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="Recommendations"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock
                                        x:Name="RecommendationsCountText"
                                        FontSize="12"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button
                                    x:Name="RunRecommendationsButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="8,7"
                                    FontSize="13"
                                    Click="RunRecommendationsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="RunRecommendationsIcon"
                                            Glyph="&#xE768;"
                                            FontSize="12" />
                                        <TextBlock x:Name="RunRecommendationsText" Text="Run" />
                                    </StackPanel>
                                </Button>
                                <StackPanel
                                    x:Name="RecommendationsProgressPanel"
                                    Spacing="4"
                                    Visibility="Collapsed">
                                    <ProgressBar
                                        x:Name="RecommendationsProgressBar"
                                        Height="8"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        Foreground="{StaticResource AccentBrush}"
                                        Minimum="0"
                                        Maximum="100" />
                                    <TextBlock
                                        x:Name="RecommendationsPctText"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>

                <!-- ===== Settings sections (embedding lock + collapsible panels) ===== -->
                <StackPanel x:Name="SettingsSectionsPanel" Spacing="12" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
