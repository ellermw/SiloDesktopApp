<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Stat card: surface panel, no border -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Section card: border + radius=24 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="28">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: title + subtitle -->
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="Dashboard"
                            FontSize="42"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Live sessions, content health, and server activity in one view."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Right: action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Content="Refresh"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}" />
                        <Button
                            Content="Scan All Libraries"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ScanAllCommand}" />
                    </StackPanel>
                </Grid>

                <!-- Inline loading indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    Margin="0,24"
                    Width="32" Height="32" />

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- ===== Stats Row ===== -->
                <Grid x:Name="StatsGrid" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1: Active Streams -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Active Streams"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xEA62;"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatActiveStreams"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatActiveStreamsSub"
                                Text="0 sessions"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 2: Total Movies -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Total Movies"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE8B2;"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatMovies"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatMoviesSub"
                                Text="of 0 items"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 3: Total Shows -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Total Shows"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE7F4;"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatShows"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatShowsSub"
                                Text="0 files total"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 4: Users -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Users"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE716;"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatUsers"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatUsersSub"
                                Text="0 registered"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 5: Storage -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Storage"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xEDA2;"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatStorage"
                                Text="0 GB"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatStorageSub"
                                Text="0 files"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Now Playing Section ===== -->
                <StackPanel x:Name="NowPlayingSection" Spacing="14" Visibility="Collapsed">
                    <!-- Header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Now Playing"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="NowPlayingViewAll"
                            Grid.Column="1"
                            Text="View all 0 streams ›"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Stream cards grid (2 columns) -->
                    <Grid x:Name="StreamCardsGrid" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>

                <!-- ===== Libraries + Users Two-Column Section ===== -->
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Libraries card -->
                    <Border Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="Libraries"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="Manage ›"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <!-- Library rows populated in code-behind -->
                            <StackPanel x:Name="LibrariesPanel" Spacing="8" />
                        </StackPanel>
                    </Border>

                    <!-- Users card -->
                    <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="14">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="Users"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="Manage ›"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <!-- User rows populated in code-behind -->
                            <StackPanel x:Name="UsersPanel" Spacing="0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Recent Activity Section ===== -->
                <Border x:Name="RecentActivitySection" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Recent Activity"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="View all ›"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center" />
                        </Grid>
                        <!-- Activity items populated in code-behind -->
                        <StackPanel x:Name="ActivityPanel" Spacing="0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
