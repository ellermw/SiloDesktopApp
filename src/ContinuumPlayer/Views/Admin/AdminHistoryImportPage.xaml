<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminHistoryImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="History Import"
                                   FontSize="{StaticResource FontSizeDisplayLarge}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Import watch history from Plex, Emby, Jellyfin, or other sources."
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="New Import"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NewImport_Click"
                            VerticalAlignment="Top" />
                </Grid>

                <!-- Import runs list -->
                <ItemsRepeater x:Name="RunsList"
                               ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="12" Padding="16">
                                <TextBlock Text="{x:Bind}" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyText"
                           Text="No import history. Click 'New Import' to get started."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
