<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminHistoryImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:local="using:ContinuumPlayer.Views.Admin"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="History Import"
                                   FontSize="{StaticResource FontSizeDisplayLarge}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Import watch history from external servers into Continuum user profiles."
                                   FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Add Source"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="NewSource_Click"
                            VerticalAlignment="Top" />
                </Grid>

                <!-- Error -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                           TextWrapping="Wrap" />

                <!-- Source servers section -->
                <TextBlock Text="SOURCE SERVERS"
                           Style="{StaticResource SectionHeaderTextStyle}" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryImportSourceDisplay">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="12" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Display}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{x:Bind SubDisplay}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Tag="{x:Bind Id}"
                                            Click="DeleteSource_Click"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Delete source">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                  Foreground="{StaticResource ErrorBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyText"
                           Text="No import sources. Click 'Add Source' to configure a Plex, Emby, or Jellyfin server."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           Visibility="Collapsed" />

                <!-- Runs section -->
                <TextBlock Text="RECENT IMPORTS"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           Margin="0,16,0,0" />

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:HistoryImportRunDisplay">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="12" Padding="16,12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Display}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="{x:Bind SubDisplay}"
                                               FontSize="12"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
