<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminInviteCodesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock Text="Invite codes" FontSize="42" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage invite codes for user registration." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button x:Name="CreateButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" Click="CreateButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Create Code" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border x:Name="StatusBanner" Background="{StaticResource AccentBackgroundBrush}" CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                    <TextBlock x:Name="StatusBannerText" FontSize="13" Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- ===== Public Signups card — matches web InviteCodesTab Public Signups card ===== -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" BorderThickness="0" Padding="20,14,20,14">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Public Signups" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="When enabled, users with a valid invite code can create their own accounts."
                                FontSize="12"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <ToggleSwitch
                                x:Name="SignupToggle"
                                OnContent="Enabled"
                                OffContent="Disabled"
                                Toggled="SignupToggle_Toggled" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" BorderThickness="0" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,14,20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Code" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="Label" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="Usage" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="Status" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="Created" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="Actions" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                        <!-- Inline loading indicator -->
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Width="32" Height="32" />

                        <!-- Inline error state -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="400" />
                            <Button
                                Content="Retry"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.LoadCommand}" />
                        </StackPanel>

                        <StackPanel x:Name="CodesPanel" Spacing="0" />
                        <Border x:Name="EmptyState" Padding="20,40" Visibility="Collapsed">
                            <TextBlock Text="No invite codes yet." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
