<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.Admin.AdminNodesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>

        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="32">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="Nodes"
                        FontSize="42"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Manage proxy and transcode nodes for content delivery and encoding."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- ===== Status banner ===== -->
                <Border
                    x:Name="StatusBanner"
                    Background="{StaticResource AccentBackgroundBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusBannerText"
                        FontSize="13"
                        Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- ===== Proxy Nodes section ===== -->
                <StackPanel Spacing="14">

                    <!-- Section header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock
                                Text="PROXY NODES"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                CharacterSpacing="100"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="ProxyNodeCountBadge"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="7,2,7,2">
                                <TextBlock
                                    x:Name="ProxyNodeCountText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>

                        <Button
                            x:Name="AddProxyNodeButton"
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddProxyNodeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add Proxy Node" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Info banner -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="10"
                        Padding="0">
                        <Grid>
                            <!-- Accent left border -->
                            <Border
                                Background="{StaticResource AccentBrush}"
                                Width="3"
                                CornerRadius="3,0,0,3"
                                HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="18,10,14,10">
                                <FontIcon
                                    Glyph="&#xE946;"
                                    FontSize="14"
                                    Foreground="{StaticResource AccentBrush}"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0" />
                                <TextBlock
                                    Text="Proxy nodes route streams from storage to clients. The URL must be publicly accessible by streaming clients."
                                    FontSize="13"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table card -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="24"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="0">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="20,14,20,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="URL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="HEALTH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="LAST CHECK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                            <!-- Proxy rows — populated in code-behind -->
                            <StackPanel x:Name="ProxyNodesPanel" Spacing="0" />

                            <!-- Empty state -->
                            <Border x:Name="ProxyEmptyState" Padding="20,40" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE968;"
                                        FontSize="32"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="No proxy nodes configured"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Add a proxy node to enable distributed stream delivery."
                                        FontSize="13"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Transcode Nodes section ===== -->
                <StackPanel Spacing="14">

                    <!-- Section header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock
                                Text="TRANSCODE NODES"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                CharacterSpacing="100"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="TranscodeNodeCountBadge"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="10"
                                Padding="7,2,7,2">
                                <TextBlock
                                    x:Name="TranscodeNodeCountText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>

                        <Button
                            x:Name="AddTranscodeNodeButton"
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddTranscodeNodeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add Transcode Node" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Info banner (amber) -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="10"
                        Padding="0">
                        <Grid>
                            <!-- Amber left border -->
                            <Border
                                Width="3"
                                CornerRadius="3,0,0,3"
                                HorizontalAlignment="Left">
                                <Border.Background>
                                    <SolidColorBrush Color="#F59E0B" />
                                </Border.Background>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="18,10,14,10">
                                <FontIcon
                                    Glyph="&#xE7BA;"
                                    FontSize="14"
                                    VerticalAlignment="Top"
                                    Margin="0,1,0,0">
                                    <FontIcon.Foreground>
                                        <SolidColorBrush Color="#F59E0B" />
                                    </FontIcon.Foreground>
                                </FontIcon>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="Transcode nodes handle video encoding for clients that can't direct play. Requires GPU hardware. " />
                                    <Run Text="Must be on the same network as proxy nodes and the backend." FontWeight="SemiBold" />
                                    <Run Text=" No public URL required." />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table card -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="24"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="0">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="20,14,20,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="NAME" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="URL" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="HEALTH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="JOBS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="5" Text="LAST CHECK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                            <!-- Transcode rows — populated in code-behind -->
                            <StackPanel x:Name="TranscodeNodesPanel" Spacing="0" />

                            <!-- Empty state -->
                            <Border x:Name="TranscodeEmptyState" Padding="20,40" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE9D9;"
                                        FontSize="32"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="No transcode nodes configured"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        Text="Add a transcode node to offload video encoding from the main server."
                                        FontSize="13"
                                        Foreground="{StaticResource TertiaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
