<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.ServerSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
        <StackPanel Spacing="24">
            <!-- Branding -->
            <TextBlock
                Text="Continuum"
                FontSize="{StaticResource FontSizeDisplay}"
                FontWeight="Bold"
                Foreground="{StaticResource AccentBrush}"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Select a server to connect to"
                Style="{StaticResource SecondaryTextStyle}"
                HorizontalAlignment="Center" />

            <!-- Error message -->
            <TextBlock
                x:Name="ErrorText"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />

            <!-- Server list -->
            <ListView
                x:Name="ServerList"
                ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
                SelectionMode="None"
                MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Name}"
                                    Style="{StaticResource BodyTextStyle}" />
                                <TextBlock
                                    Text="{Binding Url}"
                                    Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Connect"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="ConnectServer_Click"
                                Tag="{Binding}" />
                            <Button
                                Grid.Column="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="RemoveServer_Click"
                                Tag="{Binding}"
                                ToolTipService.ToolTip="Remove server">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <TextBlock
                x:Name="EmptyStateText"
                Text="No servers added yet. Add one to get started."
                Style="{StaticResource SecondaryTextStyle}"
                HorizontalAlignment="Center" />

            <!-- Add server form -->
            <Border
                Style="{StaticResource CardStyle}"
                Visibility="{x:Bind ViewModel.IsAddingServer, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add Server" Style="{StaticResource TitleTextStyle}" />
                    <TextBox
                        x:Name="ServerUrlBox"
                        PlaceholderText="Server URL (e.g., https://continuum.example.com)"
                        Text="{x:Bind ViewModel.NewServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource DarkTextBoxStyle}" />
                    <TextBox
                        PlaceholderText="Display Name (optional)"
                        Text="{x:Bind ViewModel.NewServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource DarkTextBoxStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.CancelAddServerCommand}" />
                        <Button
                            Content="Add Server"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AddServerCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Add server button (when form is hidden) -->
            <Button
                Content="Add Server"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ShowAddServerCommand}"
                Visibility="{x:Bind ViewModel.IsAddingServer, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>
    </Grid>
</Page>
