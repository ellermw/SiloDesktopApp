<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCollectionsCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Text="Collections"
                            FontSize="{StaticResource FontSizeDisplayLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Build personal or shared shelves around moods, series arcs, or anything else worth grouping."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="BrowseTemplatesButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="BrowseTemplates_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Browse Templates" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CreateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CreateCollection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New Collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Empty State ===== -->
                <Border
                    x:Name="EmptyState"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24"
                    Padding="40,48"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon
                            Glyph="&#xE8FD;"
                            FontSize="40"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="No collections yet"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Create your first collection to organize movies and shows into custom lists."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="420"
                            TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BrowseTemplates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Start from a template" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Click="CreateCollection_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create from scratch" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Collections Grid ===== -->
                <StackPanel x:Name="CollectionsGrid" Spacing="0" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
