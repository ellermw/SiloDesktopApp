<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Undo dismissal banner (bottom, overlaid) -->
        <Border
            x:Name="UndoBanner"
            Visibility="Collapsed"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,24"
            Padding="16,10,8,10"
            CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="UndoBannerText"
                    Text="Item dismissed"
                    FontSize="13"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="UndoButton"
                    Content="Undo"
                    Style="{StaticResource AccentButtonStyle}"
                    FontSize="12"
                    Padding="12,6"
                    CornerRadius="8"
                    Click="UndoButton_Click" />
            </StackPanel>
        </Border>

        <!-- Loading indicator -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error message -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True"
            CanContentRenderOutsideBounds="True">

            <!-- Web: space-y-10 py-2 -->
            <StackPanel x:Name="ContentPanel" Padding="0,8,0,0">
                <!-- Hero carousel for featured sections (web: mb-10 = 40px) -->
                <controls:HeroCarousel x:Name="HeroCarouselControl" Margin="0,0,0,40" />

                <!-- Watch Tonight quick-launcher (web parity: glass button above
                     the section rows, right-aligned). Opens WatchTonightDialog.
                     Right margin leaves ~50px clearance so the floating Server
                     Activity button in MainWindow doesn't overlap on top of it. -->
                <Grid Margin="40,0,92,12">
                    <Button
                        x:Name="WatchTonightButton"
                        HorizontalAlignment="Right"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,8"
                        Click="WatchTonightButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE734;" FontSize="14"
                                      Foreground="{StaticResource AccentBrush}" />
                            <TextBlock
                                Text="Watch Tonight"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Section rows (each section handles its own spacing and padding) -->
                <StackPanel x:Name="SectionsPanel" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
