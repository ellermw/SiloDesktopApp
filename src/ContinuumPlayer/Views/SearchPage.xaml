<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    xmlns:catalog="using:ContinuumPlayer.Core.Models.Catalog"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Empty state: shown when no query entered (web: Catalog.tsx empty search state) -->
        <StackPanel
            x:Name="EmptyState"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Padding="40">

            <!-- Search icon (web: Search h-10 w-10 strokeWidth=1.5) -->
            <FontIcon
                Glyph="&#xE721;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Title (web: page-title mb-4) -->
            <TextBlock
                Text="Search"
                FontSize="{StaticResource FontSizeDisplayLarge}"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Subtitle (web: page-subtitle mb-8 max-w-xl text-sm) -->
            <TextBlock
                Text="Find films, series, performances, and rediscover things you forgot you saved."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />

            <!-- Prominent search bar (web: SearchBar prominent - surface-panel h-14 rounded-[1.4rem] pl-12) -->
            <Border
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                MaxWidth="520"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="18"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="15"
                        Padding="46,14,16,14"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="20"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Results state: shown when query entered -->
        <Grid
            x:Name="ResultsState"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with title + count panel (web: page-header in CatalogResults) -->
            <Grid Grid.Row="0" Margin="40,24,40,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title + subtitle -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock
                        x:Name="ResultsTitle"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Refine the archive by type, era, rating, or genre."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Item count panel (web: surface-panel-subtle rounded-[1.35rem] px-5 py-4) -->
                <Border
                    Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="20"
                    Padding="20,16"
                    MinWidth="160"
                    VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock
                            Text="AVAILABLE NOW"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="160"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            x:Name="ResultCountText"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Margin="0,4,0,0" />
                        <TextBlock
                            x:Name="ResultCountLabel"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search bar in results view (web: centered prominent SearchBar) -->
            <Border
                Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Margin="40,0,40,20"
                MaxWidth="600"
                HorizontalAlignment="Center">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="16"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0" />
                    <TextBox
                        x:Name="ResultsSearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="14"
                        Padding="40,10,14,10"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="20"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>
            </Border>

            <!-- Results grid -->
            <ScrollViewer Grid.Row="2" Padding="40,0,40,24">
                <StackPanel>

                    <!-- People results section -->
                    <StackPanel x:Name="PeopleSection" Visibility="Collapsed" Margin="0,0,0,24">
                        <TextBlock
                            Text="People"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Margin="0,0,0,12" />

                        <ItemsRepeater x:Name="PeopleRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="catalog:Person">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        CornerRadius="8"
                                        Click="PersonCard_Click"
                                        Tag="{x:Bind Id}">
                                        <StackPanel Width="100" Spacing="6">
                                            <!-- Photo circle / initials fallback -->
                                            <Border
                                                Width="80" Height="80"
                                                CornerRadius="40"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                HorizontalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="24"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <!-- Name -->
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <ItemsRepeater x:Name="ResultsRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="{StaticResource PosterCardWidth}"
                                MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                MinColumnSpacing="12"
                                MinRowSpacing="16"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <controls:PosterCard MediaItem="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Loading -->
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,24"
                        Width="32" Height="32" />

                    <!-- Error -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                        Foreground="{StaticResource ErrorBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8" />

                    <!-- No results -->
                    <TextBlock
                        x:Name="NoResultsText"
                        Text="No items found."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
