<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <!-- Full-page centered auth shell -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="400"
            Spacing="16">

            <!-- Glass card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="24">
                    <!-- Header: Branding + subtitle -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Continuum"
                            FontSize="30"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />

                        <TextBlock
                            Text="Sign in with an existing account."
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14" />
                    </StackPanel>

                    <!-- Error message -->
                    <Border
                        x:Name="ErrorBorder"
                        Background="#2DEF6B73"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- Form fields -->
                    <StackPanel Spacing="16">
                        <!-- Username -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Username"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="UsernameBox"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Enter your username"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Password"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Style="{StaticResource DarkPasswordBoxStyle}"
                                PlaceholderText="Enter your password"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Sign in button -->
                        <Button
                            Content="Sign in"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Command="{x:Bind ViewModel.LoginCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <!-- Loading indicator -->
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Width="28" Height="28" />
                </StackPanel>
            </Border>

            <!-- Back to server select -->
            <Button
                Content="Back to Servers"
                Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Center"
                Click="BackButton_Click" />
        </StackPanel>
    </Grid>
</Page>
