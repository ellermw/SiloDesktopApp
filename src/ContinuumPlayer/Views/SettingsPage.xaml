<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Active tab style (pill on surface) -->
        <Style x:Key="ActiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Inactive tab style -->
        <Style x:Key="InactiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Settings group card
             B24: 22 was arbitrary; shadcn `rounded-lg`=8. Padding 24 vertical /
             24 horizontal matches `py-6 px-6`. -->
        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusLG}" />
            <Setter Property="Padding" Value="24,24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Settings row separator -->
        <Style x:Key="SettingsSeparator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel MaxWidth="1200" Margin="48,24,48,48">

            <!-- ===== Header (with back button matching webui SettingsLayout) ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Manage your playback preferences, libraries, and display options."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}"
                        VerticalAlignment="Top" Padding="12,8" CornerRadius="12"
                        Click="SettingsBackButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE76B;" FontSize="14" />
                        <TextBlock Text="Back" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== Status / Error ===== -->
            <StackPanel Margin="0,8,0,0">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource ErrorBrush}"
                    FontSize="13"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource AccentBrush}"
                    FontSize="13" />
            </StackPanel>

            <!-- ===== Settings Navigation: Two-column layout (sidebar + content) ===== -->
            <!-- Webui: SettingsLayout.tsx — grouped sidebar (220px) on desktop -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left sidebar navigation (grouped) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                    <StackPanel Spacing="20">
                        <!-- Playback group -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="PlaybackTab" Click="Tab_Click" Tag="Playback"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Playback" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SubtitlesTab" Click="Tab_Click" Tag="Subtitles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xED1E;" FontSize="16" />
                                    <TextBlock Text="Subtitles" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Appearance group -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="AppearanceTab" Click="Tab_Click" Tag="Appearance"
                                    Style="{StaticResource ActiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE790;" FontSize="16" />
                                    <TextBlock Text="Appearance" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeEditorTab" Click="Tab_Click" Tag="ThemeEditor"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE771;" FontSize="16" />
                                    <TextBlock Text="Theme Editor" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AccessibilityTab" Click="Tab_Click" Tag="Accessibility"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F3;" FontSize="16" />
                                    <TextBlock Text="Accessibility" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HomeScreenTab" Click="Tab_Click" Tag="HomeScreen"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xECA5;" FontSize="16" />
                                    <TextBlock Text="Home Screen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Library & Data group -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="LIBRARY &amp; DATA" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="LibrariesTab" Click="Tab_Click" Tag="Libraries"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                    <TextBlock Text="Libraries" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportTab" Click="Tab_Click" Tag="Import"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="16" />
                                    <TextBlock Text="Import" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WebhookSyncTab" Click="Tab_Click" Tag="WebhookSync"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" />
                                    <TextBlock Text="Webhook Sync" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WatchProvidersTab" Click="Tab_Click" Tag="WatchProviders"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                                    <TextBlock Text="Watch Providers" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Account group -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="ProfilesTab" Click="Tab_Click" Tag="Profiles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                    <TextBlock Text="Profiles" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PluginsTab" Click="Tab_Click" Tag="Plugins"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEA86;" FontSize="16" />
                                    <TextBlock Text="Plugins" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SessionsTab" Click="Tab_Click" Tag="Sessions"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                                    <TextBlock Text="Sessions" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right column: all content panels stack here; only the
                     active one is Visible (Tab_Click toggles visibility). -->
                <StackPanel Grid.Column="1" Padding="24,0,0,0">

            <!-- ===================================================================== -->
            <!-- ===== Appearance Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="AppearancePanel" Spacing="24" Margin="0,0,0,0">

                <TextBlock Text="Appearance" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />

                <!-- Theme group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Click to apply and persist the selection to this profile."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- Theme cards grid (built in code-behind) -->
                        <ItemsControl x:Name="ThemeCardsContainer">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Current selection -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Current selection" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Changes apply immediately and are saved for the active profile."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="CurrentThemeName" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="CurrentThemeDescription" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset to Cinema Dark"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8" FontSize="14"
                                    VerticalAlignment="Center"
                                    Click="ResetTheme_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Playback Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="PlaybackPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Playback" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Defaults for quality, language, and playback shortcuts."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Quality and language group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Quality and language" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Choose the defaults this profile should use when playback starts."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Video quality -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Video quality" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Pick the resolution to use when the app can match your connection."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="QualityComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="QualityComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="480p" Tag="480p" />
                                <ComboBoxItem Content="720p" Tag="720p" />
                                <ComboBoxItem Content="1080p" Tag="1080p" />
                                <ComboBoxItem Content="4K" Tag="4k" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Preferred audio language -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Preferred audio language" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose which audio track language to prefer when a file offers more than one."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SpokenLanguageComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SpokenLanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="No preference" Tag="" />
                                <ComboBoxItem Content="Original" Tag="original" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Spanish" Tag="es" />
                                <ComboBoxItem Content="French" Tag="fr" />
                                <ComboBoxItem Content="German" Tag="de" />
                                <ComboBoxItem Content="Italian" Tag="it" />
                                <ComboBoxItem Content="Portuguese" Tag="pt" />
                                <ComboBoxItem Content="Japanese" Tag="ja" />
                                <ComboBoxItem Content="Korean" Tag="ko" />
                                <ComboBoxItem Content="Chinese" Tag="zh" />
                                <ComboBoxItem Content="Russian" Tag="ru" />
                                <ComboBoxItem Content="Arabic" Tag="ar" />
                                <ComboBoxItem Content="Hindi" Tag="hi" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Subtitle language -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle language" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose a subtitle language to prefer. Leave it off if you do not have one."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleLanguageComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitleLanguageComboBox_SelectionChanged">
                                <ComboBoxItem Content="None" Tag="" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Spanish" Tag="es" />
                                <ComboBoxItem Content="French" Tag="fr" />
                                <ComboBoxItem Content="German" Tag="de" />
                                <ComboBoxItem Content="Italian" Tag="it" />
                                <ComboBoxItem Content="Portuguese" Tag="pt" />
                                <ComboBoxItem Content="Japanese" Tag="ja" />
                                <ComboBoxItem Content="Korean" Tag="ko" />
                                <ComboBoxItem Content="Chinese" Tag="zh" />
                                <ComboBoxItem Content="Russian" Tag="ru" />
                                <ComboBoxItem Content="Arabic" Tag="ar" />
                                <ComboBoxItem Content="Hindi" Tag="hi" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Subtitle behavior -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle behavior" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Decide when subtitles should appear if the app has a match."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleModeComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitleModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="Always" Tag="always" />
                                <ComboBoxItem Content="Off" Tag="off" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Show forced subtitles -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Show forced subtitles" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Display subtitles for foreign-language dialogue even when subtitles are off or set to auto."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ForcedSubtitlesToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.ShowForcedSubtitles, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Skipping and next up group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Skipping and next up" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Control the small playback shortcuts that can save you a few taps."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Skip intros -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Skip intros automatically" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Jump past opening credits when intro markers are available."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSkipIntroToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoSkipIntro, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Skip recaps -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Skip recaps automatically" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Jump past previously-on recaps when recap markers are available."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSkipRecapToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoSkipRecap, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Skip credits -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Skip end credits automatically" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Jump past credits when credit markers are available."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSkipCreditsToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoSkipCredits, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Next episode preview -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Show next episode preview automatically" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Use preview markers when available before the next episode countdown."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoPlayNextPreviewToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoPlayNextPreview, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Next up episodes -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Next up episodes" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose whether the next unwatched episode appears with Continue Watching or on its own."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="NextUpModeComboBox" Grid.Column="1" Width="240"
                                      VerticalAlignment="Center"
                                      SelectionChanged="NextUpModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="With Continue Watching" Tag="combined" />
                                <ComboBoxItem Content="In a separate section" Tag="separate" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Libraries Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="LibrariesPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Libraries" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Toggle which libraries appear in your navigation and customize playback defaults per library."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Library cards container (built in code-behind) -->
                <StackPanel x:Name="LibraryCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Subtitles Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="SubtitlesPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Subtitles" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Preview changes as you work, then save when the style feels right."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Preview -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="This sample reflects the current subtitle size, color, and positioning."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <!-- 16:9 preview box -->
                        <Border CornerRadius="20" Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F0F1A" Offset="0" />
                                    <GradientStop Color="#1A1A3E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Height="200">
                                <StackPanel x:Name="SubtitlePreviewStack" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Margin="0,0,0,24" Spacing="4">
                                    <Border x:Name="SubtitlePreviewBg1" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine1"
                                                   Text="Sample subtitle text"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SubtitlePreviewBg2" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine2"
                                                   Text="with multiple lines"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Text group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Text" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Adjust the size, typeface, color, and outline treatment for subtitle text."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Font size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontSizeComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontSize_Changed">
                                <ComboBoxItem Content="Small" Tag="small" />
                                <ComboBoxItem Content="Medium" Tag="medium" IsSelected="True" />
                                <ComboBoxItem Content="Large" Tag="large" />
                                <ComboBoxItem Content="Extra Large" Tag="xlarge" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Font family -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font family" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontFamilyComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontFamily_Changed">
                                <ComboBoxItem Content="Default (Sans-serif)" Tag="default" IsSelected="True" />
                                <ComboBoxItem Content="Monospace" Tag="monospace" />
                                <ComboBoxItem Content="Serif" Tag="serif" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Font color -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font color" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="SubtitleColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Text outline -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text outline" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch
                                x:Name="SubtitleOutlineToggle"
                                Grid.Column="1"
                                IsOn="True"
                                VerticalAlignment="Center"
                                OnContent="" OffContent=""
                                Toggled="SubtitleOutline_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Background group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Background" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Change the backing used for boxed subtitles and how strongly it appears."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Background style -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background style" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Only the boxed style uses a fill, opacity, and background color."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleBgStyleComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitleBgStyle_Changed">
                                <ComboBoxItem Content="None" Tag="none" />
                                <ComboBoxItem Content="Box" Tag="box" IsSelected="True" />
                                <ComboBoxItem Content="Shadow" Tag="shadow" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Background opacity -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background opacity" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Increase this to make the subtitle box more solid."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Slider x:Name="SubtitleBgOpacitySlider" Width="160"
                                        Minimum="0" Maximum="100" StepFrequency="5" Value="80"
                                        ValueChanged="SubtitleBgOpacity_Changed" />
                                <TextBlock x:Name="SubtitleBgOpacityLabel" Text="80%"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Position group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Position" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Place subtitles where they read best on the video frame."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Position" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose where subtitles sit on the video frame."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitlePositionComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitlePosition_Changed">
                                <ComboBoxItem Content="Bottom" Tag="bottom" IsSelected="True" />
                                <ComboBoxItem Content="Top" Tag="top" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8" Click="SubtitleSave_Click" />
                    <Button Content="Reset to Defaults" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8" Click="SubtitleReset_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Home Screen Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="HomeScreenPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Home screen" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Choose a scope, then arrange the sections that appear on that screen."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Scope group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Scope" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Pick the home screen or library-specific view you want to customize."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Editing scope" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Changes apply only to the selected home screen."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HomeScopeComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Home" Tag="home" IsSelected="True" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sections group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Sections" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Reorder, show, or hide sections. Use the arrows to change order."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="24" Height="24" />

                        <!-- Section items (built in code-behind) -->
                        <StackPanel x:Name="HomeSectionItemsContainer" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8" Click="HomeSectionsSave_Click" />
                    <Button Content="Reset to Defaults" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8" Click="HomeSectionsReset_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Import Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="ImportPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="History import" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Import watch history from an external media server into a Silo profile."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== New import — source + credentials + start button ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="New import" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Choose a source, enter credentials, then pick the profile to import into."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Source cards — 3-up grid (Emby / Jellyfin / Plex) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ImportSourceEmbyCard" Grid.Column="0" Tag="emby"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#1DCFA1">
                                            <TextBlock Text="E" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Emby" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Emby Connect cloud or a saved admin server."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourceJellyfinCard" Grid.Column="1" Tag="jellyfin"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#00A4DC">
                                            <TextBlock Text="J" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Jellyfin" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Point directly at a Jellyfin server URL."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourcePlexCard" Grid.Column="2" Tag="plex"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#E5A00D">
                                            <TextBlock Text="P" FontSize="15" FontWeight="SemiBold" Foreground="Black"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Plex" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Plex OAuth sign-in or a saved admin server."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Mode selector — only for Emby and Plex (Jellyfin is single-mode) -->
                        <StackPanel x:Name="ImportEmbyModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportEmbyConnectModeBtn" Content="Emby Connect" Tag="connect"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportEmbySavedModeBtn" Content="Saved Server" Tag="saved"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="ImportPlexModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportPlexOAuthModeBtn" Content="Plex Account" Tag="oauth"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportPlexSavedModeBtn" Content="Saved Server" Tag="saved"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <!-- ===== Auth panels (one visible at a time) ===== -->

                        <!-- Emby Connect form -->
                        <StackPanel x:Name="ImportEmbyConnectPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Emby Connect email or username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbyConnectUsernameBox"
                                             Text="{x:Bind ViewModel.EmbyConnectUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Emby Connect password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbyConnectPasswordBox"
                                                 PasswordChanged="EmbyConnectPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="EmbyConnectLoginButton" Content="Find my Emby servers"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="EmbyConnectLogin_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="EmbyConnectConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="EmbyConnectServerCombo"
                                                  SelectionChanged="EmbyConnectServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <TextBlock Text="Silo will exchange the server's temporary access key for a local Emby token and use it only for this import."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Emby Saved form -->
                        <StackPanel x:Name="ImportEmbySavedPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved server" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="EmbySavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="EmbySavedSource_SelectionChanged" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Emby username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbySavedUsernameBox"
                                             Text="{x:Bind ViewModel.EmbySavedUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Emby password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbySavedPasswordBox"
                                                 PasswordChanged="EmbySavedPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Plex OAuth form -->
                        <StackPanel x:Name="ImportPlexOAuthPanel" Spacing="12" Visibility="Collapsed">
                            <!-- Pending spinner + status -->
                            <Border x:Name="PlexAuthPendingPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ProgressRing IsActive="True" Width="18" Height="18" />
                                    <TextBlock x:Name="PlexAuthPendingText" FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Error panel -->
                            <Border x:Name="PlexAuthErrorPanel" Visibility="Collapsed"
                                    Background="#331F1F1F"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource ErrorBrush}" />
                                        <TextBlock x:Name="PlexAuthErrorText" FontSize="13"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Content="Try again" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- Sign-in button -->
                            <Button x:Name="PlexAuthSignInButton" Content="Sign in with Plex"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="PlexAuthStart_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="PlexAuthConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="PlexOAuthServerCombo"
                                                  SelectionChanged="PlexOAuthServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <Button Content="Reconnect Plex account" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plex Saved form -->
                        <StackPanel x:Name="ImportPlexSavedPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved server" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="PlexSavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="PlexSavedSource_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Plex auth token" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <PasswordBox x:Name="PlexSavedTokenBox"
                                             PasswordChanged="PlexSavedToken_Changed"
                                             Style="{StaticResource DarkPasswordBoxStyle}" MaxWidth="420" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Jellyfin direct form -->
                        <StackPanel x:Name="ImportJellyfinPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Jellyfin server URL" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="JellyfinServerUrlBox"
                                         PlaceholderText="https://jellyfin.example.com"
                                         Text="{x:Bind ViewModel.JellyfinServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Jellyfin username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="JellyfinUsernameBox"
                                             Text="{x:Bind ViewModel.JellyfinUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Jellyfin password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="JellyfinPasswordBox"
                                                 PasswordChanged="JellyfinPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Enter the base URL for the Jellyfin server you want to import from."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Divider before target row -->
                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Profile + Start Import row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Import into profile" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ImportProfileCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="ImportProfile_SelectionChanged"
                                          PlaceholderText="Choose a profile" />
                            </StackPanel>
                            <Button x:Name="StartImportButton" Grid.Column="1"
                                    Content="Start import" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" Padding="24,10"
                                    Click="StartImport_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Latest import / selected run summary ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RunSummaryTitle" Text="Latest import" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="RunSummarySubtitle" Text="Results from the most recent import run."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Run summary card is built programmatically into this container -->
                        <StackPanel x:Name="RunSummaryContainer" Spacing="14" />
                    </StackPanel>
                </Border>

                <!-- ===== Import history list ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Import history" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Select a past run to view its details above."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="20" Height="20" />
                        <StackPanel x:Name="ImportRunsContainer" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Plugins Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="PluginsPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Plugin Settings" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Configure user-level settings for installed plugins."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Plugin cards (built in code-behind) -->
                <StackPanel x:Name="PluginCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Sessions Panel ===== -->
            <!-- ===================================================================== -->
            <!-- ===== Webhook Sync Panel ===== -->
            <StackPanel x:Name="WebhookSyncPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Webhook Sync" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Connect Plex, Emby, or Jellyfin servers to sync watch state in real-time via webhooks."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Connections list -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Connections" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="AddConnectionBtn" Grid.Column="1"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="AddConnectionBtn_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Connection" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="WebhookConnectionsPanel" Spacing="8" />
                        <TextBlock x:Name="NoConnectionsText"
                                   Text="No webhook connections configured. Add a connection to start syncing watch state."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Padding="0,16"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Webhook URL info -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Webhook URL" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Configure your media server to send webhooks to your Silo server's webhook endpoint. The URL is available in Admin Settings."
                                   FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Watch Providers Panel ===== -->
            <StackPanel x:Name="WatchProvidersPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Watch Providers" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Connect external trackers to import watch history, sync progress, and scrobble playback."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <StackPanel x:Name="WatchProvidersCardsPanel" Spacing="12" />
                <TextBlock x:Name="NoWatchProvidersText"
                           Text="No watch providers are registered on this server."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Padding="0,16"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Theme Editor Panel ===== -->
            <StackPanel x:Name="ThemeEditorPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Theme Editor" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Customize colors, fonts, and styles. Changes are layered on top of your active theme."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Custom CSS -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Custom CSS" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Add custom CSS that layers on top of your active theme. Use CSS variables to override individual tokens."
                                   FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="CustomCssBox"
                                 PlaceholderText=":root { --primary: #ff6b6b; }"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="120" MaxHeight="300"
                                 FontFamily="Consolas" FontSize="12"
                                 Style="{StaticResource DarkTextBoxStyle}" />
                        <TextBlock Text="CSS changes require a server-side theme configuration. This editor saves your overrides locally."
                                   FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Movie Night" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="A preview of how text, colors, and surfaces look with your current theme."
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Primary" Style="{StaticResource AccentButtonStyle}" Padding="16,8" CornerRadius="20" />
                                    <Button Content="Secondary" Style="{StaticResource OutlineButtonStyle}" Padding="16,8" CornerRadius="20" />
                                </StackPanel>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12">
                                    <TextBlock Text="Surface panel with muted text"
                                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Profiles Panel ===== -->
            <StackPanel x:Name="ProfilesPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profiles" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage user profiles: names, PINs, and access rules."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button x:Name="AddProfileButton" Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Top"
                            Click="AddProfileButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Add Profile" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel x:Name="HouseholdStreamsPanel" Spacing="8" />
                <StackPanel x:Name="ProfileCardsPanel" Spacing="8" />
                <TextBlock x:Name="NoProfilesText" Text="No profiles found."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Accessibility Panel ===== -->
            <StackPanel x:Name="AccessibilityPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Accessibility" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Increase text size, strengthen type weight, and raise contrast for clearer reading."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Text Size -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Text Size" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextSizeButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Text Weight -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Text Weight" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextWeightButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Contrast -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Contrast" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="ContrastButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="The quick brown fox jumps over the lazy dog"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="This sample paragraph reflects your current text size, weight, and contrast preferences. Adjustments take effect across the entire interface."
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Secondary text · Metadata · Captions"
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SessionsPanel" Spacing="24" Margin="0,32,0,0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Active Sessions" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="View and manage your active login sessions across devices."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Session cards container (built in code-behind) -->
                <StackPanel x:Name="SessionCardsContainer" Spacing="12" />
            </StackPanel>

                </StackPanel>
                <!-- /Grid.Column="1" content column -->
            </Grid>
            <!-- /two-column sidebar + content grid -->

        </StackPanel>
    </ScrollViewer>
</Page>
