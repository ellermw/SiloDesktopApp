<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.ProfileSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
    </Page.Resources>

    <Grid>
        <StackPanel
            Spacing="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="900">

            <!-- Title: "Who's watching?" in huge display font -->
            <TextBlock
                Text="Who's watching?"
                FontSize="{StaticResource FontSizeDisplayLarge}"
                FontWeight="ExtraBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Error message -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap" />

            <!-- Loading -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                Width="40" Height="40" />

            <!-- Profile cards grid (hidden when PIN entry is shown) -->
            <ItemsControl
                x:Name="ProfileGrid"
                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Wrapper for hover effects: relative positioning for edit/delete -->
                        <Grid Width="148">
                            <Button
                                Click="ProfileButton_Click"
                                Tag="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                PointerEntered="ProfileCard_PointerEntered"
                                PointerExited="ProfileCard_PointerExited">
                                <Border
                                    x:Name="ProfileCardBorder"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="28"
                                    Padding="20"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel
                                        Spacing="12"
                                        HorizontalAlignment="Center">
                                        <!-- Avatar circle with ring border -->
                                        <Border
                                            Width="80" Height="80"
                                            CornerRadius="40"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="2"
                                            Background="{StaticResource CardBackgroundBrush}"
                                            HorizontalAlignment="Center">
                                            <TextBlock
                                                Text="{Binding Name, Converter={StaticResource StringToInitial}}"
                                                FontSize="24"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Name -->
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}"
                                            HorizontalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            MaxWidth="108" />
                                        <!-- Lock icon if PIN -->
                                        <FontIcon
                                            Glyph="&#xE72E;"
                                            FontSize="12"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </Button>

                            <!-- Edit/Delete buttons overlay (top-right, hidden by default) -->
                            <StackPanel
                                x:Name="EditDeletePanel"
                                Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Opacity="0">
                                <Button
                                    Click="EditProfileButton_Click"
                                    Tag="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Width="24" Height="24"
                                    CornerRadius="4">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Button>
                                <Button
                                    Click="DeleteProfileButton_Click"
                                    Tag="{Binding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    Width="24" Height="24"
                                    CornerRadius="4">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Profile card (hidden when PIN shown) -->
            <Button
                x:Name="AddProfileButton"
                Click="AddProfileButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                PointerEntered="AddProfileCard_PointerEntered"
                PointerExited="AddProfileCard_PointerExited">
                <Border
                    x:Name="AddProfileCardBorder"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="28"
                    Padding="20"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Width="148">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <!-- Dashed circle with Plus icon -->
                        <Border
                            Width="80" Height="80"
                            CornerRadius="40"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="2"
                            Background="Transparent"
                            HorizontalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE710;"
                                FontSize="28"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="Add Profile"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>

            <!-- Sign out button (outline style) -->
            <Button
                x:Name="SignOutButton"
                Content="Sign out"
                Style="{StaticResource OutlineButtonStyle}"
                HorizontalAlignment="Center"
                Click="SignOutButton_Click"
                Margin="0,8,0,0"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

            <!-- PIN entry card -->
            <Border
                Style="{StaticResource GlassCardStyle}"
                MaxWidth="320"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16">
                    <TextBlock
                        x:Name="PinProfileName"
                        Style="{StaticResource TitleTextStyle}"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Enter your PIN"
                        Style="{StaticResource SecondaryTextStyle}"
                        HorizontalAlignment="Center" />

                    <!-- PIN error -->
                    <TextBlock
                        Text="{x:Bind ViewModel.PinErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        Visibility="{x:Bind ViewModel.PinErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />

                    <PasswordBox
                        x:Name="PinBox"
                        Style="{StaticResource DarkPasswordBoxStyle}"
                        PlaceholderText="Enter 4-digit PIN"
                        MaxLength="4"
                        HorizontalAlignment="Stretch"
                        KeyDown="PinBox_KeyDown" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                        <Button
                            Content="Cancel"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CancelPinCommand}" />
                        <Button
                            Content="Confirm"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.VerifyPinCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
