<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.ProfileSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:StringToInitialConverter x:Key="StringToInitial" />
    </Page.Resources>

    <Grid>
        <StackPanel
            Spacing="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="700">

            <!-- Title -->
            <TextBlock
                Text="Who's watching?"
                FontSize="{StaticResource FontSizeDisplay}"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Error message -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap" />

            <!-- Loading -->
            <ProgressRing
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                Width="40" Height="40" />

            <!-- Profile cards (hidden when PIN entry is shown) -->
            <ItemsControl
                x:Name="ProfileGrid"
                ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Click="ProfileButton_Click"
                            Tag="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0">
                            <StackPanel
                                Spacing="8"
                                HorizontalAlignment="Center">
                                <Border
                                    Width="120" Height="120"
                                    CornerRadius="12"
                                    Background="{StaticResource CardBackgroundBrush}">
                                    <TextBlock
                                        Text="{Binding Name, Converter={StaticResource StringToInitial}}"
                                        FontSize="36"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <TextBlock
                                    Text="{Binding Name}"
                                    Style="{StaticResource BodyTextStyle}"
                                    HorizontalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="120" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add Profile card (below profiles, hidden when PIN shown) -->
            <Button
                x:Name="AddProfileButton"
                Click="AddProfileButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border
                        Width="120" Height="120"
                        CornerRadius="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                        <FontIcon
                            Glyph="&#xE710;"
                            FontSize="32"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                        Text="Add Profile"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Button>

            <!-- Sign out link -->
            <HyperlinkButton
                x:Name="SignOutButton"
                Content="Sign out"
                Click="SignOutButton_Click"
                HorizontalAlignment="Center"
                Foreground="{StaticResource SecondaryTextBrush}"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />

            <!-- PIN entry -->
            <Border
                Style="{StaticResource CardStyle}"
                MaxWidth="320"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsPinRequired, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16">
                    <TextBlock
                        x:Name="PinProfileName"
                        Style="{StaticResource TitleTextStyle}"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="Enter your PIN"
                        Style="{StaticResource SecondaryTextStyle}"
                        HorizontalAlignment="Center" />

                    <!-- PIN error -->
                    <TextBlock
                        Text="{x:Bind ViewModel.PinErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        Visibility="{x:Bind ViewModel.PinErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap" />

                    <PasswordBox
                        x:Name="PinBox"
                        Style="{StaticResource DarkPasswordBoxStyle}"
                        PlaceholderText="PIN"
                        MaxLength="10"
                        HorizontalAlignment="Stretch"
                        KeyDown="PinBox_KeyDown" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.CancelPinCommand}" />
                        <Button
                            Content="Submit"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.VerifyPinCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
