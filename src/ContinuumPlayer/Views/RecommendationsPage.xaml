<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:controls="using:ContinuumPlayer.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + subtitle on left, TasteProfile card on right (web parity) -->
        <Grid Grid.Row="0" Margin="40,24,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock
                    Text="Recommendations"
                    FontSize="{StaticResource FontSizeDisplayLarge}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    Text="Personalized picks based on your viewing history and ratings."
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <!-- Taste Profile card (web: TasteProfileCard) -->
            <Border
                x:Name="TasteProfilePanel"
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="16"
                Padding="20,16"
                MinWidth="260"
                MaxWidth="360"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Your Taste Profile"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="TasteSignalCountText"
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <!-- Top Genres -->
                    <StackPanel x:Name="TopGenresPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock
                            Text="TOP GENRES"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <controls:WrapPanel
                            x:Name="TopGenresList"
                            HorizontalSpacing="6"
                            VerticalSpacing="6" />
                    </StackPanel>

                    <!-- Favorite Directors -->
                    <StackPanel x:Name="FavoriteDirectorsPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock
                            Text="FAVORITE DIRECTORS"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <controls:WrapPanel
                            x:Name="FavoriteDirectorsList"
                            HorizontalSpacing="6"
                            VerticalSpacing="6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Skeleton while recommendations load (approximates row layout). -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Padding="40,0,40,24" Spacing="36">
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="180" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="240" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="200" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Error -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center" />
            <Button Content="Retry" Style="{StaticResource OutlineButtonStyle}"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- All recommendation rows (web: rows.map(row => <MediaCarousel title={row.label}>)) -->
        <ScrollViewer
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel x:Name="RowsPanel" Spacing="8" />
        </ScrollViewer>

        <!-- Empty state (web: DiscoverEmptyState) -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE735;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Not enough data yet"
                FontSize="{StaticResource FontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Watch and rate more content to unlock personalized recommendations."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="420" />
        </StackPanel>
    </Grid>
</Page>
