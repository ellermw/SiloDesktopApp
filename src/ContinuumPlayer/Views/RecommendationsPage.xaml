<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:ContinuumPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Text="Recommendations"
            Style="{StaticResource HeaderTextStyle}"
            Margin="24,24,24,16" />

        <!-- Loading -->
        <ProgressRing
            Grid.Row="1"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <!-- Recommendation rows -->
        <ScrollViewer
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel
                x:Name="RowsPanel"
                Padding="24,0,24,24" />
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE735;"
                FontSize="48"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="No recommendations yet"
                Style="{StaticResource SecondaryTextStyle}"
                FontSize="16"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
