<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ContinuumPlayer.Views.CollectionBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:converters="using:ContinuumPlayer.Converters"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back button + title + item count -->
        <Grid Grid.Row="0" Margin="40,24,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="{StaticResource FontSizeDisplayLarge}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Border
                Grid.Column="2"
                x:Name="CountPanel"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Padding="20,16"
                MinWidth="140"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock
                        Text="COLLECTION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="160"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="ItemCountText"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,4,0,0" />
                    <TextBlock
                        x:Name="ItemCountLabel"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="1"
            x:Name="LoadingRing"
            IsActive="True"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="1"
            x:Name="ErrorText"
            Visibility="Collapsed"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="500" />

        <!-- Content grid -->
        <ScrollViewer Grid.Row="1" x:Name="ContentScroll" Padding="40,0,40,24">
            <ItemsRepeater x:Name="PosterRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="{StaticResource PosterCardWidth}"
                        MinItemHeight="{StaticResource PosterCardTotalHeight}"
                        MinColumnSpacing="12"
                        MinRowSpacing="16"
                        ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <controls:PosterCard MediaItem="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE8FD;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="This collection is empty"
                FontSize="{StaticResource FontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Add items to this collection to see them here."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>
    </Grid>
</Page>
