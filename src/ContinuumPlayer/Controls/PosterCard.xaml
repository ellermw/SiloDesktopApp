<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="{StaticResource PosterCardWidth}"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnCardTapped">

    <Grid
        x:Name="RootGrid"
        Width="{StaticResource PosterCardWidth}"
        Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="267" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Poster image area (2:3 aspect, rounded-xl = 12px).
             Scale transform lives HERE (not on the whole card) so the
             hover zoom only affects the poster, not the text below.
             Scaling the RootGrid caused overflow clipping in the
             ItemsRepeater's fixed-height cells. -->
        <Grid
            Grid.Row="0"
            CornerRadius="{StaticResource PosterCornerRadius}">

            <!-- Card background for hover -->
            <Border
                x:Name="PosterBackground"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="{StaticResource PosterCornerRadius}" />

            <!-- Thumbhash placeholder -->
            <Image
                x:Name="ThumbhashImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Actual poster image — scale transform for hover zoom lives here
                 (not on the parent Grid) so the image zooms INSIDE the
                 rounded clip frame, matching webui's overflow:hidden +
                 group-hover:scale-105 pattern. -->
            <Image
                x:Name="PosterImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="HoverTransform" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>

            <!-- Fallback title (webui: centered text line-clamp-3 when no
                 poster URL). Hidden when a poster loads successfully. -->
            <TextBlock
                x:Name="FallbackTitle"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxLines="3"
                MaxWidth="140"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                Padding="8" />

            <!-- Bottom gradient overlay (from-black/55) -->
            <Border VerticalAlignment="Bottom" Height="96" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#8C000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Card overlay badges in 4 corners. Each corner is a
                 vertical StackPanel so multiple enabled overlays at the
                 same position stack nicely. Populated by
                 PosterCard.UpdateBadges() using CardOverlayService prefs. -->
            <StackPanel
                x:Name="OverlayTopLeft"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="6" />
            <StackPanel
                x:Name="OverlayTopRight"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="6" />
            <StackPanel
                x:Name="OverlayBottomLeft"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="6" />
            <StackPanel
                x:Name="OverlayBottomRight"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="6" />

            <!-- Hover overlays — MUST be last so they paint on top of image/gradient/badges.
                 Z-order goes: background → image → gradient → badges → dim → play → border. -->
            <Border
                x:Name="HoverDim"
                CornerRadius="{StaticResource PosterCornerRadius}"
                Background="#55000000"
                Opacity="0"
                IsHitTestVisible="False" />

            <!-- Circular Play button — fades and scales in on hover, matching
                 the webui ContinueWatchingCard/WatchTonightCard hover pattern. -->
            <Grid
                x:Name="HoverPlayButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="52" Height="52"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="HoverPlayButtonTransform" ScaleX="0.7" ScaleY="0.7" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource AccentBrush}" />
                <FontIcon
                    Glyph="&#xE768;"
                    FontSize="20"
                    Foreground="{StaticResource AccentForegroundBrush}"
                    Margin="3,0,0,0" />
            </Grid>

            <!-- Hover accent border (visible only on hover) — topmost layer -->
            <Border
                x:Name="HoverBorder"
                CornerRadius="{StaticResource PosterCornerRadius}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                Opacity="0"
                IsHitTestVisible="False" />
        </Grid>

        <!-- Text below poster (web: px-1 pt-3 = 4px side, 12px top) -->
        <StackPanel Grid.Row="1" Margin="4,12,4,0">
            <!-- Title: text-[14px] font-semibold tracking-tight -->
            <TextBlock
                x:Name="TitleText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <!-- Year/type: text-[11px] font-medium uppercase tracking-[0.14em] -->
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                CharacterSpacing="140"
                Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
