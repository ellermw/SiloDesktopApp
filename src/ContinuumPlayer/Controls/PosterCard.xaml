<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="{StaticResource PosterCardWidth}"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnCardTapped">

    <Grid
        x:Name="RootGrid"
        Width="{StaticResource PosterCardWidth}"
        Background="Transparent"
        >

        <Grid.RowDefinitions>
            <RowDefinition Height="267" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Poster image area (2:3 aspect, rounded-xl = 12px) -->
        <Grid
            Grid.Row="0"
            CornerRadius="{StaticResource PosterCornerRadius}">

            <!-- Card background for hover -->
            <Border
                x:Name="PosterBackground"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="{StaticResource PosterCornerRadius}" />

            <!-- Thumbhash placeholder -->
            <Image
                x:Name="ThumbhashImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Actual poster image -->
            <Image
                x:Name="PosterImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0" />

            <!-- Bottom gradient overlay (from-black/55) -->
            <Border VerticalAlignment="Bottom" Height="96" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#8C000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Badges overlay at bottom -->
            <StackPanel
                x:Name="BadgesPanel"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="6,0,6,6"
                Visibility="Collapsed">

                <Border
                    x:Name="ResolutionBadge"
                    Background="{StaticResource BadgeResolutionBrush}"
                    CornerRadius="{StaticResource BadgeCornerRadius}"
                    Padding="6,2"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ResolutionText"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="White" />
                </Border>

                <Border
                    x:Name="AudioBadge"
                    Background="{StaticResource BadgeBackgroundBrush}"
                    CornerRadius="{StaticResource BadgeCornerRadius}"
                    Padding="6,2"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="AudioText"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource BadgeTextBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Text below poster (web: px-1 pt-3 = 4px side, 12px top) -->
        <StackPanel Grid.Row="1" Margin="4,12,4,0">
            <!-- Title: text-[14px] font-semibold tracking-tight -->
            <TextBlock
                x:Name="TitleText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <!-- Year/type: text-[11px] font-medium uppercase tracking-[0.14em] -->
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                CharacterSpacing="140"
                Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
