<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.LandscapeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="280"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnCardTapped">

    <Grid
        x:Name="RootGrid"
        Width="280"
        Background="Transparent"
        CacheMode="BitmapCache">

        <Grid.RowDefinitions>
            <RowDefinition Height="158" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Backdrop image area (16:9 aspect, rounded) -->
        <Grid Grid.Row="0" CornerRadius="12">
            <!-- Card background for hover -->
            <Border
                x:Name="CardBackground"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12" />

            <!-- Actual backdrop image -->
            <Image
                x:Name="BackdropImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0" />

            <!-- Bottom gradient overlay -->
            <Border VerticalAlignment="Bottom" Height="64" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#99000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Progress bar at bottom -->
            <Grid
                x:Name="ProgressContainer"
                VerticalAlignment="Bottom"
                Height="3"
                Visibility="Collapsed">
                <!-- Track -->
                <Border
                    Background="#40FFFFFF"
                    CornerRadius="0,0,12,12" />
                <!-- Fill -->
                <Border
                    x:Name="ProgressFill"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="0,0,0,12"
                    HorizontalAlignment="Left" />
            </Grid>

            <!-- Remaining time badge -->
            <Border
                x:Name="RemainingBadge"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,8,8"
                Background="#B3000000"
                CornerRadius="4"
                Padding="6,2"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="RemainingText"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </Border>
        </Grid>

        <!-- Text below image -->
        <StackPanel Grid.Row="1" Margin="4,8,4,0" Spacing="2">
            <!-- Title -->
            <TextBlock
                x:Name="TitleText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <!-- Episode context: "Series Title · S1 E3" -->
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
