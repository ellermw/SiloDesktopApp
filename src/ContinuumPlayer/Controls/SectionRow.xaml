<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.SectionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d">

    <Grid Margin="{StaticResource SectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section title with navigation arrows -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                x:Name="SectionTitle"
                Style="{StaticResource TitleTextStyle}"
                VerticalAlignment="Center" />
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="4">
                <Button
                    x:Name="ScrollLeftBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    Click="ScrollLeft_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
                <Button
                    x:Name="ScrollRightBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    Click="ScrollRight_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Horizontal scrolling row of posters -->
        <ScrollViewer
            x:Name="PosterScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Auto"
            VerticalScrollMode="Disabled"
            PointerWheelChanged="PosterScrollViewer_PointerWheelChanged">

            <ItemsRepeater x:Name="ItemsRepeater">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <controls:PosterCard MediaItem="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
