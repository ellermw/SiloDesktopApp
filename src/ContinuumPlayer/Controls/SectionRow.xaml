<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.SectionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- B44: Poster vs landscape cards live in DataTemplate resources and
             get swapped onto the single ItemsRepeater at runtime based on the
             section type. Removes the duplicate ScrollViewer that shipped before. -->
        <DataTemplate x:Key="PosterCardTemplate" x:DataType="models:MediaItem">
            <controls:PosterCard MediaItem="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="models:MediaItem">
            <controls:LandscapeCard MediaItem="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Web: space-y-3 (12px) between title and cards, px-4 lg:px-12 (48px side padding) -->
    <Grid
        x:Name="RootGrid"
        Margin="0,0,0,40"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section title with navigation arrows (web: text-sm font-semibold h-6) -->
        <Grid Grid.Row="0" Margin="48,0,48,12">
            <TextBlock
                x:Name="SectionTitle"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                VerticalAlignment="Center" />
            <StackPanel
                x:Name="ArrowsPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="4"
                Opacity="0">
                <Button
                    x:Name="ScrollLeftBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    IsEnabled="False"
                    Click="ScrollLeft_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
                <Button
                    x:Name="ScrollRightBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    IsEnabled="False"
                    Click="ScrollRight_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- B44: Single ScrollViewer + ItemsRepeater hosts both poster and
             landscape layouts. The ItemTemplate swaps based on section type. -->
        <ScrollViewer
            x:Name="CardsScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            ViewChanged="CardsScrollViewer_ViewChanged"
            SizeChanged="CardsScrollViewer_SizeChanged">

            <ItemsRepeater x:Name="CardsRepeater" Margin="48,0,48,0">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
