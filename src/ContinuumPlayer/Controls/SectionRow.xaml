<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.SectionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    xmlns:models="using:ContinuumPlayer.Core.Models.Home"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- B44: Poster vs landscape cards live in DataTemplate resources and
             get swapped onto the single ItemsRepeater at runtime based on the
             section type. Removes the duplicate ScrollViewer that shipped before. -->
        <DataTemplate x:Key="PosterCardTemplate" x:DataType="models:MediaItem">
            <controls:PosterCard MediaItem="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="models:MediaItem">
            <controls:LandscapeCard MediaItem="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Web: space-y-3 (12px) between title and cards, px-4 lg:px-12 (48px side padding) -->
    <Grid
        x:Name="RootGrid"
        Margin="0,0,0,40"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Section title with navigation arrows (web: text-sm font-semibold h-6) -->
        <Grid Grid.Row="0" Margin="48,0,48,12">
            <TextBlock
                x:Name="SectionTitle"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                VerticalAlignment="Center" />
            <StackPanel
                x:Name="ArrowsPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="4"
                Opacity="0">
                <Button
                    x:Name="ExploreAllBtn"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="ExploreAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            Text="Explore all"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center" />
                        <FontIcon
                            Glyph="&#xE76C;"
                            FontSize="10"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>
                <!-- Per-section refresh / retry (webui parity: retrySection). Click fires
                     RefreshRequested and the parent re-fetches this section's items. -->
                <Button
                    x:Name="RefreshSectionBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    ToolTipService.ToolTip="Refresh this section"
                    Click="RefreshSection_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
                <Button
                    x:Name="ScrollLeftBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    IsEnabled="False"
                    Click="ScrollLeft_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
                <Button
                    x:Name="ScrollRightBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="32" Height="32"
                    Padding="0"
                    IsEnabled="False"
                    Click="ScrollRight_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- B44: Single ScrollViewer + ItemsRepeater hosts both poster and
             landscape layouts. The ItemTemplate swaps based on section type. -->
        <!-- HorizontalScrollMode=Disabled prevents the mouse wheel from
             being captured by this horizontal ScrollViewer when the user is
             scrolling the page vertically. Horizontal movement is handled
             exclusively by the arrow buttons (hover-reveal). ChangeView
             still works programmatically with scroll mode disabled. -->
        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="CardsScrollViewer"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollMode="Disabled"
                ViewChanged="CardsScrollViewer_ViewChanged"
                SizeChanged="CardsScrollViewer_SizeChanged">

                <ItemsRepeater x:Name="CardsRepeater" Margin="48,0,48,0">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Edge fade gradients hinting at more content. Alpha-only fade
                 (same RGB as AppBackgroundColor with alpha=0 on the
                 transparent end) — avoids the semi-transparent gray midpoint
                 that WinUI's "Transparent" keyword (#00FFFFFF) would produce
                 when interpolating against a dark color. Opacity driven from
                 code-behind in lock-step with ScrollLeftBtn/RightBtn. -->
            <Border
                x:Name="LeftFadeGradient"
                HorizontalAlignment="Left"
                Width="64"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FF101722" Offset="0.0" />
                        <GradientStop Color="#00101722" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border
                x:Name="RightFadeGradient"
                HorizontalAlignment="Right"
                Width="64"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop Color="#FF101722" Offset="0.0" />
                        <GradientStop Color="#00101722" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- F6: skeleton row shown when Items is empty during the F12
             per-section fetch. Replaced with the real ItemsRepeater content
             as soon as items arrive. -->
        <StackPanel
            x:Name="SkeletonPanel"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="16"
            Margin="48,0,48,0"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
