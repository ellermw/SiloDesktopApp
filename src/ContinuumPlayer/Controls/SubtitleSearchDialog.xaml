<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ContinuumPlayer.Controls.SubtitleSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Search subtitles"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <Grid MinWidth="520" MinHeight="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Language picker + Search -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="LanguageComboBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                PlaceholderText="Language">
                <ComboBoxItem Content="English" Tag="en" IsSelected="True" />
                <ComboBoxItem Content="Spanish" Tag="es" />
                <ComboBoxItem Content="French" Tag="fr" />
                <ComboBoxItem Content="German" Tag="de" />
                <ComboBoxItem Content="Italian" Tag="it" />
                <ComboBoxItem Content="Portuguese" Tag="pt" />
                <ComboBoxItem Content="Dutch" Tag="nl" />
                <ComboBoxItem Content="Polish" Tag="pl" />
                <ComboBoxItem Content="Swedish" Tag="sv" />
                <ComboBoxItem Content="Russian" Tag="ru" />
                <ComboBoxItem Content="Japanese" Tag="ja" />
                <ComboBoxItem Content="Korean" Tag="ko" />
                <ComboBoxItem Content="Chinese (Simplified)" Tag="zh" />
                <ComboBoxItem Content="Arabic" Tag="ar" />
                <ComboBoxItem Content="Turkish" Tag="tr" />
            </ComboBox>
            <Button
                x:Name="SearchButton"
                Grid.Column="1"
                Content="Search"
                Click="SearchButton_Click" />
            <ProgressRing
                x:Name="SearchProgress"
                Grid.Column="2"
                IsActive="False"
                Width="24" Height="24" />
        </Grid>

        <!-- Results list -->
        <Grid Grid.Row="1">
            <TextBlock
                x:Name="EmptyStateText"
                Text="Pick a language and tap Search."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Opacity="0.7" />
            <ListView
                x:Name="ResultsList"
                SelectionMode="None"
                IsItemClickEnabled="False" />
        </Grid>

        <!-- Status line -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            FontSize="11"
            Opacity="0.75" />
    </Grid>
</ContentDialog>
