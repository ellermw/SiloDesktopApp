<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.HeroCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!-- Height set in code-behind to 72% of window (matching web UI min-h-[72dvh]) -->
    <Grid x:Name="RootGrid">
        <!-- Backdrop image with object-position: center 20% -->
        <controls:BackdropImage
            x:Name="BackdropImage"
            AnchorY="0.2" />

        <!-- Brightness overlay: web uses brightness(0.78), so ~22% darkening -->
        <Border Background="#101722" Opacity="0.22" />

        <!-- Bottom-to-top gradient (hero-gradient) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.0" />
                    <GradientStop Color="#33101722" Offset="0.25" />
                    <GradientStop Color="#8C101722" Offset="0.5" />
                    <GradientStop Color="#EB101722" Offset="0.8" />
                    <GradientStop Color="#101722" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Left-to-right gradient (hero-gradient-left) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#101722" Offset="0.0" />
                    <GradientStop Color="#CC101722" Offset="0.2" />
                    <GradientStop Color="#66101722" Offset="0.4" />
                    <GradientStop Color="Transparent" Offset="0.6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Vignette: combined left + bottom gradient -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#66101722" Offset="0.0" />
                    <GradientStop Color="#33101722" Offset="0.3" />
                    <GradientStop Color="Transparent" Offset="0.6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Content overlay -->
        <StackPanel
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Margin="48,0,0,60"
            MaxWidth="600"
            Spacing="8">

            <TextBlock
                x:Name="HeroTitle"
                Style="{StaticResource DisplayTextStyle}"
                FontSize="36"
                TextWrapping="Wrap"
                MaxLines="2" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="HeroYear"
                    Style="{StaticResource SecondaryTextStyle}"
                    FontSize="{StaticResource FontSizeSubtitle}" />
                <TextBlock x:Name="HeroGenres"
                    Style="{StaticResource SecondaryTextStyle}"
                    FontSize="{StaticResource FontSizeSubtitle}"
                    TextTrimming="CharacterEllipsis" MaxWidth="400" />
            </StackPanel>

            <TextBlock x:Name="HeroOverview"
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap" MaxLines="3"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <!-- Single CTA matching WebUI HeroBanner: "Open details" with play icon -->
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Padding="20,10"
                        Click="PlayButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        <TextBlock Text="Open details" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Nav arrows -->
        <Button x:Name="PrevButton" Style="{StaticResource GhostButtonStyle}"
            VerticalAlignment="Center" HorizontalAlignment="Left"
            Margin="8,0,0,0" Width="40" Height="40"
            Click="PrevButton_Click" Opacity="0.7">
            <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource GhostButtonStyle}"
            VerticalAlignment="Center" HorizontalAlignment="Right"
            Margin="0,0,8,0" Width="40" Height="40"
            Click="NextButton_Click" Opacity="0.7">
            <FontIcon Glyph="&#xE76C;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
        </Button>

        <!-- Dots -->
        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,12" Spacing="8" />
    </Grid>
</UserControl>
