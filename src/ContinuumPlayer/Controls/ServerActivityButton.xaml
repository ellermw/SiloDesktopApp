<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.ServerActivityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        x:Name="RootButton"
        Background="Transparent"
        BorderThickness="0"
        Padding="10"
        CornerRadius="10"
        Click="RootButton_Click"
        ToolTipService.ToolTip="Server Activity">
        <Grid>
            <FontIcon
                x:Name="ActivityIcon"
                Glyph="&#xE95E;"
                FontSize="18"
                Foreground="{StaticResource SecondaryTextBrush}" />
            <Border
                x:Name="CountBadge"
                Background="{StaticResource AccentBrush}"
                CornerRadius="9"
                Height="16"
                MinWidth="16"
                Padding="4,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-4,-6,0"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="CountBadgeText"
                    Text="0"
                    FontSize="9"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>
            <!-- Small amber dot when WS is disconnected but activity is present.
                 Mirrors upstream ServerActivity.tsx line 100. -->
            <Ellipse
                x:Name="DisconnectedDot"
                Width="8"
                Height="8"
                Fill="#F59E0B"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-2,-2"
                Visibility="Collapsed" />
        </Grid>
        <Button.Flyout>
            <Flyout x:Name="ActivityFlyout" Placement="BottomEdgeAlignedRight">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="320" />
                        <Setter Property="MaxWidth" Value="360" />
                        <Setter Property="CornerRadius" Value="16" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel x:Name="PopoverRoot" Width="320" />
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
