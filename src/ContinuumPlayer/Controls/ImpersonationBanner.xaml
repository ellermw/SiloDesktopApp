<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ContinuumPlayer.Controls.ImpersonationBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="#CC7B5E00"
        Padding="12,8"
        HorizontalAlignment="Stretch">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Warning icon + text -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <FontIcon
                    Glyph="&#xE7BA;"
                    FontSize="16"
                    Foreground="#FFFFC107" />
                <TextBlock
                    x:Name="ImpersonatingText"
                    Text="Impersonating user"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#FFFFC107"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- End impersonation button -->
            <Button
                Grid.Column="1"
                x:Name="EndImpersonationButton"
                Content="End Impersonation"
                Background="#33FFFFFF"
                Foreground="#FFFFC107"
                BorderThickness="1"
                BorderBrush="#4DFFC107"
                CornerRadius="8"
                Padding="12,6"
                FontSize="12"
                FontWeight="SemiBold"
                Click="EndImpersonation_Click" />
        </Grid>
    </Border>
</UserControl>
