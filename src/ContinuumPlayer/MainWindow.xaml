<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ContinuumPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Continuum">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="{StaticResource SidebarWidth}"
            PaneDisplayMode="Left"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">

            <NavigationView.PaneHeader>
                <TextBlock
                    Text="Continuum"
                    FontSize="{StaticResource FontSizeBranding}"
                    FontWeight="Bold"
                    Foreground="{StaticResource AccentBrush}"
                    Margin="16,12,0,12" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Libraries inserted dynamically after this point -->
                <NavigationViewItemHeader x:Name="LibrariesHeader" Content="Libraries" />

                <!-- Discover section -->
                <NavigationViewItemHeader Content="Discover" />
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recommendations" Tag="Recommendations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Your Stuff section -->
                <NavigationViewItemHeader Content="Your Stuff" />
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" Tag="Watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="0,0,0,8">
                    <Button
                        x:Name="ProfileFooterButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32" Height="32"
                                CornerRadius="6"
                                Background="{StaticResource CardBackgroundBrush}">
                                <TextBlock
                                    x:Name="ProfileInitialText"
                                    Text="?"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                x:Name="ProfileNameText"
                                Text="Profile"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="14" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem
                                    x:Name="SwitchProfileMenuItem"
                                    Text="Switch Profile"
                                    Click="SwitchProfile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE748;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="LogoutMenuItem"
                                    Text="Logout"
                                    Click="Logout_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
