<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ContinuumPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ContinuumPlayer.Controls"
    mc:Ignorable="d"
    Title="Continuum">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="{StaticResource SidebarWidth}"
            PaneDisplayMode="Left"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">

            <NavigationView.PaneHeader>
                <StackPanel Margin="16,20,16,16">
                    <!-- Logo row: play triangle icon + text -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <!-- Play triangle icon in rounded box -->
                        <Border
                            Width="40" Height="40"
                            CornerRadius="12"
                            Background="{StaticResource SidebarAccentBrush}"
                            BorderBrush="{StaticResource SidebarBorderBrush}"
                            BorderThickness="1">
                            <TextBlock
                                Text="&#x25B6;"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <!-- Branding text -->
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock
                                Text="Continuum"
                                FontSize="{StaticResource FontSizeBrandingTitle}"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="10" />
                            <TextBlock
                                Text="Media server"
                                FontSize="{StaticResource FontSizeBrandingSubtitle}"
                                FontWeight="Medium"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Home -->
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- LIBRARIES section header -->
                <NavigationViewItemHeader x:Name="LibrariesHeader" Content="LIBRARIES" />

                <!-- Libraries inserted dynamically after this point -->

                <!-- DISCOVER section header -->
                <NavigationViewItemHeader Content="DISCOVER" />
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recommendations" Tag="Recommendations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- YOUR STUFF section header -->
                <NavigationViewItemHeader Content="YOUR STUFF" />
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" Tag="Watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watch Party" Tag="WatchParty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="0,0,0,8" Spacing="2">
                    <!-- Top border separator -->
                    <Border
                        Height="1"
                        Background="{StaticResource SidebarBorderBrush}"
                        Margin="12,0,12,8"
                        Opacity="0.7" />

                    <!-- Settings nav item -->
                    <Button
                        x:Name="SettingsButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0"
                        CornerRadius="12"
                        Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="Settings"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Admin nav item (visible only for admin users) -->
                    <Button
                        x:Name="AdminButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        Click="Admin_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7EF;" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="Admin"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Profile button -->
                    <Button
                        x:Name="ProfileFooterButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Avatar -->
                            <Border
                                Width="28" Height="28"
                                CornerRadius="14"
                                Background="{StaticResource AccentBrush}">
                                <TextBlock
                                    x:Name="ProfileInitialText"
                                    Text="?"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                x:Name="ProfileNameText"
                                Text="Profile"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem
                                    x:Name="SwitchProfileMenuItem"
                                    Text="Switch Profile"
                                    Click="SwitchProfile_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE748;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="LogoutMenuItem"
                                    Text="Logout"
                                    Click="Logout_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Impersonation banner (hidden by default) -->
                <controls:ImpersonationBanner
                    x:Name="ImpersonationBannerControl"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    EndImpersonationRequested="ImpersonationBanner_EndRequested" />

                <!-- Page content -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />

                <!-- Server Activity button (overlay on top of ContentFrame). -->
                <controls:ServerActivityButton
                    x:Name="MainServerActivityButton"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,20,0" />
            </Grid>
        </NavigationView>

        <!-- Layer 2: Loading overlay (shown while preparing playback) -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{StaticResource AppBackgroundBrush}">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Preparing playback..." FontSize="16"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <!-- Error state -->
            <StackPanel x:Name="ErrorState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorTitle" Text="Media Unavailable" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorDetail" Text="" FontSize="14" MaxWidth="400" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="Go Back" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="24,10"
                        Click="ErrorDismiss_Click" />
            </StackPanel>
        </Grid>

        <!-- Layer 3: Full-window player overlay (above nav, initially hidden) -->
        <controls:PlayerOverlay x:Name="PlayerOverlayControl" Visibility="Collapsed"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 3: Mini player bar (bottom-docked, initially hidden) -->
        <controls:MiniPlayerBar x:Name="MiniPlayerBarControl"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Bottom" />

        <!-- Layer 4: Toast notifications (F2) — top-right, above everything
             including the player overlay, so feedback stays visible during
             playback preparation and errors. -->
        <controls:ToastContainer x:Name="ToastHost" />
    </Grid>
</Window>
