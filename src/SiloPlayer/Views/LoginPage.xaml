<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    FontFamily="{StaticResource ThemeFontFamily}"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVisInverse" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <!-- Full-page centered auth shell. The server-controlled login artwork is
         rendered behind the same 70% readability scrim used by the WebUI. -->
    <Grid helpers:AuthBackdrop.Enabled="True">
        <Image
            Source="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource UrlToImage}}"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            helpers:AuthBackdrop.ReadabilityScrim="True"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
        <StackPanel x:Name="LoginLayout"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="448"
            Margin="24"
            Spacing="16">

            <!-- Glass card -->
            <Border x:Name="LoginCard" Style="{StaticResource GlassCardStyle}" Padding="52,24" CornerRadius="12" BorderThickness="0">
                <StackPanel Spacing="24">
                    <!-- Header: Branding + subtitle -->
                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="ServerNameTitle"
                            Text="{x:Bind ViewModel.ServerName, Mode=OneWay}"
                            FontSize="30"
                            Height="36" LineHeight="36" LineStackingStrategy="BlockLineHeight"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />

                        <TextBlock
                            Text="{x:Bind ViewModel.LoginSubtitle, Mode=OneWay}"
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Error message -->
                    <Border
                        x:Name="ErrorBorder"
                        Background="#2DEF6B73"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- OAuth providers section -->
                    <Border Padding="16" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                            Visibility="{x:Bind ViewModel.SessionRestoreUnavailable, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.SessionRestoreMessage, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="You're still signed in; try again in a moment." FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Content="Try again" Click="RetryRestore_Click" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsOAuthPending, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Continue signing in in your browser." FontSize="14" TextWrapping="Wrap" />
                        <Button Content="Cancel sign-in" Click="CancelOAuth_Click" />
                    </StackPanel>
                    <StackPanel
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasOAuthProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OAuthProviders, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.CanStartAuthentication, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="16,10"
                                        Tag="{Binding}"
                                        Click="AuthProviderButton_Click">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Spacing="8">
                                            <Image
                                                Source="{Binding IconUrl, Converter={StaticResource UrlToImage}}"
                                                Width="20"
                                                Height="20"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconUrl, Converter={StaticResource NullToVis}}" />
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Divider -->
                        <Grid Margin="0,4,0,0" Visibility="{x:Bind ViewModel.ShowPasswordForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="or"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="12,0" />
                            <Border Grid.Column="2" Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- Form fields -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowPasswordForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <!-- Username -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Username"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="UsernameBox"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel x:Name="LoginPasswordGroup" Spacing="8">
                            <Grid>
                                <TextBlock Text="Password" FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight" FontWeight="Medium" />
                                <HyperlinkButton Content="Forgot password?" Click="ForgotPassword_Click" HorizontalAlignment="Right" Padding="0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{x:Bind ViewModel.CanRecoverPassword, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <PasswordBox
                                x:Name="PasswordBox"
                                Style="{StaticResource DarkPasswordBoxStyle}"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Credential provider picker -->
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.HasCredentialProviderPicker, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="Sign in with"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <ComboBox
                                x:Name="CredentialProviderComboBox"
                                ItemsSource="{x:Bind ViewModel.CredentialProviders, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedCredentialProvider, Mode=TwoWay}"
                                DisplayMemberPath="DisplayName"
                                HorizontalAlignment="Stretch" />
                            <TextBlock Text="Automatic: accounts with a Silo password sign in with it, everyone else with the directory."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <!-- Sign in button -->
                        <Button
                            Content="Sign in"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="36" MinHeight="36" Padding="16,4"
                            Command="{x:Bind ViewModel.LoginCommand}"
                            IsEnabled="{x:Bind ViewModel.CanStartAuthentication, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Loading indicator -->
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Width="28" Height="28" />



                    <!-- Current WebUI device authorization flow. -->
                    <StackPanel Spacing="16">
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Use your phone instead" FontSize="14" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                            <TextBlock Text="Scan a code, sign in there, and approve this device."
                                       FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Content="Show QR code"
                            FontWeight="Medium"
                            Height="36" MinHeight="36" Padding="16,4"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsStartingDeviceLogin, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Visibility="{x:Bind ViewModel.DeviceSession, Mode=OneWay, Converter={StaticResource NullToVisInverse}}"
                            Click="StartDeviceLoginButton_Click" />

                        <Border
                            Padding="16"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.DeviceSession, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <StackPanel Spacing="12">
                                <Border Background="White" CornerRadius="6" Padding="10" HorizontalAlignment="Center">
                                    <Image Source="{x:Bind ViewModel.DeviceQrImage, Mode=OneWay}"
                                           Width="176" Height="176" Stretch="Uniform" />
                                </Border>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}">
                                        <Run Text="Or go to " /><Run Text="{x:Bind ViewModel.DeviceSession.VerificationUri, Mode=OneWay}" /><Run Text=" and enter" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind ViewModel.FormattedDeviceCode, Mode=OneWay}"
                                               AutomationProperties.Name="{x:Bind ViewModel.SpokenDeviceCode, Mode=OneWay}"
                                               FontSize="24" FontWeight="SemiBold" FontFamily="Consolas" CharacterSpacing="120"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Start over" Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="RestartDeviceLoginButton_Click" />
                                <TextBlock Text="{x:Bind ViewModel.DeviceStatusMessage, Mode=OneWay}"
                                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Create account link -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Height="20"
                        Visibility="{x:Bind ViewModel.IsSignupEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Don't have an account?" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton Padding="0" MinHeight="0" MinWidth="0" Height="20" Click="CreateAccountButton_Click">
                            <TextBlock Text="Sign up" FontSize="14" TextDecorations="Underline" Foreground="{StaticResource PrimaryTextBrush}" />
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
        <!-- Native selected-server navigation, independent of the centered auth card. -->
        <Button Content="Back to Servers" Style="{StaticResource GhostButtonStyle}"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Click="BackButton_Click" />
    </Grid>
</Page>
