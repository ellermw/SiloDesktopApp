<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisInverse" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVisInverse" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <!-- Full-page centered auth shell. The server-controlled login artwork is
         rendered behind the same 70% readability scrim used by the WebUI. -->
    <Grid>
        <Image
            Source="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay}"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            Background="#B3000000"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="400"
            Margin="24"
            Spacing="16">

            <!-- Glass card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="24">
                    <!-- Header: Branding + subtitle -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="ServerNameTitle"
                            Text="{x:Bind ViewModel.ServerName, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />

                        <TextBlock
                            Text="{x:Bind ViewModel.LoginSubtitle, Mode=OneWay}"
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14" />
                    </StackPanel>

                    <!-- Error message -->
                    <Border
                        x:Name="ErrorBorder"
                        Background="#2DEF6B73"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- OAuth providers section -->
                    <StackPanel
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasOAuthProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OAuthProviders, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,10"
                                        Tag="{Binding}"
                                        Click="AuthProviderButton_Click">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                            <Image
                                                Source="{Binding IconUrl}"
                                                Width="20"
                                                Height="20"
                                                Stretch="Uniform"
                                                Visibility="{Binding IconUrl, Converter={StaticResource NullToVis}}" />
                                            <TextBlock
                                                Text="{Binding DisplayName}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Divider -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="or"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="12,0" />
                            <Border Grid.Column="2" Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <!-- Form fields -->
                    <StackPanel Spacing="16">
                        <!-- Credential provider picker -->
                        <StackPanel
                            Spacing="6"
                            Visibility="{x:Bind ViewModel.HasCredentialProviderPicker, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="Sign in with"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <ComboBox
                                x:Name="CredentialProviderComboBox"
                                ItemsSource="{x:Bind ViewModel.CredentialProviders, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedCredentialProvider, Mode=TwoWay}"
                                DisplayMemberPath="DisplayName"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Username -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Username"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="UsernameBox"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Enter your username"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Password"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Style="{StaticResource DarkPasswordBoxStyle}"
                                PlaceholderText="Enter your password"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Sign in button -->
                        <Button
                            Content="Sign in"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Command="{x:Bind ViewModel.LoginCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    </StackPanel>

                    <!-- Loading indicator -->
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Width="28" Height="28" />

                    <!-- Current WebUI device authorization flow. -->
                    <StackPanel Spacing="12">
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Use your phone instead" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Scan a code, sign in there, and approve this device."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Content="Show QR code"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.IsStartingDeviceLogin, Mode=OneWay, Converter={StaticResource InverseBool}}"
                            Visibility="{x:Bind ViewModel.DeviceSession, Mode=OneWay, Converter={StaticResource NullToVisInverse}}"
                            Click="StartDeviceLoginButton_Click" />

                        <Border
                            Padding="16"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Visibility="{x:Bind ViewModel.DeviceSession, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <StackPanel Spacing="12">
                                <Border Background="White" CornerRadius="6" Padding="10" HorizontalAlignment="Center">
                                    <Image Source="{x:Bind ViewModel.DeviceQrImage, Mode=OneWay}"
                                           Width="176" Height="176" Stretch="Uniform" />
                                </Border>
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <TextBlock Text="MATCH CODE" FontSize="10" CharacterSpacing="140"
                                               Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.DeviceSession.MatchCode, Mode=OneWay}"
                                               FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Can't scan the QR code?"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.ShowDeviceFallback, Mode=OneWay, Converter={StaticResource BoolToVisInverse}}"
                                        Click="ShowDeviceFallbackButton_Click" />
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.ShowDeviceFallback, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="ENTER THIS CODE IF NEEDED" FontSize="10" CharacterSpacing="120"
                                               Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.DeviceSession.UserCode, Mode=OneWay}"
                                               FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                                               HorizontalAlignment="Center" />
                                    <Button Content="Open sign-in page" Style="{StaticResource GhostButtonStyle}"
                                            HorizontalAlignment="Center" Click="OpenDeviceVerificationButton_Click" />
                                </StackPanel>
                                <Button Content="Start over" Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="RestartDeviceLoginButton_Click" />
                                <TextBlock Text="{x:Bind ViewModel.DeviceStatusMessage, Mode=OneWay}"
                                           FontSize="13" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Create account link -->
                    <Button
                        Content="Create Account"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsSignupEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        Click="CreateAccountButton_Click" />
                </StackPanel>
            </Border>

            <!-- Back to server select -->
            <Button
                Content="Back to Servers"
                Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Center"
                Click="BackButton_Click" />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
