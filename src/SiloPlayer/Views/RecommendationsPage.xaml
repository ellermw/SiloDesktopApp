<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- The WebUI scrolls the header and recommendation rows as one page. -->
        <ScrollViewer
            x:Name="PageScrollViewer"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="0,0,0,40">
        <!-- Header: title + subtitle on left, TasteProfile card on right (web parity) -->
        <Grid x:Name="HeaderGrid" Margin="40,24,40,20" SizeChanged="HeaderGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="HeaderTitlePanel" Grid.Row="0" Grid.Column="0" Spacing="4">
                <TextBlock
                    x:Name="HeaderTitleText"
                    Text="Recommendations"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    Text="Personalized picks based on your viewing history and ratings."
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Border
                x:Name="TasteProfileLoadingPanel"
                Grid.Row="0"
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="20"
                MinWidth="260"
                VerticalAlignment="Top"
                Visibility="{x:Bind ViewModel.IsTasteProfileLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="130" Height="16" HorizontalAlignment="Left" />
                    <controls:SkeletonText Width="190" Height="12" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Taste Profile card (web: TasteProfileCard) -->
            <Border
                x:Name="TasteProfilePanel"
                Grid.Row="0"
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="20"
                MinWidth="260"
                MaxWidth="360"
                VerticalAlignment="Top"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Your Taste Profile"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="TasteSignalCountText"
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <!-- Top Genres -->
                    <StackPanel x:Name="TopGenresPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock
                            Text="TOP GENRES"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <controls:WrapPanel
                            x:Name="TopGenresList"
                            HorizontalSpacing="6"
                            VerticalSpacing="6" />
                    </StackPanel>

                    <!-- Favorite Directors -->
                    <StackPanel x:Name="FavoriteDirectorsPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock
                            Text="FAVORITE DIRECTORS"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <controls:WrapPanel
                            x:Name="FavoriteDirectorsList"
                            HorizontalSpacing="6"
                            VerticalSpacing="6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Skeleton while recommendations load (approximates row layout). -->
        <StackPanel x:Name="LoadingState"
                    Padding="40,2,40,24"
                    Spacing="40"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="180" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="240" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="200" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="220" Height="18" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
        </StackPanel>

        <!-- Error -->
        <StackPanel
            x:Name="ErrorState"
            HorizontalAlignment="Center"
            Margin="0,96,0,96"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource SecondaryTextBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center" />
            <Button Style="{StaticResource GhostButtonStyle}"
                    Foreground="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Retry" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- All recommendation rows (web: rows.map(row => <MediaCarousel title={row.label}>)) -->
        <StackPanel x:Name="RowsPanel" Spacing="8" Visibility="Collapsed" />

        <!-- Empty state (web: DiscoverEmptyState) -->
        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            Spacing="12"
            Margin="0,96,0,96"
            Padding="40,0"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE735;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Not enough data yet"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Watch and rate more content to unlock personalized recommendations."
                FontSize="12"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="420" />
        </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
