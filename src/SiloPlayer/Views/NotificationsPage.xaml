<Page
    x:Class="SiloPlayer.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiloPlayer.Core.Models.Notifications"
    xmlns:converters="using:SiloPlayer.Converters"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="Page_SizeChanged">

    <Page.Resources><converters:BoolToVisibilityConverter x:Key="BoolToVis" /><converters:UrlToImageSourceConverter x:Key="UrlToImage" /></Page.Resources>

    <Grid x:Name="PageContent" MaxWidth="768" HorizontalAlignment="Center" Padding="24,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" ColumnSpacing="12" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEA8F;" FontSize="24" />
                <TextBlock Text="Notifications" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="MarkAllButton" Grid.Column="1" Click="MarkAll_Click" Style="{StaticResource OutlineButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8FB;" FontSize="15" /><TextBlock Text="Mark all read" /></StackPanel>
            </Button>
            <Button x:Name="PreferencesButton" Grid.Column="2" Style="{StaticResource OutlineButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE713;" FontSize="15" /><TextBlock Text="Preferences" /></StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Grid Width="300" Padding="4">
                            <StackPanel x:Name="PreferenceControlsPanel" Spacing="14">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notifications" FontWeight="SemiBold" /><TextBlock Text="Master switch for this profile" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><ToggleSwitch x:Name="NotificationsEnabledToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Notifications" /></Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Favorites" FontWeight="SemiBold" /><TextBlock Text="New episodes of favorited series" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><ToggleSwitch x:Name="FavoritesToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Favorites" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Watchlist" FontWeight="SemiBold" /><TextBlock Text="New episodes of watchlisted series" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><ToggleSwitch x:Name="WatchlistToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Watchlist" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Continue Watching" FontWeight="SemiBold" /><TextBlock Text="Series you are actively watching" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><ToggleSwitch x:Name="ContinueWatchingToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Continue Watching" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Next Up" FontWeight="SemiBold" /><TextBlock Text="The next episode after your progress" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><ToggleSwitch x:Name="NextUpToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Next Up" /></Grid>
                            <TextBlock x:Name="PreferenceErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <StackPanel x:Name="PreferenceLoadFailedPanel" Spacing="12" Visibility="Collapsed">
                                <TextBlock Text="Couldn’t load preferences." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Retry" HorizontalAlignment="Left" Style="{StaticResource OutlineButtonStyle}" Click="RetryPreferences_Click" />
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <Button x:Name="AllButton" Content="All" Click="Filter_Click" Tag="all" />
            <Button x:Name="UnreadButton" Click="Filter_Click" Tag="unread"><TextBlock x:Name="UnreadButtonText" Text="Unread" /></Button>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListView x:Name="NotificationsList" ItemsSource="{Binding Notifications}" IsItemClickEnabled="True" ItemClick="NotificationsList_ItemClick" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppNotification">
                        <Grid x:Name="NotificationRowRoot" Padding="12" ColumnSpacing="12" MinHeight="88" CornerRadius="12" Loaded="NotificationRow_Loaded" PointerEntered="NotificationRow_PointerEntered" PointerExited="NotificationRow_PointerExited">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="44" Height="64" CornerRadius="6" Background="{StaticResource SurfaceBrush}"><Image Source="{x:Bind PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" /></Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" /><TextBlock x:Name="NotificationTitleText" Grid.Column="1" Text="{x:Bind DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{x:Bind RelativeTime}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></Grid>
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <ItemsControl ItemsSource="{x:Bind ReasonLabels}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Padding="7,2" CornerRadius="10" Background="{StaticResource SurfaceBrush}"><TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button x:Name="InlineMarkReadButton" Grid.Column="2" Tag="{x:Bind}" Click="MarkRead_Click" Tapped="MarkRead_Tapped" GotFocus="InlineMarkReadButton_GotFocus" LostFocus="InlineMarkReadButton_LostFocus" Width="32" Height="32" Padding="0" VerticalAlignment="Bottom" Opacity="0" Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="Mark as read" AutomationProperties.Name="Mark as read"><FontIcon Glyph="&#xE73E;" FontSize="14" /></Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="LoadingSkeleton" Spacing="8" Visibility="Collapsed">
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
            </StackPanel>
            <StackPanel x:Name="EmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="400">
                <FontIcon Glyph="&#xE7ED;" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitleText" Text="No notifications yet" HorizontalAlignment="Center" />
                <TextBlock Text="You will be notified here when new episodes arrive for series you favorite, watchlist, or are watching." TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMore_Click" Style="{StaticResource OutlineButtonStyle}" Visibility="Collapsed" />
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Page>
