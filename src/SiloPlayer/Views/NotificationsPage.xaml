<Page xmlns:loc="using:SiloPlayer.Services"
    x:Class="SiloPlayer.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiloPlayer.Core.Models.Notifications"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="Page_SizeChanged" loc:Localized.Direction="True">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" /><converters:UrlToImageSourceConverter x:Key="UrlToImage" />
        <!-- The row owns its rounded hover surface; the container only routes input. -->
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
    </Page.Resources>

    <Grid x:Name="PageContent" MaxWidth="768" HorizontalAlignment="Center" Padding="16,0">
        <ListView x:Name="NotificationsList" ItemsSource="{Binding Notifications}" IsItemClickEnabled="True" ItemClick="NotificationsList_ItemClick" SelectionMode="None" VerticalAlignment="Top" Padding="0,64,0,32">
            <ListView.Header>
                <StackPanel x:Name="InboxHeader" Spacing="16" Margin="0,0,0,16">
        <Grid x:Name="HeaderGrid" ColumnSpacing="8" RowSpacing="12" Margin="0,0,0,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEA8F;" FontSize="24" />
                <TextBlock Text="Notifications" loc:Localized.Text="web.notifications.inbox.title" FontSize="24" LineHeight="32" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="MarkAllButton" Grid.Column="1" Click="MarkAll_Click" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="32" Padding="12,4" FontSize="14">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8FB;" FontSize="15" /><TextBlock Text="Mark all read" loc:Localized.Text="web.notifications.inbox.markAllRead" /></StackPanel>
            </Button>
            <Button x:Name="PreferencesButton" Grid.Column="2" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="32" Padding="12,4" FontSize="14">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE713;" FontSize="15" /><TextBlock Text="Preferences" loc:Localized.Text="web.notifications.preferences.open" /></StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="Padding" Value="16" /><Setter Property="MaxWidth" Value="320" /><Setter Property="CornerRadius" Value="16" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" /><Setter Property="Background" Value="{StaticResource PopoverBrush}" /><Setter Property="Foreground" Value="{StaticResource PopoverForegroundBrush}" /></Style></Flyout.FlyoutPresenterStyle>
                        <Grid Width="286" Padding="0">
                            <StackPanel x:Name="PreferenceLoadingPanel" Spacing="12" Visibility="Collapsed">
                                <Border Height="24" CornerRadius="10" Background="{StaticResource SurfaceBrush}" />
                                <Border Height="24" CornerRadius="10" Background="{StaticResource SurfaceBrush}" />
                                <Border Height="24" CornerRadius="10" Background="{StaticResource SurfaceBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="PreferenceControlsPanel" Spacing="14">
                            <StackPanel.Resources>
                                <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
                                <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
                                <Style TargetType="ToggleSwitch" BasedOn="{StaticResource WebUiToggleSwitchStyle}">
                                    <Setter Property="Width" Value="32" /><Setter Property="MinHeight" Value="0" />
                                </Style>
                                <Style x:Key="NotificationPreferenceLabel" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
                                    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Medium" />
                                    <Setter Property="LineHeight" Value="20" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                </Style>
                                <Style x:Key="NotificationPreferenceCaption" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
                                    <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" />
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                </Style>
                            </StackPanel.Resources>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Notifications" loc:Localized.Text="web.notifications.inbox.title" Style="{StaticResource NotificationPreferenceLabel}" /><TextBlock Text="Master switch for this profile" loc:Localized.Text="web.notifications.preferences.enabledDescription" Style="{StaticResource NotificationPreferenceCaption}" /></StackPanel><ToggleSwitch x:Name="NotificationsEnabledToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Notifications" loc:Localized.Name="web.notifications.inbox.title" /></Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Favorites" loc:Localized.Text="web.notifications.preferences.favorites" Style="{StaticResource NotificationPreferenceLabel}" /><TextBlock Text="New episodes of favorited series" loc:Localized.Text="web.notifications.preferences.favoritesDescription" Style="{StaticResource NotificationPreferenceCaption}" /></StackPanel><ToggleSwitch x:Name="FavoritesToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Favorites" loc:Localized.Name="web.notifications.preferences.favorites" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Watchlist" loc:Localized.Text="web.notifications.preferences.watchlist" Style="{StaticResource NotificationPreferenceLabel}" /><TextBlock Text="New episodes of watchlisted series" loc:Localized.Text="web.notifications.preferences.watchlistDescription" Style="{StaticResource NotificationPreferenceCaption}" /></StackPanel><ToggleSwitch x:Name="WatchlistToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Watchlist" loc:Localized.Name="web.notifications.preferences.watchlist" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Continue Watching" loc:Localized.Text="web.notifications.preferences.continueWatching" Style="{StaticResource NotificationPreferenceLabel}" /><TextBlock Text="Series you are actively watching" loc:Localized.Text="web.notifications.preferences.continueWatchingDescription" Style="{StaticResource NotificationPreferenceCaption}" /></StackPanel><ToggleSwitch x:Name="ContinueWatchingToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Continue Watching" loc:Localized.Name="web.notifications.preferences.continueWatching" /></Grid>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Next Up" loc:Localized.Text="web.notifications.preferences.nextUp" Style="{StaticResource NotificationPreferenceLabel}" /><TextBlock Text="The next episode after your progress" loc:Localized.Text="web.notifications.preferences.nextUpDescription" Style="{StaticResource NotificationPreferenceCaption}" /></StackPanel><ToggleSwitch x:Name="NextUpToggle" Grid.Column="1" Toggled="Preference_Toggled" AutomationProperties.Name="Next Up" loc:Localized.Name="web.notifications.preferences.nextUp" /></Grid>
                            <TextBlock x:Name="PreferenceErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="SeeSeriesButton" Content="See which series notify you" loc:Localized.Content="web.notifications.preferences.seeSeries" Click="Series_Click" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel x:Name="PreferenceLoadFailedPanel" Spacing="12" Visibility="Collapsed">
                                <TextBlock Text="Couldn’t load preferences." loc:Localized.Text="web.notifications.preferences.loadFailed" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Retry" loc:Localized.Content="common.retry" HorizontalAlignment="Left" Style="{StaticResource OutlineButtonStyle}" Click="RetryPreferences_Click" />
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="AllButton" Content="All" loc:Localized.Content="web.notifications.inbox.filterAll" Click="Filter_Click" Tag="all" Height="32" MinHeight="32" Padding="12,4" FontSize="14" />
            <Button x:Name="UnreadButton" Click="Filter_Click" Tag="unread" Height="32" MinHeight="32" Padding="12,4" FontSize="14"><TextBlock x:Name="UnreadButtonText" Text="Unread" /></Button>
            <Button x:Name="SeriesButton" Content="Series" loc:Localized.Content="web.notifications.inbox.filterSeries" Click="Series_Click" Visibility="Collapsed" Height="32" MinHeight="32" Padding="12,4" FontSize="14" />
        </StackPanel>

        <StackPanel x:Name="InboxErrorPanel" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="ReloadButton" Content="Reload notifications" Click="Reload_Click" Visibility="Collapsed" Style="{StaticResource OutlineButtonStyle}" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
            <Grid x:Name="InboxStateHost">
            <StackPanel x:Name="LoadingSkeleton" Spacing="8" Visibility="Collapsed">
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
                <Border Height="80" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.55" />
            </StackPanel>
            <StackPanel x:Name="EmptyState" Spacing="12" Margin="0,80" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" MaxWidth="384">
                <FontIcon Glyph="&#xE7ED;" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitleText" Text="No notifications yet" FontSize="14" LineHeight="20" HorizontalAlignment="Center" />
                <TextBlock Text="You will be notified here when new episodes arrive for series you favorite, watchlist, or are watching." loc:Localized.Text="web.notifications.inbox.emptyHint" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            </Grid>
            <controls:NotificationSeriesControl x:Name="SeriesView" Visibility="Collapsed" />
                </StackPanel>
            </ListView.Header>
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="16" /><Setter Property="Margin" Value="0,0,0,4" /></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppNotification">
                        <Grid x:Name="NotificationRowRoot" Padding="12" ColumnSpacing="12" MinHeight="88" CornerRadius="16" Loaded="NotificationRow_Loaded" DataContextChanged="NotificationRow_DataContextChanged" PointerEntered="NotificationRow_PointerEntered" PointerExited="NotificationRow_PointerExited">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="44" Height="64" CornerRadius="10" Background="{StaticResource SurfaceBrush}"><Image FlowDirection="LeftToRight" Source="{x:Bind PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" /></Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" /><TextBlock x:Name="NotificationTitleText" Grid.Column="1"  FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" x:Name="NotificationTimeText" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" /></Grid>
                                <TextBlock x:Name="NotificationSubtitleText" FontSize="14" LineHeight="20" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <ItemsControl x:Name="NotificationReasons" Margin="0,4,0,0" >
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Padding="8,2" CornerRadius="10" Background="{StaticResource SurfaceBrush}"><TextBlock Text="{Binding}" FontSize="10" LineHeight="15" LineStackingStrategy="BlockLineHeight" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button x:Name="InlineMarkReadButton" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Tag="{x:Bind}" Click="MarkRead_Click" Tapped="MarkRead_Tapped" GotFocus="InlineMarkReadButton_GotFocus" LostFocus="InlineMarkReadButton_LostFocus" Width="28" Height="28" MinHeight="0" MinWidth="0" CornerRadius="10" Margin="0,0,-4,-4" Padding="0" VerticalAlignment="Bottom" Opacity="0" Visibility="{x:Bind IsUnread, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="Mark as read" loc:Localized.ToolTip="web.notifications.inbox.markRead" AutomationProperties.Name="Mark as read" loc:Localized.Name="web.notifications.inbox.markRead"><FontIcon Glyph="&#xE73E;" FontSize="14" /></Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            <ListView.Footer>
                <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
            <Button x:Name="LoadMoreButton" Click="LoadMore_Click" Style="{StaticResource OutlineButtonStyle}" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="LoadMoreBusy" Width="16" Height="16" Visibility="Collapsed" IsActive="False" />
                    <TextBlock Text="Load more" loc:Localized.Text="web.notifications.inbox.loadMore" />
                </StackPanel>
            </Button>
                </StackPanel>
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
