<Page
    x:Class="SiloPlayer.Views.ServerSetupRequiredPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="32">
        <Border
            MaxWidth="560"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel Spacing="18">
                <FontIcon
                    Glyph="&#xE713;"
                    FontSize="42"
                    Foreground="{StaticResource AccentBrush}"
                    HorizontalAlignment="Left" />
                <TextBlock
                    Text="Finish setup in your browser"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    Text="This Silo server has not finished its initial setup. Server administration is handled in the WebUI; complete setup there, then return here and retry."
                    FontSize="15"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock
                    x:Name="ServerAddressText"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock
                    x:Name="StatusText"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource ErrorBrush}"
                    Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Content="Open Silo WebUI"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OpenWebUi_Click" />
                    <Button
                        x:Name="RetryButton"
                        Content="Retry"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Retry_Click" />
                    <Button
                        Content="Choose another server"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ChooseServer_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
