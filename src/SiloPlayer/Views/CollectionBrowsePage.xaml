<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: back button + title + item count -->
        <Grid x:Name="CollectionHeaderGrid" Grid.Row="0" Margin="40,24,40,20" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Column="0"
                x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
            </Button>

            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />

                    <!-- Pin / Unpin to sidebar (webui parity with sidebar_pins user setting) -->
                    <Button
                        x:Name="PinButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="PinButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PinIcon" Glyph="&#xE840;" FontSize="13"
                                      Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="PinLabel" Text="Pin to sidebar"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <Border
                Grid.Column="2"
                x:Name="CountPanel"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Padding="20,16"
                MinWidth="140"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock
                        Text="COLLECTION"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="160"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="ItemCountText"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,4,0,0" />
                    <TextBlock
                        x:Name="ItemCountLabel"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="CollectionToolbar" Grid.Row="1" Margin="40,0,40,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LoadedCountText" Grid.Column="0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
            <ComboBox x:Name="SortCombo" Grid.Column="1" MinWidth="170" CornerRadius="16"
                      SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Collection Order" Tag="" />
                <ComboBoxItem Content="Title" Tag="title" />
                <ComboBoxItem Content="Date Added" Tag="added_at" />
                <ComboBoxItem Content="Release Date" Tag="release_date" />
                <ComboBoxItem Content="Year" Tag="year" />
                <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb" />
                <ComboBoxItem Content="Runtime" Tag="runtime" />
            </ComboBox>
            <Button x:Name="OrderButton" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                    Width="40" Height="40" Padding="0" CornerRadius="20"
                    Click="OrderButton_Click" ToolTipService.ToolTip="Descending">
                <FontIcon x:Name="OrderIcon" Glyph="&#xE74B;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Loading -->
        <ProgressRing
            Grid.Row="2"
            x:Name="LoadingRing"
            IsActive="True"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <TextBlock
            Grid.Row="2"
            x:Name="ErrorText"
            Visibility="Collapsed"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="500" />

        <!-- Content grid -->
        <ScrollViewer Grid.Row="2" x:Name="ContentScroll" Padding="40,0,40,24"
                      ViewChanged="ContentScroll_ViewChanged">
            <StackPanel Spacing="16">
                <ItemsRepeater x:Name="PosterRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="{StaticResource PosterCardWidth}"
                            MinItemHeight="{StaticResource PosterCardTotalHeight}"
                            MinColumnSpacing="12"
                            MinRowSpacing="16"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <controls:PosterCard MediaItem="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ProgressRing x:Name="LoadMoreRing" IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" Width="24" Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <FontIcon
                Glyph="&#xE8FD;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="This collection is empty"
                FontSize="{StaticResource FontSizeTitle}"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Add items to this collection to see them here."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>
    </Grid>
</Page>
