<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SiloPlayer.Services"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <controls:CollectionGlassBrush x:Key="CollectionGlassHoverBrush" TintOpacity="0.18" />
        <ControlTemplate x:Key="CollectionGlassButtonTemplate" TargetType="Button">
            <Border x:Name="CollectionGlassRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                  FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="CollectionGlassRoot.Background" Value="{StaticResource CollectionGlassHoverBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CollectionGlassRoot.Background" Value="{StaticResource CollectionGlassHoverBrush}" /></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CollectionGlassRoot.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Border>
        </ControlTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero backdrop: runs edge to edge behind the title and the filter bar and fades into the page.
             Collapsed (the plain page) for a collection without a backdrop. -->
        <controls:CollectionHeroBackdrop x:Name="HeroBackdrop" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,0,-96" />

        <!-- Header (pinned WebUI CollectionPageHero): back, eyebrow, title, byline, description, then Shuffle and the owner/Home actions. -->
        <Grid x:Name="CollectionHeaderGrid" Grid.Row="0" MaxWidth="1400" HorizontalAlignment="Stretch" Margin="40,24,40,20" RowSpacing="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Column="0"
                x:Name="BackButton"
                Click="BackButton_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="8"
                Margin="0,0,0,0"
                VerticalAlignment="Top"
                ToolTipService.ToolTip="Back" loc:Localized.ToolTip="common.back">
                <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
            </Button>

            <StackPanel x:Name="CollectionTitleStack" Grid.Column="1" Spacing="0" MaxWidth="768" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock
                    x:Name="CollectionEyebrow"
                    Text="COLLECTION"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    CharacterSpacing="220"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Grid>
                    <Border x:Name="CollectionTitleShadow" IsHitTestVisible="False" />
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="ExtraBold"
                        CharacterSpacing="-40"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />
                    </Grid>

                    <!-- Pin / Unpin to sidebar (webui parity with sidebar_pins user setting) -->
                    <Button
                        x:Name="PinButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        CornerRadius="16"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="PinButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="PinIcon" Glyph="&#xE840;" FontSize="13"
                                      Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="PinLabel" Text="Pin to sidebar"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- "by Name · Read-only" under someone else's shared collection. -->
                <TextBlock x:Name="CollectionByline" Visibility="Collapsed" FontSize="14" Margin="0,12,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <!-- The curated description, three lines with More. It stays empty while the header loads. -->
                <controls:ExpandableDescription x:Name="CollectionDescription" Visibility="Collapsed" Margin="0,12,0,0" />
                <!-- The outcome of Sync now or a failed action from More actions; polite live region. -->
                <TextBlock x:Name="CollectionActionStatus" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <controls:WrapPanel x:Name="CollectionActionsPanel" Grid.Column="2" HorizontalSpacing="12" VerticalSpacing="12" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button x:Name="CollectionShuffleButton" Click="CollectionShuffle_Click" Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="999" helpers:RoundedBadge.Radius="999" Padding="22,10"
                        AutomationProperties.Name="Shuffle">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                        <TextBlock Text="Shuffle" loc:Localized.Text="web.catalog.page.shuffle" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <!-- The collection's owner changes it; everyone else can add it to their own Home. -->
                <Button x:Name="CollectionEditButton" Click="CollectionEdit_Click" Visibility="Collapsed"
                        Style="{StaticResource OutlineButtonStyle}" CornerRadius="999" helpers:RoundedBadge.Radius="999" Padding="20,10"
                        Background="#1FFFFFFF" AutomationProperties.Name="Edit">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        <TextBlock Text="Edit" loc:Localized.Text="web.collections.pageActions.edit" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button x:Name="CollectionAddToHomeButton" Click="CollectionAddToHome_Click" Visibility="Collapsed"
                        Style="{StaticResource OutlineButtonStyle}" CornerRadius="999" helpers:RoundedBadge.Radius="999" Padding="20,10"
                        Background="#1FFFFFFF" AutomationProperties.Name="Add to my Home">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                        <TextBlock Text="Add to my Home" loc:Localized.Text="web.collections.copy.addToMyHome" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <!-- More actions: Sync now / Delete… for the owner, Add to my library page for everyone else. Collapsed when it would be empty. -->
                <Button x:Name="CollectionMoreButton" Visibility="Collapsed" Width="44" Height="44" Padding="0"
                        Style="{StaticResource OutlineButtonStyle}" CornerRadius="999" helpers:RoundedBadge.Radius="999"
                        Background="#1FFFFFFF" AutomationProperties.Name="More actions" ToolTipService.ToolTip="More actions" loc:Localized.ToolTip="web.collections.actions.moreActions">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </controls:WrapPanel>
        </Grid>

        <Grid x:Name="CollectionToolbar" Grid.Row="1" MaxWidth="1400" HorizontalAlignment="Stretch" Margin="40,0,40,16" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="MediaScopeCombo" Grid.Column="0" MinWidth="150"
                      SelectionChanged="MediaScopeCombo_SelectionChanged">
                <ComboBoxItem Content="All Media" Tag="" IsSelected="True" />
                <ComboBoxItem Content="Movies &amp; Series" Tag="video" />
                <ComboBoxItem Content="Movies" Tag="movie" />
                <ComboBoxItem Content="Series" Tag="series" />
                <ComboBoxItem Content="Audiobooks" Tag="audiobook" />
                <ComboBoxItem Content="Ebooks" Tag="ebook" />
                <ComboBoxItem Content="Manga" Tag="manga" />
            </ComboBox>
            <ComboBox x:Name="SortCombo" Grid.Column="1" MinWidth="180"
                      SelectionChanged="SortCombo_SelectionChanged">
                <ComboBoxItem Content="Collection Order" Tag="" />
                <ComboBoxItem Content="Title" Tag="title" />
                <ComboBoxItem Content="Date Added" Tag="added_at" />
                <ComboBoxItem Content="Release Date" Tag="release_date" />
                <ComboBoxItem Content="Latest Episode Air Date" Tag="last_air_date" />
                <ComboBoxItem Content="Latest Episode Added" Tag="latest_episode_added" />
                <ComboBoxItem Content="Year" Tag="year" />
                <ComboBoxItem Content="Content Rating" Tag="content_rating" />
                <ComboBoxItem Content="Duration" Tag="runtime" />
                <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb" />
                <ComboBoxItem Content="TMDB Rating" Tag="rating_tmdb" />
                <ComboBoxItem Content="RT Critic Rating" Tag="rating_rt_critic" />
                <ComboBoxItem Content="RT Audience Rating" Tag="rating_rt_audience" />
                <ComboBoxItem Content="Resolution" Tag="resolution" />
                <ComboBoxItem Content="Bitrate" Tag="bitrate" />
                <ComboBoxItem Content="Author" Tag="author" />
                <ComboBoxItem Content="Narrator" Tag="narrator" />
                <ComboBoxItem Content="Series" Tag="series" />
            </ComboBox>
            <ComboBox x:Name="OrderCombo" Grid.Column="2" MinWidth="125"
                      SelectionChanged="OrderCombo_SelectionChanged">
                <ComboBoxItem Content="Descending" Tag="desc" IsSelected="True" />
                <ComboBoxItem Content="Ascending" Tag="asc" />
            </ComboBox>
            <Button x:Name="FiltersButton" Grid.Column="3" Style="{StaticResource OutlineButtonStyle}"
                    Click="FiltersButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Filters" loc:Localized.Text="web.catalog.filters.open" />
                    <Border x:Name="ActiveFilterCountBadge" Padding="6,1" CornerRadius="6"
                            Background="{StaticResource AccentBrush}" Visibility="Collapsed">
                        <TextBlock x:Name="ActiveFilterCountText" FontSize="10"
                                   Foreground="{StaticResource AccentForegroundBrush}" />
                    </Border>
                </StackPanel>
            </Button>
            <TextBlock x:Name="LoadedCountText" Grid.Column="4" VerticalAlignment="Center"
                       HorizontalAlignment="Left" FontSize="14" Foreground="{StaticResource TertiaryTextBrush}"
                       Visibility="Collapsed" />

            <!-- WebUI ActiveFilterBadges: every applied refinement stays visible and
                 can be cleared without reopening the filter sheet. -->
            <StackPanel x:Name="ActiveFiltersPanel"
                        Grid.Row="3"
                        Grid.ColumnSpan="5"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,10,0,0"
                        Visibility="Collapsed" />
        </Grid>

        <!-- Loading: mirror the WebUI ItemGrid skeleton so the layout stays stable. -->
        <ScrollViewer
            Grid.Row="2"
            x:Name="LoadingSkeleton"
            Visibility="Collapsed"
            Padding="40,0,40,24">
            <ItemsRepeater x:Name="LoadingPosterRepeater" MaxWidth="1400" HorizontalAlignment="Center">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="178" MinItemHeight="310"
                                       MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="None" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="178" Spacing="9">
                            <Border Width="178" Height="267" CornerRadius="12"
                                    Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                            <Border Width="132" Height="15" CornerRadius="5"
                                    Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Error -->
        <TextBlock
            Grid.Row="2"
            x:Name="ErrorText"
            Visibility="Collapsed"
            Foreground="{StaticResource ErrorBrush}"
            Style="{StaticResource BodyTextStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            MaxWidth="500" />

        <!-- Content grid -->
        <ScrollViewer Grid.Row="2" x:Name="ContentScroll" Padding="40,0,40,24"
                      ViewChanged="ContentScroll_ViewChanged">
            <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">
                <ItemsRepeater x:Name="PosterRepeater" ElementPrepared="PosterRepeater_ElementPrepared">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            x:Name="PosterGridLayout"
                            MinItemWidth="{StaticResource PosterCardWidth}"
                            MinItemHeight="{StaticResource PosterCardTotalHeight}"
                            MinColumnSpacing="12"
                            MinRowSpacing="16"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem">
                            <controls:PosterCard MediaItem="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ProgressRing x:Name="LoadMoreRing" IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" Width="24" Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Padding="40"
            Visibility="Collapsed">
            <TextBlock
                Text="No items found." loc:Localized.Text="web.catalog.grid.noItems"
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
        </StackPanel>

        <controls:SlideSheet x:Name="FiltersSheet" Grid.RowSpan="3" Canvas.ZIndex="100" Title="Filters">
            <controls:SlideSheet.SheetContent>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Refine your catalog results" loc:Localized.Text="web.catalog.filters.subtitle" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,4,8,12">
                            <controls:QueryFilterEditor x:Name="CollectionQueryFilters" />
                            <StackPanel Visibility="Collapsed" Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Genres" loc:Localized.Text="web.collections.guidedRules.genres" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="GenresBox" PlaceholderText="Comma-separated genres" />
                                <TextBlock Text="Items must match all selected genres." loc:Localized.Text="web.collections.guidedRules.genresHelp" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Year From" loc:Localized.Text="web.collections.guidedRules.yearFrom" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="YearMinBox" PlaceholderText="e.g. 2000" loc:Localized.Placeholder="web.collections.guidedRules.yearFromPlaceholder" InputScope="Number" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Year To" loc:Localized.Text="web.collections.guidedRules.yearTo" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="YearMaxBox" PlaceholderText="e.g. 2025" loc:Localized.Placeholder="web.collections.guidedRules.yearToPlaceholder" InputScope="Number" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Minimum IMDb Rating" loc:Localized.Text="web.collections.guidedRules.minRating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="MinimumRatingBox" PlaceholderText="0.0 - 10.0" InputScope="Number" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Content Rating" loc:Localized.Text="web.collections.guidedRules.contentRating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="ContentRatingBox" PlaceholderText="Any rating" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Original Language" loc:Localized.Text="web.collections.guidedRules.originalLanguage" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="OriginalLanguageBox" PlaceholderText="e.g. en" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Studio" loc:Localized.Text="web.collections.guidedRules.studio" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="StudioBox" PlaceholderText="Any studio" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Country" loc:Localized.Text="web.collections.guidedRules.country" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="CountryBox" PlaceholderText="Any country" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Video Quality" loc:Localized.Text="web.collections.guidedRules.videoQuality" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleButton x:Name="FourKToggle" Content="4K" Height="32" Padding="12,0" />
                                    <ToggleButton x:Name="HdrToggle" Content="HDR" Height="32" Padding="12,0" />
                                    <ToggleButton x:Name="DolbyVisionToggle" Content="DOVI" Height="32" Padding="12,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Content="Clear All" loc:Localized.Content="web.catalog.filters.clearAll" Style="{StaticResource OutlineButtonStyle}" Click="ClearFilters_Click" />
                            <Button Grid.Column="1" Content="Done" loc:Localized.Content="common.done" Style="{StaticResource AccentButtonStyle}" Click="ApplyFilters_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>
    </Grid>
</Page>
