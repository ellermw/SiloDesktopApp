<Page
    x:Class="SiloPlayer.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="Page_SizeChanged">

    <Grid x:Name="PageShell" MaxWidth="1400" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="40,24,40,24" ColumnDefinitions="*,Auto" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Spacing="12">
                <TextBlock x:Name="PageTitleText" Text="Catalog" FontSize="56" FontWeight="ExtraBold" CharacterSpacing="-50" LineHeight="53.2" LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock x:Name="PageSubtitleText" Text="Refine the archive by type, era, rating, or genre."
                           FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <StackPanel x:Name="CountPanel" Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="6">
                <Border Width="1" Height="32" Background="{StaticResource BorderBrush}" Margin="0,0,12,0" />
                <TextBlock x:Name="CountText" FontSize="30" FontWeight="Light" />
                <TextBlock x:Name="ResultNounText" Text="RESULTS" FontSize="11" CharacterSpacing="150"
                           VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <Border x:Name="WatchlistTabs" Grid.Row="1" Visibility="Collapsed" Margin="40,0,40,24" Height="36"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="3,0" VerticalAlignment="Center">
                <Button x:Name="LibraryWatchlistTab" Style="{StaticResource WebUiLineTabStyle}" Content="In your library" Click="LibraryWatchlistTab_Click" KeyDown="WatchlistTab_KeyDown" />
                <Button x:Name="ExternalWatchlistTab" Style="{StaticResource WebUiLineTabStyle}" Click="ExternalWatchlistTab_Click" KeyDown="WatchlistTab_KeyDown">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ExternalWatchlistTabLabel" Text="Not in your library yet" />
                        <Border x:Name="ExternalTitleCountBadge" Background="{StaticResource SurfaceBrush}" CornerRadius="999" MinWidth="20" Height="20" Padding="6,0" Visibility="Collapsed">
                            <TextBlock x:Name="ExternalTitleCountText" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <Ellipse x:Name="ExternalTitleAttention" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <controls:WrapPanel x:Name="FilterPanel" Grid.Row="2" Margin="40,0,40,18" HorizontalSpacing="10" VerticalSpacing="10">
            <TextBox x:Name="QueryBox" Visibility="Collapsed" TextChanged="Filter_Changed" />
            <ComboBox x:Name="TypeCombo" Width="190" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All Media" Tag="" IsSelected="True" />
                <ComboBoxItem Content="Movies &amp; Series" Tag="video" />
                <ComboBoxItem Content="Movies" Tag="movie" />
                <ComboBoxItem Content="Series" Tag="series" />
                <ComboBoxItem Content="Episodes" Tag="episode" />
                <ComboBoxItem Content="Audiobooks" Tag="audiobook" />
                <ComboBoxItem Content="Ebooks" Tag="ebook" />
                <ComboBoxItem Content="Manga" Tag="manga" />
            </ComboBox>
            <ComboBox x:Name="SortCombo" Width="190" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Title" Tag="title" IsSelected="True" />
                <ComboBoxItem Content="Date Added" Tag="added_at" />
                <ComboBoxItem Content="Release Date" Tag="release_date" />
                <ComboBoxItem Content="Latest Episode Air Date" Tag="last_air_date" />
                <ComboBoxItem Content="Latest Episode Added" Tag="latest_episode_added" />
                <ComboBoxItem Content="Year" Tag="year" />
                <ComboBoxItem Content="Content Rating" Tag="content_rating" />
                <ComboBoxItem Content="Duration" Tag="runtime" />
                <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb" />
                <ComboBoxItem Content="TMDB Rating" Tag="rating_tmdb" />
                <ComboBoxItem Content="Rotten Tomatoes Critics" Tag="rating_rt_critic" />
                <ComboBoxItem Content="Rotten Tomatoes Audience" Tag="rating_rt_audience" />
                <ComboBoxItem Content="Resolution" Tag="resolution" />
                <ComboBoxItem Content="Bitrate" Tag="bitrate" />
                <ComboBoxItem Content="Watch Progress" Tag="progress" />
                <ComboBoxItem Content="Date Viewed" Tag="date_viewed" />
                <ComboBoxItem Content="Play Count" Tag="plays" />
                <ComboBoxItem Content="Author" Tag="author" />
                <ComboBoxItem Content="Narrator" Tag="narrator" />
                <ComboBoxItem Content="Series" Tag="series" />
            </ComboBox>
            <ComboBox x:Name="OrderCombo" Width="140" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Descending" Tag="desc" />
                <ComboBoxItem Content="Ascending" Tag="asc" IsSelected="True" />
            </ComboBox>
            <Button Style="{StaticResource OutlineButtonStyle}" Click="OpenFilters_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Filters" />
                    <Border x:Name="FilterCountBadge" Visibility="Collapsed" MinWidth="18" Height="18"
                            CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock x:Name="FilterCountText" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>
        </controls:WrapPanel>

        <Border x:Name="LockedFiltersPanel" Grid.Row="2" Margin="40,0,40,18" Padding="16"
                CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="4">
                <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Filters are locked to this source." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Border x:Name="HistoryActions" Grid.Row="3" Margin="40,0,40,18" Padding="16" CornerRadius="16"
                Background="{StaticResource SurfaceBrush}" Visibility="Collapsed">
            <Grid x:Name="HistoryActionsGrid" ColumnSpacing="16" RowSpacing="12" ColumnDefinitions="*,Auto">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock Text="Watch History" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Removing items clears watch history, watched status, and resume progress for this profile."
                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <controls:WrapPanel x:Name="HistoryButtonsPanel" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedCountText" Text="0 selected" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                    <Button x:Name="SelectLoadedButton" Content="Select Loaded" Click="SelectLoaded_Click" Visibility="Collapsed" />
                    <Button x:Name="ClearSelectionButton" Content="Clear" Click="ClearSelection_Click" Visibility="Collapsed" />
                    <Button x:Name="RemoveSelectedButton" Content="Remove Selected" Click="RemoveSelected_Click" Visibility="Collapsed" />
                    <Button x:Name="SelectionModeButton" Content="Select" Click="SelectionMode_Click" />
                </controls:WrapPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="ExternalWatchlistScroller" Grid.Row="4" Padding="40,0,40,28" Visibility="Collapsed">
            <StackPanel Spacing="24">
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="16">
                    <Grid x:Name="ExternalWatchlistHintGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <TextBlock x:Name="ExternalWatchlistHint" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <HyperlinkButton x:Name="ExternalWatchlistDiscoverLink" Content="Find more in Discover" FontSize="14" FontWeight="Medium" Padding="0" Height="20" MinHeight="20" HorizontalAlignment="Left" Click="WatchlistDiscover_Click" />
                    </Grid>
                </Border>
                <ItemsRepeater x:Name="ExternalTitlesRepeater" ElementPrepared="ExternalTitlesRepeater_ElementPrepared">
                    <ItemsRepeater.Layout><UniformGridLayout x:Name="ExternalTitlesLayout" MinItemWidth="180" MinItemHeight="330" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate><DataTemplate><ContentControl HorizontalContentAlignment="Stretch" /></DataTemplate></ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ProgressRing x:Name="ExternalTitlesLoading" Width="30" Height="30" HorizontalAlignment="Center" IsActive="False" Visibility="Collapsed" />
                <StackPanel x:Name="ExternalTitlesState" HorizontalAlignment="Center" Spacing="12" Padding="16,64" MaxWidth="448">
                    <TextBlock x:Name="ExternalTitlesStateText" TextAlignment="Center" TextWrapping="Wrap" FontSize="14" />
                    <Button x:Name="ExternalTitlesRetry" Content="Retry" Click="ExternalTitlesRetry_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
                    <Button x:Name="ExternalTitlesDiscover" Content="Browse Discover" Click="WatchlistDiscover_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="CatalogScrollViewer" Grid.Row="4" Padding="40,0,40,28" ViewChanged="CatalogScroll_ViewChanged">
            <StackPanel Spacing="16">
                <StackPanel x:Name="CatalogErrorPanel" Visibility="Collapsed" Spacing="12" Margin="0,48" HorizontalAlignment="Center" MaxWidth="448">
                    <TextBlock x:Name="CatalogErrorTitle" Text="Couldn't load the catalog" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="CatalogRetryButton" Content="Retry" Click="CatalogRetry_Click" HorizontalAlignment="Center"/>
                    <Button x:Name="CatalogCollectionsButton" Content="All collections" Click="CatalogCollections_Click" Visibility="Collapsed" HorizontalAlignment="Center"/>
                </StackPanel>
                <ItemsRepeater x:Name="CatalogLoadingRepeater"
                               ElementPrepared="CatalogLoadingRepeater_ElementPrepared"
                               Visibility="Collapsed">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="CatalogLoadingGridLayout"
                                           MinItemWidth="150"
                                           MinItemHeight="281"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="16"
                                           ItemsStretch="Fill"
                                           MaximumRowsOrColumns="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="9">
                                <controls:SkeletonBox Height="225" CornerRadius="12" />
                                <controls:SkeletonText Width="112" Height="14" HorizontalAlignment="Left" />
                                <controls:SkeletonText Width="72" Height="11" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ItemsRepeater x:Name="ItemsRepeater" ElementPrepared="ItemsRepeater_ElementPrepared">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="CatalogGridLayout" MinItemWidth="150" MinItemHeight="260" MinColumnSpacing="12"
                                           MinRowSpacing="16" ItemsStretch="Fill" MaximumRowsOrColumns="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:MediaItem"><controls:PosterCard MediaItem="{x:Bind}" /></DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <ProgressRing x:Name="LoadingRing" Width="30" Height="30" HorizontalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="EmptyText" Text="No items found." HorizontalAlignment="Center" Visibility="Collapsed"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Button x:Name="LoadMoreButton" Content="Load more" Click="LoadMore_Click" HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- WebUI parity: floating affordance for long virtual catalog grids. -->
        <Button x:Name="CatalogScrollToTopButton"
                Grid.RowSpan="5"
                Canvas.ZIndex="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Width="40"
                Height="40"
                CornerRadius="20"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed"
                Click="CatalogScrollToTop_Click"
                ToolTipService.ToolTip="Back to top"
                AutomationProperties.Name="Back to top">
            <FontIcon Glyph="&#xE74A;" FontSize="14" />
        </Button>

        <controls:SlideSheet x:Name="FiltersSheet" Title="Filters">
            <controls:SlideSheet.SheetContent>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Filters" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Refine your catalog results" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="GuidedModeButton" Content="Guided" Padding="10,5" Click="FilterMode_Click" Tag="guided" />
                            <Button x:Name="AdvancedModeButton" Content="Advanced" Padding="10,5" Style="{StaticResource OutlineButtonStyle}" Click="FilterMode_Click" Tag="advanced" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Padding="0,4,8,12">
                        <StackPanel x:Name="GuidedFiltersPanel" Spacing="12">
                            <TextBlock Text="Library" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="LibraryCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Genre" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="GenreCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Year range" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <TextBox x:Name="YearFromBox" PlaceholderText="From" InputScope="Number" TextChanged="Filter_Changed" />
                                <TextBox x:Name="YearToBox" Grid.Column="1" PlaceholderText="To" InputScope="Number" TextChanged="Filter_Changed" />
                            </Grid>
                            <TextBlock Text="Minimum IMDb rating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="MinimumRatingCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Any rating" Tag="" IsSelected="True" />
                                <ComboBoxItem Content="5+" Tag="5" /><ComboBoxItem Content="6+" Tag="6" />
                                <ComboBoxItem Content="7+" Tag="7" /><ComboBoxItem Content="8+" Tag="8" /><ComboBoxItem Content="9+" Tag="9" />
                            </ComboBox>
                            <TextBlock Text="Content Rating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="RatingCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Original Language" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="OriginalLanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="People" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox x:Name="ActorBox" PlaceholderText="Actor" TextChanged="Filter_Changed" />
                            <TextBox x:Name="DirectorBox" PlaceholderText="Director" TextChanged="Filter_Changed" />
                            <TextBox x:Name="WriterBox" PlaceholderText="Writer" TextChanged="Filter_Changed" />
                            <TextBox x:Name="ProducerBox" PlaceholderText="Producer" TextChanged="Filter_Changed" />
                            <TextBlock Text="Studio and Network" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="StudioCombo" PlaceholderText="All studios" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="NetworkCombo" PlaceholderText="All networks" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Resolution" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Audio Language" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="AudioLanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Country" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="CountryCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Series status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="StatusCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Any status" Tag="" IsSelected="True" /><ComboBoxItem Content="Returning Series" Tag="Returning Series" />
                                <ComboBoxItem Content="Ended" Tag="Ended" /><ComboBoxItem Content="Canceled" Tag="Canceled" />
                                <ComboBoxItem Content="In Production" Tag="In Production" /><ComboBoxItem Content="Planned" Tag="Planned" />
                            </ComboBox>
                            <TextBlock Text="Watch status" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="WatchStatusCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Any" Tag="" IsSelected="True" /><ComboBoxItem Content="Watched" Tag="watched" />
                                <ComboBoxItem Content="In progress" Tag="in_progress" /><ComboBoxItem Content="Unwatched" Tag="unwatched" />
                            </ComboBox>
                            <TextBlock Text="Added in the last" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="AddedInLastCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Any time" Tag="" IsSelected="True" /><ComboBoxItem Content="7 days" Tag="7d" />
                                <ComboBoxItem Content="30 days" Tag="30d" /><ComboBoxItem Content="90 days" Tag="90d" /><ComboBoxItem Content="1 year" Tag="1y" />
                            </ComboBox>
                            <TextBlock Text="Released in the last" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ReleasedInLastCombo" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="Any time" Tag="" IsSelected="True" /><ComboBoxItem Content="30 days" Tag="30d" />
                                <ComboBoxItem Content="90 days" Tag="90d" /><ComboBoxItem Content="1 year" Tag="1y" /><ComboBoxItem Content="5 years" Tag="5y" />
                            </ComboBox>
                            <TextBlock Text="Book and audiobook" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="AuthorCombo" PlaceholderText="All authors" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="NarratorCombo" PlaceholderText="All narrators" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="SeriesCombo" PlaceholderText="All series" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" />
                            <TextBlock Text="Video features" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <controls:WrapPanel HorizontalSpacing="14" VerticalSpacing="8">
                                <CheckBox x:Name="FourKCheckBox" Content="4K" Click="Filter_Changed" />
                                <CheckBox x:Name="HdrCheckBox" Content="HDR" Click="Filter_Changed" />
                                <CheckBox x:Name="DolbyVisionCheckBox" Content="Dolby Vision" Click="Filter_Changed" />
                            </controls:WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="AdvancedFiltersPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Match" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="AdvancedMatchCombo" SelectionChanged="AdvancedRule_Changed">
                                <ComboBoxItem Content="All rules" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="Any rule" Tag="any" />
                            </ComboBox>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Rules" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Add Rule" Click="AddAdvancedRule_Click" />
                            </Grid>
                            <StackPanel x:Name="AdvancedRulesPanel" Spacing="8" />
                            <TextBlock x:Name="NoAdvancedRulesText" Text="No rules defined. Add a rule to build an advanced query." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Button Content="Clear All" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Click="ClearFilters_Click" />
                        <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="CloseFilters_Click" />
                    </Grid>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>
    </Grid>
</Page>
