<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCollectionsCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- Full width, like the WebUI wall: the poster-size setting decides the columns, not a fixed shell. -->
            <StackPanel
                x:Name="CollectionsPageShell"
                HorizontalAlignment="Stretch"
                Padding="40,24,40,40"
                Spacing="24">

                <!-- ===== Header ===== -->
                <Grid x:Name="CollectionsHeaderGrid" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CollectionsTitle" Text="Collections"
                            FontSize="48"
                            FontWeight="ExtraBold"
                            LineStackingStrategy="BlockLineHeight"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="CollectionsSubtitle"
                            HorizontalAlignment="Left"
                            LineStackingStrategy="BlockLineHeight"
                            Text="Yours and the server's."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                    </StackPanel>

                    <StackPanel
                        x:Name="CollectionsHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Bottom">
                        <Button
                            x:Name="BrowseTemplatesButton"
                            Visibility="Collapsed"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="BrowseTemplates_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Browse Templates" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CreateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CreateCollection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Show: All, Mine, Shared and Server when there are any, then one pill per library. -->
                <ScrollViewer
                    x:Name="CollectionsFilterScroll"
                    Visibility="Collapsed"
                    HorizontalScrollMode="Enabled"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CollectionsFilterPills" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Show" />
                </ScrollViewer>

                <!-- A view with nothing in it says so in one line, once what it shows has loaded. -->
                <TextBlock
                    x:Name="CollectionsEmptyLine"
                    Visibility="Collapsed"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    AutomationProperties.LiveSetting="Polite" />

                <StackPanel x:Name="CollectionsLoadingShell" Visibility="Collapsed" />

                <!-- ===== Empty State ===== -->
                <Border
                    x:Name="EmptyState"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="32"
                    Padding="24,64"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon
                            Glyph="&#xE8FD;"
                            FontSize="40"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="No collections yet"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Start from a curated TMDB or MDBList template — or build your own from scratch."
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="420"
                            TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="BrowseTemplates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Start from a template" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Click="CreateCollection_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create from scratch" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Collections Grid ===== -->
                <!-- The wall: your collections, the ones other profiles share, then the server's, in one poster grid. -->
                <StackPanel x:Name="CollectionsWallPanel" Spacing="16">
                    <StackPanel x:Name="CollectionsGrid" Spacing="0" />
                    <StackPanel x:Name="ServerCollectionsRows" Spacing="12" />
                </StackPanel>
                <StackPanel x:Name="ServerCollectionsLoadingRows" Visibility="Collapsed" />
                <TextBlock x:Name="CollectionsReorderHint" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Drag a poster to change the order, or focus its handle and press Space, then the arrow keys." />

                <Button
                    x:Name="AddGroupButton"
                    Style="{StaticResource OutlineButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="AddGroup_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add group" />
                    </StackPanel>
                </Button>

                <StackPanel
                    x:Name="AddGroupEditor"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="AddGroupNameBox"
                        Width="300"
                        MaxWidth="300"
                        PlaceholderText="Group title"
                        Style="{StaticResource DarkTextBoxStyle}"
                        KeyDown="AddGroupNameBox_KeyDown" />
                    <Button
                        Content="Add"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCommit_Click" />
                    <Button
                        Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCancel_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <Border x:Name="CreateCollectionDock" VerticalAlignment="Bottom" Padding="16,22,16,20" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
            <Button Content="New collection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44" Style="{StaticResource AccentButtonStyle}" Click="CreateCollection_Click" />
        </Border>
    </Grid>
</Page>
