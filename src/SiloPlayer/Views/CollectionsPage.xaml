<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCollectionsCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <StackPanel
                x:Name="CollectionsPageShell"
                MaxWidth="1080"
                HorizontalAlignment="Center"
                Padding="40,24,40,40"
                Spacing="28">

                <!-- ===== Header ===== -->
                <Grid x:Name="CollectionsHeaderGrid" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CollectionsTitle" Text="Collections"
                            FontSize="48"
                            FontWeight="ExtraBold"
                            LineStackingStrategy="BlockLineHeight"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="CollectionsSubtitle"
                            HorizontalAlignment="Left"
                            LineStackingStrategy="BlockLineHeight"
                            Text="Yours and the server's."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                    </StackPanel>

                    <StackPanel
                        x:Name="CollectionsHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Bottom">
                        <Button
                            x:Name="BrowseTemplatesButton"
                            Visibility="Collapsed"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="BrowseTemplates_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Browse Templates" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CreateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CreateCollection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="CollectionsLoadingShell" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="PersonalCollectionsHeading"
                    Text="Your collections"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="PersonalCollectionsCount" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                    </StackPanel>
                    <TextBlock x:Name="PersonalCollectionsNote" Grid.Column="1" Text="Only you can change these" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </Grid>

                <!-- ===== Empty State ===== -->
                <Border
                    x:Name="EmptyState"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="32"
                    Padding="24,64"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon
                            Glyph="&#xE8FD;"
                            FontSize="40"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="No collections yet"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Start from a curated TMDB, Trakt, or MDBList template — or build your own from scratch."
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="420"
                            TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="BrowseTemplates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Start from a template" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Click="CreateCollection_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create from scratch" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Collections Grid ===== -->
                <StackPanel x:Name="CollectionsGrid" Spacing="0" Margin="0,-12,0,0" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel x:Name="SharedCollectionsPanel" Spacing="16" Visibility="Collapsed" />

                <Button
                    x:Name="AddGroupButton"
                    Style="{StaticResource OutlineButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="AddGroup_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add group" />
                    </StackPanel>
                </Button>

                <StackPanel
                    x:Name="AddGroupEditor"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="AddGroupNameBox"
                        Width="300"
                        MaxWidth="300"
                        PlaceholderText="Group title"
                        Style="{StaticResource DarkTextBoxStyle}"
                        KeyDown="AddGroupNameBox_KeyDown" />
                    <Button
                        Content="Add"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCommit_Click" />
                    <Button
                        Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCancel_Click" />
                </StackPanel>

                <StackPanel x:Name="ServerCollectionsSection" Spacing="16" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ServerCollectionsHeading" Text="Server collections"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="ServerCollectionsHeaderActions" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="ServerCollectionsLoadingRows" Visibility="{x:Bind ViewModel.IsLoadingServerCollections, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <StackPanel
                        x:Name="ServerCollectionsRows"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsLoadingServerCollections, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <Border x:Name="CreateCollectionDock" VerticalAlignment="Bottom" Padding="16,22,16,20" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
            <Button Content="New collection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44" Style="{StaticResource AccentButtonStyle}" Click="CreateCollection_Click" />
        </Border>
    </Grid>
</Page>
