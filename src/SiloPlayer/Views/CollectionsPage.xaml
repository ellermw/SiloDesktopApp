<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Match the WebUI's stable six-card loading layout instead of
             replacing the page with a centered spinner. -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            IsScrollInertiaEnabled="True">
            <StackPanel
                x:Name="CollectionsLoadingShell"
                MaxWidth="1400"
                HorizontalAlignment="Center"
                Padding="40,24,40,40">
                <ItemsRepeater x:Name="CollectionsLoadingRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="280"
                            MinColumnSpacing="16"
                            MinRowSpacing="16"
                            MaximumRowsOrColumns="3"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="96"
                                CornerRadius="26"
                                Background="{StaticResource SurfaceBrush}"
                                Opacity="0.62" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Error state -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCollectionsCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel
                x:Name="CollectionsPageShell"
                MaxWidth="1400"
                HorizontalAlignment="Center"
                Padding="40,24,40,40"
                Spacing="24">

                <!-- ===== Header ===== -->
                <Grid x:Name="CollectionsHeaderGrid" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Text="Collections"
                            FontSize="{StaticResource FontSizeDisplayLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Build personal or shared shelves around moods, series arcs, or anything else worth grouping."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="640" />
                    </StackPanel>

                    <StackPanel
                        x:Name="CollectionsHeaderActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="BrowseTemplatesButton"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="BrowseTemplates_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="Browse Templates" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="CreateButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CreateCollection_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New Collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock
                    Text="Your collections"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}" />

                <!-- ===== Empty State ===== -->
                <Border
                    x:Name="EmptyState"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="32"
                    Padding="24,64"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <FontIcon
                            Glyph="&#xE8FD;"
                            FontSize="40"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="No collections yet"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Start from a curated TMDB, Trakt, or MDBList template — or build your own from scratch."
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="420"
                            TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button
                                Style="{StaticResource OutlineButtonStyle}"
                                Click="BrowseTemplates_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Start from a template" />
                                </StackPanel>
                            </Button>
                            <Button
                                Style="{StaticResource GhostButtonStyle}"
                                Click="CreateCollection_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Create from scratch" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Collections Grid ===== -->
                <StackPanel x:Name="CollectionsGrid" Spacing="0" />

                <Button
                    x:Name="AddGroupButton"
                    Style="{StaticResource OutlineButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="AddGroup_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add group" />
                    </StackPanel>
                </Button>

                <StackPanel
                    x:Name="AddGroupEditor"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="AddGroupNameBox"
                        Width="300"
                        MaxWidth="300"
                        PlaceholderText="Group title"
                        Style="{StaticResource DarkTextBoxStyle}"
                        KeyDown="AddGroupNameBox_KeyDown" />
                    <Button
                        Content="Add"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCommit_Click" />
                    <Button
                        Content="Cancel"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="AddGroupCancel_Click" />
                </StackPanel>

                <StackPanel x:Name="ServerCollectionsSection" Spacing="22" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="Server collections"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Curated shelves from across every library on this server."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="ServerCollectionsLoadingRows"
                        Spacing="32"
                        Visibility="{x:Bind ViewModel.IsLoadingServerCollections, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="18">
                            <Border Width="160" Height="28" CornerRadius="8" Background="{StaticResource SurfaceBrush}" Opacity="0.62" HorizontalAlignment="Left" />
                            <ItemsRepeater x:Name="ServerCollectionsLoadingRowOne">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="178" Spacing="10">
                                            <Border Width="178" Height="267" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                            <Border Width="132" Height="16" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                        <StackPanel Spacing="18">
                            <Border Width="160" Height="28" CornerRadius="8" Background="{StaticResource SurfaceBrush}" Opacity="0.62" HorizontalAlignment="Left" />
                            <ItemsRepeater x:Name="ServerCollectionsLoadingRowTwo">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="16" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="178" Spacing="10">
                                            <Border Width="178" Height="267" CornerRadius="12" Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                            <Border Width="132" Height="16" CornerRadius="6" Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        x:Name="ServerCollectionsRows"
                        Spacing="30"
                        Visibility="{x:Bind ViewModel.IsLoadingServerCollections, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
