<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.RecommendationSectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel x:Name="PageContent" Padding="40,24,40,48" Spacing="24">
            <Button
                Style="{StaticResource GhostButtonStyle}"
                HorizontalAlignment="Left"
                Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="Back" FontSize="13" />
                </StackPanel>
            </Button>

            <StackPanel Margin="0,12,0,0" Spacing="6">
                <TextBlock
                    x:Name="PageTitleText"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    x:Name="ItemCountLabel"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <ItemsRepeater x:Name="LoadingSkeleton" ElementPrepared="LoadingSkeleton_ElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout x:Name="LoadingLayout"
                                       MinItemWidth="165"
                                       MinColumnSpacing="16"
                                       MinRowSpacing="24"
                                       ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="9">
                            <controls:SkeletonBox Height="248" CornerRadius="12" />
                            <controls:SkeletonText Width="120" Height="14" HorizontalAlignment="Left" />
                            <controls:SkeletonText Width="80" Height="11" HorizontalAlignment="Left" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel
                x:Name="ErrorState"
                HorizontalAlignment="Center"
                Spacing="12"
                Padding="40,72"
                Visibility="Collapsed">
                <TextBlock
                    Text="Failed to load this section."
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    HorizontalAlignment="Center" />
                <Button
                    Style="{StaticResource GhostButtonStyle}"
                    Foreground="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center"
                    Click="Retry_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Retry" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                Spacing="8"
                Padding="40,72"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE735;" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Nothing here yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock
                    Text="Watch and rate more content to surface picks for this section."
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    MaxWidth="380" />
            </StackPanel>

            <ItemsRepeater x:Name="ItemsGrid"
                           ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                           Visibility="Collapsed"
                           ElementPrepared="ItemsGrid_ElementPrepared">
                <ItemsRepeater.Layout>
                    <UniformGridLayout x:Name="ItemsLayout" MinItemWidth="165" MinColumnSpacing="16" MinRowSpacing="24" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaItem">
                        <controls:PosterCard MediaItem="{x:Bind}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
