<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Undo dismissal banner (bottom, overlaid) -->
        <Border
            x:Name="UndoBanner"
            Visibility="Collapsed"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,24"
            Padding="16,10,8,10"
            CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Canvas.ZIndex="100">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="UndoBannerText"
                    Text="Item dismissed"
                    FontSize="13"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="UndoButton"
                    Content="Undo"
                    Style="{StaticResource AccentButtonStyle}"
                    FontSize="12"
                    Padding="12,6"
                    CornerRadius="8"
                    Click="UndoButton_Click" />
            </StackPanel>
        </Border>

        <!-- Skeleton loading — approximates the real layout (hero + 3 section rows)
             so first paint feels instant instead of a long spinner. -->
        <ScrollViewer
            x:Name="LoadingSkeleton"
            VerticalScrollBarVisibility="Disabled"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <StackPanel Padding="40,24,40,24" Spacing="36">
                <!-- Hero carousel skeleton (16:9 backdrop) -->
                <controls:SkeletonBackdrop Height="380" />

                <!-- Three section-row skeletons -->
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="180" Height="20" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="220" Height="20" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="12">
                    <controls:SkeletonText Width="160" Height="20" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                        <controls:SkeletonPoster />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Error message -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.LoadCommand}" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True"
            CanContentRenderOutsideBounds="True">

            <!-- Web: space-y-10 py-2 -->
            <StackPanel x:Name="ContentPanel" Padding="0,8,0,0">
                <!-- Featured slot has distinct loading, error, ready, and empty
                     states just like renderHeroSlot() in the current WebUI. -->
                <controls:SkeletonBackdrop x:Name="HeroLoadingSkeleton" Height="380" Margin="40,0,40,40" Visibility="Collapsed" />
                <Border
                    x:Name="HeroErrorPanel"
                    Height="380"
                    Margin="40,0,40,40"
                    Padding="48"
                    CornerRadius="30"
                    Background="{StaticResource SurfaceBrush}"
                    Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Bottom" Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock x:Name="HeroErrorTitle" FontSize="30" FontWeight="Bold" />
                        <TextBlock Text="This featured section could not be loaded right now." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Retry section" HorizontalAlignment="Left" Click="RetryHero_Click" />
                    </StackPanel>
                </Border>
                <controls:HeroCarousel x:Name="HeroCarouselControl" Margin="0,0,0,40" />

                <!-- Soft personalization prompt shown only after the initial
                     taste picker was skipped and the profile still has no
                     favorites. Mirrors TasteSeedBanner.tsx. -->
                <Border
                    x:Name="TasteSeedBanner"
                    Margin="48,0,48,40"
                    Padding="24,16"
                    CornerRadius="22"
                    Background="{StaticResource SurfaceBrush}"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Personalize your home" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Pick a few titles you love and we'll tailor your recommendations." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Personalize" Style="{StaticResource AccentButtonStyle}" Click="PersonalizeHome_Click" />
                            <Button Style="{StaticResource GhostButtonStyle}" Width="32" Height="32" Padding="0" ToolTipService.ToolTip="Dismiss personalization prompt" Click="DismissTasteSeed_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section rows (each section handles its own spacing and padding) -->
                <StackPanel x:Name="SectionsPanel" />

                <!-- Empty state when layout returns zero sections -->
                <StackPanel
                    x:Name="EmptyHomeState"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Padding="40,80"
                    Visibility="Collapsed">
                    <FontIcon
                        Glyph="&#xE80F;"
                        FontSize="40"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EmptyHomeTitle"
                        Text="No sections configured"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="EmptyHomeDescription"
                        Text="Your home screen is empty. Customize it by adding sections to display your media."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Customize Home Screen"
                        Style="{StaticResource GhostButtonStyle}"
                        Foreground="{StaticResource AccentBrush}"
                        Click="CustomizeHome_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
