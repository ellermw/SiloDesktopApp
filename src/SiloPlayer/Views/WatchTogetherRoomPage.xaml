<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.WatchTogetherRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:playback="using:SiloPlayer.Core.Models.Playback"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <SolidColorBrush x:Key="PartyPanelBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.90" />
        <SolidColorBrush x:Key="PartyPanelBorderBrush" Color="{Binding Color, Source={StaticResource BorderBrush}}" Opacity="0.72" />
        <SolidColorBrush x:Key="PartySubtleBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.72" />
        <SolidColorBrush x:Key="PartySubtleBorderBrush" Color="{Binding Color, Source={StaticResource BorderBrush}}" Opacity="0.62" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <ScrollViewer>
        <Grid x:Name="PageShell" Padding="40,28,40,42">
            <Grid x:Name="RoomWorkspace" MaxWidth="1400" ColumnSpacing="20" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RailColumn" Width="288"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="RoomContent" MaxWidth="1040" HorizontalAlignment="Center" Spacing="20">

                <!-- Current WebUI room header bar. -->
                <Border x:Name="RoomStatusBar" Background="{StaticResource AppBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="20,10">
                        <Grid x:Name="RoomHeaderGrid" ColumnSpacing="8" RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="RoomHeaderSummary" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="PhaseText" Text="Live · 0 here" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="CopyCodeButton" Click="CopyCodeButton_Click" Height="28" MinHeight="0" Padding="12,0" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}"><TextBlock x:Name="CodeText" Text="—" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" FontFamily="Consolas" FontWeight="SemiBold" CharacterSpacing="180" /></Button>
                            <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="MemberCountText" Text="0" FontSize="13" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#6B7280" />
                                    <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <controls:WrapPanel x:Name="RoomHeaderActions" Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="CopyInviteButton" Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" FontSize="13" Click="CopyInviteButton_Click" Visibility="Collapsed"
                                    AutomationProperties.Name="Copy invite link">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                    <TextBlock Text="Invite" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PolicyButton" Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" FontSize="13" Command="{x:Bind ViewModel.TogglePolicyCommand}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" />
                                    <TextBlock x:Name="PolicyButtonText" Text="Allow Pause" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RailSheetButton" Content="People / Activity" Style="{StaticResource OutlineButtonStyle}" Click="RailSheetButton_Click" Visibility="Collapsed"/>
                            <Button x:Name="ModeButton" Content="Host picks" Style="{StaticResource OutlineButtonStyle}" Click="ModeButton_Click"/>
                            <Button x:Name="EndButton" Content="End room" Style="{StaticResource DestructiveButtonStyle}" Padding="12,8" FontSize="13"
                                    Click="EndButton_Click" Visibility="Collapsed" />
                            <Button x:Name="LeaveButton" Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" FontSize="13" Click="LeaveButton_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                                    <TextBlock Text="Leave" />
                                </StackPanel>
                            </Button>
                        </controls:WrapPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="StagedPanel" Visibility="Collapsed" Spacing="16">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                        <Grid>
                            <Image x:Name="StagedBackdrop" Stretch="UniformToFill" Opacity="0.25" />
                            <Grid x:Name="StagedHeroContent" Padding="24" ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="StagedPosterBorder" Width="112" Height="168" Background="{StaticResource SurfaceBrush}" CornerRadius="16"><Image x:Name="StagedPoster" Stretch="UniformToFill" /></Border>
                                <StackPanel x:Name="StagedHeroInfo" Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="StagedEyebrow" Text="UP NEXT" FontSize="11" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="StagedTitle" Text="Staged for the room" FontSize="24" LineHeight="32" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ReadySummary" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button x:Name="StartStagedButton" Content="Start for everyone" Click="StartStagedButton_Click" Style="{StaticResource AccentButtonStyle}" Height="36" Padding="12,0" HorizontalAlignment="Left"/>
                                        <Button x:Name="ChangeStagedButton" Click="ChangeStagedButton_Click" Style="{StaticResource OutlineButtonStyle}" Height="36" MinHeight="0" Padding="16,0"><TextBlock Text="Change" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"/></Button>
                                        <Button x:Name="LobbyReadyButton" Content="I'm ready" Click="LobbyReadyButton_Click" HorizontalAlignment="Left"/>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="ReadyCheckPanel" Background="{StaticResource PartySubtleBrush}" BorderBrush="{StaticResource PartySubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2"><TextBlock x:Name="ReadyCheckHeading" Text="Guest ready check" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold"/><TextBlock x:Name="ReadyCheckSummary" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                            <controls:WrapPanel x:Name="ReadyCheckMembers" Grid.Column="1" VerticalAlignment="Center" HorizontalSpacing="16" VerticalSpacing="8" />
                        </Grid>
                    </Border>
                    <Border x:Name="StageInvitePanel" Background="{StaticResource PartySubtleBrush}" BorderBrush="{StaticResource PartySubtleBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12">
                        <Grid x:Name="StageInviteGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <controls:WrapPanel x:Name="StageInviteInfo" HorizontalSpacing="12" VerticalSpacing="6"><TextBlock Text="INVITE" FontSize="11" LineHeight="16.5" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><TextBlock Text="Share the code to let people in." FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><Button x:Name="StageCodeButton" Content="Code" Click="CopyCodeButton_Click" Height="32" MinHeight="0" Padding="10,0" HorizontalAlignment="Left" AutomationProperties.Name="Copy room code"/></controls:WrapPanel>
                            <StackPanel x:Name="GuestPausePanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Grid Width="32" Height="20"><ToggleSwitch x:Name="GuestPauseToggle" Width="44" MinWidth="44" Height="38" Margin="-6,-9,-6,-9" OnContent="" OffContent="" Toggled="GuestPauseToggle_Toggled" AutomationProperties.Name="Guests can pause"/></Grid><TextBlock x:Name="GuestPauseLabel" Text="Guests can pause" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"/></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Background="#2DEF6B73" CornerRadius="8" Padding="14,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13" />
                </Border>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,10"
                        Visibility="{x:Bind ViewModel.NoticeMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                               Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" FontSize="13" />
                </Border>
                <!-- Current WebUI Now Playing hero. -->
                <Border x:Name="NowPlayingPanel" Visibility="Collapsed"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid x:Name="NowPlayingGrid" Height="150">
                        <Image x:Name="NowPlayingBackdrop" Stretch="UniformToFill" Opacity="0.25" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#F20E1014" Offset="0" />
                                    <GradientStop Color="#BF0E1014" Offset="0.55" />
                                    <GradientStop Color="#120E1014" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Margin="24" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="#34D399" />
                                <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="180" Foreground="#34D399" />
                            </StackPanel>
                            <TextBlock x:Name="NowPlayingTitle" Text="Loading..." FontSize="27" FontWeight="SemiBold" />
                            <TextBlock x:Name="NowPlayingSubtitle" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Candidate confirmation mirrors the WebUI spotlight before selection/suggestion. -->
                <Border x:Name="CandidateSpotlight" Visibility="Collapsed"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Grid MinHeight="260">
                        <Image x:Name="CandidateBackdrop" Stretch="UniformToFill" Opacity="0.30" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FA0E1014" Offset="0" />
                                    <GradientStop Color="#E60E1014" Offset="0.62" />
                                    <GradientStop Color="#550E1014" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid x:Name="CandidateContentGrid" Padding="22" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CandidatePosterBorder" Grid.Column="0" Width="116" Height="174" CornerRadius="10"
                                    Background="{StaticResource SurfaceRaisedBrush}" VerticalAlignment="Center">
                                <Image x:Name="CandidatePoster" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel x:Name="CandidateTextPanel" Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <TextBlock x:Name="CandidateKindLabel" Text="READY TO PLAY" FontSize="10"
                                           CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="CandidateTitle" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="CandidateMemberState" TextWrapping="Wrap" FontSize="12"/>
                                <TextBlock x:Name="CandidateMeta" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                <controls:WrapPanel x:Name="CandidateRatings" HorizontalSpacing="6" VerticalSpacing="8" Visibility="Collapsed"/>
                                <TextBlock x:Name="CandidateOverview" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" MaxLines="3" MaxWidth="620" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <Button x:Name="CandidatePlayBtn" Style="{StaticResource AccentButtonStyle}"
                                            Padding="18,9" CornerRadius="18" Click="CandidatePlay_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="13" />
                                            <TextBlock x:Name="CandidateActionLabel" Text="Start for Everyone" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Back to search" Style="{StaticResource OutlineButtonStyle}"
                                            Padding="16,9" Click="CandidateBack_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Host discovery and vote-mode suggestion search. -->
                <StackPanel x:Name="HostPickSection" Visibility="Collapsed" Spacing="16">
                    <StackPanel x:Name="BrowseFilterContainer" Spacing="8">
                        <TextBlock x:Name="BrowseHeading" Text="Browse to pick" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" />
                        <ComboBox x:Name="ShelfPicker" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="ShelfPicker_SelectionChanged" HorizontalAlignment="Left" Margin="0,0,0,8">
                            <ComboBoxItem Content="All"/><ComboBoxItem Content="Movies"/><ComboBoxItem Content="Series"/><ComboBoxItem Content="Together"/><ComboBoxItem Content="Watchlists"/><ComboBoxItem Content="Recent"/>
                        </ComboBox>
                        <Grid x:Name="BrowseSearchContainer">
                        <TextBox x:Name="HostSearchBox" Style="{StaticResource DarkTextBoxStyle}"
                                 Height="40" Padding="36,0,12,0" Background="{StaticResource SurfaceBrush}" FontSize="14" CornerRadius="12" VerticalContentAlignment="Center"
                                 PlaceholderText="Search movies and series..."
                                 TextChanged="HostSearchBox_TextChanged" KeyDown="HostSearchBox_KeyDown" />
                        <FontIcon Glyph="&#xE721;" FontSize="15" Margin="16,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Foreground="{StaticResource SecondaryTextBrush}" IsHitTestVisible="False" />
                        <Button x:Name="ClearSearchButton" Content="&#xE711;" Width="32" Height="32" Padding="0"
                                Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0" Click="ClearSearchButton_Click"
                                Visibility="Collapsed" />
                    </Grid>
                        <controls:WrapPanel x:Name="ShelfChipsPanel" HorizontalSpacing="4" VerticalSpacing="6" />
                    </StackPanel>

                    <Grid x:Name="SearchEmptyState" HorizontalAlignment="Center" Padding="0,32" Visibility="Visible">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <FontIcon x:Name="SearchEmptyIcon" Glyph="&#xE721;" FontSize="30" Opacity="0.3" />
                            <TextBlock x:Name="SearchEmptyText" Text="Find something for everyone to watch."
                                       FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="BrowseShelfRows" Spacing="24" Visibility="Collapsed" />
                    <ItemsRepeater x:Name="HostSearchResults">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="140" MinItemHeight="250"
                                               MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <Button Tag="{x:Bind}" Click="HostSearchResult_Click" Padding="0"
                                        Background="Transparent" BorderThickness="0">
                                    <StackPanel Spacing="6">
                                        <controls:PosterCard MediaItem="{x:Bind}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5" Tag="{x:Bind ContentId}" Loaded="MemberDots_Loaded" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid x:Name="DrillDownPanel" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" CornerRadius="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="PickerSeriesHeader">
                            <Image x:Name="PickerSeriesBackdrop" Stretch="UniformToFill" Opacity="0" ImageOpened="PickerImage_Opened" />
                            <Grid IsHitTestVisible="False">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                        <GradientStop Color="{StaticResource SurfaceColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource SurfaceColor}" Offset="0.35" />
                                        <GradientStop Color="Transparent" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                            </Grid>
                            <Grid x:Name="PickerSeriesHeaderContent" Padding="16,32,16,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border x:Name="PickerSeriesPosterBorder" Width="64" Height="96" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}">
                                    <Image x:Name="PickerSeriesPoster" Stretch="UniformToFill" Opacity="0" ImageOpened="PickerImage_Opened" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="CANDIDATE · SERIES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="PickerSeriesTitle" FontSize="16" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PickerSeriesMeta" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PickerSeriesOverview" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Button Content="×" Click="CloseSeriesPicker_Click" Style="{StaticResource GhostButtonStyle}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" AutomationProperties.Name="Close series" />
                        </Grid>
                        <Grid x:Name="PickerSeriesBody" Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PickerSeasonScroll" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,8">
                                <StackPanel x:Name="PickerSeasons" Orientation="Horizontal" Spacing="6" />
                            </ScrollViewer>
                            <Grid x:Name="PickerEpisodeArea" Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="16,8" ColumnSpacing="12" BorderThickness="0,1,0,1" BorderBrush="{StaticResource BorderBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DrillDownTitle" FontSize="11" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="PickerDotsLegend" Grid.Column="1" Text="● Watched   ◐ In progress   ○ Unseen" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                                <ScrollViewer x:Name="PickerEpisodeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                                    <StackPanel>
                        <Button x:Name="DrillDownBackBtn" Click="DrillDownBack_Click"
                                Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                <TextBlock x:Name="DrillDownBackText" Text="Back to results" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="DrillDownSubtitle" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="DrillDownLoading" Visibility="Collapsed" Spacing="4">
                            <Border Height="80" CornerRadius="8" Background="{StaticResource SurfaceBrush}" />
                            <Border Height="80" CornerRadius="8" Background="{StaticResource SurfaceBrush}" />
                            <Border Height="80" CornerRadius="8" Background="{StaticResource SurfaceBrush}" />
                            <Border Height="80" CornerRadius="8" Background="{StaticResource SurfaceBrush}" />
                            <Border Height="80" CornerRadius="8" Background="{StaticResource SurfaceBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DrillDownEmptyText" Visibility="Collapsed" Text="No playable episodes in this season."
                                   Margin="8,32" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <ItemsRepeater x:Name="DrillDownItems">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="220" MinItemHeight="76"
                                                   MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <Border Tag="{x:Bind}" Loaded="EpisodeRow_Loaded" SizeChanged="EpisodeRow_SizeChanged" Padding="8" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Tag="{x:Bind}" Loaded="EpisodeStill_Loaded" Tapped="EpisodeStill_Tapped" Width="112" Height="63" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Visibility="Collapsed">
                                                <Image Source="{x:Bind PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" Opacity="0" ImageOpened="PickerImage_Opened" />
                                            </Border>
                                            <Button Grid.Column="1" Tag="{x:Bind}" Click="DrillDownResult_Click" Padding="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Top">
                                            <StackPanel Spacing="3">
                                                <TextBlock Tag="{x:Bind}" Loaded="EpisodeNextUp_Loaded" FontSize="10" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Tag="{x:Bind}" Loaded="EpisodeNumber_Loaded" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Tag="{x:Bind}" Loaded="EpisodeRuntime_Loaded" FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock Text="{x:Bind Overview}" FontSize="12" MaxLines="2" TextWrapping="Wrap"
                                                           Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="5" Tag="{x:Bind ContentId}" Loaded="MemberDots_Loaded" />
                                            </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="DrillDownResult_Click" Loaded="EpisodeAction_Loaded" Style="{StaticResource OutlineButtonStyle}" FontSize="12" Padding="10,4" MinHeight="28" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                        <Grid x:Name="PickerConfirmation" Grid.Row="2" Visibility="Collapsed" Padding="16,12" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="YOUR PICK" FontSize="11" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="PickerPickTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PickerPickRisk" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Cancel" Click="CloseSeriesPicker_Click" Style="{StaticResource GhostButtonStyle}" IsEnabled="{Binding IsEnabled, ElementName=PickerConfirmButton}" FontSize="14" />
                            <Button x:Name="PickerConfirmButton" Grid.Column="2" Content="Stage it" Click="SeriesConfirm_Click" Style="{StaticResource AccentButtonStyle}" FontSize="14" />
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Guest waiting state. -->
                <StackPanel x:Name="WaitingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Spacing="12" Padding="24,38">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE716;" FontSize="24" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="Waiting for the host" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingSubtitle" Text="The host will choose a movie or episode for the room."
                               FontSize="13" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Vote mode suggestions are a poster grid in the current WebUI. -->
                <Border x:Name="SuggestionsPanel" Visibility="Collapsed" Background="#06000000"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="18">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#1F7C3AED">
                                    <FontIcon Glyph="&#xE74A;" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Suggestions" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SuggestionsSubtitle" Text="No suggestions yet — search for something to add."
                                               FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" Click="SuggestButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Suggest" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsRepeater x:Name="SuggestionsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="145" MinItemHeight="258"
                                                   MinColumnSpacing="14" MinRowSpacing="16" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="playback:WatchTogetherSuggestion">
                                    <Grid Width="145">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="218" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}">
                                            <Grid>
                                <Image Source="{x:Bind PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                                <Button Tag="{x:Bind Id}" Click="SuggestionVoteButton_Click" Visibility="{x:Bind CanVote, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,8,8,0" Padding="8,4" CornerRadius="12"
                                                        Background="#B3000000">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="9" />
                                                        <TextBlock Text="{x:Bind VoteCount, Mode=OneWay}" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="&#xE74D;" Tag="{x:Bind}" Click="SuggestionDelete_Click"
                                                        Visibility="{x:Bind CanDelete, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top" Margin="8,8,0,0" Width="28" Height="28"
                                                        Padding="0" CornerRadius="14" Background="#B3000000" />
                                                <Button Content="&#xE768;" Tag="{x:Bind}" Click="SuggestionPromote_Click"
                                                        Visibility="{x:Bind CanPromote, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                        Width="42" Height="42" Padding="0"
                                                        CornerRadius="21" Background="#C9404040" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{x:Bind Title}" Margin="2,9,2,0" FontSize="13"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="{x:Bind Subtitle}" Margin="2,2,2,0" FontSize="10"
                                                   CharacterSpacing="100" Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="RoomRail" Grid.Column="1" VerticalAlignment="Stretch" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <StackPanel Spacing="0">
                    <Grid Padding="8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="PeopleTabButton" Content="People" Height="36" CornerRadius="0" Background="Transparent" BorderBrush="{StaticResource PrimaryTextBrush}" BorderThickness="0,0,0,2" HorizontalAlignment="Stretch" Click="PeopleTab_Click"/>
                        <Button x:Name="ActivityTabButton" Grid.Column="1" Content="Activity" Height="36" CornerRadius="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Stretch" Click="ActivityTab_Click"/>
                    </Grid>
                <!-- Additive participants field from the current server. -->
                <Border x:Name="MembersPanel" Visibility="Collapsed">
                    <StackPanel x:Name="MembersWrapPanel" />
                </Border>

                    <ScrollViewer x:Name="ActivityScroller" Visibility="Collapsed" MaxHeight="500"><StackPanel x:Name="ActivityList" Spacing="12"/></ScrollViewer>
                </StackPanel>
            </Border>
            </Grid>
            <!-- Current WebUI RoomTerminalState. Terminal failures replace the
                 room rather than leaving unusable room chrome on screen. -->
            <StackPanel x:Name="TerminalStatePanel" MaxWidth="560" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="14" Visibility="Collapsed">
                <FontIcon Glyph="&#xE783;" FontSize="34" HorizontalAlignment="Center"
                          Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="TerminalStateTitle" FontSize="26" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="TerminalStateDescription" FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="TerminalStateAction" HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="LeaveButton_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
