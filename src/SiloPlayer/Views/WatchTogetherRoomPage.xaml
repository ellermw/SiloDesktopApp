<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.WatchTogetherRoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:playback="using:SiloPlayer.Core.Models.Playback"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="40,28,40,32">
            <StackPanel MaxWidth="1040" HorizontalAlignment="Stretch" Spacing="20">

                <!-- Room header -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: code + status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20">
                            <StackPanel Spacing="2">
                                <TextBlock Text="WATCH PARTY" FontSize="10" FontWeight="SemiBold"
                                           CharacterSpacing="280"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="CodeText" Text="—"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>

                            <Border Width="1" Margin="8,4"
                                    Background="{StaticResource BorderBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE716;" FontSize="14"
                                              Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="MemberCountText" Text="0"
                                               FontSize="13"
                                               Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                             Fill="#6b7280" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" Text="Disconnected"
                                               FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: host actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CopyInviteButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" FontSize="13"
                                    Click="CopyInviteButton_Click"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="12" />
                                    <TextBlock Text="Invite" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PolicyButton"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Padding="12,8" FontSize="13"
                                    Command="{x:Bind ViewModel.TogglePolicyCommand}"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" />
                                    <TextBlock x:Name="PolicyButtonText" Text="Allow Pause" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="EndButton" Content="End"
                                    Padding="12,8" FontSize="13"
                                    Command="{x:Bind ViewModel.CloseRoomCommand}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error / Closed reason -->
                <Border
                    Background="#2DEF6B73" CornerRadius="8" Padding="14,10"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13" />
                </Border>
                <Border
                    Background="#2DEF6B73" CornerRadius="8" Padding="14,10"
                    Visibility="{x:Bind ViewModel.ClosedReason, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock x:Name="ClosedReasonText"
                               Text="The room has ended."
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13" />
                </Border>

                <!-- Now Playing hero -->
                <Border x:Name="NowPlayingPanel" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="#34d399" VerticalAlignment="Center" />
                            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="280"
                                       Foreground="#34d399" />
                        </StackPanel>
                        <TextBlock x:Name="NowPlayingTitle" Text="—"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="NowPlayingSubtitle" Text=""
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Lobby waiting state (guest, no selection yet) -->
                <StackPanel x:Name="WaitingPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" Spacing="12" Padding="24,40">
                    <Border Width="64" Height="64" CornerRadius="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE716;" FontSize="24"
                                  Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="Waiting for the host" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingSubtitle"
                               Text="The host will choose a movie or episode for the room."
                               FontSize="13" MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Room info card (host info, lobby actions placeholder) -->
                <Border x:Name="HostPanel" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="You're the host" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Share the room code (top-left) with guests, or copy the invite link. Once the party is together, pick content from your library — synchronized playback will start on everyone's player. (Content selection inside the watch party is coming in a later pass of the desktop player.)"
                            FontSize="13" TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <!-- Suggestions (vote mode) -->
                <Border x:Name="SuggestionsPanel" Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Suggestions" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="SuggestionsSubtitle"
                                       Text="No suggestions yet."
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ItemsRepeater x:Name="SuggestionsRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="playback:WatchTogetherSuggestion">
                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,10">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Padding="10,6" FontSize="12"
                                                        Tag="{x:Bind Id}"
                                                        Click="SuggestionVoteButton_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="10" />
                                                        <TextBlock Text="{x:Bind VoteCount}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="Play" Padding="10,6" FontSize="12" Tag="{x:Bind}" Click="SuggestionPromote_Click" Loaded="SuggestionPromote_Loaded" />
                                                <Button Content="&#xE74D;" Padding="10,6" FontSize="12" Tag="{x:Bind}" Click="SuggestionDelete_Click" Loaded="SuggestionDelete_Loaded" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Host: pick content via search. Visible only when the current
                     user can manage the room (IsHost). -->
                <Border
                    x:Name="HostPickSection"
                    Style="{StaticResource CardStyle}"
                    Padding="16"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="PICK CONTENT"
                            FontSize="10"
                            FontWeight="SemiBold"
                            CharacterSpacing="120"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="HostSearchBox"
                                Grid.Column="0"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Search movies or shows..."
                                KeyDown="HostSearchBox_KeyDown" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Search"
                                Click="HostSearchBtn_Click" />
                        </Grid>
                        <!-- Search results as poster card grid -->
                        <ItemsRepeater x:Name="HostSearchResults">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="140" MinItemHeight="250"
                                                   MinColumnSpacing="12" MinRowSpacing="12"
                                                   ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <Button Tag="{x:Bind}" Click="HostSearchResult_Click" Padding="0" Background="Transparent" BorderThickness="0">
                                        <controls:PosterCard MediaItem="{x:Bind}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Series drill-down: season/episode selection (hidden by default) -->
                        <StackPanel x:Name="DrillDownPanel" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="DrillDownBackBtn" Click="DrillDownBack_Click"
                                    Background="Transparent" BorderThickness="0" Padding="4,4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="DrillDownBackText" Text="Back to results"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="DrillDownTitle" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <ItemsRepeater x:Name="DrillDownItems">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="140" MinItemHeight="250"
                                                       MinColumnSpacing="12" MinRowSpacing="12"
                                                       ItemsStretch="None" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaItem">
                                        <Button Tag="{x:Bind}" Click="DrillDownResult_Click" Padding="0" Background="Transparent" BorderThickness="0">
                                            <controls:PosterCard MediaItem="{x:Bind}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>

                        <!-- Candidate spotlight (confirmation before playing) -->
                        <Border x:Name="CandidateSpotlight" Visibility="Collapsed"
                                Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="16" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="CandidateTitle" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="CandidateMeta" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="CandidateOverview" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" MaxLines="3" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="CandidatePlayBtn" Style="{StaticResource AccentButtonStyle}"
                                            Padding="20,10" CornerRadius="20" Click="CandidatePlay_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Play Now" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Back to search" Style="{StaticResource OutlineButtonStyle}"
                                            Padding="16,10" Click="CandidateBack_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
