<?xml version="1.0" encoding="utf-8"?>
<Page loc:Localized.Direction="True"
    x:Class="SiloPlayer.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SiloPlayer.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    xmlns:catalog="using:SiloPlayer.Core.Models.Catalog"
    xmlns:requests="using:SiloPlayer.Core.Models.Requests"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <Grid x:Name="SearchRoot">
        <!-- Empty state: shown when no query entered (web: Catalog.tsx empty search state) -->
        <StackPanel
            x:Name="EmptyState"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="0"
            Padding="40">

            <!-- Search icon (web: Search h-10 w-10 strokeWidth=1.5) -->
            <FontIcon
                Glyph="&#xE721;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                Margin="0,0,0,24" />

            <!-- Current WebUI Catalog empty-query heading: page-title mb-4. -->
            <TextBlock
                x:Name="EmptySearchTitle"
                Text="Search"
                FontSize="60"
                FontWeight="ExtraBold"
                CharacterSpacing="-50"
                LineHeight="57"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"  loc:Localized.Text="web.search.label"/>

            <!-- Subtitle (web: page-subtitle mb-8 max-w-xl text-sm) -->
            <TextBlock
                Text="Find films, series, performances, and rediscover things you forgot you saved."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="576"
                Margin="0,0,0,32"  loc:Localized.Text="web.catalog.page.searchSubtitle"/>

            <!-- This host only reserves the input's layout slot. SearchSurface
                 remains a child of SearchRoot for the page's entire lifetime. -->
            <Grid x:Name="EmptySearchHost"
                  Width="576"
                  MaxWidth="576"
                  Height="56"
                  HorizontalAlignment="Center" />
            <StackPanel x:Name="EmptyScopeChips" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="EmptyVideoScope" Content="Media" Tag="video" Click="Scope_Click"  loc:Localized.Content="web.catalog.mediaType.media"/>
                <Button x:Name="EmptyAudiobookScope" Content="Audiobooks" Tag="audiobook" Click="Scope_Click"  loc:Localized.Content="web.catalog.mediaType.audiobooks"/>
                <Button x:Name="EmptyAllScope" Content="All" Tag="all" Click="Scope_Click"  loc:Localized.Content="web.catalog.mediaType.all"/>
            </StackPanel>
        </StackPanel>

        <!-- Results state: shown when query entered. Official SearchResults (#4450): a
             full-width page with the query as its heading, the scope chips and filters
             on one row, the result views, then the body. -->
        <Grid
            x:Name="ResultsState"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The search field reads as the page's heading; this names the page for assistive tech. -->
            <TextBlock x:Name="ResultsTitle" Grid.Row="0" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- Reserves the same persistent input's results-layout slot. -->
            <Grid
                x:Name="ResultsSearchHost"
                Grid.Row="0"
                Margin="40,24,40,16"
                Height="84"
                HorizontalAlignment="Stretch" />

            <!-- Current WebUI: SearchScopeChips and the filter toolbar share one wrapping row. -->
            <controls:WrapPanel x:Name="ResultsToolbar" Grid.Row="1"
                                Margin="40,0,40,16" HorizontalSpacing="12" VerticalSpacing="12"
                                HorizontalAlignment="Stretch">
                <!-- Current WebUI SearchScopeChips: one surface-panel radiogroup,
                     rounded-full with 4px padding/gaps and pill-shaped choices. -->
                <Border
                    Height="40"
                    Padding="4"
                    CornerRadius="20"
                    Background="{StaticResource SurfaceBrush}"
                    AutomationProperties.Name="Search scope" loc:Localized.Name="web.catalog.search.scopeLabel">
                    <StackPanel x:Name="ResultsScopePanel"
                                Orientation="Horizontal"
                                Spacing="4">
                        <Button x:Name="ResultsVideoScope"
                                Content="Media"
                                Tag="video"
                                Click="Scope_Click"
                                Height="32"
                                MinHeight="0"
                                CornerRadius="16"
                                Padding="16,0"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                AutomationProperties.Name="Search media"  loc:Localized.Content="web.catalog.mediaType.media"/>
                        <Button x:Name="ResultsAudiobookScope"
                                Content="Audiobooks"
                                Tag="audiobook"
                                Click="Scope_Click"
                                Height="32"
                                MinHeight="0"
                                CornerRadius="16"
                                Padding="16,0"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                AutomationProperties.Name="Search audiobooks"  loc:Localized.Content="web.catalog.mediaType.audiobooks"/>
                        <Button x:Name="ResultsAllScope"
                                Content="All"
                                Tag="all"
                                Click="Scope_Click"
                                Height="32"
                                MinHeight="0"
                                CornerRadius="16"
                                Padding="16,0"
                                BorderThickness="0"
                                FontSize="14"
                                FontWeight="Medium"
                                AutomationProperties.Name="Search all media"  loc:Localized.Content="web.catalog.mediaType.all"/>
                    </StackPanel>
                </Border>
                <ComboBox x:Name="ResultTypeCombo" Width="180" SelectionChanged="ResultFilter_Changed">
                    <ComboBoxItem Content="Movies &amp; Series" Tag="video" IsSelected="True"  loc:Localized.Content="web.catalog.mediaType.moviesAndSeries"/>
                    <ComboBoxItem Content="Movies" Tag="movie"  loc:Localized.Content="web.catalog.mediaType.movies"/>
                    <ComboBoxItem Content="Series" Tag="series"  loc:Localized.Content="web.search.typeSeries"/>
                    <ComboBoxItem Content="Episodes" Tag="episode"  loc:Localized.Content="web.catalog.mediaType.episodes"/>
                    <ComboBoxItem Content="Audiobooks" Tag="audiobook"  loc:Localized.Content="web.catalog.mediaType.audiobooks"/>
                    <ComboBoxItem Content="Ebooks" Tag="ebook"  loc:Localized.Content="web.catalog.mediaType.ebooks"/>
                    <ComboBoxItem Content="Manga" Tag="manga"  loc:Localized.Content="web.search.typeManga"/>
                    <ComboBoxItem Content="All Media" Tag="all"  loc:Localized.Content="web.catalog.mediaType.allMedia"/>
                </ComboBox>
                <ComboBox x:Name="ResultSortCombo" Width="180" SelectionChanged="ResultSort_Changed">
                    <ComboBoxItem Content="Relevance" Tag="relevance" IsSelected="True" loc:Localized.Content="web.catalog.sort.relevance" />
                    <ComboBoxItem Content="Date Added" Tag="added_at"  loc:Localized.Content="catalog.sort.added"/>
                    <ComboBoxItem Content="Title" Tag="title"  loc:Localized.Content="catalog.sort.title"/>
                    <ComboBoxItem Content="Release Date" Tag="release_date"  loc:Localized.Content="catalog.sort.released"/>
                    <ComboBoxItem Content="Latest Episode Air Date" Tag="last_air_date"  loc:Localized.Content="web.common.sort.latestEpisodeAirDate"/>
                    <ComboBoxItem Content="Latest Episode Added" Tag="latest_episode_added"  loc:Localized.Content="web.common.sort.latestEpisodeAdded"/>
                    <ComboBoxItem Content="Year" Tag="year"  loc:Localized.Content="catalog.sort.year"/>
                    <ComboBoxItem Content="Content Rating" Tag="content_rating"  loc:Localized.Content="web.common.sort.contentRating"/>
                    <ComboBoxItem Content="Duration" Tag="runtime"  loc:Localized.Content="web.common.sort.duration"/>
                    <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb"  loc:Localized.Content="catalog.sort.imdbRating"/>
                    <ComboBoxItem Content="TMDB Rating" Tag="rating_tmdb"  loc:Localized.Content="web.common.sort.tmdbRating"/>
                    <ComboBoxItem Content="RT Critic Rating" Tag="rating_rt_critic"  loc:Localized.Content="web.common.sort.rtCriticRating"/>
                    <ComboBoxItem Content="RT Audience Rating" Tag="rating_rt_audience"  loc:Localized.Content="web.common.sort.rtAudienceRating"/>
                    <ComboBoxItem Content="Resolution" Tag="resolution"  loc:Localized.Content="catalog.sort.resolution"/>
                    <ComboBoxItem Content="Bitrate" Tag="bitrate"  loc:Localized.Content="web.common.sort.bitrate"/>
                    <ComboBoxItem Content="Progress" Tag="progress"  loc:Localized.Content="web.common.sort.progress"/>
                    <ComboBoxItem Content="Date Viewed" Tag="date_viewed"  loc:Localized.Content="web.common.sort.dateViewed"/>
                    <ComboBoxItem Content="Plays" Tag="plays"  loc:Localized.Content="web.common.sort.plays"/>
                    <ComboBoxItem Content="Author" Tag="author"  loc:Localized.Content="catalog.sort.author"/>
                    <ComboBoxItem Content="Narrator" Tag="narrator"  loc:Localized.Content="catalog.sort.narrator"/>
                    <ComboBoxItem Content="Series" Tag="series"  loc:Localized.Content="web.search.typeSeries"/>
                </ComboBox>
                <ComboBox x:Name="ResultOrderCombo" Width="140" SelectionChanged="ResultFilter_Changed">
                    <ComboBoxItem Content="Descending" Tag="desc" IsSelected="True"  loc:Localized.Content="web.catalog.sort.descending"/>
                    <ComboBoxItem Content="Ascending" Tag="asc"  loc:Localized.Content="web.catalog.sort.ascending"/>
                </ComboBox>
                <Button x:Name="ResultFiltersButton"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="OpenResultFilters_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock Text="Filters"  loc:Localized.Text="web.catalog.filters.heading"/>
                        <Border x:Name="ResultFiltersButtonCountBadge"
                                Visibility="Collapsed"
                                Padding="6,0"
                                MinWidth="18"
                                Height="18"
                                CornerRadius="9"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock x:Name="ResultFiltersButtonCount"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </controls:WrapPanel>

            <!-- Current WebUI ActiveFilterBadges: active secondary filters
                 remain visible below the toolbar and can be removed directly. -->
            <controls:WrapPanel x:Name="ActiveResultFiltersPanel"
                                Grid.Row="2"
                                Margin="40,0,40,16"
                                HorizontalSpacing="8"
                                VerticalSpacing="8"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Active search filters" />

            <!-- Result views: Overview, In your library, and Request to add when there is something to request. -->
            <controls:WrapPanel x:Name="ResultViewsPanel" Grid.Row="3"
                                Margin="40,0,40,0" HorizontalSpacing="4" VerticalSpacing="4"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Result views" loc:Localized.Name="web.search.results.viewsLabel">
                <Button x:Name="ViewOverviewButton" Tag="overview" Click="ResultView_Click" MinHeight="0" CornerRadius="20" Padding="16,8" BorderThickness="0">
                    <TextBlock x:Name="ViewOverviewLabel" Text="Overview" FontSize="14" FontWeight="SemiBold" loc:Localized.Text="web.search.results.overview" />
                </Button>
                <Button x:Name="ViewLibraryButton" Tag="library" Click="ResultView_Click" MinHeight="0" CornerRadius="20" Padding="16,8" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ViewLibraryLabel" Text="In your library" FontSize="14" FontWeight="SemiBold" loc:Localized.Text="web.search.results.inLibrary" />
                        <TextBlock x:Name="ViewLibraryCount" FontSize="12" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ViewRequestsButton" Tag="requests" Click="ResultView_Click" MinHeight="0" CornerRadius="20" Padding="16,8" BorderThickness="0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="ViewRequestsLabel" Text="Request to add" FontSize="14" FontWeight="SemiBold" loc:Localized.Text="web.search.results.requestToAdd" />
                        <TextBlock x:Name="ViewRequestsCount" FontSize="12" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>
            </controls:WrapPanel>

            <!-- Results -->
            <ScrollViewer x:Name="ResultsScroll" Grid.Row="4" Padding="40,0,40,24"
                          ViewChanged="ResultsScroll_ViewChanged">
                <!-- A Grid preserves the ScrollViewer's effective viewport for the
                     virtualizing repeaters. A vertical StackPanel measures children
                     with infinite height and causes the entire result set to realize. -->
                <Grid x:Name="ResultsContent" Margin="0,32,0,0" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="BoxSetSearchSection" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,32" Spacing="12" AutomationProperties.Name="Box sets" loc:Localized.Name="web.search.boxSets">
                        <TextBlock x:Name="BoxSetSearchTitle" Text="Box sets" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-25" loc:Localized.Text="web.search.boxSets"/>
                        <ItemsRepeater x:Name="BoxSetSearchRepeater" ElementPrepared="BoxSetSearch_Prepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout x:Name="BoxSetSearchGridLayout" MinItemWidth="178" MinItemHeight="310" MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate><ContentControl /></DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Best matches (relevance) or In your library (another sort): the first two rows. -->
                    <StackPanel x:Name="FirstRowsSection" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,32" Spacing="12">
                        <Grid>
                            <TextBlock x:Name="FirstRowsTitle" Text="Best matches" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-25" VerticalAlignment="Bottom" Foreground="{StaticResource PrimaryTextBrush}" loc:Localized.Text="web.search.results.bestMatches" />
                            <Button x:Name="FirstShowAllButton" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" MinHeight="0" Click="ShowAllResults_Click" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="SortedByPanel" Orientation="Horizontal" Spacing="12" Margin="0,-8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="SortedByText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="BackToRelevanceButton" Style="{StaticResource GhostButtonStyle}" Padding="0" MinHeight="0" VerticalAlignment="Center" Click="BackToRelevance_Click">
                                <TextBlock x:Name="BackToRelevanceText" Text="Back to relevance" FontSize="14" TextDecorations="Underline" Foreground="{StaticResource SecondaryTextBrush}" loc:Localized.Text="web.search.results.backToRelevance" />
                            </Button>
                        </StackPanel>
                        <ItemsRepeater x:Name="BestRepeater" ElementPrepared="ResultsRepeater_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    x:Name="BestGridLayout"
                                    MinItemWidth="{StaticResource PosterCardWidth}"
                                    MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                    MinColumnSpacing="12"
                                    MinRowSpacing="16"
                                    ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <controls:PosterCard MediaItem="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Request to add, in its fixed spot: "Not in your library" between the library's rows... -->
                    <Border x:Name="RequestOverviewSection" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,32"
                            BorderThickness="1" CornerRadius="16" Padding="20,20,20,12">
                        <StackPanel Spacing="20">
                            <Grid>
                                <TextBlock x:Name="RequestOverviewTitle" Text="Not in your library" FontSize="20" FontWeight="SemiBold" CharacterSpacing="-25" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" loc:Localized.Text="web.search.results.notInLibrary" />
                                <Button x:Name="RequestOverviewExploreButton" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="0" MinHeight="0" Click="RequestOverviewExplore_Click">
                                    <TextBlock x:Name="RequestOverviewExploreText" Text="EXPLORE ALL" FontSize="12" FontWeight="SemiBold" CharacterSpacing="160" Foreground="{StaticResource SecondaryTextBrush}" loc:Localized.Text="web.catalog.carousel.exploreAll" loc:Localized.Uppercase="True" />
                                </Button>
                            </Grid>
                            <Grid x:Name="RequestOverviewRailHost" />
                        </StackPanel>
                    </Border>

                    <!-- ...or the paged request grid, which is the answer when the library has nothing. -->
                    <StackPanel x:Name="RequestResultsSection" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,32" Spacing="12" AutomationProperties.Name="Request to add" loc:Localized.Name="web.requests.toAdd.heading">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RequestResultsTitle" Text="Request to add" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" loc:Localized.Text="web.requests.toAdd.heading" />
                            <TextBlock x:Name="RequestNoLibraryMatchText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                        <ItemsRepeater x:Name="RequestResultsRepeater" ElementPrepared="ExternalRequestCard_Prepared">
                            <ItemsRepeater.Layout><UniformGridLayout x:Name="RequestGridLayout" MinItemWidth="170" MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="None" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate><DataTemplate><ContentControl HorizontalContentAlignment="Stretch" /></DataTemplate></ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock x:Name="RequestAllInLibraryText" Text="Every title on this page is already in your library." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" loc:Localized.Text="web.requests.toAdd.allInLibrary" />
                        <StackPanel x:Name="RequestErrorPanel" Orientation="Horizontal" Spacing="12" Padding="0,24" Visibility="Collapsed">
                            <TextBlock x:Name="RequestErrorText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="RequestRetryButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" Click="RequestRetry_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentControl x:Name="RequestRetryIcon" />
                                    <TextBlock Text="Retry" loc:Localized.Text="common.retry" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RequestFirstPageButton" Style="{StaticResource GhostButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" Click="RequestFirstPage_Click">
                                <TextBlock Text="Back to page 1" loc:Localized.Text="web.requests.toAdd.firstPage" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="RequestPagingPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0" Visibility="Collapsed"
                                    AutomationProperties.Name="Request to add pages" loc:Localized.Name="web.requests.toAdd.pages">
                            <Button x:Name="RequestPreviousButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" Content="Previous" Click="RequestPrevious_Click"  loc:Localized.Content="web.requests.results.previous"/>
                            <TextBlock x:Name="RequestPageText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <Button x:Name="RequestNextButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" Content="Next" Click="RequestNext_Click"  loc:Localized.Content="web.requests.results.next"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- People results section -->
                    <StackPanel x:Name="PeopleSection" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,32" Spacing="12" AutomationProperties.Name="People" loc:Localized.Name="web.catalog.page.people">
                        <TextBlock
                            x:Name="PeopleTitle"
                            Text="People"
                            FontSize="18"
                            FontWeight="SemiBold"
                            CharacterSpacing="-25"
                            Foreground="{StaticResource PrimaryTextBrush}"  loc:Localized.Text="web.catalog.page.people"/>
                        <StackPanel x:Name="PeopleErrorPanel" Visibility="Collapsed" Spacing="8">
                            <TextBlock x:Name="PeopleErrorText" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <Button x:Name="RetryPeopleButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" HorizontalAlignment="Left" Click="RetryPeople_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentControl x:Name="RetryPeopleIcon" />
                                    <TextBlock Text="Retry people search" loc:Localized.Text="web.catalog.page.retryPeople" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PeopleSearchingText" Text="Searching people..." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" loc:Localized.Text="web.catalog.page.searchingPeople" />
                        <ItemsRepeater x:Name="PeopleRepeater" ElementPrepared="PersonCard_Prepared">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate><ContentControl /></DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- More results (relevance): up to three more rows, then Show all results. -->
                    <StackPanel x:Name="MoreResultsSection" Grid.Row="4" Visibility="Collapsed" Margin="0,0,0,32" Spacing="12">
                        <Grid x:Name="MoreResultsHeader">
                            <TextBlock x:Name="MoreResultsTitle" Text="More results" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-25" VerticalAlignment="Bottom" Foreground="{StaticResource PrimaryTextBrush}" loc:Localized.Text="web.search.results.moreResults" />
                            <Button x:Name="MoreShowAllLink" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0" MinHeight="0" Click="ShowAllResults_Click" Visibility="Collapsed" />
                        </Grid>
                        <ItemsRepeater x:Name="MoreRepeater" ElementPrepared="ResultsRepeater_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    x:Name="MoreGridLayout"
                                    MinItemWidth="{StaticResource PosterCardWidth}"
                                    MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                    MinColumnSpacing="12"
                                    MinRowSpacing="16"
                                    ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <controls:PosterCard MediaItem="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <Button x:Name="ShowAllResultsButton" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Center" Margin="0,4,0,0" Height="36" MinHeight="0" CornerRadius="18" Padding="24,0" FontSize="14" Click="ShowAllResults_Click" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- In your library: every library result. -->
                    <StackPanel x:Name="LibraryViewSection" Grid.Row="6" Visibility="Collapsed" Margin="0,0,0,32" Spacing="16" AutomationProperties.Name="All results in your library" loc:Localized.Name="web.search.results.allInLibrary">
                        <TextBlock x:Name="LibraryViewTitle" Text="All results in your library" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-25" Foreground="{StaticResource PrimaryTextBrush}" loc:Localized.Text="web.search.results.allInLibrary" />
                        <ItemsRepeater x:Name="ResultsRepeater" ElementPrepared="ResultsRepeater_ElementPrepared">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    x:Name="ResultsGridLayout"
                                    MinItemWidth="{StaticResource PosterCardWidth}"
                                    MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                    MinColumnSpacing="12"
                                    MinRowSpacing="16"
                                    ItemsStretch="None" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:MediaItem">
                                    <controls:PosterCard MediaItem="{x:Bind}" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ProgressRing x:Name="SearchLoadMoreRing"
                                      IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                      HorizontalAlignment="Center" Width="24" Height="24" Margin="0,0" />
                    </StackPanel>

                    <!-- Skeleton while the library search loads -->
                    <ItemsRepeater x:Name="SearchLoadingRepeater" Grid.Row="7" Margin="0,0,0,32"
                                   ElementPrepared="SearchLoadingRepeater_ElementPrepared"
                                   Visibility="Collapsed">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="SearchLoadingGridLayout" MinItemWidth="178" MinItemHeight="310"
                                               MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="178" Spacing="9">
                                    <Border Width="178" Height="267" CornerRadius="8"
                                            Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                    <Border Width="132" Height="15" CornerRadius="5"
                                            Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Failed search: a card with a retry, in the spot of the first rows, ahead of the request results. -->
                    <Border x:Name="SearchErrorCard" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,32"
                            CornerRadius="16" BorderThickness="1" Padding="16,64"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            AutomationProperties.LiveSetting="Assertive">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="Could not load search results." FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" loc:Localized.Text="web.catalog.page.searchFailed" />
                            <TextBlock Text="The search request failed. Please retry." FontSize="14" MaxWidth="448" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" loc:Localized.Text="web.catalog.page.searchFailedBody" />
                            <Button x:Name="RetrySearchButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" Padding="12,0" FontSize="14" HorizontalAlignment="Center" Click="RetrySearch_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ContentControl x:Name="RetrySearchIcon" />
                                    <TextBlock Text="Retry search" loc:Localized.Text="web.catalog.page.retrySearch" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- No results -->
                    <TextBlock
                        Grid.Row="9"
                        x:Name="NoResultsText"
                        Text="No items found."
                        FontSize="16"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,48,0,48"
                        Visibility="Collapsed"  loc:Localized.Text="web.catalog.grid.noItems"/>
                </Grid>
            </ScrollViewer>

            <!-- WebUI parity: long result grids expose a floating scroll-to-top affordance. -->
            <Button x:Name="SearchScrollToTopButton"
                    Grid.RowSpan="5"
                    Canvas.ZIndex="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="SearchScrollToTop_Click"
                    ToolTipService.ToolTip="Back to top"
                    AutomationProperties.Name="Back to top">
                <!-- Geometry, not a font glyph: this button inherits the text font, which has no E74A,
                     and rendered half an arrow. PathIcon keeps the button's hover/pressed/disabled colours. -->
                <PathIcon Width="16" Height="16"
                          Data="M8,2 L13.6,7.6 L12.4,8.8 L8.9,5.3 L8.9,14 L7.1,14 L7.1,5.3 L3.6,8.8 L2.4,7.6 Z" />
            </Button>
        </Grid>

        <!-- A single persistent input. It is positioned over the visible host,
             never removed from or appended to a WinUI children collection. -->
        <Border
            x:Name="SearchSurface"
            Canvas.ZIndex="10"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="22"
            Width="576"
            MaxWidth="576"
            Height="56"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Grid>
                <FontIcon
                    x:Name="SearchSurfaceIcon"
                    Glyph="&#xE721;"
                    FontSize="20"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0" />
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search movies, series..."
                    TextChanged="SearchBox_TextChanged"
                    KeyDown="SearchBox_KeyDown"
                    Height="56"
                    MinHeight="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    FontSize="16"
                    Padding="48,16,12,16"
                    VerticalContentAlignment="Center"
                    TextWrapping="NoWrap"
                    AcceptsReturn="False"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="22"
                    Foreground="{StaticResource PrimaryTextBrush}"  loc:Localized.Placeholder="web.search.placeholderProminent"/>
            </Grid>
        </Border>

        <controls:SlideSheet x:Name="ResultFiltersSheet" Title="Filters" Canvas.ZIndex="40" TitleKey="web.catalog.filters.heading">
            <controls:SlideSheet.SheetContent>
                <Grid RowDefinitions="*,Auto" RowSpacing="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Padding="0,0,0,16">
                            <controls:QueryFilterEditor x:Name="SearchQueryFilters" />
                            <Button Visibility="Collapsed" x:Name="AdvancedSearchButton" Content="Advanced filters" HorizontalAlignment="Left" Click="AdvancedSearch_Click" />
                            <StackPanel x:Name="AdvancedSearchHost" Visibility="Collapsed" Spacing="12">
                                <controls:QueryRulesEditor x:Name="SearchRulesEditor" />
                                <Button Content="Apply filters" Click="ApplyAdvancedSearch_Click" />
                            </StackPanel>
                            <StackPanel Visibility="Collapsed" x:Name="GuidedSearchFilters" Spacing="12">
                            <TextBlock Text="Genre" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"  loc:Localized.Text="web.collections.builder.fieldGenre"/>
                            <ComboBox x:Name="ResultGenreCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Content Rating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"  loc:Localized.Text="web.common.sort.contentRating"/>
                            <ComboBox x:Name="ResultRatingCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Resolution" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"  loc:Localized.Text="catalog.sort.resolution"/>
                            <ComboBox x:Name="ResultResolutionCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Country" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"  loc:Localized.Text="web.collections.guidedRules.country"/>
                            <ComboBox x:Name="ResultCountryCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="0,16,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Content="Clear All" Height="32" MinHeight="32" FontSize="14" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Click="ClearResultFilters_Click"  loc:Localized.Content="web.catalog.filters.clearAll"/>
                            <Button Grid.Column="1" Content="Done" Height="32" MinHeight="32" FontSize="14" Style="{StaticResource AccentButtonStyle}" Click="CloseResultFilters_Click"  loc:Localized.Content="common.done"/>
                        </Grid>
                    </Border>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>
    </Grid>
</Page>
