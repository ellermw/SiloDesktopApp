<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    xmlns:catalog="using:SiloPlayer.Core.Models.Catalog"
    xmlns:requests="using:SiloPlayer.Core.Models.Requests"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <Grid>
        <!-- Empty state: shown when no query entered (web: Catalog.tsx empty search state) -->
        <StackPanel
            x:Name="EmptyState"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="0"
            Padding="40">

            <!-- Search icon (web: Search h-10 w-10 strokeWidth=1.5) -->
            <FontIcon
                Glyph="&#xE721;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                Margin="0,0,0,24" />

            <!-- Current WebUI Catalog empty-query heading: page-title mb-4. -->
            <TextBlock
                x:Name="EmptySearchTitle"
                Text="Search"
                FontSize="60"
                FontWeight="ExtraBold"
                CharacterSpacing="-50"
                LineHeight="57"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center"
                Margin="0,0,0,16" />

            <!-- Subtitle (web: page-subtitle mb-8 max-w-xl text-sm) -->
            <TextBlock
                Text="Find films, series, performances, and rediscover things you forgot you saved."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="576"
                Margin="0,0,0,32" />

            <!-- Prominent search bar (web: SearchBar prominent - surface-panel h-14 rounded-[1.4rem] pl-12) -->
            <Border
                x:Name="EmptySearchSurface"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="22"
                Width="576"
                MaxWidth="576"
                Height="56"
                HorizontalAlignment="Stretch">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="20"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="16"
                        Padding="48,0,12,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="22"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>
            </Border>
            <StackPanel x:Name="EmptyScopeChips" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="EmptyVideoScope" Content="Media" Tag="video" Click="Scope_Click" />
                <Button x:Name="EmptyAudiobookScope" Content="Audiobooks" Tag="audiobook" Click="Scope_Click" />
                <Button x:Name="EmptyAllScope" Content="All" Tag="all" Click="Scope_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Results state: shown when query entered -->
        <Grid
            x:Name="ResultsState"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with title + inline result count (web: page-header in CatalogResults) -->
            <StackPanel x:Name="ResultsHeader" Grid.Row="0" MaxWidth="1400" HorizontalAlignment="Stretch" Margin="40,24,40,24" Spacing="12">
                <TextBlock
                    x:Name="ResultsTitle"
                    FontSize="56"
                    FontWeight="ExtraBold"
                    CharacterSpacing="-50"
                    LineHeight="53"
                    Foreground="{StaticResource PrimaryTextBrush}" />

                <TextBlock Text="Refine the archive by type, era, rating, or genre."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />

                <!-- Inline result count (web style: "N results" next to header) -->
                <StackPanel x:Name="ResultCountPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        x:Name="ResultCountText"
                        FontSize="{StaticResource FontSizeTitle}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Search bar in results view (web: centered prominent SearchBar) -->
            <Border
                x:Name="ResultsSearchSurface"
                Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="22"
                Margin="40,0,40,12"
                Width="576"
                MaxWidth="576"
                Height="56"
                HorizontalAlignment="Center">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="20"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
                    <TextBox
                        x:Name="ResultsSearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="16"
                        Padding="48,0,12,0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="22"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                </Grid>
            </Border>

            <!-- Current WebUI SearchScopeChips: one surface-panel radiogroup,
                 rounded-full with 4px padding/gaps and pill-shaped choices. -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24"
                    Padding="4"
                    CornerRadius="999"
                    Background="{StaticResource SurfaceBrush}"
                    AutomationProperties.Name="Search scope">
                <StackPanel x:Name="ResultsScopePanel"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="ResultsVideoScope"
                            Content="Media"
                            Tag="video"
                            Click="Scope_Click"
                            CornerRadius="999"
                            Padding="16,6"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Medium"
                            AutomationProperties.Name="Search media" />
                    <Button x:Name="ResultsAudiobookScope"
                            Content="Audiobooks"
                            Tag="audiobook"
                            Click="Scope_Click"
                            CornerRadius="999"
                            Padding="16,6"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Medium"
                            AutomationProperties.Name="Search audiobooks" />
                    <Button x:Name="ResultsAllScope"
                            Content="All"
                            Tag="all"
                            Click="Scope_Click"
                            CornerRadius="999"
                            Padding="16,6"
                            BorderThickness="0"
                            FontSize="14"
                            FontWeight="Medium"
                            AutomationProperties.Name="Search all media" />
                </StackPanel>
            </Border>

            <controls:WrapPanel x:Name="ResultsToolbar" Grid.Row="3" MaxWidth="1400"
                                Margin="40,0,40,24" HorizontalSpacing="10" VerticalSpacing="10"
                                HorizontalAlignment="Stretch">
                <ComboBox x:Name="ResultTypeCombo" Width="180" SelectionChanged="ResultFilter_Changed">
                    <ComboBoxItem Content="Movies &amp; Series" Tag="video" IsSelected="True" />
                    <ComboBoxItem Content="Movies" Tag="movie" />
                    <ComboBoxItem Content="Series" Tag="series" />
                    <ComboBoxItem Content="Episodes" Tag="episode" />
                    <ComboBoxItem Content="Audiobooks" Tag="audiobook" />
                    <ComboBoxItem Content="Ebooks" Tag="ebook" />
                    <ComboBoxItem Content="Manga" Tag="manga" />
                    <ComboBoxItem Content="All Media" Tag="all" />
                </ComboBox>
                <ComboBox x:Name="ResultSortCombo" Width="180" SelectionChanged="ResultSort_Changed">
                    <ComboBoxItem Content="Date Added" Tag="added_at" IsSelected="True" />
                    <ComboBoxItem Content="Title" Tag="title" />
                    <ComboBoxItem Content="Release Date" Tag="release_date" />
                    <ComboBoxItem Content="Latest Episode Air Date" Tag="last_air_date" />
                    <ComboBoxItem Content="Latest Episode Added" Tag="latest_episode_added" />
                    <ComboBoxItem Content="Year" Tag="year" />
                    <ComboBoxItem Content="Content Rating" Tag="content_rating" />
                    <ComboBoxItem Content="Duration" Tag="runtime" />
                    <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb" />
                    <ComboBoxItem Content="TMDB Rating" Tag="rating_tmdb" />
                    <ComboBoxItem Content="RT Critic Rating" Tag="rating_rt_critic" />
                    <ComboBoxItem Content="RT Audience Rating" Tag="rating_rt_audience" />
                    <ComboBoxItem Content="Resolution" Tag="resolution" />
                    <ComboBoxItem Content="Bitrate" Tag="bitrate" />
                    <ComboBoxItem Content="Progress" Tag="progress" />
                    <ComboBoxItem Content="Date Viewed" Tag="date_viewed" />
                    <ComboBoxItem Content="Plays" Tag="plays" />
                    <ComboBoxItem Content="Author" Tag="author" />
                    <ComboBoxItem Content="Narrator" Tag="narrator" />
                    <ComboBoxItem Content="Series" Tag="series" />
                </ComboBox>
                <ComboBox x:Name="ResultOrderCombo" Width="140" SelectionChanged="ResultFilter_Changed">
                    <ComboBoxItem Content="Descending" Tag="desc" IsSelected="True" />
                    <ComboBoxItem Content="Ascending" Tag="asc" />
                </ComboBox>
                <Button x:Name="ResultFiltersButton"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="OpenResultFilters_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE71C;" FontSize="14" />
                        <TextBlock Text="Filters" />
                        <Border x:Name="ResultFiltersButtonCountBadge"
                                Visibility="Collapsed"
                                Padding="6,0"
                                MinWidth="18"
                                Height="18"
                                CornerRadius="9"
                                Background="{StaticResource AccentBrush}">
                            <TextBlock x:Name="ResultFiltersButtonCount"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>
            </controls:WrapPanel>

            <!-- Current WebUI ActiveFilterBadges: active secondary filters
                 remain visible below the toolbar and can be removed directly. -->
            <controls:WrapPanel x:Name="ActiveResultFiltersPanel"
                                Grid.Row="4"
                                MaxWidth="1400"
                                Margin="40,0,40,24"
                                HorizontalSpacing="8"
                                VerticalSpacing="8"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Active search filters" />

            <!-- Results grid -->
            <ScrollViewer x:Name="ResultsScroll" Grid.Row="5" Padding="40,0,40,24"
                          ViewChanged="ResultsScroll_ViewChanged">
                <StackPanel x:Name="ResultsContent" MaxWidth="1400" HorizontalAlignment="Center">

                    <!-- People results section -->
                    <StackPanel x:Name="PeopleSection" Visibility="Collapsed" Margin="0,0,0,24">
                        <TextBlock
                            Text="People"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Margin="0,0,0,12" />

                        <ItemsRepeater x:Name="PeopleRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="catalog:Person">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        CornerRadius="8"
                                        Click="PersonCard_Click"
                                        Tag="{x:Bind Id}">
                                        <StackPanel Width="100" Spacing="6">
                                            <!-- Photo circle / initials fallback -->
                                            <Border
                                                Width="80" Height="80"
                                                CornerRadius="40"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                HorizontalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="24"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <!-- Name -->
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <ItemsRepeater x:Name="ResultsRepeater" ElementPrepared="ResultsRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                x:Name="ResultsGridLayout"
                                MinItemWidth="{StaticResource PosterCardWidth}"
                                MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                MinColumnSpacing="12"
                                MinRowSpacing="16"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <controls:PosterCard MediaItem="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <ProgressRing x:Name="SearchLoadMoreRing"
                                  IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                  HorizontalAlignment="Center" Width="24" Height="24" Margin="0,16" />

                    <StackPanel x:Name="RequestResultsSection" Visibility="Collapsed" Margin="0,36,0,0" Spacing="12">
                        <TextBlock Text="Discover · Outside your library" FontSize="11" CharacterSpacing="140" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="Request to Add" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <ItemsRepeater x:Name="RequestResultsRepeater">
                                <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="170" MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="requests:RequestMediaResult">
                                        <Button Tag="{x:Bind}" Click="RequestResult_Click" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="6"><Border Height="240" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}"><Image Source="{x:Bind PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" /></Border><TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind YearText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                    </StackPanel>

                    <!-- Skeleton while search results load (inline rows) -->
                    <ItemsRepeater x:Name="SearchLoadingRepeater"
                                   ElementPrepared="SearchLoadingRepeater_ElementPrepared"
                                   Visibility="Collapsed">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout x:Name="SearchLoadingGridLayout" MinItemWidth="178" MinItemHeight="310"
                                               MinColumnSpacing="12" MinRowSpacing="16" ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="178" Spacing="9">
                                    <Border Width="178" Height="267" CornerRadius="8"
                                            Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                    <Border Width="132" Height="15" CornerRadius="5"
                                            Background="{StaticResource SurfaceBrush}" Opacity="0.62" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Error -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                        Foreground="{StaticResource ErrorBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8" />

                    <!-- No results -->
                    <TextBlock
                        x:Name="NoResultsText"
                        Text="No items found."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- WebUI parity: long result grids expose a floating scroll-to-top affordance. -->
            <Button x:Name="SearchScrollToTopButton"
                    Grid.RowSpan="6"
                    Canvas.ZIndex="20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="SearchScrollToTop_Click"
                    ToolTipService.ToolTip="Back to top"
                    AutomationProperties.Name="Back to top">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
        </Grid>

        <controls:SlideSheet x:Name="ResultFiltersSheet" Title="Filters">
            <controls:SlideSheet.SheetContent>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Filters" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Refine your catalog results" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Padding="0,4,8,12">
                            <TextBlock Text="Genre" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ResultGenreCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Content Rating" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ResultRatingCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Resolution" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ResultResolutionCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                            <TextBlock Text="Country" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ComboBox x:Name="ResultCountryCombo" HorizontalAlignment="Stretch" SelectionChanged="ResultFilter_Changed" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Button Content="Clear All" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Click="ClearResultFilters_Click" />
                        <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}" Click="CloseResultFilters_Click" />
                    </Grid>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>
    </Grid>
</Page>
