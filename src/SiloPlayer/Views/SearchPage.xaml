<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    xmlns:catalog="using:SiloPlayer.Core.Models.Catalog"
    xmlns:requests="using:SiloPlayer.Core.Models.Requests"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Empty state: shown when no query entered (web: Catalog.tsx empty search state) -->
        <StackPanel
            x:Name="EmptyState"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="16"
            Padding="40">

            <!-- Search icon (web: Search h-10 w-10 strokeWidth=1.5) -->
            <FontIcon
                Glyph="&#xE721;"
                FontSize="40"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Title (web: page-title mb-4) -->
            <TextBlock
                Text="Search"
                FontSize="{StaticResource FontSizeDisplayLarge}"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryTextBrush}"
                HorizontalAlignment="Center" />

            <!-- Subtitle (web: page-subtitle mb-8 max-w-xl text-sm) -->
            <TextBlock
                Text="Find films, series, performances, and rediscover things you forgot you saved."
                FontSize="14"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480" />

            <!-- Prominent search bar (web: SearchBar prominent - surface-panel h-14 rounded-[1.4rem] pl-12) -->
            <Border
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                MaxWidth="520"
                HorizontalAlignment="Stretch"
                Margin="0,8,0,0">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="18"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0" />
                    <TextBox
                        x:Name="SearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="15"
                        Padding="46,14,40,14"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="20"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <Button
                        x:Name="SearchBoxClearButton"
                        Click="ClearButton_Click"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        CornerRadius="12">
                        <FontIcon
                            Glyph="&#xE711;"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="EmptyVideoScope" Content="Movies &amp; Shows" Tag="video" Click="Scope_Click" />
                <Button x:Name="EmptyAudiobookScope" Content="Audiobooks" Tag="audiobook" Click="Scope_Click" />
                <Button x:Name="EmptyAllScope" Content="All" Tag="all" Click="Scope_Click" />
            </StackPanel>
        </StackPanel>

        <!-- Results state: shown when query entered -->
        <Grid
            x:Name="ResultsState"
            Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with title + inline result count (web: page-header in CatalogResults) -->
            <StackPanel Grid.Row="0" Margin="40,24,40,20" Spacing="6">
                <TextBlock
                    x:Name="ResultsTitle"
                    FontSize="{StaticResource FontSizeDisplayLarge}"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}" />

                <!-- Inline result count (web style: "N results" next to header) -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        x:Name="ResultCountText"
                        FontSize="{StaticResource FontSizeTitle}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Search bar in results view (web: centered prominent SearchBar) -->
            <Border
                Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="20"
                Margin="40,0,40,20"
                MaxWidth="600"
                HorizontalAlignment="Center">
                <Grid>
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="16"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0" />
                    <TextBox
                        x:Name="ResultsSearchBox"
                        PlaceholderText="Search movies, series..."
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown"
                        FontSize="14"
                        Padding="40,10,36,10"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="20"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <Button
                        x:Name="ResultsSearchBoxClearButton"
                        Click="ClearButton_Click"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        CornerRadius="12">
                        <FontIcon
                            Glyph="&#xE711;"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,16">
                <Button x:Name="ResultsVideoScope" Content="Movies &amp; Shows" Tag="video" Click="Scope_Click" />
                <Button x:Name="ResultsAudiobookScope" Content="Audiobooks" Tag="audiobook" Click="Scope_Click" />
                <Button x:Name="ResultsAllScope" Content="All" Tag="all" Click="Scope_Click" />
            </StackPanel>

            <!-- Results grid -->
            <ScrollViewer Grid.Row="3" Padding="40,0,40,24">
                <StackPanel>

                    <!-- People results section -->
                    <StackPanel x:Name="PeopleSection" Visibility="Collapsed" Margin="0,0,0,24">
                        <TextBlock
                            Text="People"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Margin="0,0,0,12" />

                        <ItemsRepeater x:Name="PeopleRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="catalog:Person">
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        CornerRadius="8"
                                        Click="PersonCard_Click"
                                        Tag="{x:Bind Id}">
                                        <StackPanel Width="100" Spacing="6">
                                            <!-- Photo circle / initials fallback -->
                                            <Border
                                                Width="80" Height="80"
                                                CornerRadius="40"
                                                Background="{StaticResource CardBackgroundBrush}"
                                                HorizontalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind Name}"
                                                    FontSize="24"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxLines="1"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <!-- Name -->
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryTextBrush}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                MaxLines="2"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <ItemsRepeater x:Name="ResultsRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="{StaticResource PosterCardWidth}"
                                MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                MinColumnSpacing="12"
                                MinRowSpacing="16"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <controls:PosterCard MediaItem="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <StackPanel x:Name="RequestResultsSection" Visibility="Collapsed" Margin="0,28,0,0" Spacing="12">
                        <TextBlock Text="Request to Add" FontSize="{StaticResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater x:Name="RequestResultsRepeater">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="12" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="requests:RequestMediaResult">
                                        <Button Tag="{x:Bind}" Click="RequestResult_Click" Padding="0" Background="Transparent" BorderThickness="0">
                                            <StackPanel Width="150" Spacing="6"><Border Width="150" Height="225" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}"><Image Source="{x:Bind PosterUrl}" Stretch="UniformToFill" /></Border><TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind YearText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Skeleton while search results load (inline rows) -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                            <controls:SkeletonPoster />
                        </StackPanel>
                    </StackPanel>

                    <!-- Error -->
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                        Foreground="{StaticResource ErrorBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8" />

                    <!-- No results -->
                    <TextBlock
                        x:Name="NoResultsText"
                        Text="No items found."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,40,0,0"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
