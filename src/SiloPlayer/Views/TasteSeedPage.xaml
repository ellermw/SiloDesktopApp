<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.TasteSeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Padding="28,18" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="18" MaxWidth="1152" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE735;" FontSize="22" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Pick what you love" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"
                            IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" Click="Done_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="1" ViewChanged="ItemsScrollViewer_ViewChanged">
            <StackPanel Padding="24" Spacing="20" MaxWidth="1152" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                <Border Padding="32" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="No items to show yet" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Once your library has matched content, you'll see popular titles here." Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Continue" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center" Click="Cancel_Click" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="147" MaximumRowsOrColumns="7" MinColumnSpacing="12" MinRowSpacing="12" ItemsJustification="Start" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TasteSeedItemViewModel">
                            <Button Tag="{x:Bind}" Click="Item_Click" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="12" HorizontalAlignment="Left">
                                <Grid Width="147" Height="221" CornerRadius="12" Background="{StaticResource SurfaceBrush}">
                                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="12" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    <Image Source="{x:Bind Item.PosterUrl}" Stretch="UniformToFill"/>
                                    <Border Background="#300078D4" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" CornerRadius="12" />
                                    <Border Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" CornerRadius="14" BorderThickness="1" BorderBrush="White" Background="#70000000">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="White" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                    <TextBlock Text="Loading more" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="That's everything popular on this server." HorizontalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                           Visibility="{x:Bind ViewModel.HasReachedEnd, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
