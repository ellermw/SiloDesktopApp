<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.TasteSeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels"
    Background="{StaticResource AppBackgroundBrush}">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="TasteHeaderBorder" Padding="24,16" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TasteHeaderGrid" ColumnSpacing="12" MaxWidth="1104" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <StackPanel x:Name="TasteTitleRow" Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE735;" FontSize="20" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="TasteTitleText" Text="Pick what you love" FontSize="24" FontWeight="Bold" LineHeight="32" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-25" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <StackPanel x:Name="TasteHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource GhostButtonStyle}" Padding="16,8" Height="36" FontSize="14" FontWeight="Medium" Click="Cancel_Click"
                            IsEnabled="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    <Button x:Name="DoneButton" Content="Done" Style="{StaticResource AccentButtonStyle}" Padding="16,8" Height="36" FontSize="14" FontWeight="Medium" IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" Click="Done_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="ItemsScrollViewer" Grid.Row="1" ViewChanged="ItemsScrollViewer_ViewChanged">
            <StackPanel x:Name="TasteBodyPanel" Padding="24,32" Spacing="20" MaxWidth="1152" HorizontalAlignment="Stretch">
                <ItemsRepeater x:Name="TasteSkeletonGrid" ElementPrepared="TasteCard_Prepared" ItemsSource="{x:Bind SkeletonItems}"
                               Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="147" MaximumRowsOrColumns="7"
                                           MinColumnSpacing="12" MinRowSpacing="12"
                                           ItemsJustification="SpaceBetween" MinItemHeight="221" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:SkeletonPoster Width="147" Height="221" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                <Border Padding="32" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="No items to show yet" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Once your library has matched content, you'll see popular titles here." Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Continue" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center" Click="Cancel_Click" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <ItemsRepeater x:Name="TasteItemsGrid" ElementPrepared="TasteCard_Prepared" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="147" MaximumRowsOrColumns="7" MinColumnSpacing="12" MinRowSpacing="12" ItemsJustification="SpaceBetween" MinItemHeight="221" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TasteSeedItemViewModel">
                            <Button Tag="{x:Bind}" Click="Item_Click" Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="12" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                <Grid Width="147" Height="221" CornerRadius="12" Background="Transparent">
                                    <controls:DefaultArtwork MediaType="{x:Bind Item.Type}" Thumbhash="{x:Bind Item.PosterThumbhash}" />
                                    <Image Source="{x:Bind Item.PosterUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill"
                                           Loaded="TastePoster_Loaded" ImageOpened="TastePoster_ImageOpened" ImageFailed="TastePoster_ImageFailed" />
                                    <Border Background="{StaticResource AccentBrush}" Opacity="0.2" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" CornerRadius="12" />
                                    <Border Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" CornerRadius="14" BorderThickness="1" BorderBrush="#99FFFFFF" Background="#66000000" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                    <Border Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}" Background="{StaticResource AccentBrush}" Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{StaticResource AccentForegroundBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                    <TextBlock Text="Loading more" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="That's everything popular on this server." HorizontalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                           Visibility="{x:Bind ViewModel.HasReachedEnd, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
