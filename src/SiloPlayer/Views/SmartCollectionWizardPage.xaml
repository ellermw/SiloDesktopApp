<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SmartCollectionWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48"
            Height="48" />

        <ScrollViewer x:Name="PreviewScroll" ViewChanged="PreviewScroll_ViewChanged"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">
            <StackPanel x:Name="WizardPageShell" Padding="48,24,48,48" Spacing="24">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="WizardTitle" Text="New Collection" FontSize="32" FontWeight="Bold" CharacterSpacing="-40" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="WizardSubtitle" Text="Tune the filters until the cards below show the collection you want." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border x:Name="FiltersStepBadge" CornerRadius="14" Padding="10,4" Background="{StaticResource AccentBackgroundBrush}"><TextBlock x:Name="FiltersStepText" Text="1  Filters" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" /></Border>
                        <Border Width="24" Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        <Border x:Name="DetailsStepBadge" CornerRadius="14" Padding="10,4" Background="{StaticResource SurfaceBrush}"><TextBlock x:Name="DetailsStepText" Text="2  Details" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                    </StackPanel>
                </StackPanel>



                <Border
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="16,12">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </Border>

                <Grid x:Name="WizardWorkspaceGrid" ColumnSpacing="18" RowSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="WizardPrimaryPanel" Grid.Column="0" Spacing="18">
                        <Border
                            x:Name="DetailsStepPanel"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                            <StackPanel Spacing="18">
                            <Button x:Name="TopBackToFiltersButton"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="BackToFilters_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                    <TextBlock Text="Back to Filters" />
                                </StackPanel>
                            </Button>
                            <Grid x:Name="DetailsGrid" ColumnSpacing="28" RowSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Name" FontSize="13" FontWeight="SemiBold" />
                                        <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                                 PlaceholderText="e.g. Saturday Night Movies"
                                                 Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel x:Name="DescriptionPanel" Spacing="6" Visibility="Collapsed">
                                        <TextBlock Text="Description" FontSize="13" FontWeight="SemiBold" />
                                        <TextBox Style="{StaticResource DarkTextBoxStyle}" PlaceholderText="Optional description"
                                                 Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" Height="84" />
                                    </StackPanel>
                                    <TextBlock Text="Sharing" FontSize="16" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Share with this account" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Shared collections appear for the selected profiles across the account."
                                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="SharedToggle" Grid.Column="1" VerticalAlignment="Center"
                                                          IsOn="{x:Bind ViewModel.IsShared, Mode=TwoWay}"
                                                          Toggled="SharedToggle_Toggled" OnContent="" OffContent="" />
                                        </Grid>
                                    </Border>
                                    <StackPanel x:Name="ProfileAccessSection" Spacing="8" Visibility="Collapsed">
                                        <TextBlock Text="Profiles" FontSize="13" FontWeight="SemiBold" />
                                        <StackPanel x:Name="ProfilesPanel" Spacing="4" />
                                    </StackPanel>
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="14">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Show in my library Collections tab" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="Pin this collection to your library's Collections tab alongside the admin shelves. Only you see it — personal collections are private to your user."
                                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ToggleSwitch x:Name="IncludeServerToggle" Grid.Column="1" VerticalAlignment="Center"
                                                          IsOn="{x:Bind ViewModel.IncludeInServerCollections, Mode=TwoWay}"
                                                          OnContent="" OffContent="" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="PosterDetailsPanel" Grid.Column="1" Spacing="10">
                                    <TextBlock Text="Poster" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="WizardPosterFrame" Height="128" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Visibility="Collapsed">
                                        <Grid>
                                            <Image x:Name="WizardPosterImage" Stretch="UniformToFill" Visibility="Collapsed" AutomationProperties.Name="Poster" />
                                            <Button x:Name="WizardRemoveSelectedPoster" AutomationProperties.Name="Remove selected file" Click="RemoveSelectedPoster_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="4" Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button x:Name="WizardDeletePoster" AutomationProperties.Name="Delete image" Click="DeletePoster_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="4" Style="{StaticResource DestructiveButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <Button x:Name="WizardPosterDropTarget" Style="{StaticResource OutlineButtonStyle}" BorderThickness="2" Padding="0"
                                            HorizontalAlignment="Stretch" Height="128" Click="ChoosePoster_Click" AllowDrop="True" DragOver="Poster_DragOver" Drop="Poster_Drop">
                                        <StackPanel x:Name="WizardPosterPlaceholder" Spacing="8" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE898;" FontSize="24" />
                                            <TextBlock Text="Click or drop image" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="PosterFileStatusText" Text="Upload a JPG, PNG, or WebP (max 20 MB)."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}" PlaceholderText="https://example.com/image.jpg"
                                             Text="{x:Bind ViewModel.PosterSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Paste an image URL instead of uploading a file. If both are provided, the uploaded file wins."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FiltersStepRulesPanel" Spacing="18">
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                <ComboBox x:Name="MediaScopeCombo" MinWidth="160" CornerRadius="8" SelectionChanged="MediaScopeCombo_SelectionChanged" />
                                <ComboBox x:Name="SortFieldCombo" MinWidth="160" CornerRadius="8" SelectionChanged="SortFieldCombo_SelectionChanged" />
                                <ComboBox x:Name="SortOrderCombo" MinWidth="140" CornerRadius="8" SelectionChanged="SortOrderCombo_SelectionChanged" />
                                <Button x:Name="FiltersButton" Style="{StaticResource OutlineButtonStyle}" Click="FiltersButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE71C;" FontSize="13" />
                                        <TextBlock Text="Filters" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="PreviewCountTextBlock" Text="Loading items…" FontSize="13"
                                           Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </controls:WrapPanel>

                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="14" Padding="18,14">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="3"><TextBlock Text="Max items" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Caps saved collection results. Use 1–500." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                    <TextBox Style="{StaticResource DarkTextBoxStyle}" PlaceholderText="No limit" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.LimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="LimitTextBox_TextChanged" />
                                </StackPanel>
                            </Border>

                            <ProgressRing x:Name="PreviewLoadingRing" Width="32" Height="32" HorizontalAlignment="Center"
                                          IsActive="{x:Bind ViewModel.IsPreviewing, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsPreviewing, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Retry preview" Click="Preview_Click" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" HorizontalAlignment="Center" />
                            <StackPanel x:Name="PreviewEmptyPanel" Visibility="Collapsed" Spacing="5" HorizontalAlignment="Center" Margin="0,42">
                                <TextBlock Text="No titles match these filters yet." FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Loosen the filters above to see what your collection would include."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                            <ItemsRepeater x:Name="PreviewItemsRepeater"
                                           ItemsSource="{x:Bind ViewModel.PreviewMediaItems, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="150"
                                                       MinItemHeight="260"
                                                       MinColumnSpacing="12"
                                                       MinRowSpacing="18"
                                                       ItemsStretch="Fill"
                                                       MaximumRowsOrColumns="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:MediaItem">
                                        <controls:PosterCard MediaItem="{x:Bind}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="FiltersStepPreviewPanel" Grid.Column="1" Visibility="Collapsed" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button x:Name="WizardDeleteButton" Content="Delete collection" Click="DeleteCollection_Click" Visibility="Collapsed" Style="{StaticResource DestructiveButtonStyle}" />
                    <Button
                        x:Name="CancelButton"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Cancel"
                        Click="BackButton_Click" />
                    <Button
                        x:Name="BackToFiltersButton"
                        Visibility="Collapsed"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Back"
                        Click="BackToFilters_Click" />
                    <Button
                        x:Name="SaveButton"
                        Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind CanSave, Mode=OneTime}"
                        Click="Save_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Width="14"
                                Height="14" />
                            <TextBlock x:Name="SaveButtonText" Text="Create Collection" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="FilterActionBar" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,28,24" Padding="14,10" CornerRadius="14"
                Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Canvas.ZIndex="30">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock x:Name="NextSummaryText" Text="Choose filters to preview matching titles"
                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                <Button x:Name="ContinueButton" Style="{StaticResource AccentButtonStyle}"
                        Content="Next: Details" Click="ContinueToDetails_Click" />
            </StackPanel>
        </Border>
        <Button x:Name="WizardBackButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,16,0,0" Width="34" Height="34" MinWidth="0" MinHeight="0" Padding="6" CornerRadius="17" Style="{StaticResource GhostButtonStyle}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Click="BackButton_Click" AutomationProperties.Name="Go back"><FontIcon Glyph="&#xE76B;" FontSize="20" /></Button>
        <controls:SlideSheet x:Name="WizardFiltersSheet" Title="Filters" Canvas.ZIndex="40">
            <controls:SlideSheet.SheetContent>
                <Grid RowDefinitions="*,Auto" RowSpacing="16">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FiltersAdvancedPanel" Spacing="16" Padding="0,0,0,16">
                            <StackPanel Spacing="8"><TextBlock Text="Media Type" FontSize="14" FontWeight="Medium" LineHeight="14" LineStackingStrategy="BlockLineHeight" /><ComboBox x:Name="SheetMediaScopeCombo" HorizontalAlignment="Left" MinWidth="0" SelectionChanged="SheetMediaScopeCombo_SelectionChanged" /></StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Libraries" FontSize="14" FontWeight="Medium" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
                                <Button x:Name="LibraryPickerButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource OutlineButtonStyle}" Height="36" MinHeight="0" Padding="12,0">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="LibraryPickerLabel" Text="All Libraries" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="12" VerticalAlignment="Center" /></Grid>
                                </Button>
                            </StackPanel>
                            <ComboBox x:Name="MatchModeCombo" Visibility="Collapsed" SelectionChanged="MatchModeCombo_SelectionChanged" />
                            <StackPanel x:Name="RulesPanel" Spacing="10" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Content="Clear All" Height="32" MinHeight="0" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Click="ClearWizardFilters_Click" />
                            <Button Grid.Column="1" Content="Done" Height="32" MinHeight="0" Style="{StaticResource AccentButtonStyle}" Click="DoneWizardFilters_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>
    </Grid>
</Page>
