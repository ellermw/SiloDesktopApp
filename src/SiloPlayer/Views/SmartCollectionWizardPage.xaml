<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SmartCollectionWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48"
            Height="48" />

        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">
            <StackPanel Padding="48,24,48,48" Spacing="24" MaxWidth="1080">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,8,14,0"
                        VerticalAlignment="Top"
                        Click="BackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back to Collections" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            x:Name="WizardTitle"
                            Text="New Collection"
                            FontSize="{StaticResource FontSizeDisplayLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            x:Name="WizardSubtitle"
                            Text="Tune the filters until the cards below show the collection you want."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="720" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <Border x:Name="FiltersStepBadge" CornerRadius="14" Padding="12,6" Background="{StaticResource AccentBackgroundBrush}">
                        <TextBlock Text="1  Filters" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                    <Border x:Name="DetailsStepBadge" CornerRadius="14" Padding="12,6" Background="{StaticResource SurfaceBrush}">
                        <TextBlock Text="2  Details" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                </StackPanel>

                <Border
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="16,12">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </Border>

                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="18">
                        <Border
                            x:Name="DetailsStepPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22,20">
                            <StackPanel Spacing="16">
                                <TextBlock
                                    Text="Details"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Title" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="A collection worth building"
                                        Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Description" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="Optional description"
                                        Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="84" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Media Scope" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="MediaScopeCombo" HorizontalAlignment="Stretch" CornerRadius="8" SelectionChanged="MediaScopeCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Limit" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            PlaceholderText="No limit"
                                            Text="{x:Bind ViewModel.LimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Sort" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="SortFieldCombo" HorizontalAlignment="Stretch" CornerRadius="8" SelectionChanged="SortFieldCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Order" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="SortOrderCombo" HorizontalAlignment="Stretch" CornerRadius="8" SelectionChanged="SortOrderCombo_SelectionChanged" />
                                    </StackPanel>
                                </Grid>

                                <ToggleSwitch
                                    x:Name="SharedToggle"
                                    IsOn="{x:Bind ViewModel.IsShared, Mode=TwoWay}"
                                    OnContent="Shared with all profiles"
                                    OffContent="Private to your profile" />
                                <ToggleSwitch
                                    x:Name="IncludeServerToggle"
                                    IsOn="{x:Bind ViewModel.IncludeInServerCollections, Mode=TwoWay}"
                                    OnContent="Include on server collection surfaces"
                                    OffContent="Hide from server collection surfaces" />
                                <ToggleSwitch
                                    x:Name="FeaturedToggle"
                                    IsOn="{x:Bind ViewModel.Featured, Mode=TwoWay}"
                                    OnContent="Featured in library"
                                    OffContent="Not featured" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Poster URL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="Optional poster image URL"
                                        Text="{x:Bind ViewModel.PosterSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="FiltersStepRulesPanel"
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22,20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Text="Rules"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="AddRule_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                                            <TextBlock Text="Add Rule" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ComboBox x:Name="MatchModeCombo" HorizontalAlignment="Left" MinWidth="180" CornerRadius="8" SelectionChanged="MatchModeCombo_SelectionChanged" />
                                <StackPanel x:Name="RulesPanel" Spacing="10" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="FiltersStepPreviewPanel" Grid.Column="1" Spacing="18">
                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22,20">
                            <StackPanel Spacing="14">
                                <TextBlock
                                    Text="Libraries"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Leave every library unchecked to match all visible libraries."
                                    FontSize="12"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="LibrariesPanel" Spacing="4" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="22,20">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Text="Preview"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock
                                            Text="{x:Bind PreviewCountText, Mode=OneWay}"
                                            FontSize="12"
                                            Foreground="{StaticResource TertiaryTextBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Click="Preview_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ProgressRing
                                                IsActive="{x:Bind ViewModel.IsPreviewing, Mode=OneWay}"
                                                Visibility="{x:Bind ViewModel.IsPreviewing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Width="14"
                                                Height="14" />
                                            <TextBlock Text="Preview" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="PreviewItemsPanel" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button
                        x:Name="CancelButton"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Cancel"
                        Click="BackButton_Click" />
                    <Button
                        x:Name="BackToFiltersButton"
                        Visibility="Collapsed"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Back to Filters"
                        Click="BackToFilters_Click" />
                    <Button
                        x:Name="ContinueButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Continue to Details"
                        Click="ContinueToDetails_Click" />
                    <Button
                        x:Name="SaveButton"
                        Visibility="Collapsed"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{x:Bind CanSave, Mode=OneWay}"
                        Click="Save_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Width="14"
                                Height="14" />
                            <TextBlock x:Name="SaveButtonText" Text="Create Collection" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
