<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:viewModels="using:SiloPlayer.ViewModels"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="800"
                Spacing="24"
                Margin="0,48,0,48">

                <!-- Header: Branding -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock
                        Text="Silo"
                        FontSize="30"
                        FontWeight="ExtraBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        CharacterSpacing="-40"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Server Setup"
                        Style="{StaticResource SecondaryTextStyle}"
                        FontSize="16"
                        HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Step indicator -->
                <StackPanel
                    x:Name="StepIndicator"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <!-- Step dots built in code-behind -->
                </StackPanel>

                <!-- Error message -->
                <Border
                    Background="#2DEF6B73"
                    CornerRadius="8"
                    Padding="12,10"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        TextWrapping="Wrap"
                        FontSize="13" />
                </Border>

                <!-- Step 1: Account -->
                <Border x:Name="Step1Panel" Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Create Admin Account"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Set up the first administrator account for your server."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13" />
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Username" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="Admin username" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Email" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="admin@example.com" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Password" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <PasswordBox
                                    x:Name="SetupPasswordBox"
                                    Style="{StaticResource DarkPasswordBoxStyle}"
                                    PlaceholderText="Create a strong password"
                                    PasswordChanged="SetupPasswordBox_PasswordChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Confirm password" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <PasswordBox
                                    x:Name="SetupConfirmPasswordBox"
                                    Style="{StaticResource DarkPasswordBoxStyle}"
                                    PlaceholderText="Re-enter your password"
                                    PasswordChanged="SetupConfirmPasswordBox_PasswordChanged" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 2: Profile -->
                <Border x:Name="Step2Panel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Create Your Profile"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Profiles let different people track their own watch progress."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Profile Name" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="e.g. Mike" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 3: Library -->
                <Border x:Name="Step3Panel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Libraries"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Add one or more libraries now, or skip and configure them later."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13" />
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="ADDED LIBRARIES" FontSize="11" FontWeight="SemiBold"
                                           CharacterSpacing="100"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AddedLibraries, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="20">
                            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.LibraryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="e.g. Movies" />
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Type" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <ItemsControl x:Name="LibraryTypeChoices">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid MaximumRowsOrColumns="4" ItemWidth="170" ItemHeight="52"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ToggleButton Content="Movies" Tag="movies" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Series" Tag="series" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Mixed" Tag="mixed" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Audiobooks" Tag="audiobooks" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Ebooks" Tag="ebooks" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Manga" Tag="manga" Margin="3" Click="LibraryType_Click"/>
                                    <ToggleButton Content="Podcasts" Tag="podcasts" Margin="3" Click="LibraryType_Click"/>
                                </ItemsControl>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Enabled" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Disabled libraries are hidden from browsing and skipped by scans."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LibraryEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="FOLDERS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100"
                                           Foreground="{StaticResource PrimaryTextBrush}" />

                                <!-- Path list -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryPaths, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind}" FontSize="13"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="4" Click="RemovePath_Click" Tag="{x:Bind}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="12"
                                                              Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add path -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Text="{x:Bind ViewModel.NewLibraryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="/mnt/media/movies" />
                                    <Button Grid.Column="1" Content="Add Path" Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{x:Bind ViewModel.AddLibraryPathCommand}" />
                                    <Button Grid.Column="2" Content="Browse" Margin="8,0,0,0"
                                            Style="{StaticResource OutlineButtonStyle}" Click="BrowseLibraryFolders_Click" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="METADATA" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Metadata Language" FontSize="13" FontWeight="SemiBold"/>
                                <ComboBox x:Name="LibraryMetadataLanguageCombo" Width="260" HorizontalAlignment="Left"
                                          SelectionChanged="LibraryMetadataLanguage_Changed"/>
                                <TextBlock Text="Preferred language for titles, summaries, and artwork fetched from providers."
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Auto-translate descriptions" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Use AI when providers have no translation for this library's language."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LibraryAutoTranslateMetadata, Mode=TwoWay}" OnContent="" OffContent=""/>
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Trailer &amp; extras types" FontSize="13" FontWeight="SemiBold"/>
                                <Grid ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <CheckBox Content="Trailers" IsChecked="{x:Bind ViewModel.LibraryTrailer, Mode=TwoWay}"/>
                                    <CheckBox Grid.Column="1" Content="Teasers" IsChecked="{x:Bind ViewModel.LibraryTeaser, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="1" Content="Featurettes" IsChecked="{x:Bind ViewModel.LibraryFeaturette, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Clips" IsChecked="{x:Bind ViewModel.LibraryClip, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="2" Content="Behind the Scenes" IsChecked="{x:Bind ViewModel.LibraryBehindTheScenes, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Bloopers" IsChecked="{x:Bind ViewModel.LibraryBloopers, Mode=TwoWay}"/>
                                    <CheckBox Grid.Row="3" Content="Other" IsChecked="{x:Bind ViewModel.LibraryOtherExtras, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Provider Priority" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Providers are asked in order from top to bottom. Uncheck one to skip it for that level."
                                           FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                <ProgressRing IsActive="{x:Bind ViewModel.LibraryProvidersLoading, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.LibraryProvidersLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                              Width="22" Height="22" HorizontalAlignment="Left"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.LibraryProviderLevels, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:SetupLibraryProviderLevel">
                                            <StackPanel Spacing="5" Margin="0,4,0,8">
                                                <TextBlock Text="{x:Bind Label}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:SetupLibraryProviderEntry">
                                                            <Grid ColumnSpacing="6" Padding="8,4">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <CheckBox IsChecked="{x:Bind Enabled, Mode=TwoWay}"/>
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ProviderSlug}" FontFamily="Cascadia Mono" FontSize="11" VerticalAlignment="Center"/>
                                                                <Button Grid.Column="2" Content="↑" Tag="{x:Bind}" Click="MoveLibraryProviderUp_Click" Padding="7,2"/>
                                                                <Button Grid.Column="3" Content="↓" Tag="{x:Bind}" Click="MoveLibraryProviderDown_Click" Padding="7,2"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock Text="ADVANCED" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Generate chapter thumbnails" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Stores chapter preview images in the configured public asset S3 bucket."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LibraryChapterThumbnailsEnabled, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.LibraryChapterThumbnailsSupported, Mode=OneWay}" OnContent="" OffContent=""/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Detect intro markers" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Runs background audio analysis for episodes in this library."
                                               FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.LibraryIntroDetectionEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                            </Grid>

                            <Button Content="Add library" HorizontalAlignment="Stretch"
                                    Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddLibraryCommand}"/>
                            <Button Content="Skip" HorizontalAlignment="Left"
                                    Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.SkipLibraryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 4: Server Settings -->
                <Border x:Name="Step4Panel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Server Configuration"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Configure core server settings. These can all be changed later."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13" />
                        </StackPanel>

                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Redis URL" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.RedisUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="redis://localhost:6379" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="FFmpeg Path" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="/usr/bin/ffmpeg" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Transcode Directory" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.TranscodeDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="/tmp/transcode" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Hardware Acceleration" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <!-- B48: Auto is default; ordering matches WebUI. -->
                                <ComboBox x:Name="HardwareAccelComboBox" Width="200"
                                          SelectionChanged="HardwareAccelComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto (recommended)" Tag="auto" IsSelected="True" />
                                    <ComboBoxItem Content="VAAPI" Tag="vaapi" />
                                    <ComboBoxItem Content="NVENC" Tag="nvenc" />
                                    <ComboBoxItem Content="QSV" Tag="qsv" />
                                    <ComboBoxItem Content="None" Tag="none" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleSwitch
                                    IsOn="{x:Bind ViewModel.TranscodingEnabled, Mode=TwoWay}"
                                    OnContent="" OffContent="" />
                                <TextBlock Text="Enable transcoding" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleSwitch IsOn="{x:Bind ViewModel.JellyfinEnabled, Mode=TwoWay}" OnContent="" OffContent="" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Enable Jellyfin compatibility" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock Text="For VidHub, Findroid, Infuse, and other Jellyfin clients." FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Jellyfin Compatibility URL" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.JellyfinUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="https://jf.example.com (optional)" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Jellyfin Web Version" FontSize="12"/>
                                    <TextBox Text="{x:Bind ViewModel.JellyfinWebVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="latest"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Jellyfin Web Install Directory" FontSize="12"/>
                                    <TextBox Text="{x:Bind ViewModel.JellyfinWebInstallDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="/var/lib/silo/compat/jellyfin-web"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Jellyfin Server Name" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBox
                                    Text="{x:Bind ViewModel.JellyfinName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="My Silo (optional)" />
                            </StackPanel>

                            <!-- Optional: S3 Storage. Collapsed by default so the
                                 wizard stays light for users who don't need S3. -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <ToggleSwitch
                                    IsOn="{x:Bind ViewModel.ConfigureStorage, Mode=TwoWay}"
                                    OnContent="" OffContent="" />
                                <TextBlock Text="Configure S3 storage now (optional)" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="StoragePanel" Spacing="16"
                                        Visibility="{x:Bind ViewModel.ConfigureStorage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Text="Public Assets Storage (S3)"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    CharacterSpacing="120" />
                                <TextBlock
                                    Text="Stores client-facing assets: artwork, chapter thumbnails, subtitle files."
                                    FontSize="11" Opacity="0.75"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Endpoint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox
                                            Text="{x:Bind ViewModel.S3PublicEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            PlaceholderText="https://s3.amazonaws.com" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Bucket" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox
                                            Text="{x:Bind ViewModel.S3PublicBucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Key Prefix (optional)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Text="{x:Bind ViewModel.S3PublicKeyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="silo/prod" />
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Access Key" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <PasswordBox
                                            Password="{x:Bind ViewModel.S3PublicAccessKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Secret Key" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <PasswordBox
                                            Password="{x:Bind ViewModel.S3PublicSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="URL Auth Method" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="PublicUrlAuthComboBox" Width="260"
                                              SelectionChanged="PublicUrlAuthComboBox_SelectionChanged">
                                        <ComboBoxItem Content="S3 Presigned URLs (Recommended)" Tag="presigned" IsSelected="True" />
                                        <ComboBoxItem Content="Public (no auth)" Tag="public" />
                                        <ComboBoxItem Content="Cloudflare Token Auth" Tag="cloudflare_token" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.IsPublicReadEndpointVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Read Endpoint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Text="{x:Bind ViewModel.S3PublicReadEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="https://cdn.example.com" />
                                </StackPanel>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.35" />

                                <TextBlock
                                    Text="Private Internal Storage (S3)"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    CharacterSpacing="120" />
                                <TextBlock
                                    Text="Non-public objects: imports, exports, internal artifacts."
                                    FontSize="11" Opacity="0.75"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Endpoint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox
                                            Text="{x:Bind ViewModel.S3PrivateEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkTextBoxStyle}"
                                            PlaceholderText="https://s3.amazonaws.com" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Bucket" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox
                                            Text="{x:Bind ViewModel.S3PrivateBucket, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DarkTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Key Prefix (optional)" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox
                                        Text="{x:Bind ViewModel.S3PrivateKeyPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        PlaceholderText="silo/internal" />
                                </StackPanel>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Access Key" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <PasswordBox
                                            Password="{x:Bind ViewModel.S3PrivateAccessKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Secret Key" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <PasswordBox
                                            Password="{x:Bind ViewModel.S3PrivateSecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.35" />

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleSwitch
                                        IsOn="{x:Bind ViewModel.CacheImages, Mode=TwoWay}"
                                        OnContent="" OffContent="" />
                                    <StackPanel>
                                        <TextBlock Text="Cache artwork in public storage" FontSize="13"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Instead of proxying external URLs."
                                                   FontSize="11" Opacity="0.7"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Current WebUI step 4: Integrations -->
                <Border x:Name="Step5IntegrationsPanel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Integrations" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Configure subtitle providers for automatic subtitle downloading."
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SubtitleProviders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:SetupSubtitleProviderItem">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#4ADE80"
                                                                  Visibility="{x:Bind HasCredential, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                                            </Grid>
                                            <StackPanel Spacing="8" Visibility="{x:Bind Enabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                                <Grid ColumnSpacing="8" Visibility="{x:Bind IsOpenSubtitles, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{x:Bind Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Username"/>
                                                    <PasswordBox Grid.Column="1" PlaceholderText="Password" PasswordChanged="ProviderPassword_Changed" Tag="{x:Bind}"/>
                                                </Grid>
                                                <TextBox Text="{x:Bind ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="API key"
                                                         Visibility="{x:Bind UsesApiKey, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="Test connection" Tag="{x:Bind}" Click="TestProvider_Click"/>
                                                    <Button Content="Save" Tag="{x:Bind}" Click="SaveProvider_Click"/>
                                                    <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" VerticalAlignment="Center" FontSize="12"
                                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Step 6: Downloads -->
                <Border x:Name="Step6DownloadsPanel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Downloads" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Allow users to download media files for offline viewing."
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Enable Downloads" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="When enabled, users can download media to their devices."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DownloadsEnabledToggle" Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.DownloadsEnabled, Mode=TwoWay}"
                                          OnContent="" OffContent="" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.DownloadsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Total download bandwidth (Mbps)" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.DownloadServerBandwidthMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Shared across all users. 0 = unlimited." FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Per-user bandwidth (Mbps)" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.DownloadUserBandwidthMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="0 = unlimited" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="5" Visibility="{x:Bind ViewModel.DownloadsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Max concurrent per user" FontSize="12"/>
                            <TextBox Width="120" HorizontalAlignment="Left" Text="{x:Bind ViewModel.DownloadMaxConcurrentPerUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="0 = unlimited" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Step 7: Recommendations -->
                <Border x:Name="Step7RecommendationsPanel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Recommendations" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Configure the AI-powered recommendation engine. Requires pgvector and an embedding endpoint."
                                       Style="{StaticResource SecondaryTextStyle}" FontSize="13" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Enable recommendations" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.RecommendationsEnabled, Mode=TwoWay}" OnContent="" OffContent=""/>
                        </Grid>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.RecommendationsEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Base URL" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.RecommendationsBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://generativelanguage.googleapis.com"/>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Model" FontSize="12"/>
                                <TextBox Text="{x:Bind ViewModel.RecommendationsModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="gemini-embedding-001"/>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="API Key" FontSize="12"/>
                                <PasswordBox PasswordChanged="RecommendationToken_Changed" PlaceholderText="Leave blank to keep configured value"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Current WebUI step 8: Nodes and finish -->
                <Border x:Name="Step5Panel" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Nodes &amp; finish"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Optionally add a worker node, then start using Silo."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.AddedNodes, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,3">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#4ADE80"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Type}" Foreground="{StaticResource TertiaryTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add a worker node" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ToggleNodeFormCommand}"/>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowNodeForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.NodeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="proxy-us-east"/>
                                <ComboBox x:Name="NodeTypeComboBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="NodeType_Changed">
                                    <ComboBoxItem Content="Proxy" Tag="proxy"/><ComboBoxItem Content="Transcode" Tag="transcode"/>
                                </ComboBox>
                                <TextBox Grid.Column="2" Text="{x:Bind ViewModel.NodeUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://proxy.example.com"/>
                            </Grid>
                            <Button Content="Add node" HorizontalAlignment="Left" Command="{x:Bind ViewModel.AddNodeCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Loading indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    Width="28" Height="28" />

                <!-- Navigation buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BackButton"
                        Content="Back"
                        Style="{StaticResource OutlineButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="24,12"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="NextButton"
                        Content="Next"
                        Style="{StaticResource AccentButtonStyle}"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Padding="24,12"
                        Command="{x:Bind ViewModel.NextCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" />

                    <Button
                        x:Name="FinishButton"
                        Content="Start using Silo"
                        Style="{StaticResource AccentButtonStyle}"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Padding="24,12"
                        Command="{x:Bind ViewModel.FinishCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="GoToAdminButton"
                        Content="Go to admin"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        Margin="0,0,12,0"
                        Padding="24,12"
                        Command="{x:Bind ViewModel.GoToAdminCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
