<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    SizeChanged="Page_SizeChanged"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Pill tab button style (web: rounded-xl px-4 py-2.5 text-[13px] font-semibold) -->
        <Style x:Key="PillTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,8,16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Active pill tab (web: bg-accent text-primary) -->
        <Style x:Key="PillTabButtonActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,8,16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Pill filter ComboBox style (web: h-9 rounded-full text-[13px]) -->
        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6,8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Order toggle button (web: h-9 w-9 rounded-full border) -->
        <Style x:Key="OrderToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Year filter input style -->
        <Style x:Key="YearInputStyle" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Item count panel style (web: surface-panel-subtle rounded-[1.35rem] px-5 py-4) -->
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: overlays hero in Recommended tab (webui: LibraryHeader with overlay prop) -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Height="70" Margin="48,0" Canvas.ZIndex="10"
              Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and tabs row (web: page-header gap-5) -->
            <Grid x:Name="HeaderContentGrid" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Eyebrow breadcrumb (webui: hero-eyebrow "Library / {name}") -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <StackPanel x:Name="LibraryEyebrow" Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="LibraryEyebrowPrefix" Text="LIBRARY" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="200"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryEyebrowDivider" Text="/" FontSize="11"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryEyebrowName" FontSize="11" FontWeight="Bold"
                                   CharacterSpacing="200"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LibraryTitle"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Visibility="Collapsed" />
                    <TextBlock
                        Text="Move between recommendations, the full archive, and curated collections."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Pill tab bar (web: surface-panel-subtle rounded-[1.2rem] gap-1 p-1) -->
                <Border
                    x:Name="TabBarBorder"
                    Grid.Column="1"
                    CornerRadius="22"
                    SizeChanged="TabBarBorder_SizeChanged"
                    Padding="4"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2.4">
                        <Button
                            x:Name="RecommendedTab"
                            Content="Recommended"
                            Style="{StaticResource PillTabButtonActiveStyle}"
                            Click="Tab_Click"
                            Tag="Recommended" />
                        <Button
                            x:Name="LibraryTab"
                            Content="Library"
                            Style="{StaticResource PillTabButtonStyle}"
                            Click="Tab_Click"
                            Tag="Library" />
                        <Button
                            x:Name="CollectionsTab"
                            Content="Collections"
                            Style="{StaticResource PillTabButtonStyle}"
                            Click="Tab_Click"
                            Tag="Collections" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="HeaderDivider" Grid.RowSpan="2" Height="1"
                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="{StaticResource BorderBrush}" Opacity="0.55" />
        </Grid>

        <!-- Current WebUI toolbar: sort, order, Filters. Secondary facets live in the right sheet. -->
        <Grid
            x:Name="FilterBar"
            Grid.Row="1"
            Margin="48,8,48,16"
            Canvas.ZIndex="10"
            Background="{StaticResource AppBackgroundBrush}"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <StackPanel x:Name="AudiobookAxisPanel" Grid.Row="0" Grid.ColumnSpan="5"
                        Orientation="Horizontal" Spacing="4" Margin="0,0,0,12"
                        Visibility="Collapsed">
                <Button x:Name="AudiobookBooksButton" Content="Books" Tag="books"
                        Style="{StaticResource PillTabButtonActiveStyle}" Click="AudiobookAxis_Click" />
                <Button x:Name="AudiobookSeriesButton" Content="Series" Tag="series"
                        Style="{StaticResource PillTabButtonStyle}" Click="AudiobookAxis_Click" />
                <Button x:Name="AudiobookAuthorsButton" Content="Authors" Tag="author"
                        Style="{StaticResource PillTabButtonStyle}" Click="AudiobookAxis_Click" />
                <Button x:Name="AudiobookNarratorsButton" Content="Narrators" Tag="narrator"
                        Style="{StaticResource PillTabButtonStyle}" Click="AudiobookAxis_Click" />
            </StackPanel>

            <StackPanel x:Name="BrowseTypePanel" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                        Spacing="10" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Type" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="BrowseTypeComboBox" Style="{StaticResource PillComboBoxStyle}"
                          Width="180" SelectionChanged="BrowseTypeComboBox_SelectionChanged" />
            </StackPanel>

            <ComboBox
                x:Name="SortComboBox"
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource PillComboBoxStyle}"
                MinWidth="100"
                SelectionChanged="SortComboBox_SelectionChanged" />

            <ComboBox
                x:Name="OrderComboBox"
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource PillComboBoxStyle}"
                MinWidth="128"
                SelectionChanged="OrderComboBox_SelectionChanged">
                <ComboBoxItem Content="Descending" Tag="desc" />
                <ComboBoxItem Content="Ascending" Tag="asc" IsSelected="True" />
            </ComboBox>

            <Button
                x:Name="OpenFiltersButton"
                Grid.Row="1"
                Grid.Column="3"
                Style="{StaticResource OutlineButtonStyle}"
                Height="36"
                MinWidth="0"
                Padding="12,0"
                Click="OpenFilters_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71C;" FontSize="14" />
                    <TextBlock Text="Filters" FontSize="13" />
                    <Border x:Name="FilterCountBadge"
                            MinWidth="18" Height="18" Padding="5,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="9" Visibility="Collapsed">
                        <TextBlock x:Name="FilterCountText" FontSize="10" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Button>

            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
            <TextBlock
                x:Name="ResultCountText"
                Grid.Row="1"
                Grid.Column="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{StaticResource SecondaryTextBrush}"
                Visibility="Collapsed" />
            <Button Style="{StaticResource OutlineButtonStyle}" Height="36" MinWidth="36" Padding="8"
                    AutomationProperties.Name="Poster size" ToolTipService.ToolTip="Poster size">
                <FontIcon Glyph="&#xE8A9;" FontSize="16" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="220" Spacing="8">
                            <TextBlock Text="Poster size" FontWeight="SemiBold" />
                            <Slider x:Name="PosterSizeSlider" Minimum="100" Maximum="300" StepFrequency="10"
                                    Value="180" AutomationProperties.Name="Poster size, smaller to larger"
                                    ValueChanged="PosterSizeSlider_ValueChanged" />
                            <Button Content="Use theme default" Click="ResetPosterSize_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Active filter badges -->
        <controls:WrapPanel
            x:Name="ActiveFiltersBar"
            Grid.Row="2"
            HorizontalSpacing="6"
            VerticalSpacing="6"
            Margin="48,0,48,12"
            Visibility="Collapsed">
            <controls:WrapPanel x:Name="FilterBadgesPanel" HorizontalSpacing="6" VerticalSpacing="6" />
            <Button
                x:Name="ClearAllFiltersButton"
                Style="{StaticResource GhostButtonStyle}"
                Content="Clear All"
                FontSize="12"
                Foreground="{StaticResource AccentBrush}"
                Padding="8,4"
                Click="ClearAllFilters_Click"
                Visibility="Collapsed" />
        </controls:WrapPanel>

        <!-- Pixel scrolling with a bounded set of cards for 100k-scale libraries. -->
        <Grid x:Name="LibraryContentArea" Grid.Row="3" Visibility="Collapsed">
            <ScrollViewer x:Name="LibrarySkeletonScroll" Padding="48,0,48,24"
                          VerticalScrollBarVisibility="Disabled" Visibility="Collapsed"
                          Canvas.ZIndex="20" Background="{StaticResource AppBackgroundBrush}">
                <controls:WrapPanel x:Name="LibrarySkeletonHost"
                                    HorizontalSpacing="12" VerticalSpacing="16" />
            </ScrollViewer>
            <Border
                x:Name="LibraryViewportHost"
                Padding="48,0,48,24"
                Background="Transparent"
                SizeChanged="LibraryViewport_SizeChanged">
                <ScrollViewer x:Name="LibraryScroller"
                              Background="Transparent"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              ZoomMode="Disabled"
                              IsScrollInertiaEnabled="True"
                              ViewChanged="LibraryScroller_ViewChanged"
                              SizeChanged="LibraryScroller_SizeChanged">
                    <Canvas
                        x:Name="VirtualGridCanvas"
                        Background="Transparent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />
                </ScrollViewer>
            </Border>

            <!-- Loading indicator overlaid at bottom of viewport -->
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Width="32" Height="32" />

            <TextBlock x:Name="LibraryEmptyText" Text="No items found."
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,48,0,0" FontSize="14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="Collapsed" />

            <!-- Scroll-to-top button (webui: floating bottom-right) -->
            <Button x:Name="ScrollToTopButton"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Width="40" Height="40"
                    CornerRadius="20"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="ScrollToTop_Click">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <!-- Error message overlaid at bottom of viewport -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8" />
        </Grid>

        <ScrollViewer
            x:Name="AudiobookGroupsPanel"
            Grid.Row="3"
            Padding="48,0,48,24"
            ViewChanged="AudiobookGroupsPanel_ViewChanged"
            Visibility="Collapsed">
            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBox x:Name="AudiobookGroupSearchBox" MaxWidth="320"
                             HorizontalAlignment="Left" PlaceholderText="Search groups…"
                             TextChanged="AudiobookGroupSearch_TextChanged" />
                    <ComboBox x:Name="AudiobookGroupSortComboBox" Grid.Column="1" Width="160"
                              SelectionChanged="AudiobookGroupSort_SelectionChanged">
                        <ComboBoxItem Content="Name" Tag="name" IsSelected="True" />
                        <ComboBoxItem Content="Most books" Tag="count" />
                        <ComboBoxItem Content="Longest" Tag="duration" />
                    </ComboBox>
                    <TextBlock x:Name="AudiobookGroupCountText" Grid.Column="2"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>

                <ProgressRing x:Name="AudiobookGroupsLoading" Width="32" Height="32"
                              HorizontalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="AudiobookGroupsEmpty" Text="No groups found in this library."
                           HorizontalAlignment="Center" Margin="0,32" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                <controls:WrapPanel x:Name="AudiobookGroupsHost"
                                    HorizontalSpacing="12" VerticalSpacing="12" />
            </StackPanel>
        </ScrollViewer>

        <!-- Recommended tab content (web LibraryRecommended.tsx: HeroBanner + SectionRows) -->
        <ScrollViewer
            x:Name="RecommendedPanel"
            Grid.Row="3"
            Padding="0,0,0,24">
            <StackPanel x:Name="RecommendedSectionsPanel" Spacing="8">
                <!-- Hero banner built from first featured library section -->
                <Border x:Name="RecommendedHeroSkeleton" Height="560"
                        Background="{StaticResource SurfaceBrush}"
                        Visibility="Collapsed" />
                <controls:HeroCarousel
                    x:Name="RecommendedHeroCarousel"
                    IsTall="True"
                    Margin="0,0,0,24"
                    Visibility="Collapsed" />
                <controls:NowListeningHero
                    x:Name="RecommendedNowListeningHero"
                    Margin="0,0,0,24"
                    Visibility="Collapsed" />
                <ProgressRing
                    x:Name="RecommendedLoading"
                    IsActive="False"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Margin="0,24,0,0" />
                <StackPanel
                    x:Name="RecommendedErrorPanel"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,24,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="RecommendedError"
                        Foreground="{StaticResource ErrorBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="480" />
                    <Button
                        x:Name="RecommendedRetryButton"
                        Content="Retry"
                        Style="{StaticResource OutlineButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="RecommendedRetry_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Collections tab (web: shows grid of collection poster cards or empty state) -->
        <ScrollViewer
            x:Name="CollectionsPanel"
            Grid.Row="3"
            Padding="40,56,40,56"
            SizeChanged="CollectionsPanel_SizeChanged"
            Visibility="Collapsed">
            <StackPanel Spacing="24" MaxWidth="1320" HorizontalAlignment="Center">
                <!-- Collections header (web: page-header) -->
                <StackPanel x:Name="CollectionsHeader" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        x:Name="CollectionsTitle"
                        Text="Collections"
                        FontSize="48"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        x:Name="CollectionsSubtitle"
                        Text="Browse hand-picked shelves and smart lists created for this library."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Empty state card (web: surface-panel rounded-[2rem] border-0) -->
                <Border
                    x:Name="CollectionsEmptyCard"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="32"
                    Padding="40,40"
                    HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock
                            Text="No collections yet"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Create library collections from the admin area to feature curated shelves here."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="400"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Collections sections (web: grouped sections rendered in sort order) -->
                <controls:WrapPanel x:Name="CollectionsSkeletonHost"
                                    HorizontalSpacing="12" VerticalSpacing="16"
                                    Visibility="Collapsed" />
                <StackPanel x:Name="CollectionSectionsHost"
                            Spacing="28"
                            Visibility="Collapsed" />

                <!-- Collections loading -->
                <ProgressRing
                    x:Name="CollectionsLoading"
                    IsActive="False"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- WebUI CatalogFilterSheet equivalent. It stays out of the visual tree until opened. -->
        <controls:SlideSheet
            x:Name="FiltersSheet"
            Grid.RowSpan="4"
            Canvas.ZIndex="100"
            Title="Filters">
            <controls:SlideSheet.SheetContent>
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Text="Refine your catalog results"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryTextBrush}" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="GuidedFilterModeButton" Content="Guided"
                                Style="{StaticResource AccentButtonStyle}"
                                MinWidth="0" Padding="12,5" Click="GuidedFilterMode_Click" />
                        <Button x:Name="AdvancedFilterModeButton" Content="Advanced"
                                Style="{StaticResource OutlineButtonStyle}"
                                MinWidth="0" Padding="12,5" Click="AdvancedFilterMode_Click" />
                    </StackPanel>

                    <ScrollViewer x:Name="GuidedFiltersScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Padding="0,4,8,12">
                            <StackPanel x:Name="MediaTypeFilterField" Spacing="6">
                                <TextBlock Text="Media Type" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="MediaTypeComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="MediaTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All Media" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Movies &amp; Series" Tag="video" />
                                    <ComboBoxItem Content="Movies" Tag="movie" />
                                    <ComboBoxItem Content="Series" Tag="series" />
                                    <ComboBoxItem Content="Episodes" Tag="episode" />
                                    <ComboBoxItem Content="Audiobooks" Tag="audiobook" />
                                    <ComboBoxItem Content="Ebooks" Tag="ebook" />
                                    <ComboBoxItem Content="Manga" Tag="manga" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Genres" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button x:Name="GenreMultiSelectButton" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Click="GenreMultiSelect_Click">
                                    <TextBlock x:Name="GenreMultiSelectText" Text="Select genres..."
                                               TextTrimming="CharacterEllipsis" />
                                </Button>
                                <ComboBox x:Name="GenreComboBox" Visibility="Collapsed"
                                          SelectionChanged="GenreComboBox_SelectionChanged" />
                                <TextBlock Text="Items must match all selected genres." FontSize="11"
                                           Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Decade" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="DecadeComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="DecadeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Custom" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="2030s" Tag="2030" />
                                    <ComboBoxItem Content="2020s" Tag="2020" />
                                    <ComboBoxItem Content="2010s" Tag="2010" />
                                    <ComboBoxItem Content="2000s" Tag="2000" />
                                    <ComboBoxItem Content="1990s" Tag="1990" />
                                    <ComboBoxItem Content="1980s" Tag="1980" />
                                    <ComboBoxItem Content="1970s" Tag="1970" />
                                    <ComboBoxItem Content="1960s" Tag="1960" />
                                    <ComboBoxItem Content="1950s" Tag="1950" />
                                    <ComboBoxItem Content="1940s" Tag="1940" />
                                    <ComboBoxItem Content="1930s" Tag="1930" />
                                    <ComboBoxItem Content="1920s" Tag="1920" />
                                    <ComboBoxItem Content="1910s" Tag="1910" />
                                    <ComboBoxItem Content="1900s" Tag="1900" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Year From" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="YearMinBox" PlaceholderText="e.g. 2000"
                                         TextChanged="YearFilter_TextChanged" InputScope="Number" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Year To" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="YearMaxBox" PlaceholderText="e.g. 2025"
                                         TextChanged="YearFilter_TextChanged" InputScope="Number" />
                            </StackPanel>

                            <StackPanel x:Name="VideoRatingFilters" Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Minimum IMDb Rating" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="MinimumRatingBox" PlaceholderText="0.0 - 10.0"
                                             InputScope="Number" TextChanged="AdvancedTextFilter_TextChanged" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Content Rating" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="ContentRatingComboBox" HorizontalAlignment="Stretch"
                                              SelectionChanged="ContentRatingComboBox_SelectionChanged"
                                              PlaceholderText="Select rating..." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Original Language" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button x:Name="OriginalLanguageMultiSelectButton" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Click="OriginalLanguageMultiSelect_Click">
                                    <TextBlock x:Name="OriginalLanguageMultiSelectText" Text="Select languages..."
                                               TextTrimming="CharacterEllipsis" />
                                </Button>
                                <ComboBox x:Name="OriginalLanguageComboBox" Visibility="Collapsed"
                                          SelectionChanged="AdvancedComboFilter_SelectionChanged" />
                            </StackPanel>

                            <StackPanel x:Name="VideoPeopleFilters" Spacing="14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Actor" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="ActorBox" PlaceholderText="Any actor"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Director" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="DirectorBox" PlaceholderText="Any director"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Writer" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="WriterBox" PlaceholderText="Any writer"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Producer" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="ProducerBox" PlaceholderText="Any producer"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Studio" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="StudioComboBox" HorizontalAlignment="Stretch"
                                              SelectionChanged="StudioComboBox_SelectionChanged"
                                              PlaceholderText="Select studio..." />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Network" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ComboBox x:Name="NetworkComboBox" HorizontalAlignment="Stretch"
                                              PlaceholderText="All Networks"
                                              SelectionChanged="AdvancedComboFilter_SelectionChanged" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="BookMetadataFilters" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Author" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="AuthorBox" PlaceholderText="Any author"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel x:Name="NarratorFilterField" Spacing="6">
                                    <TextBlock Text="Narrator" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="NarratorBox" PlaceholderText="Any narrator"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Series" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <AutoSuggestBox x:Name="SeriesBox" PlaceholderText="Any series"
                                             TextChanged="PersonFacet_TextChanged" SuggestionChosen="PersonFacet_SuggestionChosen" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Country" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="CountryComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="CountryComboBox_SelectionChanged"
                                          PlaceholderText="Select country..." />
                            </StackPanel>

                            <!-- Kept for restoring older desktop-only saved filters. Current WebUI exposes these through Advanced rules. -->
                            <ComboBox x:Name="ResolutionComboBox" Visibility="Collapsed"
                                      SelectionChanged="ResolutionComboBox_SelectionChanged" />
                            <ComboBox x:Name="AudioLangComboBox" Visibility="Collapsed"
                                      SelectionChanged="AudioLangComboBox_SelectionChanged" />

                            <StackPanel x:Name="MatchStatusFilterField" Spacing="6">
                                <TextBlock Text="Match Status" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="MatchStatusComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="AdvancedComboFilter_SelectionChanged">
                                    <ComboBoxItem Content="Any Status" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Matched" Tag="matched" />
                                    <ComboBoxItem Content="Pending" Tag="pending" />
                                    <ComboBoxItem Content="Unmatched" Tag="unmatched" />
                                    <ComboBoxItem Content="Ambiguous" Tag="ambiguous" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock x:Name="WatchStatusLabel" Text="Watch status" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="WatchStatusComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="AdvancedComboFilter_SelectionChanged">
                                    <ComboBoxItem Content="Any Status" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Watched" Tag="watched" />
                                    <ComboBoxItem Content="In Progress" Tag="in_progress" />
                                    <ComboBoxItem Content="Unwatched" Tag="unwatched" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="VideoQualityToggles" Spacing="8">
                                <TextBlock Text="Video Quality" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ToggleButton x:Name="FourKToggle" Content="4K" Height="32" Padding="12,0"
                                                  Checked="AdvancedToggle_Toggled" Unchecked="AdvancedToggle_Toggled" />
                                    <ToggleButton x:Name="HdrToggle" Content="HDR" Height="32" Padding="12,0"
                                                  Checked="AdvancedToggle_Toggled" Unchecked="AdvancedToggle_Toggled" />
                                    <ToggleButton x:Name="DolbyVisionToggle" Content="DOVI" Height="32" Padding="12,0"
                                                  Checked="AdvancedToggle_Toggled" Unchecked="AdvancedToggle_Toggled" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Added in the Last" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="AddedInLastBox" PlaceholderText="Example: 30 days"
                                         TextChanged="AdvancedTextFilter_TextChanged" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Released in the Last" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="ReleasedInLastBox" PlaceholderText="Example: 1 year"
                                         TextChanged="AdvancedTextFilter_TextChanged" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AdvancedFiltersScroll" Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Spacing="14" Padding="0,4,8,12">
                            <TextBlock Text="Build rule groups directly. Groups and their rules can each match all or any."
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Match groups" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="AdvancedMatchComboBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="AdvancedMatch_SelectionChanged">
                                    <ComboBoxItem Content="Match ALL groups" Tag="all" IsSelected="True" />
                                    <ComboBoxItem Content="Match ANY group" Tag="any" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="AdvancedRulesHost" Spacing="10" />
                            <Button Content="Add Group" Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Left" Click="AddAdvancedGroup_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Padding="0,12,0,0"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Content="Clear All" Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Left" Click="ClearAllFilters_Click" />
                            <Button Grid.Column="1" Content="Done" Style="{StaticResource AccentButtonStyle}"
                                    Click="CloseFilters_Click" />
                        </Grid>
                    </Border>
                </Grid>
            </controls:SlideSheet.SheetContent>
        </controls:SlideSheet>

        <!-- LibraryPage.tsx returns this state when the route no longer maps to
             a library visible to the active profile. Keep it above every tab so
             a stale/deep-linked route cannot expose the previous cached page. -->
        <StackPanel
            x:Name="LibraryUnavailableState"
            Grid.RowSpan="4"
            Canvas.ZIndex="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Padding="24"
            Visibility="Collapsed">
            <TextBlock
                Text="This library is hidden or unavailable for your account."
                Foreground="{StaticResource SecondaryTextBrush}"
                FontSize="14"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                Content="Manage library visibility in Settings"
                Style="{StaticResource GhostButtonStyle}"
                Foreground="{StaticResource AccentBrush}"
                HorizontalAlignment="Center"
                Click="ManageLibraryVisibility_Click" />
        </StackPanel>
    </Grid>
</Page>
