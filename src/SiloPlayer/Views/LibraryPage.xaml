<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Pill tab button style (web: rounded-xl px-4 py-2.5 text-[13px] font-semibold) -->
        <Style x:Key="PillTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Active pill tab (web: bg-accent text-primary) -->
        <Style x:Key="PillTabButtonActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10,16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Pill filter ComboBox style (web: h-9 rounded-full text-[13px]) -->
        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6,8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Order toggle button (web: h-9 w-9 rounded-full border) -->
        <Style x:Key="OrderToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Year filter input style -->
        <Style x:Key="YearInputStyle" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Item count panel style (web: surface-panel-subtle rounded-[1.35rem] px-5 py-4) -->
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: overlays hero in Recommended tab (webui: LibraryHeader with overlay prop) -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="40,24,40,20" Canvas.ZIndex="10"
              Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title and tabs row (web: page-header gap-5) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Eyebrow breadcrumb (webui: hero-eyebrow "Library / {name}") -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel x:Name="LibraryEyebrow" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="LIBRARY" FontSize="11" FontWeight="SemiBold"
                                   CharacterSpacing="200"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="11"
                                   Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="LibraryEyebrowName" FontSize="11" FontWeight="Bold"
                                   CharacterSpacing="200"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        x:Name="LibraryTitle"
                        FontSize="{StaticResource FontSizeDisplayLarge}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Move between recommendations, the full archive, and curated collections."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Pill tab bar (web: surface-panel-subtle rounded-[1.2rem] gap-1 p-1) -->
                <Border
                    Grid.Column="1"
                    CornerRadius="20"
                    Padding="4"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="RecommendedTab"
                            Content="Recommended"
                            Style="{StaticResource PillTabButtonActiveStyle}"
                            Click="Tab_Click"
                            Tag="Recommended" />
                        <Button
                            x:Name="LibraryTab"
                            Content="Library"
                            Style="{StaticResource PillTabButtonStyle}"
                            Click="Tab_Click"
                            Tag="Library" />
                        <Button
                            x:Name="CollectionsTab"
                            Content="Collections"
                            Style="{StaticResource PillTabButtonStyle}"
                            Click="Tab_Click"
                            Tag="Collections" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Filter bar (web: AdvancedFilterBar - flex items-center gap-2, sort pushed right via ml-auto) -->
        <Grid
            x:Name="FilterBar"
            Grid.Row="1"
            Margin="40,0,40,16"
            Canvas.ZIndex="10"
            Background="{StaticResource AppBackgroundBrush}"
            ColumnDefinitions="Auto,*,Auto"
            Visibility="Collapsed">

            <!-- Left: filters -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- Media Type filter (web CatalogFilterBar: All Media / Movies / Series / Episodes) -->
                <ComboBox
                    x:Name="MediaTypeComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="140"
                    SelectionChanged="MediaTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="All Media" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Movies" Tag="movie" />
                    <ComboBoxItem Content="Series" Tag="series" />
                    <ComboBoxItem Content="Episodes" Tag="episode" />
                </ComboBox>

                <!-- Genre filter (web: pill select) -->
                <ComboBox
                    x:Name="GenreComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="150"
                    SelectionChanged="GenreComboBox_SelectionChanged"
                    PlaceholderText="All Genres" />

                <!-- Content Rating filter -->
                <ComboBox
                    x:Name="ContentRatingComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="130"
                    SelectionChanged="ContentRatingComboBox_SelectionChanged"
                    PlaceholderText="All Ratings" />

                <!-- Year range (web: Year <from> - <to>) -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        Text="Year"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        VerticalAlignment="Center" />
                    <TextBox
                        x:Name="YearMinBox"
                        Style="{StaticResource YearInputStyle}"
                        PlaceholderText="From"
                        TextChanged="YearFilter_TextChanged"
                        InputScope="Number" />
                    <TextBlock
                        Text="&#x2013;"
                        FontSize="12"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,0,0" />
                    <TextBox
                        x:Name="YearMaxBox"
                        Style="{StaticResource YearInputStyle}"
                        PlaceholderText="To"
                        TextChanged="YearFilter_TextChanged"
                        InputScope="Number" />
                </StackPanel>

                <!-- Studio filter -->
                <ComboBox
                    x:Name="StudioComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="150"
                    SelectionChanged="StudioComboBox_SelectionChanged"
                    PlaceholderText="All Studios" />

                <!-- Country filter -->
                <ComboBox
                    x:Name="CountryComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="140"
                    SelectionChanged="CountryComboBox_SelectionChanged"
                    PlaceholderText="All Countries" />

                <!-- Resolution filter -->
                <ComboBox
                    x:Name="ResolutionComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="130"
                    SelectionChanged="ResolutionComboBox_SelectionChanged"
                    PlaceholderText="All Quality" />

                <!-- Audio Language filter -->
                <ComboBox
                    x:Name="AudioLangComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="150"
                    SelectionChanged="AudioLangComboBox_SelectionChanged"
                    PlaceholderText="All Audio" />
            </StackPanel>

            <!-- Right: sort + order + count (pushed right via Grid column) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <!-- Sort + Order (web: ml-auto, pill) -->
                <!-- B43: Sort tags align with WebUI catalog params: sort_title,
                     recently_added, year, rating_imdb. -->
                <ComboBox
                    x:Name="SortComboBox"
                    Style="{StaticResource PillComboBoxStyle}"
                    Width="160"
                    SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="Title" Tag="sort_title" IsSelected="True" />
                    <ComboBoxItem Content="Recently Added" Tag="recently_added" />
                    <ComboBoxItem Content="Year" Tag="year" />
                    <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb" />
                </ComboBox>

                <!-- Order toggle button (web: arrow up/down in circle) -->
                <Button
                    x:Name="OrderToggleButton"
                    Style="{StaticResource OrderToggleButtonStyle}"
                    Click="OrderToggle_Click"
                    ToolTipService.ToolTip="Ascending">
                    <FontIcon
                        x:Name="OrderIcon"
                        Glyph="&#xE74A;"
                        FontSize="14" />
                </Button>

                <!-- Item count (web: surface-panel-subtle with count) -->
                <Border
                    x:Name="CountPanel"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="16,8"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock
                        Text="AVAILABLE NOW"
                        FontSize="10"
                        FontWeight="SemiBold"
                        CharacterSpacing="160"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock
                        x:Name="CountText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Margin="0,4,0,0" />
                    <TextBlock
                        x:Name="CountLabel"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>

        <!-- Active filter badges -->
        <StackPanel
            x:Name="ActiveFiltersBar"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="6"
            Margin="40,0,40,12"
            Visibility="Collapsed">
            <StackPanel x:Name="FilterBadgesPanel" Orientation="Horizontal" Spacing="6" />
            <Button
                x:Name="ClearAllFiltersButton"
                Style="{StaticResource GhostButtonStyle}"
                Content="Clear All"
                FontSize="12"
                Foreground="{StaticResource AccentBrush}"
                Padding="8,4"
                Click="ClearAllFilters_Click"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- Content area: fixed viewport plus row scrollbar for 100k-scale libraries. -->
        <Grid x:Name="LibraryContentArea" Grid.Row="3" Visibility="Collapsed">
            <Border
                x:Name="LibraryViewportHost"
                Padding="40,0,40,24"
                SizeChanged="LibraryViewport_SizeChanged"
                PointerWheelChanged="LibraryViewport_PointerWheelChanged">
                <Grid ColumnDefinitions="*,Auto">
                    <Canvas
                        x:Name="VirtualGridCanvas"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top" />
                    <ScrollBar
                        x:Name="LibraryScrollBar"
                        Grid.Column="1"
                        Orientation="Vertical"
                        Width="14"
                        Margin="12,0,0,0"
                        Minimum="0"
                        Maximum="0"
                        SmallChange="1"
                        LargeChange="3"
                        ValueChanged="LibraryScrollBar_ValueChanged" />
                </Grid>
            </Border>

            <!-- Loading indicator overlaid at bottom of viewport -->
            <ProgressRing
                x:Name="LoadingRing"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Width="32" Height="32" />

            <!-- Scroll-to-top button (webui: floating bottom-right) -->
            <Button x:Name="ScrollToTopButton"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Width="40" Height="40"
                    CornerRadius="20"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Click="ScrollToTop_Click">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>

            <!-- Error message overlaid at bottom of viewport -->
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8" />
        </Grid>

        <!-- Recommended tab content (web LibraryRecommended.tsx: HeroBanner + SectionRows) -->
        <ScrollViewer
            x:Name="RecommendedPanel"
            Grid.Row="3"
            Padding="0,0,0,24">
            <StackPanel x:Name="RecommendedSectionsPanel" Spacing="8">
                <!-- Hero banner built from first featured library section -->
                <controls:HeroCarousel
                    x:Name="RecommendedHeroCarousel"
                    Margin="0,0,0,24"
                    Visibility="Collapsed" />
                <ProgressRing
                    x:Name="RecommendedLoading"
                    IsActive="False"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Margin="0,24,0,0" />
                <StackPanel
                    x:Name="RecommendedErrorPanel"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,24,0,0"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="RecommendedError"
                        Foreground="{StaticResource ErrorBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        MaxWidth="480" />
                    <Button
                        x:Name="RecommendedRetryButton"
                        Content="Retry"
                        Style="{StaticResource OutlineButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="RecommendedRetry_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Collections tab (web: shows grid of collection poster cards or empty state) -->
        <ScrollViewer
            x:Name="CollectionsPanel"
            Grid.Row="3"
            Padding="40,0,40,24"
            Visibility="Collapsed">
            <StackPanel Spacing="24">
                <!-- Collections header (web: page-header) -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Collections"
                        FontSize="{StaticResource FontSizeDisplay}"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Browse hand-picked shelves and smart lists created for this library."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Empty state card (web: surface-panel rounded-[2rem] border-0) -->
                <Border
                    x:Name="CollectionsEmptyCard"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="24"
                    Padding="40,40"
                    HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock
                            Text="No collections yet"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Create library collections from the admin area to feature curated shelves here."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="400"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Collections grid (populated dynamically) -->
                <ItemsRepeater x:Name="CollectionsRepeater" Visibility="Collapsed">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="{StaticResource PosterCardWidth}"
                            MinItemHeight="{StaticResource PosterCardTotalHeight}"
                            MinColumnSpacing="12"
                            MinRowSpacing="16"
                            ItemsStretch="None" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!-- Collections loading -->
                <ProgressRing
                    x:Name="CollectionsLoading"
                    IsActive="False"
                    HorizontalAlignment="Center"
                    Width="32" Height="32"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
