<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.ProfileSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:StringToInitialConverter x:Key="StringToInitial" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <Grid helpers:AuthBackdrop.Enabled="True">
    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
        <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="28">
            <controls:SkeletonText Width="270" Height="46" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Width="148" Spacing="12"><Border Width="80" Height="80" CornerRadius="40"><controls:SkeletonText Width="80" Height="80" /></Border><controls:SkeletonText Width="70" Height="14" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel Width="148" Spacing="12"><Border Width="80" Height="80" CornerRadius="40"><controls:SkeletonText Width="80" Height="80" /></Border><controls:SkeletonText Width="70" Height="14" HorizontalAlignment="Center" /></StackPanel>
                <StackPanel Width="148" Spacing="12"><Border Width="80" Height="80" CornerRadius="40"><controls:SkeletonText Width="80" Height="80" /></Border><controls:SkeletonText Width="70" Height="14" HorizontalAlignment="Center" /></StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ExistingProfilesState" Spacing="32" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="1000" Visibility="Collapsed">
            <TextBlock x:Name="ProfilePickerTitle" Text="Who's watching?" FontSize="64" FontWeight="ExtraBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:CenteredWrapPanel HorizontalSpacing="20" VerticalSpacing="20" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="ProfileButton_Click" Tag="{Binding}" Background="Transparent"
                                BorderThickness="0" Padding="0" Margin="0"
                                AutomationProperties.Name="{Binding SelectProfileAccessibleName}"
                                PointerEntered="ProfileCard_PointerEntered" PointerExited="ProfileCard_PointerExited">
                            <Border x:Name="ProfileCardBorder" Width="148" Background="{StaticResource SurfaceBrush}" CornerRadius="28" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <Grid Width="80" Height="80">
                                        <Border CornerRadius="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Background="{StaticResource CardBackgroundBrush}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource StringToInitial}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="40" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Visibility="{Binding AvatarUrl, Converter={StaticResource NullToVis}}">
                                            <Image Source="{Binding AvatarUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                        </Border>
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}">
                                            <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" LineStackingStrategy="BlockLineHeight" MaxWidth="108" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Sign out" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Center" Click="SignOutButton_Click" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel x:Name="EmptyProfilesState" Spacing="22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="Collapsed">
            <TextBlock x:Name="EmptyProfilesTitle" Text="Create your first profile" FontSize="52" FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="You need a profile before you can enter the app." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
            <Button Content="＋  Create profile" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="AddProfileButton_Click" />
            <Button Content="Sign out" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Center" Click="SignOutButton_Click" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
    </Grid>
</Page>
