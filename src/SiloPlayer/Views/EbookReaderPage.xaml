<Page
    x:Class="SiloPlayer.Views.EbookReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}"
    KeyDown="Page_KeyDown"
    IsTabStop="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="14,8" Background="{StaticResource SurfaceRaisedBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button ToolTipService.ToolTip="Back" Click="Back_Click" Width="44" Height="44">
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Reader" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ChapterText" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button ToolTipService.ToolTip="Contents" Click="Contents_Click" Width="44" Height="44"><FontIcon Glyph="&#xE8A9;" /></Button>
                <Button x:Name="SearchBookButton" ToolTipService.ToolTip="Search book" Click="Search_Click" Width="44" Height="44"><FontIcon Glyph="&#xE721;" /></Button>
                <Button x:Name="HighlightButton" ToolTipService.ToolTip="Highlight selection" Click="Highlight_Click" Width="44" Height="44"><FontIcon Glyph="&#xE7E6;" /></Button>
                <Button ToolTipService.ToolTip="Add bookmark" Click="Bookmark_Click" Width="44" Height="44"><FontIcon Glyph="&#xE735;" /></Button>
                <Button ToolTipService.ToolTip="Annotations and bookmarks" Click="Annotations_Click" Width="44" Height="44"><FontIcon Glyph="&#xE70B;" /></Button>
                <Button ToolTipService.ToolTip="Reader settings" Click="Settings_Click" Width="44" Height="44"><FontIcon Glyph="&#xE713;" /></Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SideColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidePanel" Visibility="Collapsed" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="PanelTitle" Text="Contents" FontSize="20" FontWeight="SemiBold" />
                        <Button HorizontalAlignment="Right" Click="ClosePanel_Click" Width="36" Height="36"><FontIcon Glyph="&#xE711;" FontSize="12" /></Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <ListView x:Name="ContentsList" SelectionChanged="ContentsList_SelectionChanged" SelectionMode="Single" />
                            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="14">
                                <Button Content="Reset reader settings" Click="ResetSettings_Click" HorizontalAlignment="Stretch" />
                                <TextBlock Text="Reading profile" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Comfortable" Tag="comfortable" Click="Profile_Click" />
                                    <Button Content="Accessible" Tag="accessible" Click="Profile_Click" />
                                    <Button Content="Compact" Tag="compact" Click="Profile_Click" />
                                </StackPanel>
                                <TextBlock Text="Read aloud" Opacity="0.7" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Speak" Click="Speak_Click" />
                                    <Button Content="Pause / Resume" Click="PauseSpeech_Click" />
                                    <Button Content="Stop" Click="StopSpeech_Click" />
                                </StackPanel>
                                <TextBlock Text="Speech rate" Opacity="0.7" />
                                <Slider x:Name="SpeechRateSlider" Minimum="0.5" Maximum="2" StepFrequency="0.1" Value="1" />
                                <CheckBox x:Name="WakeLockCheck" Content="Keep screen awake" Click="WakeLock_Click" />
                                <TextBlock Text="Theme" Opacity="0.7" />
                                <ComboBox x:Name="ThemeCombo" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Dark" Tag="dark" /><ComboBoxItem Content="Light" Tag="light" /><ComboBoxItem Content="Sepia" Tag="sepia" />
                                </ComboBox>
                                <TextBlock Text="Font" Opacity="0.7" />
                                <ComboBox x:Name="FontCombo" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Book serif" Tag="Georgia" /><ComboBoxItem Content="System sans" Tag="Segoe UI" /><ComboBoxItem Content="Accessible" Tag="Atkinson Hyperlegible" />
                                </ComboBox>
                                <TextBlock Text="Text size" Opacity="0.7" />
                                <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="32" StepFrequency="1" ValueChanged="AppearanceSlider_Changed" />
                                <TextBlock Text="Brightness" Opacity="0.7" />
                                <Slider x:Name="BrightnessSlider" Minimum="70" Maximum="125" StepFrequency="1" Value="100" ValueChanged="AppearanceSlider_Changed" />
                                <TextBlock Text="Line spacing" Opacity="0.7" />
                                <Slider x:Name="LineHeightSlider" Minimum="1.1" Maximum="2.2" StepFrequency="0.1" ValueChanged="AppearanceSlider_Changed" />
                                <TextBlock Text="Page margins" Opacity="0.7" />
                                <Slider x:Name="MarginSlider" Minimum="12" Maximum="120" StepFrequency="4" ValueChanged="AppearanceSlider_Changed" />
                                <TextBlock Text="Reading width" Opacity="0.7" />
                                <Slider x:Name="MaxWidthSlider" Minimum="42" Maximum="96" StepFrequency="1" Value="72" ValueChanged="AppearanceSlider_Changed" />
                                <CheckBox x:Name="HyphenationCheck" Content="Hyphenation" Click="AppearanceCheck_Click" />
                                <CheckBox x:Name="RtlCheck" Content="Right to left" Click="AppearanceCheck_Click" />
                                <CheckBox x:Name="ReadingRulerCheck" Content="Reading ruler" Click="AppearanceCheck_Click" />
                                <TextBlock Text="Ruler position" Opacity="0.7" />
                                <Slider x:Name="RulerPositionSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="45" ValueChanged="AppearanceSlider_Changed" />
                                <TextBlock Text="Writing mode" Opacity="0.7" />
                                <ComboBox x:Name="WritingModeCombo" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Auto" Tag="auto" /><ComboBoxItem Content="Horizontal" Tag="horizontal-tb" /><ComboBoxItem Content="Vertical" Tag="vertical-rl" />
                                </ComboBox>
                                <TextBlock Text="Flow" Opacity="0.7" />
                                <ComboBox x:Name="FlowCombo" SelectionChanged="Appearance_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Paginated" Tag="paginated" /><ComboBoxItem Content="Scrolled" Tag="scrolled" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="10">
                                <TextBox x:Name="SearchBox" PlaceholderText="Search this book" KeyDown="SearchBox_KeyDown" />
                                <Button Content="Search" Click="RunSearch_Click" HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="SearchStatusText" Opacity="0.7" />
                                <ListView x:Name="SearchResultsList" SelectionChanged="SearchResultsList_SelectionChanged" />
                            </StackPanel>
                            <StackPanel x:Name="AnnotationsPanel" Visibility="Collapsed" Spacing="8">
                                <TextBlock Text="Highlights and bookmarks" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel x:Name="AnnotationsList" Spacing="8" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#111111">
                <WebView2 x:Name="ReaderWebView" NavigationCompleted="ReaderWebView_NavigationCompleted" />
                <Grid x:Name="LoadingLayer" Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <ProgressRing IsActive="True" Width="42" Height="42" />
                        <TextBlock x:Name="LoadingText" Text="Opening book…" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="14,4" Background="{StaticResource SurfaceRaisedBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Click="Previous_Click" ToolTipService.ToolTip="Previous"><FontIcon Glyph="&#xE76B;" /></Button>
            <Slider x:Name="ProgressSlider" Grid.Column="1" Margin="14,0" Minimum="0" Maximum="1" StepFrequency="0.001" ValueChanged="ProgressSlider_ValueChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText" Text="0%" MinWidth="42" TextAlignment="Right" />
                <Button x:Name="NextButton" Click="Next_Click" ToolTipService.ToolTip="Next"><FontIcon Glyph="&#xE76C;" /></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
