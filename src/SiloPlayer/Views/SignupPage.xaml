<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SignupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    FontFamily="{StaticResource ThemeFontFamily}"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <!-- Full-page centered auth shell -->
    <Grid helpers:AuthBackdrop.Enabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Image
            Source="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource UrlToImage}}"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            helpers:AuthBackdrop.ReadabilityScrim="True"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False" />
        <StackPanel x:Name="SignupLayout"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="384"
            Spacing="16">

            <ProgressRing
                IsActive="{x:Bind ViewModel.IsCheckingSignupStatus, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsCheckingSignupStatus, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Center"
                Width="32" Height="32" />

            <Border x:Name="SignupClosedCard" Padding="52,24" CornerRadius="12" BorderThickness="0"
                Style="{StaticResource GlassCardStyle}"
                Visibility="{x:Bind ViewModel.ShowSignupClosed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16">
                    <TextBlock
                        Text="{x:Bind ViewModel.ServerName, Mode=OneWay, FallbackValue='Silo'}"
                        FontSize="30"
                        Height="36" LineHeight="36" LineStackingStrategy="BlockLineHeight"
                        FontWeight="ExtraBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        CharacterSpacing="-40" />
                    <TextBlock
                        Text="Public signups are currently closed."
                        Style="{StaticResource SecondaryTextStyle}"
                        FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Glass card -->
            <Border x:Name="SignupCard" Padding="52,24" CornerRadius="12" BorderThickness="0"
                Style="{StaticResource GlassCardStyle}"
                Visibility="{x:Bind ViewModel.ShowSignupForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="24">
                    <!-- Header: Branding + subtitle -->
                    <StackPanel Spacing="16">
                        <TextBlock
                            x:Name="ServerNameTitle"
                            Text="{x:Bind ViewModel.ServerName, Mode=OneWay, FallbackValue='Silo'}"
                            FontSize="30"
                            Height="36" LineHeight="36" LineStackingStrategy="BlockLineHeight"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />

                        <TextBlock
                            Text="Create a new account to get started."
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Error message -->
                    <Border
                        Background="#2DEF6B73"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- Form fields -->
                    <StackPanel Spacing="16">
                    <StackPanel Spacing="16">
                        <!-- Username -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Username"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="UsernameBox"
                                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Email"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="EmailBox"
                                Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel x:Name="SignupPasswordGroup" Spacing="8">
                            <TextBlock
                                Text="Password"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="At least 8 characters"
                                FontSize="12" Height="16" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Style="{StaticResource DarkPasswordBoxStyle}"
                                PasswordChanged="PasswordBox_PasswordChanged"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Confirm Password -->
                        <StackPanel x:Name="SignupConfirmationGroup" Spacing="8">
                            <TextBlock
                                Text="Confirm password"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <PasswordBox
                                x:Name="ConfirmPasswordBox"
                                Style="{StaticResource DarkPasswordBoxStyle}"
                                PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                KeyDown="InputBox_KeyDown" />
                            <TextBlock
                                x:Name="PasswordMismatchText"
                                Text="Passwords do not match"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="12" Height="16" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Invite Code -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Invite code"
                                FontSize="14" Height="14" LineHeight="14" LineStackingStrategy="BlockLineHeight"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="InviteCodeBox"
                                Text="{x:Bind ViewModel.InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Enter your invite code"
                                KeyDown="InputBox_KeyDown" />
                        </StackPanel>

                        <!-- Sign up button -->
                        <Button
                            Content="Create account"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="36" MinHeight="36" Padding="16,4"
                            Command="{x:Bind ViewModel.SignupCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Height="20">
                        <TextBlock Text="Already have an account?" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <HyperlinkButton Padding="0" MinHeight="0" MinWidth="0" Height="20" Click="BackToLoginButton_Click">
                            <TextBlock Text="Sign in" FontSize="14" TextDecorations="Underline" Foreground="{StaticResource PrimaryTextBrush}" />
                        </HyperlinkButton>
                    </StackPanel>
                    </StackPanel>

                    <!-- Loading indicator -->
                    <ProgressRing
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center"
                        Width="28" Height="28" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
