<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.CollectionEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Type toggle button style (inactive) -->
        <Style x:Key="TypeToggleInactiveStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Type toggle button style (active) -->
        <Style x:Key="TypeToggleActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Settings group card style -->
        <Style x:Key="EditorGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading overlay -->
        <StackPanel
            x:Name="CollectionLoadingState"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ProgressRing IsActive="True" HorizontalAlignment="Center" Width="40" Height="40" />
            <TextBlock Text="Loading collection editor..."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" />
        </StackPanel>

        <StackPanel x:Name="CollectionNotFoundState" MaxWidth="1400" Margin="48,24,48,48"
                    Spacing="24" Visibility="Collapsed">
            <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Go back" Click="BackButton_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Border Style="{StaticResource EditorGroupStyle}" Margin="0,24,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="Collection not found" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="The selected collection could not be loaded." FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    <Button Content="All collections" HorizontalAlignment="Left" Click="AllCollections_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="CollectionUnavailableState" Margin="24" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Visibility="Collapsed">
            <TextBlock Text="Couldn't load this collection" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="The collection is temporarily unavailable. Try again." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Retry" Click="RetryCollection_Click" HorizontalAlignment="Center" />
            <Button Content="Go back" Click="BackButton_Click" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer
            x:Name="CollectionEditorScroll"
            IsScrollInertiaEnabled="True">

            <StackPanel x:Name="CollectionEditorShell" MaxWidth="1400" Margin="48,24,48,48" Spacing="24">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="10">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource GhostButtonStyle}"
                        Width="32" Height="32" Padding="0" CornerRadius="16"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Go back"
                        Click="BackButton_Click">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="PageTitle"
                            Text="New Collection"
                            FontSize="{StaticResource FontSizeDisplayLarge}"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        x:Name="PageSubtitle"
                        Text="Build collections in a full-page editor so sharing, rules, and preview stay visible."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="620" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Error Message ===== -->
                <Border
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12"
                    Padding="16,12">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        TextWrapping="Wrap" />
                </Border>

                <Border x:Name="ImportedSourceBanner" Visibility="Collapsed"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="27" Padding="28">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#162A3A" Offset="0" />
                            <GradientStop Color="#101214" Offset="0.48" />
                            <GradientStop Color="#132A21" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="SourceBrandMark" Width="72" Height="72" CornerRadius="16"
                                Background="{StaticResource AccentBackgroundBrush}"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                            <TextBlock x:Name="SourceBrandInitials" Text="Mb" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="SourceBrandBadge" Padding="10,4" CornerRadius="12" Background="{StaticResource AccentBackgroundBrush}">
                                    <TextBlock x:Name="SourceBrandLabel" Text="MDBLIST" FontSize="10" FontWeight="SemiBold"
                                               CharacterSpacing="180" Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock x:Name="SourcePresetLabel" FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="SourceBannerDescription" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="SourceBannerSyncStatus" FontSize="12"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="SourceBannerActions" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="OpenSourceButton" Content="Open source"
                                    Style="{StaticResource OutlineButtonStyle}" Click="OpenSource_Click" />
                            <Button x:Name="SourceSyncButton" Content="Sync now" Style="{StaticResource AccentButtonStyle}" Click="SyncNow_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="EditorBodyGrid" ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="EditorSidebarColumn" Width="352" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ImportedEditorSurface" Grid.Column="0">
                    <StackPanel x:Name="EditorPrimaryColumn" Spacing="24">

                <!-- ===== Basic Info Section ===== -->
                <Border x:Name="BasicInfoSection" Style="{StaticResource EditorGroupStyle}" Padding="28,26">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DisplaySectionNumber" Text="01" FontFamily="Consolas" FontSize="10"
                                       CharacterSpacing="260" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock x:Name="BasicInfoTitle" Text="Display" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Rename, describe, and scope which libraries this collection's items resolve into."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="20">

                        <!-- Name -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Name"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox
                                x:Name="NameTextBox"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="My Collection"
                                Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MaxWidth="500"
                                HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Description"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox
                                x:Name="DescriptionTextBox"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="A short blurb shown alongside the collection."
                                Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="86"
                                MaxWidth="500"
                                HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="ImportedDisplayOptions" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="Imported with the collection on first sync. Edits stick — future syncs won't overwrite this."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="DisplayFilterGrid" ColumnSpacing="20" RowSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox x:Name="WatchFilterCombo" Header="WATCH STATE" SelectionChanged="WatchFilter_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="All" Tag="all" IsSelected="True" />
                                    <ComboBoxItem Content="Unwatched" Tag="unwatched" />
                                    <ComboBoxItem Content="Watched" Tag="watched" />
                                </ComboBox>
                                <ComboBox x:Name="MediaFilterCombo" Grid.Column="1" Header="CONTENT" SelectionChanged="MediaFilter_Changed" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="All" Tag="all" IsSelected="True" />
                                    <ComboBoxItem Content="Movies" Tag="movie" />
                                    <ComboBoxItem Content="Shows" Tag="series" />
                                </ComboBox>
                            </Grid>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Default Sort" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ImportedDefaultSortCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="ImportedDefaultSort_Changed">
                                    <ComboBoxItem Content="Collection order (default)" Tag="" IsSelected="True" />
                                    <ComboBoxItem Content="Title" Tag="title:asc" />
                                    <ComboBoxItem Content="Date Added" Tag="added_at:desc" />
                                    <ComboBoxItem Content="Release Date" Tag="release_date:desc" />
                                    <ComboBoxItem Content="Latest Episode Air Date" Tag="last_air_date:desc" />
                                    <ComboBoxItem Content="Latest Episode Added" Tag="latest_episode_added:desc" />
                                    <ComboBoxItem Content="Year" Tag="year:desc" />
                                    <ComboBoxItem Content="Content Rating" Tag="content_rating:asc" />
                                    <ComboBoxItem Content="Duration" Tag="runtime:desc" />
                                    <ComboBoxItem Content="IMDb Rating" Tag="rating_imdb:desc" />
                                    <ComboBoxItem Content="TMDB Rating" Tag="rating_tmdb:desc" />
                                    <ComboBoxItem Content="RT Critic Rating" Tag="rating_rt_critic:desc" />
                                    <ComboBoxItem Content="RT Audience Rating" Tag="rating_rt_audience:desc" />
                                    <ComboBoxItem Content="Resolution" Tag="resolution:desc" />
                                    <ComboBoxItem Content="Bitrate" Tag="bitrate:desc" />
                                    <ComboBoxItem Content="Progress" Tag="progress:desc" />
                                    <ComboBoxItem Content="Date Viewed" Tag="last_watched_at:desc" />
                                    <ComboBoxItem Content="Plays" Tag="play_count:desc" />
                                    <ComboBoxItem Content="Author" Tag="author:asc" />
                                    <ComboBoxItem Content="Narrator" Tag="narrator:asc" />
                                    <ComboBoxItem Content="Series" Tag="series:asc" />
                                </ComboBox>
                                <TextBlock Text="The order viewers get when they open this collection. They can still sort it their own way, and that choice is remembered for them."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="Uses the active profile's watched state. Shared profiles may see different results."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="LIBRARIES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="140"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <StackPanel x:Name="ImportedLibrariesPanel" Spacing="6" />
                                <TextBlock Text="Items resolve only inside libraries you select. Leave empty to span every library you can see."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PosterSection" Spacing="6">
                            <TextBlock Text="Poster" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox
                                x:Name="PosterSourceUrlTextBox"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Optional poster image URL"
                                Text="{x:Bind ViewModel.PosterSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MaxWidth="560"
                                HorizontalAlignment="Left" />
                            <Border x:Name="PosterDraftPreviewFrame" Height="128" CornerRadius="12" Visibility="Collapsed">
                                <Image x:Name="PosterDraftPreview" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Choose image" Click="ChoosePoster_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                <Button x:Name="RemovePosterButton" Content="Remove poster" Click="RemovePoster_Click" Visibility="Collapsed" />
                                <TextBlock x:Name="PosterFileStatusText" Text="JPG, PNG, or WebP · maximum 20 MB" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Type selector -->
                        <StackPanel x:Name="TypeSection" Spacing="6">
                            <TextBlock
                                Text="Type"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel
                                x:Name="TypeSelectorPanel"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="ManualTypeButton"
                                    Content="Manual"
                                    Style="{StaticResource TypeToggleActiveStyle}"
                                    Click="ManualType_Click" />
                                <Button
                                    x:Name="SmartTypeButton"
                                    Content="Smart"
                                    Style="{StaticResource TypeToggleInactiveStyle}"
                                    Click="SmartType_Click" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TypeDescription"
                                Text="Manually add items to this collection."
                                FontSize="12"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Shared toggle -->
                        <StackPanel x:Name="SharingSection" Spacing="6">
                            <TextBlock
                                Text="Sharing"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <ToggleSwitch
                                x:Name="SharedToggle"
                                IsOn="{x:Bind ViewModel.IsShared, Mode=TwoWay}"
                                Toggled="SharedToggle_Toggled"
                                OnContent="Share with this account"
                                OffContent="Share with this account" />
                            <TextBlock Text="Shared collections appear for the selected profiles across the account."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="ImportedProfileAccessSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Profile access" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="Choose profiles that can access this shared collection. Leave all unchecked to allow every profile." FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="ImportedProfilesPanel" Spacing="6" />
                        </StackPanel>
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Imported Source Section (visible for MDBList/TMDB/Trakt) ===== -->
                <Border
                    x:Name="ImportedSourceSection"
                    Style="{StaticResource EditorGroupStyle}"
                    Padding="28,26"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="02" FontFamily="Consolas" FontSize="10" CharacterSpacing="260"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Text="Source" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Where this collection pulls its items from and how often."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="18">

                        <StackPanel x:Name="SourceUrlSection" Spacing="6">
                            <TextBlock
                                Text="Source URL"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBox
                                x:Name="SourceUrlTextBox"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Source URL"
                                Text="{x:Bind ViewModel.SourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                MaxWidth="560"
                                HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="SourcePresetSection" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="SourcePresetHeader" Text="TMDB PRESET" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="140" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SourcePresetReadoutText" FontSize="13" FontWeight="Medium" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <TextBlock x:Name="SourcePresetLockText" Text="TMDB" FontSize="10" FontWeight="SemiBold"
                                                   CharacterSpacing="120" Foreground="{StaticResource TertiaryTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock
                                    Text="Max items"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox
                                    x:Name="MaxItemsTextBox"
                                    Style="{StaticResource DarkTextBoxStyle}"
                                    PlaceholderText="No limit"
                                    Text="{x:Bind ViewModel.MaxItemsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock
                                    Text="Sync schedule"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                                <Border
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    MinHeight="40">
                                    <TextBlock
                                        x:Name="SyncScheduleTextBlock"
                                        Text="{x:Bind ViewModel.SyncSchedule, Mode=OneWay}"
                                        FontSize="13"
                                        Foreground="{StaticResource SecondaryTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="LastSyncSummaryText" Text="Not synced yet" Visibility="Collapsed" />
                    </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Sharing (imported collections) ===== -->
                <Border x:Name="ImportedSharingSection" Style="{StaticResource EditorGroupStyle}"
                        Padding="28,26" Visibility="Collapsed">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="03" FontFamily="Consolas" FontSize="10" CharacterSpacing="260"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Text="Sharing" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Decide which profiles on this account can browse the collection."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Share with this account" FontSize="14" FontWeight="Medium" />
                                        <TextBlock Text="Shared collections appear for the selected profiles across the account."
                                                   FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ImportedSharedToggle" Grid.Column="1" HorizontalAlignment="Right"
                                                  IsOn="{x:Bind ViewModel.IsShared, Mode=TwoWay}"
                                                  Toggled="ImportedSharedToggle_Toggled" OnContent="" OffContent="" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="ImportedProfileAccessSection2" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="PROFILE ACCESS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="140"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="Choose profiles that can access this shared collection. Leave all unchecked to allow every profile."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                <StackPanel x:Name="ImportedProfilesPanel2" Spacing="6" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Library visibility (imported collections) ===== -->
                <Border x:Name="ImportedVisibilitySection" Style="{StaticResource EditorGroupStyle}"
                        Padding="28,26" Visibility="Collapsed">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="04" FontFamily="Consolas" FontSize="10" CharacterSpacing="260"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Text="Library visibility" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Pin this collection to your library's Collections tab. Only you see it — personal collections are private to your user."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Show in my library Collections tab" FontSize="14" FontWeight="Medium" />
                                    <TextBlock Text="Appears in the Collections tab of the libraries you scope this to."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="IncludeInServerCollectionsToggle" Grid.Column="1" HorizontalAlignment="Right"
                                              IsOn="{x:Bind ViewModel.IncludeInServerCollections, Mode=TwoWay}"
                                              OnContent="" OffContent="" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== Poster (imported collections) ===== -->
                <Border x:Name="ImportedPosterSection" Style="{StaticResource EditorGroupStyle}"
                        Padding="28,26" Visibility="Collapsed">
                    <Grid ColumnSpacing="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="05" FontFamily="Consolas" FontSize="10" CharacterSpacing="260"
                                       Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Text="Poster" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Override the default card with a custom poster. Upload an image or paste an image URL."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock Text="POSTER" FontSize="11" FontWeight="SemiBold" CharacterSpacing="140"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border x:Name="ImportedPosterPreviewFrame" Height="128" CornerRadius="12" Visibility="Collapsed">
                                <Grid>
                                    <Image x:Name="ImportedPosterPreview" Stretch="UniformToFill" Visibility="Collapsed" AutomationProperties.Name="Poster" />
                                    <Button x:Name="ImportedRemoveSelectedPoster" AutomationProperties.Name="Remove selected file" Click="RemoveSelectedPoster_Click" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="6" />
                                    <Button x:Name="ImportedRemovePosterButton" AutomationProperties.Name="Remove poster" Click="RemovePoster_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0" Margin="6" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Button x:Name="ImportedPosterDropTarget" Content="Click or drop image" Click="ChoosePoster_Click" Style="{StaticResource SecondaryButtonStyle}"
                                    AllowDrop="True" DragOver="PosterDrop_DragOver" Drop="PosterDrop_Drop"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="128" />
                            <TextBlock x:Name="ImportedPosterFileStatusText" Text="JPG, PNG, or WebP · maximum 20 MB"
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBox x:Name="ImportedPosterSourceUrlTextBox" Style="{StaticResource DarkTextBoxStyle}"
                                     PlaceholderText="https://example.com/image.jpg"
                                     Text="{x:Bind ViewModel.PosterSourceUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Paste an image URL instead of uploading a file. If both are provided, the uploaded file wins."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="DeleteCollectionButton" Content="Delete this collection" Click="DeleteCollection_Click"
                        Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Left" Visibility="Collapsed" />

                <!-- ===== Smart Rules Section (visible when type=smart) ===== -->
                <Border
                    x:Name="SmartRulesSection"
                    Style="{StaticResource EditorGroupStyle}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Smart Rules"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="AddRule_Click"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add Rule" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock
                            Text="Define rules to automatically match items. All rules must match."
                            FontSize="13"
                            Foreground="{StaticResource TertiaryTextBrush}" />

                        <!-- Rules list -->
                        <StackPanel x:Name="RulesPanel" Spacing="8" />

                        <!-- Empty rules state -->
                        <TextBlock
                            x:Name="NoRulesText"
                            Text="No rules defined. Add a rule to get started."
                            FontSize="13"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,8" />

                        <!-- Preview button and results -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Style="{StaticResource AccentButtonStyle}"
                                Click="Preview_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                                    <TextBlock Text="Preview Results" />
                                </StackPanel>
                            </Button>
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsPreviewing, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsPreviewing, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Width="24" Height="24" />
                            <TextBlock
                                x:Name="PreviewCountText"
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Preview items list -->
                        <StackPanel x:Name="PreviewItemsPanel" Spacing="4" />
                    </StackPanel>
                </Border>

                <!-- ===== Manual Items Section (visible when type=manual) ===== -->
                <Border
                    x:Name="ManualItemsSection"
                    Style="{StaticResource EditorGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock
                                    Text="Items"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />

                        <!-- Search bar -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="SearchBox"
                                Grid.Column="0"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="Search for movies or shows to add..."
                                MaxWidth="500"
                                HorizontalAlignment="Stretch"
                                KeyDown="SearchBox_KeyDown" />

                            <Button
                                Grid.Column="1"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="8,0,0,0"
                                Click="SearchItems_Click"
                                VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                            </Button>
                        </Grid>

                        <TextBlock
                            Text="Use the controls to reorder. The saved order is what every viewer sees."
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap" />

                        <!-- Search results -->
                        <StackPanel x:Name="SearchResultsPanel" Spacing="4" />

                        <!-- Separator between search and added items -->
                        <Border
                            x:Name="ItemsSeparator"
                            Background="{StaticResource BorderBrush}"
                            Opacity="0.5"
                            Height="1"
                            Visibility="Collapsed" />

                        <!-- Added items header -->
                        <TextBlock
                            x:Name="AddedItemsHeader"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Visibility="Collapsed" />

                        <!-- Added items list -->
                        <StackPanel x:Name="ManualItemsPanel" Spacing="4" />

                        <!-- Empty items state -->
                        <TextBlock
                            x:Name="NoItemsText"
                            Text="No items added. Search above to find and add movies or shows."
                            FontSize="13"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,8" />
                    </StackPanel>
                </Border>

                    </StackPanel>
                    </Border>

                    <StackPanel x:Name="EditorSidebar" Grid.Column="1" Spacing="18">
                        <Border x:Name="SourceSpecSheet" Style="{StaticResource EditorGroupStyle}" CornerRadius="24">
                            <StackPanel Spacing="16">
                                <TextBlock x:Name="SidebarTitle" Text="Collection Summary" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="SidebarSubtitle" Text="Preview and sharing stay visible while you edit." FontSize="12"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <Grid RowSpacing="12" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SummaryModeLabel" Text="Mode" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummaryModeText" Grid.Column="1" FontWeight="Medium" Text="Manual" />
                                    <TextBlock x:Name="SummaryLibrariesLabel" Grid.Row="1" Text="Libraries" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummaryLibrariesText" Grid.Row="1" Grid.Column="1" FontWeight="Medium" Text="All libraries" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    <TextBlock x:Name="SummarySharedLabel" Grid.Row="2" Text="Shared" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummarySharedText" Grid.Row="2" Grid.Column="1" FontWeight="Medium" Text="No" />
                                    <TextBlock x:Name="SummaryProfilesLabel" Grid.Row="3" Text="Profiles" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummaryProfilesText" Grid.Row="3" Grid.Column="1" FontWeight="Medium" Text="All profiles" />
                                    <TextBlock x:Name="SummaryLibraryTabLabel" Grid.Row="4" Text="In my library tab" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummaryLibraryTabText" Grid.Row="4" Grid.Column="1" FontWeight="Medium" Text="No" />
                                    <TextBlock x:Name="SummaryCollectionLabel" Grid.Row="5" Text="Collection" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="SummaryCollectionText" Grid.Row="5" Grid.Column="1" FontWeight="Medium" Text="New" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ===== Action Buttons ===== -->
                <StackPanel x:Name="EditorActions" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <TextBlock Text="Source-managed fields remain locked" FontSize="12"
                               Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Cancel"
                        Click="Cancel_Click"
                        Padding="20,10" />
                    <Button
                        x:Name="DiscardButton"
                        Style="{StaticResource GhostButtonStyle}"
                        Content="Discard"
                        Click="Discard_Click"
                        Padding="20,10" />
                    <Button
                        x:Name="SaveButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click"
                        Padding="20,10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                Width="16" Height="16" />
                            <TextBlock x:Name="SaveButtonText" Text="Save changes" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <Border x:Name="CollectionDirtyDock" Visibility="Collapsed" Canvas.ZIndex="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,24,24" Padding="16,12" CornerRadius="14" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="8">
                <TextBlock x:Name="CollectionDirtyCount" FontSize="13" VerticalAlignment="Center" />
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource GhostButtonStyle}" />
                <Button Content="Discard" Click="Discard_Click" />
                <Button x:Name="DockSaveButton" Content="Save changes" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
            </controls:WrapPanel>
        </Border>
    </Grid>
</Page>
