<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.ItemDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="ItemDetailPage_SizeChanged">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- F6: Skeleton placeholder — shown while ViewModel.IsLoading is
             true. Approximates the hero backdrop + title + metadata row
             layout so the user sees page structure immediately instead of
             a blank spinner. Real content fades in when loading finishes. -->
        <ScrollViewer
            x:Name="DetailSkeleton"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Current WebUI ItemDetailSkeleton: a full-bleed artwork hero
                     with the poster and information anchored at its bottom. -->
                <Grid x:Name="DetailSkeletonHero" MinHeight="420" Background="{StaticResource SurfaceBrush}">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="SkeletonLeftSolid" Color="#FF101722" Offset="0" />
                                <GradientStop x:Name="SkeletonLeftMid" Color="#B3101722" Offset="0.55" />
                                <GradientStop x:Name="SkeletonLeftSoft" Color="#33101722" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="SkeletonBottomTransparent" Color="#00101722" Offset="0" />
                                <GradientStop x:Name="SkeletonBottomSolid" Color="#FF101722" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="DetailSkeletonHeroContent" VerticalAlignment="Bottom"
                          Margin="48,112,48,32" ColumnSpacing="24" MaxWidth="1520"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="DetailSkeletonPoster" Width="220" Height="330"
                                CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" />
                        <StackPanel Grid.Column="1" MaxWidth="768" VerticalAlignment="Bottom" Spacing="12">
                            <controls:SkeletonText Width="84" Height="14" />
                            <controls:SkeletonText Width="360" Height="48" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <controls:SkeletonText Width="58" Height="18" />
                                <controls:SkeletonText Width="68" Height="18" />
                                <controls:SkeletonText Width="92" Height="18" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <controls:SkeletonText Width="620" Height="14" />
                                <controls:SkeletonText Width="540" Height="14" />
                                <controls:SkeletonText Width="430" Height="14" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Border Width="116" Height="40" CornerRadius="20" Background="{StaticResource SurfaceRaisedBrush}" />
                                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" />
                                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource SurfaceRaisedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Below-fold placeholders keep the page height and section
                     rhythm stable while the detail response is in flight. -->
                <StackPanel x:Name="DetailSkeletonSections" Padding="40,40,40,48" Spacing="48"
                            MaxWidth="1400" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="16">
                        <controls:SkeletonText Width="72" Height="22" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                            <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="16">
                        <controls:SkeletonText Width="80" Height="22" />
                        <Border Height="116" CornerRadius="12" Background="{StaticResource SurfaceBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="16">
                        <controls:SkeletonText Width="150" Height="22" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                            <controls:SkeletonPoster /><controls:SkeletonPoster />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid
            x:Name="DetailErrorPanel"
            Canvas.ZIndex="20"
            Background="{StaticResource AppBackgroundBrush}"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <StackPanel
                x:Name="DetailErrorContent"
                Margin="40,32,40,0"
                MaxWidth="1400"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <TextBlock
                    Text="Item not found."
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- SeasonContent.tsx treats an episode-query failure as a page-level
             season failure, not as a valid hero followed by a broken row. -->
        <Grid
            x:Name="SeasonEpisodesFatalError"
            Canvas.ZIndex="21"
            Background="{StaticResource AppBackgroundBrush}"
            Visibility="Collapsed">
            <StackPanel
                x:Name="SeasonEpisodesFatalErrorContent"
                Margin="48,40,48,0"
                Spacing="24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">
                <Button
                    x:Name="SeasonEpisodesBackButton"
                    HorizontalAlignment="Left"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Click="SeasonEpisodesBackButton_Click" />
                <TextBlock
                    x:Name="SeasonEpisodesFatalErrorText"
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Content -->
        <ScrollViewer
            x:Name="ContentScroll"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">

            <StackPanel>
                <!-- Backdrop hero area: 60% of viewport height -->
                <Grid x:Name="BackdropContainer" MinHeight="300">
                    <controls:BackdropImage
                        x:Name="BackdropImage"
                        AnchorY="0.2"
                        EnableKenBurns="True" />

                    <!-- Brightness overlay: web uses brightness(0.4), so ~60% darkening -->
                    <Border Background="Black" Opacity="0.6" />

                    <!-- Bottom-to-top gradient (hero-gradient) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="DetailBottomTransparent" Color="Transparent" Offset="0.0" />
                                <GradientStop x:Name="DetailBottomSoft" Color="#33101722" Offset="0.25" />
                                <GradientStop x:Name="DetailBottomMid" Color="#8C101722" Offset="0.5" />
                                <GradientStop x:Name="DetailBottomStrong" Color="#EB101722" Offset="0.8" />
                                <GradientStop x:Name="DetailBottomSolid" Color="#101722" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Left-to-right gradient (hero-gradient-left) -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="DetailLeftSolid" Color="#101722" Offset="0.0" />
                                <GradientStop x:Name="DetailLeftStrong" Color="#CC101722" Offset="0.2" />
                                <GradientStop x:Name="DetailLeftSoft" Color="#66101722" Offset="0.4" />
                                <GradientStop x:Name="DetailLeftTransparent" Color="Transparent" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Vignette: combined left + bottom gradient -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop x:Name="DetailVignetteStrong" Color="#66101722" Offset="0.0" />
                                <GradientStop x:Name="DetailVignetteSoft" Color="#33101722" Offset="0.3" />
                                <GradientStop x:Name="DetailVignetteTransparent" Color="Transparent" Offset="0.6" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Ambient glow: radial gradient from bottom tinted by dominant backdrop color.
                         Color is extracted in code-behind after backdrop loads. -->
                    <Border x:Name="AmbientGlowBorder" Opacity="0.08" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,1.0" RadiusX="0.8" RadiusY="0.6">
                                <GradientStop x:Name="AmbientGlowColor" Color="#78AEFC" Offset="0.0" />
                                <GradientStop Color="Transparent" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- WebUI DetailHero uses border-b border-border/10.
                         Keep this as an overlay so it visually separates the
                         hero from the below-fold shell without altering the
                         min-height layout. -->
                    <Border
                        VerticalAlignment="Bottom"
                        Height="1"
                        Background="{StaticResource BorderBrush}"
                        Opacity="0.1"
                        IsHitTestVisible="False" />

                    <!-- Back button -->
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="8,24,0,0"
                        Click="BackButton_Click"
                        Width="32" Height="32" CornerRadius="16" Padding="0"
                        ToolTipService.ToolTip="Go back"
                        AutomationProperties.Name="Go back">
                        <FontIcon Glyph="&#xE72B;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
                    </Button>

                    <!-- Hero content row: 170×255 poster column on the left,
                         title/metadata column on the right. Mirrors the
                         webui DetailHero layout (lib/detailHero.tsx). -->
                    <Grid
                        x:Name="HeroContentGrid"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Margin="48,0,48,24"
                        ColumnSpacing="24"
                        MaxWidth="1520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Portrait poster column -->
                        <Border
                            x:Name="HeroPosterContainer"
                            Grid.Column="0"
                            Width="170"
                            Height="255"
                            CornerRadius="16"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            VerticalAlignment="Bottom"
                            Visibility="Collapsed">
                            <Image
                                x:Name="HeroPosterImage"
                                Stretch="UniformToFill" />
                        </Border>

                        <!-- Title / metadata column -->
                        <StackPanel
                            x:Name="HeroInfoPanel"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            MaxWidth="768"
                            Spacing="6">

                            <!-- Parent navigation breadcrumbs (episodes: Series › Season › Episode).
                                 Populated in code-behind when the item is an episode. -->
                            <StackPanel
                                x:Name="BreadcrumbPanel"
                                Orientation="Horizontal"
                                Spacing="0"
                                Visibility="Collapsed" />

                            <TextBlock x:Name="EpisodeContextText"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Visibility="Collapsed" />

                            <!-- Current WebUI DetailHero context label. -->
                            <TextBlock
                                x:Name="HeroContextText"
                                Margin="0,0,0,8"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Visibility="Collapsed" />

                            <!-- Studio/network kicker (web: mb-2 text-xs font-semibold
                                 uppercase tracking-[0.16em]). Shown above the title when
                                 the item has a studio or network. -->
                            <TextBlock
                                x:Name="StudioKickerText"
                                FontSize="11"
                                FontWeight="SemiBold"
                                CharacterSpacing="160"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Visibility="Collapsed" />

                            <!-- Logo image — when LogoUrl is present, replaces the
                                 plain title with the item's stylized logo (web parity).
                                 Falls back to TitleText when no logo is available. -->
                            <Image
                                x:Name="HeroLogoImage"
                                Stretch="Uniform"
                                HorizontalAlignment="Left"
                                MaxWidth="420"
                                MaxHeight="120"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="TitleText"
                                Style="{StaticResource DisplayTextStyle}"
                                FontSize="36"
                                FontWeight="ExtraBold"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="TaglineText"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontStyle="Italic"
                                TextWrapping="Wrap"
                                MaxLines="2" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Detail content below backdrop -->
                <StackPanel x:Name="DetailContentPanel" Padding="40,40,40,48" Spacing="16"
                            MaxWidth="1400" HorizontalAlignment="Stretch">

                    <!-- Metadata row: year · content rating pill · runtime · TMDB score + quality badges -->
                    <controls:WrapPanel x:Name="HeroMetadataRow" HorizontalSpacing="8" VerticalSpacing="8">
                        <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border x:Name="YearBadge" CornerRadius="999" Padding="10,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="YearText" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" />
                            </Border>
                            <TextBlock x:Name="MetaDot1" Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed" />
                            <!-- Content rating in a pill badge -->
                            <Border x:Name="ContentRatingBadge" CornerRadius="999" Padding="10,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock x:Name="ContentRatingText" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                            <TextBlock x:Name="MetaDot2" Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="RuntimeBadge" CornerRadius="999" Padding="10,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="RuntimeText" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" />
                            </Border>
                            <Border x:Name="SeasonCountBadge" CornerRadius="999" Padding="10,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="SeasonCountText" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" />
                            </Border>
                            <Border x:Name="EpisodeCountBadge" CornerRadius="999" Padding="10,4"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="EpisodeCountText" Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" />
                            </Border>
                        </StackPanel>

                        <!-- Scores: current WebUI ScoreRow (IMDb + Rotten Tomatoes only). -->
                        <StackPanel x:Name="ScoresPanel" Orientation="Horizontal" Spacing="20" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock Text=" · " Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" VerticalAlignment="Center" />
                            <!-- IMDb score -->
                            <StackPanel x:Name="ImdbScorePanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <FontIcon Glyph="&#xE735;" FontSize="16" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ImdbScoreText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="/10" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- RT Critic score -->
                            <StackPanel x:Name="RtCriticPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="&#x1F345;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="RtCriticText" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- RT Audience score -->
                            <StackPanel x:Name="RtAudiencePanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="&#x1F37F;" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock x:Name="RtAudienceText" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Quality badges (populated in code-behind from version info) -->
                        <StackPanel x:Name="QualityBadgesPanel" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed" />
                    </controls:WrapPanel>

                    <!-- Crew line in hero: "Directed by X · Written by Y" (webui: HeroCrewLine) -->
                    <TextBlock x:Name="HeroCrewLine" FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxWidth="600"
                               Visibility="Collapsed" />

                    <!-- Genres: styled badge pills (webui: flex-wrap gap-1.5) -->
                    <StackPanel
                        x:Name="GenresBadgesPanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed" />
                    <!-- Hidden TextBlock kept for code-behind compat -->
                    <TextBlock x:Name="GenresText" Visibility="Collapsed" />

                    <!-- Action buttons row -->
                    <controls:WrapPanel x:Name="HeroActionsRow" HorizontalSpacing="12" VerticalSpacing="10">

                        <!-- Split play button: [Play / Resume ... | dropdown] -->
                        <Grid x:Name="SplitPlayButton" Height="44" CornerRadius="22" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Accent background spanning both columns -->
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="22" />

                            <!-- Progress bar overlay -->
                            <Border x:Name="PlayProgressBar" CornerRadius="22"
                                    HorizontalAlignment="Left" Width="0" Opacity="0.2" IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource AccentForegroundColor}" />
                                </Border.Background>
                            </Border>

                            <!-- Main play/resume button -->
                            <Button x:Name="PrimaryPlayButton" Grid.Column="0" Click="PlayButton_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="12,10" CornerRadius="22"
                                AutomationProperties.Name="{Binding Text, ElementName=PlayButtonText}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="PlayButtonIcon" Glyph="&#xE768;" FontSize="18" Foreground="{StaticResource AccentForegroundBrush}" />
                                    <TextBlock x:Name="PlayButtonText" Text="Play" Foreground="{StaticResource AccentForegroundBrush}" FontWeight="Bold" FontSize="15" CharacterSpacing="25" />
                                </StackPanel>
                            </Button>

                            <!-- Dropdown arrow for versions — shows the active version's quality
                                 summary beside the chevron (webui commit a42f46b). -->
                            <Button x:Name="VersionDropdownButton" Grid.Column="1"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="12,0" CornerRadius="16" Visibility="Collapsed"
                                AutomationProperties.Name="Version">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE958;" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" />
                                    <TextBlock Text="Version" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VersionSummaryText" Text=""
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="VersionFlyout" />
                                </Button.Flyout>
                            </Button>

                            <!-- Left border separator between play and dropdown -->
                            <Border x:Name="VersionSeparator" Grid.Column="1" Width="1" Opacity="0.3" HorizontalAlignment="Left" Visibility="Collapsed">
                                <Border.Background>
                                    <SolidColorBrush Color="{StaticResource AccentForegroundColor}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <!-- Audio tracks popover (pre-play selection) — Phase 2a.
                             Visible only when the current version has 2+ audio tracks.
                             Flyout is populated programmatically from the version's audio_tracks[]. -->
                        <Button
                            x:Name="EditionButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="12,0"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Edition">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Edition" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="EditionSummaryText" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="EditionFlyout" />
                            </Button.Flyout>
                        </Button>

                        <Button
                            x:Name="AudioTracksButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="12,0"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Audio">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Audio" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" />
                                <TextBlock x:Name="AudioTracksSummary" Text="" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioTracksFlyout" />
                            </Button.Flyout>
                        </Button>

                        <!-- Subtitles popover (pre-play selection) — Phase 2b.
                             Visible only when the current version has subtitle tracks or downloaded subs.
                             Flyout populated from version.subtitle_tracks + WatchDetail.subtitles. -->
                        <Button
                            x:Name="SubtitlesPopoverButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="32" Padding="12,0"
                            CornerRadius="16"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Subtitles">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED1E;" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Subs" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" />
                                <TextBlock x:Name="SubtitlesSummary" Text="" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="SubtitlesPopoverFlyout" />
                            </Button.Flyout>
                        </Button>

                        <!-- Watched toggle button -->
                        <Button
                            x:Name="WatchedButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="WatchedButton_Click"
                            Height="44"
                            Padding="12,10"
                            CornerRadius="22"
                            AutomationProperties.Name="{Binding Text, ElementName=WatchedText}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="18"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="WatchedText" Text="Mark Watched" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Favorite button (icon only, pill) -->
                        <Button
                            x:Name="FavoriteButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="FavoriteButton_Click"
                            Width="44" Height="44" Padding="0"
                            CornerRadius="22"
                            ToolTipService.ToolTip="Favorite"
                            AutomationProperties.Name="Favorite">
                            <FontIcon x:Name="FavoriteIcon" Glyph="&#xEB51;" FontSize="18"
                                      Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>

                        <Button x:Name="AddCollectionButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,10" CornerRadius="22"
                                Click="AddCollectionButton_Click"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Add to Collection">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                                <TextBlock Text="Add to Collection" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ListenFromStartButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,10" CornerRadius="22"
                                Click="PlayFromStart_Click"
                                Content="Listen from Start"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Listen from Start" />

                        <Button x:Name="BookDownloadButton"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,10" CornerRadius="22"
                                Click="DownloadButton_Click"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Download">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="16" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                        </Button>

                        <!-- Star rating: 5 stars wrapped in a glass-subtle
                             rounded capsule (web parity). PointerEntered /
                             Exited on each star drive the hover preview. -->
                        <Border
                            x:Name="StarRatingContainer"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="6,2"
                            PointerExited="StarPanel_PointerExited"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Rating">
                            <StackPanel x:Name="StarRatingPanel" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <Button x:Name="Star1" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" PointerEntered="Star_PointerEntered" KeyDown="Star_KeyDown" IsTabStop="True" Tag="1" AutomationProperties.Name="1 star">
                                    <FontIcon x:Name="Star1Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Button>
                                <Button x:Name="Star2" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" PointerEntered="Star_PointerEntered" KeyDown="Star_KeyDown" IsTabStop="False" Tag="2" AutomationProperties.Name="2 stars">
                                    <FontIcon x:Name="Star2Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Button>
                                <Button x:Name="Star3" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" PointerEntered="Star_PointerEntered" KeyDown="Star_KeyDown" IsTabStop="False" Tag="3" AutomationProperties.Name="3 stars">
                                    <FontIcon x:Name="Star3Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Button>
                                <Button x:Name="Star4" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" PointerEntered="Star_PointerEntered" KeyDown="Star_KeyDown" IsTabStop="False" Tag="4" AutomationProperties.Name="4 stars">
                                    <FontIcon x:Name="Star4Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Button>
                                <Button x:Name="Star5" Style="{StaticResource GhostButtonStyle}" Padding="4,6" Click="Star_Click" PointerEntered="Star_PointerEntered" KeyDown="Star_KeyDown" IsTabStop="False" Tag="5" AutomationProperties.Name="5 stars">
                                    <FontIcon x:Name="Star5Icon" Glyph="&#xE735;" FontSize="18" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- "More" kebab menu — consolidates less-common actions
                             (Watchlist, Download, admin Match/Refresh) to reduce
                             action bar clutter. Matches webui 3-dot overflow. -->
                        <Button
                            x:Name="MoreButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="44" Height="44" Padding="0"
                            CornerRadius="22"
                            ToolTipService.ToolTip="More"
                            AutomationProperties.Name="More">
                            <FontIcon Glyph="&#xE712;" FontSize="16"
                                      Foreground="{StaticResource PrimaryTextBrush}" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="MoreFlyout" />
                            </Button.Flyout>
                        </Button>

                        <!-- Hidden elements kept for code-behind references but
                             no longer directly in the action bar layout. Their
                             state is driven by the More flyout items instead. -->
                        <Button x:Name="WatchlistButton" Visibility="Collapsed" />
                        <Button x:Name="DownloadButton" Visibility="Collapsed" />
                        <Button x:Name="MatchButton" Visibility="Collapsed" />

                        <!-- Refresh metadata (admin only) — B12 -->
                        <Button
                            x:Name="RefreshMetadataButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshMetadataButton_Click"
                            Padding="16,10"
                            CornerRadius="22"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Refresh metadata" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Edit metadata (admin only) — inline dialog with title, year, overview, rating -->
                        <Button
                            x:Name="EditMetadataButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="EditMetadataButton_Click"
                            Padding="16,10"
                            CornerRadius="22"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="16"
                                          Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Edit metadata" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:WrapPanel>

                    <!-- The current WebUI keeps Version, Audio, and Subtitles
                         together in a compact second row. ComposeHeroLayout
                         moves the existing controls here once at construction. -->
                    <controls:WrapPanel x:Name="PlaybackOptionsRow"
                                        HorizontalSpacing="8" VerticalSpacing="8" />

                    <!-- Overview -->
                    <TextBlock
                        x:Name="OverviewText"
                        Style="{StaticResource BodyTextStyle}"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="672"
                        HorizontalAlignment="Left"
                        LineHeight="24"
                        FontSize="15" />

                    <Button x:Name="TranslateOverviewButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Translate description"
                            Click="TranslateOverviewButton_Click"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            CornerRadius="16"
                            Visibility="Collapsed" />

                    <!-- Media locations (admin-only) — current WebUI renders this
                         immediately after the hero/action/overview block on leaf
                         items, before trailers, extras, cast, and recommendations. -->
                    <StackPanel x:Name="MediaLocationsSection" Visibility="Collapsed" Spacing="12">
                        <!-- WebUI MediaLocations.tsx: space-y-3 + text-base font-semibold tracking-tight. -->
                        <TextBlock x:Name="MediaLocationsTitle" Text="Media locations" Style="{StaticResource TitleTextStyle}" FontSize="16" />
                        <StackPanel x:Name="MediaLocationsPanel" Spacing="8" />
                    </StackPanel>

                    <!-- Remote provider videos. The current WebUI exposes only
                         YouTube entries and opens them in a privacy-enhanced embed. -->
                    <StackPanel x:Name="TrailersSection" Visibility="Collapsed" Spacing="20">
                        <TextBlock Text="Trailers &amp; More" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      IsTabStop="True"
                                      KeyDown="HorizontalCarousel_KeyDown"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel x:Name="TrailersPanel" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Local extras are first-class watch targets, grouped by kind
                         in the order supplied by the server. -->
                    <StackPanel x:Name="ExtrasSection" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Extras" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                        <StackPanel x:Name="ExtrasGroupsPanel" Spacing="24" />
                    </StackPanel>

                    <StackPanel x:Name="BookRelatedSection" Visibility="Collapsed" Spacing="28" Margin="0,16,0,0">
                        <StackPanel x:Name="BookRelatedGroupsPanel" Spacing="28" />
                    </StackPanel>

                    <StackPanel x:Name="AudiobookChaptersSection" Visibility="Collapsed" Spacing="12" Margin="0,16,0,0">
                        <TextBlock Text="Chapters" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                        <StackPanel x:Name="AudiobookChaptersPanel" Spacing="2" />
                    </StackPanel>

                    <StackPanel x:Name="MangaChaptersSection" Visibility="Collapsed" Spacing="12" Margin="0,16,0,0">
                        <Grid>
                            <TextBlock Text="Chapters" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="MangaProgressText" VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                                <Button x:Name="MangaJumpButton" Visibility="Collapsed"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="8,4" Click="MangaJumpButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE74B;" FontSize="13" />
                                        <TextBlock x:Name="MangaJumpButtonText" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="MangaChaptersPanel" Spacing="1" />
                    </StackPanel>

                    <!-- Cast section -->
                    <StackPanel x:Name="CastSection" Visibility="Collapsed" Spacing="20">
                        <TextBlock
                            x:Name="CastHeader"
                            Text="Cast"
                            Style="{StaticResource TitleTextStyle}" />

                        <ScrollViewer
                            x:Name="CastScrollViewer"
                            IsTabStop="True"
                            KeyDown="HorizontalCarousel_KeyDown"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel x:Name="CastPanel" Orientation="Horizontal" Spacing="12" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Crew section (directors + writers) -->
                    <StackPanel x:Name="CrewSection" Visibility="Collapsed" Spacing="16">
                        <TextBlock Text="Crew" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20,16">
                            <StackPanel Spacing="12">
                                <Grid x:Name="DirectorsPanel" ColumnDefinitions="Auto,*" ColumnSpacing="24" Visibility="Collapsed">
                                    <TextBlock Text="Directors" Width="88" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="DirectorNamesPanel" Grid.Column="1" Orientation="Horizontal" Spacing="0" />
                                </Grid>
                                <Grid x:Name="WritersPanel" ColumnDefinitions="Auto,*" ColumnSpacing="24" Visibility="Collapsed">
                                    <TextBlock Text="Writers" Width="88" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="WriterNamesPanel" Grid.Column="1" Orientation="Horizontal" Spacing="0" />
                                </Grid>
                                <Grid x:Name="ProducersPanel" ColumnDefinitions="Auto,*" ColumnSpacing="24" Visibility="Collapsed">
                                    <TextBlock Text="Producers" Width="88" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <StackPanel x:Name="ProducerNamesPanel" Grid.Column="1" Orientation="Horizontal" Spacing="0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Studios row -->
                    <TextBlock
                        x:Name="StudiosText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Networks row (series only) -->
                    <TextBlock
                        x:Name="NetworksText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Countries row -->
                    <TextBlock
                        x:Name="CountriesText"
                        FontSize="13"
                        Foreground="{StaticResource TertiaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />

                    <!-- Subtitles section (downloaded subs for the current file) -->
                    <StackPanel x:Name="SubtitlesSection" Visibility="Collapsed" Spacing="8" Margin="0,12,0,0">
                        <TextBlock
                            Text="Subtitles"
                            Style="{StaticResource TitleTextStyle}"
                            FontSize="18" />
                        <StackPanel x:Name="SubtitlesList" Spacing="6" />
                    </StackPanel>

                    <!-- Seasons (for series only) -->
                    <StackPanel x:Name="SeasonsSection" Visibility="Collapsed" Spacing="12">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Seasons" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                            <TextBlock x:Name="SeasonsTotalText" HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom" FontSize="14"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <StackPanel x:Name="SeasonsLoadingSkeleton"
                                    Orientation="Horizontal" Spacing="16"
                                    Visibility="Collapsed">
                            <controls:SkeletonPoster Width="170" Height="255" />
                            <controls:SkeletonPoster Width="170" Height="255" />
                            <controls:SkeletonPoster Width="170" Height="255" />
                            <controls:SkeletonPoster Width="170" Height="255" />
                            <controls:SkeletonPoster Width="170" Height="255" />
                        </StackPanel>
                        <Border x:Name="SeasonsLoadError" Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Seasons could not be loaded." VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Try again" Click="RetrySeasonsButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <ScrollViewer x:Name="SeasonsScrollViewer"
                                IsTabStop="True"
                                KeyDown="HorizontalCarousel_KeyDown"
                                ViewChanged="SeasonsScrollViewer_ViewChanged"
                                SizeChanged="SeasonsScrollViewer_SizeChanged"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollMode="Disabled">
                                <StackPanel x:Name="SeasonsPanel" Orientation="Horizontal" Spacing="16" />
                            </ScrollViewer>
                            <Button
                                x:Name="SeasonsPrevButton"
                                Width="44"
                                Height="44"
                                Padding="0"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Click="SeasonsPrev_Click"
                                AutomationProperties.Name="Scroll seasons left"
                                ToolTipService.ToolTip="Scroll left">
                                <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Button>
                            <Button
                                x:Name="SeasonsNextButton"
                                Width="44"
                                Height="44"
                                Padding="0"
                                CornerRadius="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Click="SeasonsNext_Click"
                                AutomationProperties.Name="Scroll seasons right"
                                ToolTipService.ToolTip="Scroll right">
                                <FontIcon Glyph="&#xE76C;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Episodes (shown when a season is selected) -->
                    <StackPanel x:Name="EpisodesSection" Visibility="Collapsed" Spacing="12">
                        <Grid>
                            <TextBlock x:Name="EpisodesHeader" Style="{StaticResource TitleTextStyle}" FontSize="18" />
                            <TextBlock x:Name="EpisodesTotalText"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <controls:WrapPanel x:Name="EpisodesLoadingSkeleton"
                                            HorizontalSpacing="16" VerticalSpacing="16"
                                            Visibility="Collapsed">
                            <StackPanel Width="260" Spacing="8"><controls:SkeletonBackdrop Width="260" Height="146"/><controls:SkeletonText Width="190" Height="16"/></StackPanel>
                            <StackPanel Width="260" Spacing="8"><controls:SkeletonBackdrop Width="260" Height="146"/><controls:SkeletonText Width="210" Height="16"/></StackPanel>
                            <StackPanel Width="260" Spacing="8"><controls:SkeletonBackdrop Width="260" Height="146"/><controls:SkeletonText Width="175" Height="16"/></StackPanel>
                            <StackPanel Width="260" Spacing="8"><controls:SkeletonBackdrop Width="260" Height="146"/><controls:SkeletonText Width="205" Height="16"/></StackPanel>
                        </controls:WrapPanel>
                        <Border x:Name="EpisodesLoadError" Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Episodes could not be loaded." VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Try again" Click="RetryEpisodesButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="EpisodesEmptyState"
                            Visibility="Collapsed"
                            Padding="20"
                            CornerRadius="8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                            <TextBlock
                                Text="No episodes are available for this season yet."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>
                        <!-- Grid container populated in code-behind: responsive column count
                             driven by available width, mirrors upstream's grid-cols-1 →
                             grid-cols-5 pattern. Cards placed at (row, col) programmatically. -->
                        <Grid x:Name="EpisodesPanel" SizeChanged="EpisodesPanel_SizeChanged" />
                    </StackPanel>

                    <!-- Sibling Episodes (shown when viewing an episode — other episodes in same season) -->
                    <StackPanel x:Name="SiblingEpisodesSection" Visibility="Collapsed" Spacing="20">
                        <Grid>
                            <TextBlock x:Name="SiblingEpisodesTitle" Text="More Episodes" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                            <StackPanel
                                x:Name="SiblingEpisodesArrowPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="SiblingEpisodesPrevButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Click="SiblingEpisodesPrev_Click"
                                    ToolTipService.ToolTip="Previous episodes">
                                    <FontIcon Glyph="&#xE76B;" FontSize="18" Foreground="{StaticResource PrimaryTextBrush}" />
                                </Button>
                                <Button
                                    x:Name="SiblingEpisodesNextButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="18"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Click="SiblingEpisodesNext_Click"
                                    ToolTipService.ToolTip="Next episodes">
                                    <FontIcon Glyph="&#xE76C;" FontSize="18" Foreground="{StaticResource PrimaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="SiblingEpisodesLoadingSkeleton" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                            <StackPanel Width="240" Spacing="8"><controls:SkeletonBackdrop Width="240" Height="135"/><controls:SkeletonText Width="180" Height="16"/></StackPanel>
                            <StackPanel Width="240" Spacing="8"><controls:SkeletonBackdrop Width="240" Height="135"/><controls:SkeletonText Width="200" Height="16"/></StackPanel>
                            <StackPanel Width="240" Spacing="8"><controls:SkeletonBackdrop Width="240" Height="135"/><controls:SkeletonText Width="165" Height="16"/></StackPanel>
                        </StackPanel>
                        <Border x:Name="SiblingEpisodesLoadError" Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="More episodes could not be loaded." VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Try again" Click="RetrySiblingEpisodesButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer
                            x:Name="SiblingEpisodesScrollViewer"
                            IsTabStop="True"
                            KeyDown="HorizontalCarousel_KeyDown"
                            ViewChanged="SiblingEpisodesScrollViewer_ViewChanged"
                            SizeChanged="SiblingEpisodesScrollViewer_SizeChanged"
                            PointerPressed="SiblingEpisodesScrollViewer_PointerPressed"
                            PointerMoved="SiblingEpisodesScrollViewer_PointerMoved"
                            PointerReleased="SiblingEpisodesScrollViewer_PointerReleased"
                            PointerCanceled="SiblingEpisodesScrollViewer_PointerCanceled"
                            PointerCaptureLost="SiblingEpisodesScrollViewer_PointerCaptureLost"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollMode="Disabled">
                            <StackPanel
                                x:Name="SiblingEpisodesPanel"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="16,0,0,0" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- More Like This section -->
                    <StackPanel x:Name="SimilarSection" Visibility="Collapsed" Spacing="20">
                        <TextBlock Text="More Like This" Style="{StaticResource TitleTextStyle}" FontSize="20" />
                        <controls:WrapPanel x:Name="SimilarLoadingSkeleton"
                                            HorizontalSpacing="12" VerticalSpacing="12"
                                            Visibility="Collapsed">
                            <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                            <controls:SkeletonPoster /><controls:SkeletonPoster /><controls:SkeletonPoster />
                        </controls:WrapPanel>
                        <Border x:Name="SimilarLoadError" Visibility="Collapsed"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="Recommendations could not be loaded." VerticalAlignment="Center"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Try again" Click="RetrySimilarButton_Click"
                                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                            </StackPanel>
                        </Border>
                        <controls:WrapPanel x:Name="SimilarPanel" HorizontalSpacing="12" VerticalSpacing="12" />
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
