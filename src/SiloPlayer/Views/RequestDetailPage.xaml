<Page
    x:Class="SiloPlayer.Views.RequestDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer>
        <Grid x:Name="RootGrid" MinHeight="720">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" MinHeight="620">
                <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.48" />
                <Rectangle>
                    <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#FF0B0C0F" Offset="0" /><GradientStop Color="#E60B0C0F" Offset="0.45" /><GradientStop Color="#330B0C0F" Offset="1" /></LinearGradientBrush></Rectangle.Fill>
                </Rectangle>
                <Rectangle VerticalAlignment="Bottom" Height="250"><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#000B0C0F" /><GradientStop Color="#FF0B0C0F" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                <Button VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24" Width="44" Height="44" Click="Back_Click"><FontIcon Glyph="&#xE72B;" /></Button>
                <Grid Margin="54,104,54,46" VerticalAlignment="Bottom" ColumnSpacing="34">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border CornerRadius="10" Background="#25272D" VerticalAlignment="Bottom"><Image x:Name="PosterImage" Stretch="UniformToFill" /></Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="13" MaxWidth="850" HorizontalAlignment="Left">
                        <TextBlock x:Name="ContextText" Text="REQUEST" FontSize="12" FontWeight="SemiBold" CharacterSpacing="190" Opacity="0.65" />
                        <TextBlock x:Name="StudioText" FontSize="13" FontWeight="SemiBold" Opacity="0.75" />
                        <TextBlock x:Name="TitleText" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="TaglineText" FontSize="17" FontStyle="Italic" Opacity="0.72" TextWrapping="Wrap" />
                        <StackPanel x:Name="MetadataPanel" Orientation="Horizontal" Spacing="10" />
                        <TextBlock x:Name="ScoreText" FontSize="13" Foreground="#FFF4C95D" />
                        <TextBlock x:Name="CrewText" FontSize="13" Opacity="0.76" TextWrapping="Wrap" />
                        <TextBlock x:Name="OverviewText" FontSize="15" LineHeight="23" MaxWidth="800" TextWrapping="Wrap" MaxLines="6" />
                        <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Spacing="10" />
                    </StackPanel>
                </Grid>
            </Grid>
            <StackPanel Grid.Row="1" Padding="54,20,54,50" Spacing="34">
                <StackPanel x:Name="CastSection" Spacing="14">
                    <TextBlock Text="Cast" FontSize="22" FontWeight="SemiBold" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CastPanel" Orientation="Horizontal" Spacing="12" /></ScrollViewer>
                </StackPanel>
                <StackPanel x:Name="RecommendationsSection" Spacing="14">
                    <TextBlock Text="More Like This" FontSize="22" FontWeight="SemiBold" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="RecommendationsPanel" Orientation="Horizontal" Spacing="12" /></ScrollViewer>
                </StackPanel>
            </StackPanel>
            <Grid x:Name="LoadingLayer" Grid.RowSpan="2" Background="{StaticResource AppBackgroundBrush}">
                <Grid x:Name="DetailSkeleton" Margin="54,105,54,50" VerticalAlignment="Center" ColumnSpacing="34">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:SkeletonPoster Width="210" Height="315" />
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center" MaxWidth="760" HorizontalAlignment="Left">
                        <controls:SkeletonText Width="110" Height="14" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="470" Height="42" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="280" Height="20" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="700" Height="15" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="640" Height="15" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="520" Height="15" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="180" Height="44" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
                <ProgressRing x:Name="LoadingRing" IsActive="False" Visibility="Collapsed" />
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
