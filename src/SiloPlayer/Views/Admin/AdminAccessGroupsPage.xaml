<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminAccessGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels.Admin"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel Padding="40,28,40,48" Spacing="20">
            <StackPanel
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsListVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Access Groups" FontSize="42" FontWeight="Bold" />
                        <TextBlock
                            Text="Shared access defaults for a set of users. A member's own restrictions still apply on top — a group grants the most a member can do, never more."
                            FontSize="14"
                            MaxWidth="820"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Content="＋  New group"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="NewGroup_Click"
                        Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox
                            x:Name="NewGroupNameBox"
                            Width="320"
                            PlaceholderText="Group name (e.g. Kids, Guests)"
                            Text="{x:Bind ViewModel.NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="NewGroupNameBox_KeyDown" />
                        <Button Content="Create" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CreateCommand}" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelCreate_Click" />
                    </StackPanel>
                </Border>

                <ProgressRing
                    Width="32" Height="32"
                    HorizontalAlignment="Center"
                    Margin="0,24"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="32"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="30" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="No access groups yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Create a group to manage libraries, downloads, streams, and permissions for many users at once, then assign users to it from their profile."
                            MaxWidth="520"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <GridView
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="GroupGrid_ItemClick"
                    SelectionMode="None"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,14,14" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccessGroupCardViewModel">
                            <Border
                                Width="340"
                                MinHeight="150"
                                Padding="20"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Padding="7,2"
                                                    CornerRadius="8"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="DEFAULT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="9,3" CornerRadius="10" Background="{StaticResource SurfaceHoverBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind MemberLabel}" FontSize="11" FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind LibraryLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind DownloadLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind StreamLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind RequestLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel
                Spacing="18"
                Visibility="{x:Bind ViewModel.IsEditorVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button Content="←  All groups" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="AllGroups_Click" />

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Group details" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" FontWeight="SemiBold" FontSize="13" />
                                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Description" FontWeight="SemiBold" FontSize="13" />
                                <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
                            </StackPanel>
                        </Grid>
                        <Grid Padding="12" ColumnSpacing="16" Background="{StaticResource SurfaceHoverBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default for new users" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Newly created accounts are placed in this group automatically. Existing users are never moved." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDefault, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeDefault, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Libraries &amp; playback" FontSize="18" FontWeight="SemiBold" />
                        <ToggleSwitch Header="All libraries" IsOn="{x:Bind ViewModel.AllLibraries, Mode=TwoWay}" />
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectSpecificLibraries, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccessGroupLibraryOptionViewModel">
                                    <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Maximum playback quality" FontWeight="SemiBold" FontSize="13" />
                            <ComboBox Width="360" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.QualityPreset, Mode=TwoWay}">
                                <ComboBoxItem Content="Any — Allow all resolutions" Tag="any" />
                                <ComboBoxItem Content="Standard — Hide 4K and higher versions" Tag="standard" />
                                <ComboBoxItem Content="4K — Allow 4K and lower versions" Tag="4k" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Downloads &amp; requests" FontSize="18" FontWeight="SemiBold" />
                        <ToggleSwitch Header="Allow downloads" OffContent="Members cannot download items" OnContent="Members may download items" IsOn="{x:Bind ViewModel.DownloadAllowed, Mode=TwoWay}" />
                        <ToggleSwitch Header="Allow transcoded downloads" OffContent="Original files only" OnContent="Converted versions may be downloaded" IsOn="{x:Bind ViewModel.DownloadTranscodeAllowed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DownloadAllowed, Mode=OneWay}" />
                        <ToggleSwitch Header="Allow media requests" OffContent="Requests disabled" OnContent="Members may request missing titles" IsOn="{x:Bind ViewModel.RequestsAllowed, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Concurrent streams" FontSize="18" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Max streams (0 = unlimited)" FontWeight="SemiBold" FontSize="13" />
                                <NumberBox Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MaxStreams, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Max transcodes (0 = unlimited)" FontWeight="SemiBold" FontSize="13" />
                                <NumberBox Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MaxTranscodes, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Permissions" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="A member also needs the permission granted on their own account." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Header="Allow all" IsOn="{x:Bind ViewModel.AllPermissions, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectSpecificPermissions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ToggleSwitch Header="Metadata curation" OffContent="Not granted" OnContent="Edit metadata for items in member libraries" IsOn="{x:Bind ViewModel.MetadataCurationAllowed, Mode=TwoWay}" />
                            <ToggleSwitch Header="Marker editing" OffContent="Not granted" OnContent="Create and adjust intro / credit markers" IsOn="{x:Bind ViewModel.MarkerEditingAllowed, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <Button Content="Delete group" Style="{StaticResource DestructiveButtonStyle}" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" Click="DeleteGroup_Click" />
                        <TextBlock Text="The default group can't be deleted. Make another group the default first." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{x:Bind ViewModel.IsDefaultLocked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Save changes" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                </Grid>
            </StackPanel>

            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />
            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{StaticResource SuccessBrush}"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
