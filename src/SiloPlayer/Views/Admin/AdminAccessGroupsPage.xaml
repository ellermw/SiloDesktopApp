<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminAccessGroupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels.Admin"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <Style TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="44" />
        </Style>
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel x:Name="AccessGroupsPageShell" Padding="32,24,32,48" Spacing="24" MaxWidth="1400" HorizontalAlignment="Center">
            <StackPanel
                Spacing="24"
                Visibility="{x:Bind ViewModel.IsListVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid x:Name="AccessGroupsHeaderGrid" ColumnSpacing="24" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Access Groups" FontSize="48" FontWeight="Bold" />
                        <TextBlock
                            Text="Shared access defaults for a set of users. A member's own restrictions still apply on top — a group grants the most a member can do, never more."
                            FontSize="14"
                            MaxWidth="820"
                            HorizontalAlignment="Left"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="NewGroupButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="NewGroup_Click"
                        Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New group" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="16"
                    Visibility="{x:Bind ViewModel.IsCreating, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel x:Name="CreateGroupPanel" Orientation="Horizontal" Spacing="10">
                        <TextBox
                            x:Name="NewGroupNameBox"
                            MinWidth="240"
                            PlaceholderText="Group name (e.g. Kids, Guests)"
                            Text="{x:Bind ViewModel.NewGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="NewGroupNameBox_KeyDown" />
                        <Button Content="Create" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.CreateCommand}"
                                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelCreate_Click" />
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="Loading access groups..."
                    FontSize="14"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Border
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="16"
                    Padding="32"
                    Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="30" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="No access groups yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="Create a group to manage libraries, downloads, streams, and permissions for many users at once, then assign users to it from their profile."
                            MaxWidth="520"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <GridView
                    x:Name="GroupsGridView"
                    ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                    IsItemClickEnabled="True"
                    ItemClick="GroupGrid_ItemClick"
                    SelectionMode="None"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.HasGroups, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,14,14" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccessGroupCardViewModel">
                            <Border
                                MinHeight="140"
                                HorizontalAlignment="Stretch"
                                Padding="20"
                                Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <Border
                                                    Padding="7,2"
                                                    CornerRadius="8"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    Visibility="{x:Bind IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="DEFAULT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="9,3" CornerRadius="10" Background="{StaticResource SurfaceHoverBrush}" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind MemberLabel}" FontSize="12" FontWeight="Medium" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind LibraryLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind DownloadLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind StreamLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                        <Border Padding="7,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="{x:Bind RequestLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <StackPanel
                Spacing="20"
                Visibility="{x:Bind ViewModel.IsEditorVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="AllGroups_Click" Padding="8,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="All groups" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Button>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid x:Name="GroupIdentityGrid" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" FontWeight="SemiBold" FontSize="13" />
                                <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Description" FontWeight="SemiBold" FontSize="13" />
                                <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
                            </StackPanel>
                        </Grid>
                        <Grid Padding="12" ColumnSpacing="16" Background="{StaticResource SurfaceHoverBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default for new users" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.DefaultGroupDescription, Mode=OneWay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.IsDefault, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeDefault, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Libraries &amp; playback" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Library Access" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="All libraries" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AllLibraries, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.Libraries, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SelectSpecificLibraries, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccessGroupLibraryOptionViewModel">
                                    <CheckBox Content="{x:Bind Name}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Maximum playback quality" FontWeight="SemiBold" FontSize="13" />
                            <ComboBox Width="288" HorizontalAlignment="Left" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.QualityPreset, Mode=TwoWay}">
                                <ComboBoxItem Content="Any — Allow all resolutions" Tag="any" />
                                <ComboBoxItem Content="Standard — Hide 4K and higher versions" Tag="standard" />
                                <ComboBoxItem Content="4K — Allow 4K and lower versions" Tag="4k" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Downloads &amp; requests" FontSize="14" FontWeight="SemiBold" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Allow downloads" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Members may download items to their devices." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DownloadAllowed, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Allow transcoded downloads" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Members may download converted versions, not just the original file." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DownloadTranscodeAllowed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DownloadAllowed, Mode=OneWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock Text="Allow media requests" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Members may request titles that aren't in the library yet." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.RequestsAllowed, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Concurrent streams" FontSize="14" FontWeight="SemiBold" />
                        <Grid x:Name="StreamLimitsGrid" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="5">
                                <Grid><TextBlock Text="Max streams" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="0 = unlimited" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" /></Grid>
                                <NumberBox Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MaxStreams, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <Grid><TextBlock Text="Max transcodes" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="0 = unlimited" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" /></Grid>
                                <NumberBox Minimum="0" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.MaxTranscodes, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Permissions" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="A member also needs the permission granted on their own account." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Allow all" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.AllPermissions, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SelectSpecificPermissions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2"><TextBlock Text="Metadata curation" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Edit metadata for items in the member's libraries." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MetadataCurationAllowed, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2"><TextBlock Text="Marker editing" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Create and adjust intro / credit markers." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MarkerEditingAllowed, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="GroupEditorFooter" ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <Button Background="Transparent" BorderThickness="0" Foreground="{StaticResource ErrorBrush}"
                                HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}" Click="DeleteGroup_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Delete group" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="The default group can't be deleted. Make another group the default first." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Visibility="{x:Bind ViewModel.IsDefaultLocked, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Button x:Name="SaveGroupButton" Grid.Column="1" Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
