<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminHistoryImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsScrollInertiaEnabled="True">
            <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
            <StackPanel
                Padding="32,24,32,40"
                Spacing="24"
                MaxWidth="1400"
                HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="12">
                    <TextBlock Text="History Import"
                               FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Import watch history from external servers into Silo user profiles."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Loading -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center" Width="32" Height="32" />

                <!-- Error -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                           TextWrapping="Wrap" />

                <!-- ===== Source Bar ===== -->
                <Border Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="{StaticResource RadiusLG}" Padding="16">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ComboBox x:Name="SourceComboBox"
                                      MinWidth="220" FontSize="13"
                                      PlaceholderText="Select a source..."
                                      SelectionChanged="SourceComboBox_SelectionChanged" />
                            <TextBlock x:Name="SourceUrlText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnSetToken" Content="Set API key"
                                    Style="{StaticResource OutlineButtonStyle}" FontSize="13"
                                    Click="BtnSetToken_Click" />
                            <Button x:Name="BtnEditSource" Content="Edit server"
                                    Style="{StaticResource OutlineButtonStyle}" FontSize="13"
                                    Click="BtnEditSource_Click" />
                            <Button x:Name="BtnDeleteSource" FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="BtnDeleteSource_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                            <Button x:Name="BtnNewSource" Content="Add"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="BtnNewSource_Click" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="TokenStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TokenBadgeText" Text="API key not configured" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Mappings Section ===== -->
                <StackPanel x:Name="MappingsSection" Spacing="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="User mappings" FontSize="18" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnDiscoverUsers" Content="Discover users"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="BtnDiscoverUsers_Click" />
                            <Button x:Name="BtnBulkRun" Content="Run All"
                                    Style="{StaticResource OutlineButtonStyle}" FontSize="13"
                                    Click="BtnBulkRun_Click" />
                            <Button x:Name="BtnAddMapping" Content="Add Mapping"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="BtnAddMapping_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusLG}">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="16,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Source User" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="Silo User" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Profile" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="Last Imported" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Actions" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                            <StackPanel x:Name="MappingsRowsPanel" Spacing="0" />
                            <StackPanel x:Name="NoMappingsText" Spacing="12" HorizontalAlignment="Center" Padding="0,36" Visibility="Collapsed">
                                <TextBlock Text="No user mappings yet. Discover users on the server to create mappings." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button Content="Discover users" HorizontalAlignment="Center" Click="BtnDiscoverUsers_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Runs Section ===== -->
                <StackPanel x:Name="RunsSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="Recent Imports" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource PrimaryTextBrush}" />

                    <StackPanel x:Name="RunsPanel" Spacing="8" />

                    <TextBlock x:Name="NoRunsText" Text="No import runs yet."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
