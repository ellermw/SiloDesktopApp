<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminHistoryImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsScrollInertiaEnabled="True">
            <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
            <StackPanel
                Padding="40,32,40,40"
                Spacing="32"
                MaxWidth="1400"
                HorizontalAlignment="Center">

                <!-- Header -->
                <StackPanel Spacing="12">
                    <TextBlock Text="History Import"
                               FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Import watch history from external servers into Silo user profiles."
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- Loading -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center" Width="32" Height="32" />

                <!-- Error -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                           TextWrapping="Wrap" />

                <!-- ===== Source Bar ===== -->
                <Border x:Name="NoSourcesCard"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="{StaticResource RadiusXL}"
                        Padding="24,48"
                        Visibility="Collapsed">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE968;" FontSize="24"
                                      Foreground="{StaticResource SecondaryTextBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="No source servers" FontSize="14" FontWeight="Medium"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Add the Jellyfin, Emby, or Plex server you want to import watch history from."
                                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                        <Button Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center" Click="BtnNewSource_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add server" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border x:Name="SourceBarCard"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="{StaticResource Radius2XL}" Padding="16">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ComboBox x:Name="SourceComboBox"
                                      Width="220" FontSize="13"
                                      PlaceholderText="Select a source..."
                                      SelectionChanged="SourceComboBox_SelectionChanged" />
                            <TextBlock x:Name="SourceUrlText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnSetToken"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="36" Height="32" Padding="0"
                                    Click="BtnSetToken_Click"
                                    ToolTipService.ToolTip="Set API key">
                                <FontIcon Glyph="&#xE72E;" FontSize="13" />
                            </Button>
                            <Button x:Name="BtnEditSource"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="36" Height="32" Padding="0"
                                    Click="BtnEditSource_Click"
                                    ToolTipService.ToolTip="Edit server">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                            </Button>
                            <Button x:Name="BtnDeleteSource" FontSize="13"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="36" Height="32" Padding="0"
                                    ToolTipService.ToolTip="Delete server"
                                    Click="BtnDeleteSource_Click">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                            <Button x:Name="BtnNewSource"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="BtnNewSource_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ConfiguredTokenRow"
                                    Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="TokenStatusDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TokenBadgeText" Text="API key configured" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <Grid x:Name="MissingTokenCallout"
                              Grid.Row="1" Grid.ColumnSpan="2"
                              Margin="-16,0,-16,-16" Padding="16,12"
                              Background="#0DF59E0B"
                              ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FFF59E0B"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="No admin API key configured. Add one to discover users and run imports."
                                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource OutlineButtonStyle}"
                                    Click="BtnSetToken_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                    <TextBlock Text="Set API key" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== Mappings Section ===== -->
                <StackPanel x:Name="MappingsSection" Spacing="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="User mappings" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnBulkRun"
                                    Style="{StaticResource OutlineButtonStyle}" FontSize="13"
                                    Visibility="Collapsed"
                                    Click="BtnBulkRun_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock x:Name="BulkRunText" Text="Import all" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDiscoverUsers"
                                    Style="{StaticResource AccentButtonStyle}" FontSize="13"
                                    Click="BtnDiscoverUsers_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock x:Name="DiscoverUsersText" Text="Discover users" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnAddMapping" Content="Add Mapping"
                                    Visibility="Collapsed"
                                    Click="BtnAddMapping_Click" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="MappingsTableCard"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="{StaticResource RadiusLG}">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="16,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Source user" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Silo user" AutomationProperties.Name="Silo User"
                                           FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="3" Text="Last imported" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="4" Text="Actions" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                            <StackPanel x:Name="MappingsRowsPanel" Spacing="0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="NoMappingsText"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            CornerRadius="12"
                            Padding="16,40"
                            Visibility="Collapsed">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="No user mappings yet. Discover users on the server to create mappings."
                                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Center" Click="BtnDiscoverUsers_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                    <TextBlock Text="Discover users" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Runs Section ===== -->
                <StackPanel x:Name="RunsSection" Spacing="12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recent imports" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="2">
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <ToggleButton x:Name="RunFilterAll" Content="All" Tag="all"
                                              IsChecked="True" FontSize="12" Padding="10,4"
                                              Click="RunFilter_Click" />
                                <ToggleButton x:Name="RunFilterAdmin" Content="Admin" Tag="admin"
                                              FontSize="12" Padding="10,4"
                                              Click="RunFilter_Click" />
                                <ToggleButton x:Name="RunFilterUser" Content="User" Tag="user"
                                              FontSize="12" Padding="10,4"
                                              Click="RunFilter_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="RunsCard"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="{StaticResource Radius2XL}">
                        <StackPanel x:Name="RunsPanel" Spacing="0" />
                    </Border>

                    <TextBlock x:Name="NoRunsText" Text="No import runs yet."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Padding="16,24"
                               Visibility="Collapsed" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
