<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminSettingsDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                Grid.Row="0"
                IsScrollInertiaEnabled="True"
                VerticalScrollBarVisibility="Auto">

                <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
                <StackPanel
                    Padding="32,24,32,40"
                    Spacing="24"
                    MaxWidth="1400"
                    HorizontalAlignment="Center">

                    <!-- Header -->
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Settings"
                                FontSize="48"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Configure server-wide settings. Most changes require a server restart to take effect."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                            <TextBox
                                x:Name="SettingsSearchBox"
                                PlaceholderText="Search settings"
                                Style="{StaticResource DarkTextBoxStyle}"
                                TextChanged="SettingsSearchBox_TextChanged" />
                            <TextBlock
                                x:Name="SettingsSearchStatusText"
                                FontSize="12"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Outer surface panel with left sidebar nav + right content area
                         (matches webui AdminSettingsLayout). -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="28"
                        Padding="0"
                        MinHeight="500">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="224" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left sub-nav sidebar -->
                            <Border
                                Grid.Column="0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,1,0"
                                Padding="8,12,8,12">
                                <ScrollViewer
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel
                                        x:Name="TabBar"
                                        Spacing="2" />
                                </ScrollViewer>
                            </Border>

                            <!-- Right content area -->
                            <ScrollViewer
                                Grid.Column="1"
                                VerticalScrollBarVisibility="Auto"
                                Padding="28,24,28,28">
                                <StackPanel Spacing="20">
                                    <!-- Inline loading indicator -->
                                    <ProgressRing
                                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        HorizontalAlignment="Center"
                                        Margin="0,24"
                                        Width="32" Height="32" />

                                    <!-- Inline error state -->
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        Padding="0,16"
                                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                            Foreground="{StaticResource ErrorBrush}"
                                            FontSize="13"
                                            HorizontalAlignment="Center"
                                            TextWrapping="Wrap"
                                            MaxWidth="400" />
                                        <Button
                                            Content="Retry"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Center"
                                            Command="{x:Bind ViewModel.LoadCommand}" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="ContentPanel"
                                        Spacing="20" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Save bar (replaced by inline per-tab save, kept hidden for code-behind references) -->
            <Border
                x:Name="SaveBar"
                Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,14"
                Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status text -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="DirtyCountText"
                            FontSize="13"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            x:Name="RestartHintText"
                            Text="Server restart may be required for changes to take effect."
                            FontSize="11"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Restart Server button (shown after saving keys that require restart) -->
                    <Button
                        Grid.Column="1"
                        x:Name="RestartServerButton"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="Collapsed"
                        Click="RestartServer_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Restart Server" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- Discard button -->
                    <Button
                        Grid.Column="2"
                        Content="Discard"
                        Style="{StaticResource OutlineButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.DiscardCommand}"
                        Click="DiscardButton_Click" />

                    <!-- Save button -->
                    <Button
                        Grid.Column="3"
                        x:Name="SaveButton"
                        Content="Save Changes"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Click="SaveButton_Click" />
                </Grid>
            </Border>

            <!-- Status message toast -->
            <Border
                x:Name="StatusToast"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-40,0,0"
                Padding="16,10"
                CornerRadius="12"
                Background="#22C55E"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="StatusToastText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </Border>
        </Grid>
    </Grid>
</Page>
