<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminUserDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- surface-panel borderless: CardBackgroundBrush, CornerRadius=26, no border -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="26" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Line-style tab button: transparent bg, underline on active -->
        <Style x:Key="LineTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8,12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Loading -->
        <ProgressRing
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="48" Height="48" />

        <!-- Error -->
        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
            <TextBlock
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Foreground="{StaticResource ErrorBrush}"
                Style="{StaticResource BodyTextStyle}"
                HorizontalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="400" />
            <Button
                x:Name="RetryButton"
                Content="Retry"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
            IsScrollInertiaEnabled="True">

            <StackPanel Padding="40,28,40,40" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button (ghost, 32x32) -->
                    <Button
                        x:Name="BackButton"
                        Grid.Column="0"
                        Width="32" Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="16"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Back to Users">
                        <FontIcon Glyph="&#xE72B;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Button>

                    <!-- Title area -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <!-- Username + badges row -->
                        <StackPanel x:Name="TitleBadgeRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                        <!-- Email subtitle -->
                        <TextBlock
                            x:Name="EmailSubtitle"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="ImpersonateButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Impersonate" />
                        <Button
                            x:Name="EditButton"
                            Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="DeleteButton"
                            Background="{StaticResource ErrorBrush}"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="14,7">
                            <TextBlock Text="Delete" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Line-style Tab bar ===== -->
                <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="2"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0" />

                <!-- ===== Tab panels ===== -->

                <!-- Overview -->
                <Grid x:Name="OverviewPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Account card -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12,16,12">
                                <TextBlock Text="Account" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                            <StackPanel x:Name="AccountRows" />
                        </StackPanel>
                    </Border>

                    <!-- Permissions card -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12,16,12">
                                <TextBlock Text="Permissions &amp; Limits" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                            <StackPanel x:Name="PermissionsRows" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Profiles -->
                <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
                    <StackPanel x:Name="ProfilesContent" />
                </Grid>

                <!-- Watch History -->
                <Border x:Name="HistoryPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <!-- History table header -->
                        <Grid Padding="16,12,16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Media" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="Profile" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="Method" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="Watch Time" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="4" Text="Status" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="5" Text="Ended" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                        <StackPanel x:Name="HistoryRows" />
                        <Border x:Name="HistoryEmpty" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No playback history for this user."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- IP History -->
                <Border x:Name="IPPanel" Visibility="Collapsed" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <!-- IP table header -->
                        <Grid Padding="16,12,16,12" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="IP Address" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="First Seen" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="Last Seen" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="Requests" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                        <StackPanel x:Name="IPRows" />
                        <Border x:Name="IPEmpty" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No IP history found for this user."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
