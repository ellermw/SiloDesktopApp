<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminRequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="RequestTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
        </Style>
        <Style x:Key="RequestFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RequestsPageShell" Padding="40,32,40,40" Spacing="20" MaxWidth="1640" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock Text="Requests" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Review media requests, set limits, and manage Radarr or Sonarr routing."
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" />
            </StackPanel>

            <Grid ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="QueueTabButton" Grid.Column="0" Content="Queue" Style="{StaticResource RequestTabStyle}" Click="QueueTab_Click" />
                <Button x:Name="SettingsTabButton" Grid.Column="1" Content="Settings" Style="{StaticResource RequestTabStyle}" Click="SettingsTab_Click" />
                <Button x:Name="IntegrationsTabButton" Grid.Column="2" Content="Integrations" Style="{StaticResource RequestTabStyle}" Click="IntegrationsTab_Click" />
                <Button x:Name="OverridesTabButton" Grid.Column="3" Content="User Overrides" Style="{StaticResource RequestTabStyle}" Click="OverridesTab_Click" />
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel x:Name="QueuePanel" Spacing="16">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="12">
                    <StackPanel x:Name="QueueFilterBar" Orientation="Horizontal" Spacing="10">
                        <ComboBox x:Name="StatusFilterComboBox" Width="170" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All statuses" Tag="all" IsSelected="True" />
                            <ComboBoxItem Content="Pending" Tag="pending" /><ComboBoxItem Content="Approved" Tag="approved" />
                            <ComboBoxItem Content="Queued" Tag="queued" /><ComboBoxItem Content="Downloading" Tag="downloading" />
                            <ComboBoxItem Content="Completed" Tag="completed" />
                        </ComboBox>
                        <ComboBox x:Name="OutcomeFilterComboBox" Width="170" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All outcomes" Tag="all" IsSelected="True" />
                            <ComboBoxItem Content="Active" Tag="active" /><ComboBoxItem Content="Declined" Tag="declined" />
                            <ComboBoxItem Content="Cancelled" Tag="cancelled" /><ComboBoxItem Content="Failed" Tag="failed" />
                        </ComboBox>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="QueueSkeleton" Spacing="8" Visibility="Collapsed" />
                <ScrollViewer x:Name="QueueTableScroll" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled">
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                        MinWidth="1120">
                    <StackPanel>
                        <Grid Padding="12,11" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.6*" /><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Title" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="Requested" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Outcome" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Integration" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="Actions" FontWeight="SemiBold" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                        <StackPanel x:Name="RequestRows" />
                    </StackPanel>
                </Border>
                </ScrollViewer>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" MaxWidth="768" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Global Settings" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                        <Grid ColumnSpacing="18" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Requests enabled" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="RequestsEnabledSwitch" Grid.Column="1" OnContent="" OffContent="" />
                                </Grid>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Auto approval" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <ToggleSwitch x:Name="AutoApprovalSwitch" Grid.Column="1" OnContent="" OffContent="" />
                                </Grid>
                            </Border>
                            <NumberBox x:Name="MaxRequestsBox" Grid.Row="1" Grid.Column="0" Header="Max requests" Minimum="0" SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Name="WindowDaysBox" Grid.Row="1" Grid.Column="1" Header="Window days" Minimum="1" SpinButtonPlacementMode="Compact" />
                        </Grid>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Always fulfill in both 1080p and 4K" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="Applies to all requests when both a Default HD and Default 4K instance exist, regardless of user role." FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ForceDualQualitySwitch" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveSettings_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" /><TextBlock Text="Save Settings" /></StackPanel></Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="IntegrationsPanel" Visibility="Collapsed" Spacing="14">
                <Grid><TextBlock Text="Connections" FontSize="18" FontWeight="SemiBold" /><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="AddIntegration_Click" Content="＋ Add connection" /></Grid>
                <StackPanel x:Name="IntegrationRows" Spacing="12" />
            </StackPanel>

            <StackPanel x:Name="OverridesPanel" Visibility="Collapsed" MaxWidth="768" HorizontalAlignment="Stretch">
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="User Overrides" FontSize="18" FontWeight="SemiBold" /></StackPanel>
                        <ComboBox x:Name="OverrideUserPicker" Header="User" HorizontalAlignment="Stretch" SelectionChanged="OverrideUserPicker_SelectionChanged" />
                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ComboBox x:Name="LimitModePicker" Grid.Row="0" Grid.Column="0" Header="Limit mode" HorizontalAlignment="Stretch" SelectionChanged="LimitModePicker_SelectionChanged">
                                <ComboBoxItem Content="Inherit" Tag="inherit" /><ComboBoxItem Content="Custom" Tag="custom" /><ComboBoxItem Content="Unlimited" Tag="unlimited" /><ComboBoxItem Content="Blocked" Tag="blocked" />
                            </ComboBox>
                            <ComboBox x:Name="ApprovalModePicker" Grid.Row="0" Grid.Column="1" Header="Approval mode" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Inherit" Tag="inherit" /><ComboBoxItem Content="Manual" Tag="manual" /><ComboBoxItem Content="Auto" Tag="auto" /><ComboBoxItem Content="Blocked" Tag="blocked" />
                            </ComboBox>
                            <NumberBox x:Name="OverrideMaxRequestsBox" Grid.Row="1" Grid.Column="0" Header="Max requests" Minimum="0" />
                            <NumberBox x:Name="OverrideWindowDaysBox" Grid.Row="1" Grid.Column="1" Header="Window days" Minimum="1" />
                        </Grid>
                        <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveOverride_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14"/><TextBlock Text="Save Override"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
