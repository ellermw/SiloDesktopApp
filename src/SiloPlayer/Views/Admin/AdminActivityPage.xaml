<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Borderless surface panel style: rounded-[1.6rem] p-4, no border -->
        <Style x:Key="SurfacePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Filter toggle button style: text-[11px] rounded-md border px-2.5 py-1.5 -->
        <Style x:Key="FilterToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            IsScrollInertiaEnabled="True">

            <!-- webui parity: AdminActivity inherits .admin-shell (1560px) from AdminLayout. -->
            <StackPanel
                Padding="40,32,40,40"
                Spacing="24"
                MaxWidth="1640"
                HorizontalAlignment="Stretch">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Bottom">
                        <!-- Title row with session count badge -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PageTitle"
                                Text="Activity"
                                FontSize="52"
                                FontWeight="ExtraBold"
                                CharacterSpacing="-50"
                                LineHeight="50"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <!-- Live badge -->
                            <Border
                                x:Name="LiveBadge"
                                Background="#1FFF3C3C"
                                BorderBrush="#33FF3C3C"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,2"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        Glyph="&#xE978;"
                                        FontSize="12"
                                        Foreground="#F87171"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="LiveBadgeText"
                                        Text="0 live"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#F87171" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Subtitle: text-[13px], includes node count -->
                        <TextBlock
                            x:Name="SubtitleText"
                            Text="No active streams"
                            FontSize="16"
                            LineHeight="27"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Connection state indicator + Refresh -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                        <Button
                            x:Name="ActivityRefreshButton"
                            Style="{StaticResource OutlineButtonStyle}"
                            MinWidth="132"
                            Height="32"
                            VerticalAlignment="Center"
                            Click="ActivityRefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="ActivityRefreshIcon" Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock x:Name="ActivityRefreshLabel" Text="Refresh" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <!-- Connection state eyebrow: "Stream" label + Live/Connecting/Disconnected -->
                        <StackPanel x:Name="ConnectionStatePanel" Width="140" Padding="4,0"
                                    VerticalAlignment="Center" Spacing="0" HorizontalAlignment="Right">
                            <TextBlock
                                Text="REALTIME UPDATES"
                                FontSize="10"
                                FontWeight="SemiBold"
                                CharacterSpacing="80"
                                TextAlignment="Right"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock
                                x:Name="ConnectionStateText"
                                Text="Disconnected"
                                FontSize="12"
                                TextAlignment="Right"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== IP Lookup Panel (collapsible, default collapsed — matches webui <details>) ===== -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="20" BorderThickness="0">
                    <Expander
                        x:Name="IpLookupExpander"
                        Header="IP Lookup"
                        IsExpanded="False"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0">
                        <StackPanel Spacing="12" Padding="16,0,16,16">
                        <!-- Input row -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="IpLookupBox"
                                Grid.Column="0"
                                PlaceholderText="IP lookup (e.g. 203.0.113.50)"
                                Text="{x:Bind ViewModel.IpLookupText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="IpLookupBox_KeyDown"
                                TextChanged="IpLookupBox_TextChanged"
                                FontSize="13"
                                FontFamily="Consolas"
                                CornerRadius="8"
                                MaxWidth="320"
                                HorizontalAlignment="Left" />
                            <Button
                                x:Name="IpLookupButton"
                                Grid.Column="1"
                                Content="Lookup"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Click="IpLookupButton_Click" />
                        </Grid>

                        <!-- IP results table -->
                        <StackPanel x:Name="IpResultsPanel" Spacing="0" Visibility="Collapsed">
                            <!-- Header row -->
                            <Grid x:Name="IpResultsHeader" Padding="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="User" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="First Seen" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Last Seen" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Requests" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,8" />
                            <StackPanel x:Name="IpResultsRows" Spacing="4" />
                        </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- ===== Play Method Distribution (Summary Strip) ===== -->
                <!-- Web: surface-panel rounded-[1.6rem] border-0 p-4, only shown when sessions > 0 -->
                <Border x:Name="SummaryStrip" Style="{StaticResource SurfacePanelStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="0">
                        <StackPanel Spacing="0" Margin="0,0,0,0">
                            <!-- Uppercase label: text-[10px] font-semibold tracking-wider uppercase -->
                            <TextBlock
                                Text="PLAY METHOD"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryTextBrush}"
                                CharacterSpacing="50"
                                Margin="0,0,0,8" />

                            <!-- Proportional bar: h-1.5 rounded-full = 6px, fully rounded -->
                            <Grid x:Name="MethodBar" Height="6" CornerRadius="3">
                                <!-- Filled in code-behind with colored Border segments -->
                            </Grid>

                            <!-- Method toggle buttons: mt-2 flex gap-x-4 -->
                            <StackPanel x:Name="MethodButtonsPanel" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                                <!-- Built in code-behind -->
                            </StackPanel>
                        </StackPanel>

                        <!-- Node breakdown: conditionally shown when >1 node -->
                        <Border x:Name="NodeBreakdownPanel" Visibility="Collapsed"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    Text="BY NODE"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    CharacterSpacing="50" />
                                <StackPanel x:Name="NodeButtonsPanel" Orientation="Horizontal" Spacing="6">
                                    <!-- Built in code-behind -->
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== Filter Bar ===== -->
                <!-- Web: flex flex-wrap items-center gap-2 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search box: h-8 (32px), text-[13px], with icon and X clear button -->
                    <Grid Grid.Column="0">
                        <TextBox
                            x:Name="SearchBox"
                            PlaceholderText="Filter by user or media..."
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            FontSize="13"
                            CornerRadius="8"
                            Height="32"
                            Padding="36,6,30,6" />
                        <FontIcon
                            Glyph="&#xE721;"
                            FontSize="14"
                            Foreground="{StaticResource TertiaryTextBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            IsHitTestVisible="False" />
                        <!-- X clear button (visible when search text entered) -->
                        <Button
                            x:Name="SearchClearButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="SearchClearButton_Click">
                            <FontIcon
                                Glyph="&#xE711;"
                                FontSize="14"
                                Foreground="{StaticResource TertiaryTextBrush}" />
                        </Button>
                    </Grid>

                    <!-- Type filter buttons: text-[11px] rounded-md border px-2.5 py-1.5 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button
                            x:Name="BtnTypeMovie"
                            Content="Movies"
                            Click="BtnTypeMovie_Click"
                            Style="{StaticResource FilterToggleButtonStyle}" />
                        <Button
                            x:Name="BtnTypeSeries"
                            Content="Series"
                            Click="BtnTypeSeries_Click"
                            Style="{StaticResource FilterToggleButtonStyle}" />
                    </StackPanel>

                    <!-- Clear filters button: text-[11px] -->
                    <Button
                        x:Name="BtnClearFilters"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Click="BtnClearFilters_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            <TextBlock Text="Clear filters" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- "Showing X of Y": text-[11px], only visible when filters active -->
                <TextBlock
                    x:Name="FilterCountText"
                    Text=""
                    FontSize="11"
                    Foreground="{StaticResource TertiaryTextBrush}"
                    Visibility="Collapsed"
                    Margin="0,0,0,0" />

                <!-- ===== Streams Table ===== -->
                <!-- Web: rounded-lg border (CornerRadius=8, NOT 24) -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="0">
                    <StackPanel>
                        <!-- Table header: bg-surface/50 py-2.5 -->
                        <Grid x:Name="TableHeader" Padding="12,10" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" MinWidth="120" />
                                <ColumnDefinition Width="1.7*" MinWidth="190" />
                                <ColumnDefinition Width="1.9*" MinWidth="220" />
                                <ColumnDefinition Width="0.8*" MinWidth="90" />
                                <ColumnDefinition Width="0.9*" MinWidth="125" />
                                <ColumnDefinition Width="1.4*" MinWidth="220" />
                            </Grid.ColumnDefinitions>
                            <!-- Sortable header buttons (USER, STREAM, VIDEO, NODE, TIME) — AUDIO is not sortable -->
                            <Button x:Name="SortUser" Grid.Column="0" Click="SortHeader_Click" Tag="username" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="USER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" />
                                    <TextBlock x:Name="SortUserIndicator" Text="" FontSize="8" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SortStream" Grid.Column="1" Click="SortHeader_Click" Tag="media" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="STREAM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" />
                                    <TextBlock x:Name="SortStreamIndicator" Text="" FontSize="8" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SortVideo" Grid.Column="2" Click="SortHeader_Click" Tag="method" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" />
                                    <TextBlock x:Name="SortVideoIndicator" Text="" FontSize="8" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SortNode" Grid.Column="3" Click="SortHeader_Click" Tag="node" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="NODE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" />
                                    <TextBlock x:Name="SortNodeIndicator" Text="" FontSize="8" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SortTime" Grid.Column="4" Click="SortHeader_Click" Tag="started" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right" HorizontalContentAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="TIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" />
                                    <TextBlock x:Name="SortTimeIndicator" Text="" FontSize="8" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="5" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" CharacterSpacing="80" HorizontalAlignment="Right" />
                        </Grid>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                        <!-- Inline loading indicator -->
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Width="32" Height="32" />

                        <!-- Inline error state -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="400" />
                            <Button
                                Content="Retry"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.LoadCommand}" />
                        </StackPanel>

                        <!-- Stream rows — internal scroll so header/filters stay pinned (webui: max-h-[calc(100vh-420px)] min-h-[200px]) -->
                        <ScrollViewer
                            x:Name="StreamsScrollViewer"
                            MinHeight="200"
                            MaxHeight="660"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="StreamsPanel" Spacing="0" />
                        </ScrollViewer>

                        <!-- Empty state — contextual icon + text set in code-behind -->
                        <Border x:Name="EmptyState" Padding="20,40" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <FontIcon
                                    x:Name="EmptyStateIcon"
                                    Glyph="&#xE768;"
                                    FontSize="32"
                                    Foreground="{StaticResource TertiaryTextBrush}"
                                    Opacity="0.2"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    x:Name="EmptyStateText"
                                    Text="No active streams"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
