<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminPolicyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:a="using:SiloPlayer.Core.Models.Admin"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel x:Name="PolicyPageShell" Padding="40,32,40,40" Spacing="24" MaxWidth="1400" HorizontalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock x:Name="PolicyTitle" Text="Policy" FontSize="48" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Household access rules: what Silo allows by default, and where you tighten it."
                           FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <ProgressRing IsActive="{Binding IsLoading, Mode=OneWay}" HorizontalAlignment="Left" />
            <Border x:Name="UnavailablePanel" Visibility="Collapsed" Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="16" Padding="24">
                <StackPanel Spacing="7">
                    <TextBlock Text="Policy workspace unavailable" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="The policy engine or editor API is not available from this server process."
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#22EF4444" CornerRadius="10" Padding="14,10">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="StatusPanel" Visibility="Collapsed" Background="{StaticResource AccentBackgroundBrush}" CornerRadius="10" Padding="14,10">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            </Border>

            <Border x:Name="PipelineStrip" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="16" Padding="16">
              <Grid x:Name="PipelineGrid" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="PipelineStepOne" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Spacing="3">
                            <TextBlock Text="Silo decides the baseline" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Built-in rules ship with every release: profile restrictions, ratings, limits."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <FontIcon x:Name="PipelineArrowOne" Grid.Column="1" Glyph="&#xE72A;" FontSize="14" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <Border x:Name="PipelineStepTwo" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Spacing="3">
                            <TextBlock Text="Your overrides narrow it" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Custom rules can tighten the baseline — never grant more than it allows."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <FontIcon x:Name="PipelineArrowTwo" Grid.Column="3" Glyph="&#xE72A;" FontSize="14" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Top" Margin="0,3,0,0" />
                <Border x:Name="PipelineStepThree" Grid.Column="4">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Spacing="3">
                            <TextBlock Text="Every decision is logged" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Denials are always recorded; allowed requests are sampled."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Pivot x:Name="PolicyTabs">
                <PivotItem Header="Overrides">
                    <Grid Margin="0,14,0,0">
                        <StackPanel x:Name="OverridesOverview" Spacing="14">
                            <StackPanel x:Name="DocumentDomainCards" Spacing="14" />
                        </StackPanel>

                        <StackPanel x:Name="EditorPanel" Visibility="Collapsed" Spacing="16">
                            <Button Content="←  All overrides" Click="BackToOverrides_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="EditorDocumentName" FontSize="20" FontWeight="SemiBold" />
                                                <Border x:Name="EditorStatusBadge" CornerRadius="6" Padding="8,3">
                                                    <TextBlock x:Name="EditorStatusText" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="EditorDomainText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DocumentEnabledToggle" Grid.Column="1" Header="Enabled" Toggled="Enabled_Toggled" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border x:Name="DraftStageBadge" CornerRadius="12" Padding="9,4"><TextBlock x:Name="DraftStageText" Text="Draft" FontSize="11" /></Border>
                                        <TextBlock Text="—" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <Border x:Name="ValidatedStageBadge" CornerRadius="12" Padding="9,4"><TextBlock x:Name="ValidatedStageText" Text="Validated" FontSize="11" /></Border>
                                        <TextBlock Text="—" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <Border x:Name="SavedStageBadge" CornerRadius="12" Padding="9,4"><TextBlock x:Name="SavedStageText" Text="Saved" FontSize="11" /></Border>
                                        <TextBlock Text="—" Foreground="{StaticResource TertiaryTextBrush}" />
                                        <Border x:Name="LiveStageBadge" CornerRadius="12" Padding="9,4"><TextBlock x:Name="LiveVersionText" Text="Live" FontSize="11" /></Border>
                                    </StackPanel>

                                    <TextBlock x:Name="LiveSourceExplanation"
                                               Text="This source is what the live policy runs today. Edit it to start a new draft — nothing changes until you activate the result."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="DisabledOverrideExplanation" Visibility="Collapsed"
                                               Text="This override is disabled: the Silo baseline applies unchanged until it is re-enabled from the overrides list."
                                               FontSize="12" Foreground="#FFFBBF24" TextWrapping="Wrap" />

                                    <TextBox x:Name="PolicySourceBox" Header="Rego source" Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" FontFamily="Consolas" MinHeight="390" TextWrapping="NoWrap"
                                             TextChanged="PolicySourceBox_TextChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                    <Border x:Name="CompileIssuesPanel" Visibility="Collapsed" Background="#20EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Compile issues" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                            <ItemsControl ItemsSource="{Binding CompileIssues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap">
                                                            <Run Text="{Binding Row}" /><Run Text=":" /><Run Text="{Binding Col}" /><Run Text="  " /><Run Text="{Binding Message}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBox x:Name="VersionCommentBox" Header="Policy version comment"
                                             Text="{Binding Comment, Mode=TwoWay}"
                                             PlaceholderText="What changed? (optional, shown in history)"
                                             Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="RevalidateButton" Content="Re-validate" Click="Validate_Click"
                                                Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" />
                                        <Button x:Name="ValidateDraftButton" Content="Validate draft" Click="Validate_Click"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="SaveVersionButton" Content="Save as version" Click="Save_Click"
                                                Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                                        <Button x:Name="ActivateVersionButton" Content="Activate" Click="ActivateDraft_Click"
                                                Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                                        <Button Content="Delete override" Click="Delete_Click" Style="{StaticResource DestructiveButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Simulate this policy" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Evaluate the draft against sample input without changing the live version."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox Header="Input JSON" Text="{Binding SimulationInput, Mode=TwoWay}"
                                             AcceptsReturn="True" FontFamily="Consolas" MinHeight="130" />
                                    <Button Content="Run simulation" Click="Simulate_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />
                                    <TextBox Header="Decision" Text="{Binding SimulationResult, Mode=OneWay}"
                                             AcceptsReturn="True" IsReadOnly="True" FontFamily="Consolas" MinHeight="100" />
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="22">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Version history" FontSize="16" FontWeight="SemiBold" />
                                    <StackPanel x:Name="VersionRows" Spacing="1" />
                                    <StackPanel x:Name="SelectedVersionSourcePanel" Spacing="8" Visibility="Collapsed">
                                        <TextBlock x:Name="SelectedVersionSourceTitle" Text="Selected Source" FontSize="13" FontWeight="SemiBold" />
                                        <TextBox x:Name="SelectedVersionSource" IsReadOnly="True" AcceptsReturn="True"
                                                 FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="260"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Baseline">
                    <StackPanel Margin="0,14,0,0" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Silo baseline policy" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Read-only rules shipped with the server. Overrides may narrow these decisions, never broaden them."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid x:Name="VendorGrid" ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="VendorListPanel" Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="10">
                                <ListView ItemsSource="{Binding VendorModules}" SelectedItem="{Binding SelectedVendor, Mode=TwoWay}">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="a:PolicyVendorModule"><TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="12" Padding="8" /></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Border>
                            <Border x:Name="VendorSourcePanel" Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="14">
                                <TextBox Text="{Binding SelectedVendor.Source, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                         FontFamily="Consolas" TextWrapping="NoWrap" MinHeight="460"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </PivotItem>

                <PivotItem Header="Decision Log">
                    <StackPanel Margin="0,14,0,0" Spacing="14">
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="18">
                            <Grid x:Name="DecisionFilterGrid" ColumnSpacing="10" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" /><ColumnDefinition Width="110" /><ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ComboBox x:Name="DecisionFilterCombo" Grid.Column="0" Header="Decision" SelectionChanged="DecisionFilterCombo_SelectionChanged" />
                                <TextBox x:Name="DecisionUserIdBox" Grid.Column="1" Header="User ID" PlaceholderText="42" Text="{Binding DecisionUserId, Mode=TwoWay}" />
                                <ComboBox x:Name="DecisionAllowedCombo" Grid.Column="2" Header="Allowed" SelectedItem="{Binding DecisionAllowed, Mode=TwoWay}">
                                    <x:String>All</x:String><x:String>Allowed</x:String><x:String>Denied</x:String>
                                </ComboBox>
                                <TextBox x:Name="DecisionFromBox" Grid.Column="3" Header="From" PlaceholderText="RFC3339 or blank" Text="{Binding DecisionFrom, Mode=TwoWay}" />
                                <TextBox x:Name="DecisionToBox" Grid.Column="4" Header="To" PlaceholderText="RFC3339 or blank" Text="{Binding DecisionTo, Mode=TwoWay}" />
                                <StackPanel x:Name="DecisionFilterActions" Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Bottom">
                                    <Button Content="Reset" Click="ResetFilters_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="Apply" Click="Filter_Click" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="0" MinWidth="1000">
                            <StackPanel>
                                <Grid Padding="16,11" ColumnSpacing="12" Background="#0DFFFFFF">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="TIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="DECISION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="2" Text="USER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="3" Text="ALLOWED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="4" Text="EVAL" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                    <TextBlock Grid.Column="5" Text="DIGEST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TertiaryTextBrush}" />
                                </Grid>
                                <ListView ItemsSource="{Binding Decisions}" IsItemClickEnabled="True" ItemClick="Decision_Click">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="a:PolicyDecisionEntry">
                                            <Grid Padding="16,11" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="90" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Timestamp}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DecisionName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind UserId}" FontSize="12" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind Allowed}" FontSize="12" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind EvalTimeNs}" FontSize="12" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind InputDigest}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="DecisionPreviousButton" Content="Previous" Click="PreviousDecisions_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="DecisionNextButton" Content="Next" Click="NextDecisions_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
