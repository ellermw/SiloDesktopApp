<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminPluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- webui parity: admin pages sit inside .admin-shell (1560); we cap at 1400 for
                 consistency with sibling admin pages that use .page-shell. -->
            <StackPanel
                Padding="32,24,32,40"
                Spacing="24"
                MaxWidth="1560"
                HorizontalAlignment="Center">

                <!-- Header — matches web AdminPlugins: title/subtitle left, Check for updates button right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock
                            Text="Plugins"
                            FontSize="48"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Extend Silo with community and first-party plugins."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button
                        x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Click="CheckUpdatesButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Status banner -->
                <Border
                    x:Name="StatusBanner"
                    Background="{StaticResource AccentBackgroundBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusBannerText"
                        FontSize="13"
                        Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- Inline loading indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    Margin="0,24"
                    Width="32" Height="32" />

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- Tab bar -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="TabInstalled"
                        Click="TabInstalled_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        CornerRadius="8">
                        <TextBlock x:Name="TabInstalledText" Text="Installed" />
                    </Button>
                    <Button
                        x:Name="TabAvailable"
                        Click="TabAvailable_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8"
                        CornerRadius="8">
                        <TextBlock x:Name="TabCatalogText" Text="Catalog" />
                    </Button>
                </StackPanel>

                <!-- Installed plugins -->
                <StackPanel x:Name="InstalledPanel" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstalledSearchBox"
                                 Grid.Column="0"
                                 PlaceholderText="Search installed plugins"
                                 TextChanged="InstalledSearchBox_TextChanged"
                                 Style="{StaticResource DarkTextBoxStyle}" />
                        <TextBlock x:Name="InstalledMatchText" Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                    </Grid>
                    <StackPanel x:Name="InstalledCards" Spacing="8" />
                    <Border x:Name="InstalledEmpty" Padding="20,40" Visibility="Collapsed">
                        <TextBlock
                            Text="No plugins installed."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="InstalledPager" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Previous" Click="InstalledPrevious_Click" Style="{StaticResource OutlineButtonStyle}" />
                        <TextBlock x:Name="InstalledPageText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Next" Click="InstalledNext_Click" Style="{StaticResource OutlineButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Available plugins tab content — matches web: Catalog section, then Repositories section -->
                <StackPanel x:Name="AvailablePanel" Spacing="24" Visibility="Collapsed">

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Approved community catalog" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock x:Name="CommunityCatalogDescription" Text="Include plugins reviewed and approved by the Silo project." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CommunityCatalogToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="CommunityCatalogToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Catalog section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Catalog"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CatalogSearchBox" Grid.Column="0"
                                     PlaceholderText="Search the plugin catalog"
                                     TextChanged="CatalogSearchBox_TextChanged"
                                     Style="{StaticResource DarkTextBoxStyle}" />
                            <TextBlock x:Name="CatalogMatchText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <StackPanel x:Name="AvailableCards" Spacing="8" />
                        <Border x:Name="AvailableEmpty" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No plugins available. Add a repository to browse available plugins."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="CatalogPager" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" Visibility="Collapsed">
                            <Button Content="Previous" Click="CatalogPrevious_Click" Style="{StaticResource OutlineButtonStyle}" />
                            <TextBlock x:Name="CatalogPageText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Content="Next" Click="CatalogNext_Click" Style="{StaticResource OutlineButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Repositories section -->
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Repositories"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Sources for discovering plugins."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                x:Name="AddRepoButton"
                                Click="AddRepoButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Add" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            BorderThickness="0"
                            Padding="0">
                            <StackPanel>
                                <StackPanel x:Name="RepoRows" Spacing="0" />
                                <Border x:Name="RepoEmpty" Padding="20,30" Visibility="Collapsed">
                                    <TextBlock
                                        Text="No repositories configured."
                                        FontSize="14"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
