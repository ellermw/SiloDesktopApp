<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminPluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <StackPanel x:Name="PluginsPageShell"
                Padding="40,32,40,40"
                Spacing="24"
                MaxWidth="1400"
                HorizontalAlignment="Center">

                <!-- Header — matches web AdminPlugins: title/subtitle left, Check for updates button right -->
                <Grid x:Name="PluginsHeaderGrid" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Spacing="12">
                        <TextBlock x:Name="PluginsTitle"
                            Text="Plugins"
                            FontSize="48"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Extend Silo with community and first-party plugins."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <Button
                        x:Name="CheckUpdatesButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Click="CheckUpdatesButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock x:Name="CheckUpdatesButtonText" Text="Check for updates" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Inline loading indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    Margin="0,24"
                    Width="32" Height="32" />

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- Line tabs used by the WebUI (not filled/pill buttons). -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        x:Name="TabInstalled"
                        Click="TabInstalled_Click"
                        Background="Transparent"
                        BorderThickness="0,0,0,2"
                        Padding="10,7,10,9"
                        CornerRadius="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Installed" />
                            <Border x:Name="InstalledCountBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="7,1">
                                <TextBlock x:Name="InstalledCountText" FontSize="10" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="TabAvailable"
                        Click="TabAvailable_Click"
                        Background="Transparent"
                        BorderThickness="0,0,0,2"
                        Padding="10,7,10,9"
                        CornerRadius="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Catalog" />
                            <Border x:Name="CatalogCountBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="7,1">
                                <TextBlock x:Name="CatalogCountText" FontSize="10" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Installed plugins -->
                <StackPanel x:Name="InstalledPanel" Spacing="12">
                    <Grid x:Name="InstalledToolbarGrid" ColumnSpacing="12" RowSpacing="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:Name="InstalledSearchContainer" Grid.Column="0">
                            <TextBox x:Name="InstalledSearchBox"
                                     PlaceholderText="Search installed plugins"
                                     TextChanged="InstalledSearchBox_TextChanged"
                                     Style="{StaticResource DarkTextBoxStyle}"
                                     Padding="36,8,10,8" />
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock x:Name="InstalledMatchText" Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                    </Grid>
                    <StackPanel x:Name="InstalledCards" Spacing="8" />
                    <Border x:Name="InstalledEmpty" Padding="20,40" Visibility="Collapsed">
                        <TextBlock
                            x:Name="InstalledEmptyText"
                            Text="No plugins installed."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="InstalledPager" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button Content="Previous" Click="InstalledPrevious_Click" Style="{StaticResource OutlineButtonStyle}" />
                        <TextBlock x:Name="InstalledPageText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Next" Click="InstalledNext_Click" Style="{StaticResource OutlineButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Available plugins tab content — matches web: Catalog section, then Repositories section -->
                <StackPanel x:Name="AvailablePanel" Spacing="24" Visibility="Collapsed">

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,20">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xEA18;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="Include approved community plugins" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                                <TextBlock Text="Reviewed by Silo maintainers to work as described and be safe for their documented use. These plugins remain maintained and supported by community contributors."
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="CommunityCatalogDescription" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CommunityCatalogToggle" Grid.Column="1" VerticalAlignment="Center"
                                          OnContent="" OffContent="" Toggled="CommunityCatalogToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Catalog section -->
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Catalog"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid x:Name="CatalogToolbarGrid" ColumnSpacing="12" RowSpacing="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="CatalogSearchContainer" Grid.Column="0">
                                <TextBox x:Name="CatalogSearchBox"
                                         PlaceholderText="Search the plugin catalog"
                                         TextChanged="CatalogSearchBox_TextChanged"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Padding="36,8,10,8" />
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock x:Name="CatalogMatchText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                        <Grid x:Name="AvailableCards" ColumnSpacing="12" RowSpacing="12" SizeChanged="AvailableCards_SizeChanged" />
                        <Border x:Name="AvailableEmpty" Padding="20,40" Visibility="Collapsed">
                            <TextBlock
                                Text="No plugins available. Add a repository to browse available plugins."
                                FontSize="14"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="CatalogPager" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" Visibility="Collapsed">
                            <Button Content="Previous" Click="CatalogPrevious_Click" Style="{StaticResource OutlineButtonStyle}" />
                            <TextBlock x:Name="CatalogPageText" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button Content="Next" Click="CatalogNext_Click" Style="{StaticResource OutlineButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Manual plugin upload is a first-class WebUI catalog function. -->
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Manual Install" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Upload a plugin binary directly." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="20">
                            <Grid x:Name="ManualInstallGrid" ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button x:Name="ChoosePluginFileButton" Grid.Column="0" Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalContentAlignment="Left" Click="ChoosePluginFileButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE898;" FontSize="14" />
                                        <TextBlock x:Name="ChosenPluginFileText" Text="Choose plugin file..." Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UploadPluginButton" Grid.Column="1" Style="{StaticResource OutlineButtonStyle}"
                                        IsEnabled="False" Click="UploadPluginButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                                        <TextBlock x:Name="UploadPluginButtonText" Text="Upload" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Repositories section -->
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Repositories"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Sources for discovering plugins."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                x:Name="AddRepoButton"
                                Click="AddRepoButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="AddRepoButtonIcon" Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock x:Name="AddRepoButtonText" Text="Add" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border x:Name="RepoForm" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16" Visibility="Collapsed">
                            <Grid x:Name="RepoFormGrid" ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="RepoNameBox" Grid.Column="0" PlaceholderText="Repository name" Style="{StaticResource DarkTextBoxStyle}" />
                                <TextBox x:Name="RepoUrlBox" Grid.Column="1" PlaceholderText="https://plugins.example.test/index.json" Style="{StaticResource DarkTextBoxStyle}" />
                                <Button x:Name="SubmitRepoButton" Grid.Column="2" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="SubmitRepoButton_Click" />
                            </Grid>
                        </Border>

                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="16"
                            BorderThickness="0"
                            Padding="0">
                            <StackPanel>
                                <StackPanel x:Name="RepoRows" Spacing="0" />
                                <Border x:Name="RepoEmpty" Padding="20,30" Visibility="Collapsed">
                                    <TextBlock
                                        Text="No repositories configured."
                                        FontSize="14"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
