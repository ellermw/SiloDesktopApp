<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SiloPlayer.Views.Admin.AdminAutoscanPage" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:admin="using:SiloPlayer.Core.Models.Admin" xmlns:converters="using:SiloPlayer.Converters"
 Background="{StaticResource AppBackgroundBrush}" DataContext="{x:Bind ViewModel}" Loaded="Page_Loaded">
 <Page.Resources>
  <converters:BoolToVisibilityConverter x:Key="BoolToVis"/><converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
  <Style x:Key="AutoscanTabButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="3,11"/><Setter Property="CornerRadius" Value="0"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TableHeaderText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/></Style>
 </Page.Resources>
 <ScrollViewer x:Name="ContentScrollViewer" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" SizeChanged="ContentScrollViewer_SizeChanged"><StackPanel x:Name="AdminPageContent" Padding="40,32,40,56" Spacing="24" MaxWidth="1640" HorizontalAlignment="Center">
  <!-- Current WebUI page header -->
  <Grid x:Name="PageHeaderGrid" ColumnSpacing="28" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel x:Name="PageHeaderCopy" Spacing="9"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="PageTitleText" Text="Autoscan" FontSize="36" FontWeight="SemiBold"/><Border x:Name="EnabledBadge" Padding="9,3" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"><TextBlock x:Name="EnabledBadgeText" FontSize="11"/></Border></StackPanel>
    <TextBlock MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}" Text="Automatically detect library changes from installed scan-source plugins. Install them from the Plugins page, configure each source, bind a connection if it needs one, and tune polling intervals."/>
   </StackPanel>
   <StackPanel x:Name="PageHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock Text="Autoscan" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><ToggleSwitch x:Name="AutoscanToggle" OnContent="" OffContent="" MinWidth="44" IsEnabled="False" IsOn="{x:Bind ViewModel.Enabled,Mode=TwoWay}" Toggled="Enabled_Toggled"/><Button x:Name="RunNowButton" Style="{StaticResource SecondaryButtonStyle}" Click="RunNow_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13"/><TextBlock x:Name="RunNowText" Text="Run now"/></StackPanel></Button></StackPanel>
  </Grid>
  <!-- Keep transient loading/error feedback out of layout when idle.  Separate
       empty TextBlocks previously added more than 100px between the header and
       tabs because StackPanel spacing was applied around each one. -->
  <!-- WebUI line tabs -->
  <Grid BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,22,0"><Button x:Name="SourcesTab" Content="Sources" Style="{StaticResource AutoscanTabButton}" Tag="0" Click="Tab_Click"/><Border x:Name="SourcesTabBar" Height="2" Background="{StaticResource AccentBrush}"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,22,0"><Button x:Name="ActivityTab" Content="Activity" Style="{StaticResource AutoscanTabButton}" Tag="1" Click="Tab_Click"/><Border x:Name="ActivityTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="0,0,22,0"><Button x:Name="ConnectionsTab" Content="Connections" Style="{StaticResource AutoscanTabButton}" Tag="2" Click="Tab_Click"/><Border x:Name="ConnectionsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel Grid.Column="3"><Button x:Name="SettingsTab" Content="Settings" Style="{StaticResource AutoscanTabButton}" Tag="3" Click="Tab_Click"/><Border x:Name="SettingsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
  </Grid>

  <!-- Sources: matching WebUI table hierarchy -->
  <StackPanel x:Name="SourcesPanel" Spacing="16"><Grid><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Scan-source plugins are installed from the Plugins page. Add a source for each thing you want to watch."/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="AddSource_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="Add source"/></StackPanel></Button></Grid>
   <TextBlock Text="Loading sources&#x2026;" Padding="0,4" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Visibility="{x:Bind ViewModel.IsLoading,Mode=OneWay,Converter={StaticResource BoolToVis}}"/>
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasSources,Mode=OneWay,Converter={StaticResource BoolToVis}}">
    <StackPanel><Grid Padding="16,11" ColumnSpacing="16" Background="{StaticResource SurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.7*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="Source"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="Connection"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="Interval &amp; settings"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="Enabled"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="Last run"/></Grid>
     <ListView ItemsSource="{x:Bind ViewModel.Sources,Mode=OneWay}" SelectionMode="None" Padding="0">
      <ListView.ItemTemplate>
       <DataTemplate x:DataType="admin:AutoscanSource">
        <Grid Padding="16,13" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.7*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind SourceDisplayName}" FontWeight="SemiBold"/><Border Padding="7,2" CornerRadius="8" Background="{StaticResource SurfaceBrush}" Visibility="{x:Bind IsWebhook,Converter={StaticResource BoolToVis}}"><TextBlock Text="Webhook" FontSize="10"/></Border></StackPanel>
          <TextBlock Text="{x:Bind SourceDetail}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
          <TextBox Text="{x:Bind Label,Mode=OneWay}" PlaceholderText="Custom label (optional)" FontSize="11" Padding="8,3" Tag="{x:Bind}" LostFocus="SourceLabel_LostFocus"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding DataContext.SourceConnectionOptions,ElementName=Root}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{x:Bind ConnectionId,Mode=TwoWay}" Tag="{x:Bind}" PlaceholderText="— No connection —" HorizontalAlignment="Stretch" SelectionChanged="SourceConnection_Changed" Visibility="{x:Bind IsWebhook,Converter={StaticResource InverseBoolToVis}}"/>
          <TextBlock Text="Not needed — Sonarr/Radarr deliver directly" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="{x:Bind IsWebhook,Converter={StaticResource BoolToVis}}"/>
         </StackPanel>
         <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind IsWebhook,Converter={StaticResource InverseBoolToVis}}"><NumberBox Width="96" PlaceholderText="Default" SpinButtonPlacementMode="Hidden" Minimum="1" Text="{x:Bind PollIntervalText,Mode=OneWay}" Tag="{x:Bind}" LostFocus="SourceInterval_LostFocus"/><TextBlock Text="sec" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="{x:Bind PollIntervalHelp}" FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" Visibility="{x:Bind IsWebhook,Converter={StaticResource InverseBoolToVis}}"/>
          <Button Tag="{x:Bind}" Click="ManageWebhook_Click" Visibility="{x:Bind IsWebhook,Converter={StaticResource BoolToVis}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE71B;" FontSize="10"/><TextBlock Text="Webhook endpoint &amp; provider"/></StackPanel></Button>
          <Button Tag="{x:Bind}" Click="EditRewrites_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE76C;" FontSize="10"/><TextBlock Text="{x:Bind PathRewriteDisplay}"/></StackPanel></Button>
          <Grid Visibility="{x:Bind IsCephFs,Converter={StaticResource BoolToVis}}" ColumnSpacing="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Tag="{x:Bind}" Click="EditSource_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE76C;" FontSize="10"/><TextBlock Text="CephFS paths &amp; ignores"/></StackPanel></Button><Button Grid.Column="1" Tag="{x:Bind}" Click="UseConfiguredLibraries_Click" Style="{StaticResource SecondaryButtonStyle}" ToolTipService.ToolTip="Replace CephFS roots with enabled Silo library paths"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8F1;" FontSize="12"/><TextBlock Text="Use configured libraries"/></StackPanel></Button></Grid>
         </StackPanel>
         <ToggleSwitch Grid.Column="3" OnContent="" OffContent="" MinWidth="44" IsOn="{x:Bind Enabled,Mode=OneWay}" Tag="{x:Bind}" Toggled="SourceEnabled_Toggled" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource AccentBrush}" Visibility="{x:Bind HasLastError,Converter={StaticResource InverseBoolToVis}}"/><FontIcon Glyph="&#xE814;" FontSize="13" Foreground="{StaticResource ErrorBrush}" Visibility="{x:Bind HasLastError,Converter={StaticResource BoolToVis}}"/><TextBlock Text="{x:Bind StatusTitle}" FontWeight="SemiBold" FontSize="12"/></StackPanel><TextBlock Text="{x:Bind StatusDetail}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"><Button Tag="{x:Bind}" Click="DeleteSource_Click" ToolTipService.ToolTip="Delete source"><FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource ErrorBrush}"/></Button></StackPanel>
        </Grid>
       </DataTemplate>
      </ListView.ItemTemplate>
     </ListView>
    </StackPanel>
   </Border>
   <Border Padding="32" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.ShowSourcesEmpty,Mode=OneWay,Converter={StaticResource BoolToVis}}"><TextBlock Text="No scan sources yet. Click Add source to create one from an installed scan-source plugin." HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/></Border>
  </StackPanel>

  <!-- Activity -->
  <StackPanel x:Name="ActivityPanel" Spacing="24" Visibility="Collapsed">
   <Border Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Style="{StaticResource TableHeaderText}" Text="ACTIVE"/></StackPanel><TextBlock Text="{x:Bind ViewModel.Status.ActiveScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel>
     <StackPanel Grid.Column="1" Spacing="5"><TextBlock Style="{StaticResource TableHeaderText}" Text="QUEUED"/><TextBlock Text="{x:Bind ViewModel.Status.AcceptedScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel>
     <StackPanel Grid.Column="2" Spacing="5"><TextBlock Style="{StaticResource TableHeaderText}" Text="RUNNING SCANS"/><TextBlock Text="{x:Bind ViewModel.Status.RunningScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel>
     <StackPanel Grid.Column="3" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Style="{StaticResource TableHeaderText}" Text="POLLING"/></StackPanel><TextBlock Text="{x:Bind ViewModel.RunningPolls.Count,Mode=OneWay}" FontSize="24"/></StackPanel>
     <StackPanel Grid.Column="4" Spacing="7"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Style="{StaticResource TableHeaderText}" Text="LATEST POLL"/></StackPanel><TextBlock Text="{x:Bind ViewModel.LatestPollDisplay,Mode=OneWay}" FontSize="13"/><Button HorizontalAlignment="Left" Width="34" Height="32" Padding="0" Click="RefreshActivity_Click" ToolTipService.ToolTip="Refresh autoscan activity"><FontIcon Glyph="&#xE72C;" FontSize="13"/></Button></StackPanel>
    </Grid>
   </Border>

   <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasRunningPolls,Mode=OneWay,Converter={StaticResource BoolToVis}}">
    <StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing Width="16" Height="16" IsActive="True"/><TextBlock Text="Polling now" FontWeight="SemiBold"/><Border Padding="7,2" CornerRadius="8" Background="{StaticResource SurfaceBrush}"><TextBlock Text="{x:Bind ViewModel.RunningPolls.Count,Mode=OneWay}" FontSize="10"/></Border></StackPanel>
    <TextBlock Text="Scan-source plugin calls currently in progress." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
    <ItemsControl ItemsSource="{x:Bind ViewModel.RunningPolls,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="admin:AutoscanRunningPoll"><Border Margin="0,0,0,8" Padding="14" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind CapabilityId}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind PluginId}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="Running" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="{x:Bind StartedAt}" FontSize="11"/><TextBlock Text="{x:Bind ElapsedMs}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>

   <StackPanel Spacing="9">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Autoscan queue" FontWeight="SemiBold"/></StackPanel>
    <TextBlock Text="Live scans created by autoscan sources." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
    <Border Padding="22" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasActiveScans,Mode=OneWay,Converter={StaticResource InverseBoolToVis}}"><TextBlock Text="{x:Bind ViewModel.EmptyQueueMessage,Mode=OneWay}" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/></Border>
    <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasActiveScans,Mode=OneWay,Converter={StaticResource BoolToVis}}"><StackPanel><Grid Padding="14,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="STATUS"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="LIBRARY"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="SCOPE"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="PROGRESS"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="ACTION"/></Grid><ListView ItemsSource="{x:Bind ViewModel.ActiveScans,Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanScan"><Grid Padding="14,10" ColumnSpacing="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind StatusDisplay}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind LibraryDisplayName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ActiveTimeDisplay}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="{x:Bind ScopeDisplay}"/><TextBlock Text="{x:Bind PathDisplay}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="3" Text="{x:Bind ProgressDisplay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/><Button Grid.Column="4" Tag="{x:Bind}" Click="CancelActiveScan_Click" ToolTipService.ToolTip="Cancel scans for this library" Background="Transparent" BorderThickness="0"><FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{StaticResource ErrorBrush}"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
   </StackPanel>

   <StackPanel Spacing="12">
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D5;" FontSize="14" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="{x:Bind ViewModel.ActivityHistoryTitle,Mode=OneWay}" FontWeight="SemiBold"/></StackPanel><TextBlock Margin="22,4,0,0" Text="{x:Bind ViewModel.ActivityHistoryDescription,Mode=OneWay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel>
     <Grid Grid.Column="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="330"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Padding="3" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal"><Button x:Name="ScansActivityButton" Content="Scans" Tag="Scans" Padding="12,5" BorderThickness="0" Click="ActivityView_Click"/><Button x:Name="PollsActivityButton" Content="Polls" Tag="Polls" Padding="12,5" BorderThickness="0" Click="ActivityView_Click"/></StackPanel></Border>
      <TextBox x:Name="ActivitySearchBox" Grid.Column="1" PlaceholderText="Search scan history" Text="{x:Bind ViewModel.ActivityQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" TextChanged="ActivitySearch_TextChanged"/>
      <ComboBox x:Name="ActivityStatusCombo" Grid.Column="2" ItemsSource="{x:Bind ScanActivityStatuses}" SelectedItem="{x:Bind ViewModel.ActivityStatus,Mode=TwoWay}" SelectionChanged="ActivityFilter_Changed"/>
      <Button Grid.Column="3" Content="Reset" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{x:Bind ViewModel.IsActivityFiltered,Mode=OneWay}" Click="ResetActivity_Click"/>
     </Grid>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,12" Visibility="{x:Bind ViewModel.IsActivityLoading,Mode=OneWay,Converter={StaticResource BoolToVis}}"><ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsActivityLoading,Mode=OneWay}"/><TextBlock Text="Loading autoscan activity&#x2026;" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/></StackPanel>
    <Border Padding="32" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.ShowActivityEmpty,Mode=OneWay,Converter={StaticResource BoolToVis}}"><TextBlock Text="{x:Bind ViewModel.ActivityEmptyMessage,Mode=OneWay}" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/></Border>
    <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasActivityRows,Mode=OneWay,Converter={StaticResource BoolToVis}}">
     <StackPanel>
      <Grid Padding="14,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="14" Visibility="{x:Bind ViewModel.ShowScans,Mode=OneWay,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.8*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="STATUS"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="LIBRARY"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="SOURCE"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="SCOPE"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="TIME"/><TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Text="POLL"/></Grid>
      <ListView ItemsSource="{x:Bind ViewModel.Scans,Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowScans,Mode=OneWay,Converter={StaticResource BoolToVis}}" MaxHeight="620"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanScan"><Grid Padding="14,11" ColumnSpacing="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="2.8*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Border Padding="7,2" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{x:Bind Status}" FontSize="10"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind LibraryDisplayName}"/><TextBlock Text="{x:Bind Id}" FontSize="9" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind SourceDisplayName}"/><StackPanel Grid.Column="3"><TextBlock Text="{x:Bind ScopeDisplay}" FontSize="11"/><TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="4" Text="{x:Bind RequestedAtDisplay}" FontSize="11"/><TextBlock Grid.Column="5" Text="{x:Bind PollDisplay}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
      <Grid Padding="14,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="14" Visibility="{x:Bind ViewModel.ShowPolls,Mode=OneWay,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="STATUS"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="SOURCE"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="COUNTS"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="SCANS"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="DURATION"/><TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Text="TIME"/></Grid>
      <ListView ItemsSource="{x:Bind ViewModel.Events,Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowPolls,Mode=OneWay,Converter={StaticResource BoolToVis}}" MaxHeight="620"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanEvent"><Grid Padding="14,11" ColumnSpacing="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind SourceDisplayName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind DeliveryDisplay}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="{x:Bind CountsDisplay}" FontSize="11"/><TextBlock Text="{x:Bind ScanCountsDisplay}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{x:Bind ErrorMessage}" FontSize="10" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="3" Text="{x:Bind LinkedScansDisplay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Grid.Column="4" Text="{x:Bind DurationDisplay}"/><TextBlock Grid.Column="5" Text="{x:Bind TimestampDisplay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
     </StackPanel>
    </Border>
    <Grid><TextBlock Text="{x:Bind ViewModel.ActivityPageSummary,Mode=OneWay}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><TextBlock Text="Rows" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><ComboBox Width="76" ItemsSource="{x:Bind ActivityPageSizes}" SelectedItem="{x:Bind ViewModel.ActivityPageSize,Mode=OneWay}" SelectionChanged="ActivityPageSize_Changed"/><Button Click="FirstActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoBack,Mode=OneWay}" ToolTipService.ToolTip="First page"><FontIcon Glyph="&#xE892;" FontSize="11"/></Button><Button Click="PreviousActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoBack,Mode=OneWay}" ToolTipService.ToolTip="Previous page"><FontIcon Glyph="&#xE76B;" FontSize="11"/></Button><Button Click="NextActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoForward,Mode=OneWay}" ToolTipService.ToolTip="Next page"><FontIcon Glyph="&#xE76C;" FontSize="11"/></Button><Button Click="LastActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoForward,Mode=OneWay}" ToolTipService.ToolTip="Last page"><FontIcon Glyph="&#xE893;" FontSize="11"/></Button></StackPanel></Grid>
   </StackPanel>
  </StackPanel>

  <!-- Connections card -->
  <StackPanel x:Name="ConnectionsPanel" Visibility="Collapsed">
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <StackPanel>
     <Grid Padding="20,17"><TextBlock Text="Connections" FontSize="18" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="AddConnection_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="Add connection"/></StackPanel></Button></Grid>
     <TextBlock Text="Loading&#x2026;" Padding="20,14" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Visibility="{x:Bind ViewModel.IsLoading,Mode=OneWay,Converter={StaticResource BoolToVis}}"/>
     <TextBlock Text="No connections yet. A connection holds credentials for a server-based source (e.g. Sonarr/Radarr). Add one if your source needs to reach a server." Padding="20,20" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.ShowConnectionsEmpty,Mode=OneWay,Converter={StaticResource BoolToVis}}"/>
     <Grid Padding="16,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasConnections,Mode=OneWay,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="190"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="NAME"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="KIND"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="SOURCE"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="URL"/></Grid>
     <ListView ItemsSource="{x:Bind ViewModel.Connections,Mode=OneWay}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasConnections,Mode=OneWay,Converter={StaticResource BoolToVis}}"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanConnection"><Grid Padding="16,12" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="190"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind KindDisplay}"/><Border Grid.Column="2" Padding="8,3" CornerRadius="9" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Left"><TextBlock Text="{x:Bind SourceDisplay}" FontSize="10"/></Border><TextBlock Grid.Column="3" Text="{x:Bind UrlDisplay}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="{x:Bind}" Click="EditConnection_Click" ToolTipService.ToolTip="Edit connection"><FontIcon Glyph="&#xE70F;" FontSize="13"/></Button><Button Tag="{x:Bind}" Click="DeleteConnection_Click" ToolTipService.ToolTip="Delete connection"><FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{StaticResource ErrorBrush}"/></Button></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel>
   </Border>
  </StackPanel>

  <!-- Settings -->
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="24" MaxWidth="520" HorizontalAlignment="Left"><TextBlock Text="Autoscan can be enabled or disabled from the toggle in the page header. Tune polling behavior below." Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="Wrap"/><StackPanel Spacing="6"><TextBlock Text="Default poll interval (seconds)" FontWeight="SemiBold" FontSize="13"/><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox Width="128" SpinButtonPlacementMode="Hidden" Minimum="1" Value="{x:Bind ViewModel.DefaultPollIntervalSeconds,Mode=TwoWay}" LostFocus="SettingsNumber_LostFocus"/><TextBlock Text="sec" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/></StackPanel><TextBlock Text="Used for sources that have no per-source interval set." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/></StackPanel><StackPanel Spacing="6"><TextBlock Text="Debounce (seconds)" FontWeight="SemiBold" FontSize="13"/><StackPanel Orientation="Horizontal" Spacing="8"><NumberBox Width="128" SpinButtonPlacementMode="Hidden" Minimum="0" Value="{x:Bind ViewModel.DebounceSeconds,Mode=TwoWay}" LostFocus="SettingsNumber_LostFocus"/><TextBlock Text="sec" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/></StackPanel><TextBlock Text="Coalesces rapid change events before triggering a scan." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/></StackPanel></StackPanel>
 </StackPanel></ScrollViewer>
</Page>
