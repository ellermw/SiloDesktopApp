<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SiloPlayer.Views.Admin.AdminAutoscanPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:admin="using:SiloPlayer.Core.Models.Admin" xmlns:converters="using:SiloPlayer.Converters"
 Background="{StaticResource AppBackgroundBrush}" Loaded="Page_Loaded">
 <Page.Resources>
  <converters:BoolToVisibilityConverter x:Key="BoolToVis"/><converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
  <Style x:Key="AutoscanTabButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="3,11"/><Setter Property="CornerRadius" Value="0"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TableHeaderText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/></Style>
 </Page.Resources>
 <ScrollViewer><StackPanel Padding="32,24,32,56" Spacing="24" MaxWidth="1560" HorizontalAlignment="Stretch">
  <!-- Current WebUI page header -->
  <Grid ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="9"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Autoscan" FontSize="48" FontWeight="Bold"/><Border x:Name="EnabledBadge" Padding="9,3" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"><TextBlock x:Name="EnabledBadgeText" FontSize="11"/></Border></StackPanel>
    <TextBlock MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}" Text="Automatically detect library changes from installed scan-source plugins. Install them from the Plugins page, configure each source, bind a connection if it needs one, and tune polling intervals."/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><ToggleSwitch Header="Autoscan" IsOn="{x:Bind ViewModel.Enabled,Mode=TwoWay}" Toggled="Enabled_Toggled"/><Button Style="{StaticResource SecondaryButtonStyle}" Click="RunNow_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="13"/><TextBlock Text="Run now"/></StackPanel></Button></StackPanel>
  </Grid>
  <ProgressRing Width="28" Height="28" IsActive="{x:Bind ViewModel.IsLoading,Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading,Mode=OneWay,Converter={StaticResource BoolToVis}}"/>
  <TextBlock Text="{x:Bind ViewModel.ErrorMessage,Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.StatusMessage,Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
  <!-- WebUI line tabs -->
  <Grid BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0"><Button x:Name="SourcesTab" Content="Sources" HorizontalAlignment="Stretch" Style="{StaticResource AutoscanTabButton}" Tag="0" Click="Tab_Click"/><Border x:Name="SourcesTabBar" Height="2" Background="{StaticResource AccentBrush}"/></StackPanel>
   <StackPanel Grid.Column="1"><Button x:Name="ActivityTab" Content="Activity" HorizontalAlignment="Stretch" Style="{StaticResource AutoscanTabButton}" Tag="1" Click="Tab_Click"/><Border x:Name="ActivityTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel Grid.Column="2"><Button x:Name="ConnectionsTab" Content="Connections" HorizontalAlignment="Stretch" Style="{StaticResource AutoscanTabButton}" Tag="2" Click="Tab_Click"/><Border x:Name="ConnectionsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel Grid.Column="3"><Button x:Name="SettingsTab" Content="Settings" HorizontalAlignment="Stretch" Style="{StaticResource AutoscanTabButton}" Tag="3" Click="Tab_Click"/><Border x:Name="SettingsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
  </Grid>

  <!-- Sources: matching WebUI table hierarchy -->
  <StackPanel x:Name="SourcesPanel" Spacing="16"><Grid><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Scan-source plugins are installed from the Plugins page. Add a source for each thing you want to watch."/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="AddSource_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="Add source"/></StackPanel></Button></Grid>
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasSources,Mode=OneWay,Converter={StaticResource BoolToVis}}">
    <StackPanel><Grid Padding="16,11" ColumnSpacing="16" Background="{StaticResource SurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.7*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="Source"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="Connection"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="Interval &amp; settings"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="Enabled"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="Last run"/></Grid>
     <ListView ItemsSource="{x:Bind ViewModel.Sources,Mode=OneWay}" SelectionMode="None" Padding="0"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanSource"><Grid Padding="16,13" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.7*"/><ColumnDefinition Width="4*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind PluginId}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{x:Bind LastError}" FontSize="11" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{x:Bind ConnectionDisplay}"/><TextBlock Text="{x:Bind DeliveryMode}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="7"><Border Padding="8,4" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><TextBlock Text="{x:Bind PollIntervalDisplay}" FontSize="11"/></Border><TextBlock Text="Floor only · values below the global default have no effect." FontSize="10" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center"/></StackPanel><Button Tag="{x:Bind}" Click="EditRewrites_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"><TextBlock Text="{x:Bind PathRewriteDisplay}"/></Button><Button Tag="{x:Bind}" Click="EditSource_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"><TextBlock Text="{x:Bind SourceSettingsDisplay}"/></Button></StackPanel><ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled,Mode=OneWay}" Tag="{x:Bind}" Toggled="SourceEnabled_Toggled" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind LastRunDisplay}" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"><Button Tag="{x:Bind}" Click="ManageWebhook_Click" ToolTipService.ToolTip="Webhook"><FontIcon Glyph="&#xE71B;" FontSize="13"/></Button><Button Tag="{x:Bind}" Click="DeleteSource_Click" ToolTipService.ToolTip="Delete source"><FontIcon Glyph="&#xE74D;" FontSize="13"/></Button></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel>
   </Border>
   <Border Padding="32" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasSources,Mode=OneWay,Converter={StaticResource InverseBoolToVis}}"><TextBlock Text="No scan sources yet. Add one from an installed scan-source plugin." HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/></Border>
  </StackPanel>

  <!-- Activity -->
  <StackPanel x:Name="ActivityPanel" Spacing="20" Visibility="Collapsed"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="ACTIVE"/><TextBlock Text="{x:Bind ViewModel.Status.ActiveScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="1" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="QUEUED"/><TextBlock Text="{x:Bind ViewModel.Status.AcceptedScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="2" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="RUNNING SCANS"/><TextBlock Text="{x:Bind ViewModel.Status.RunningScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="3" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="POLLING"/><TextBlock Text="{x:Bind ViewModel.RunningPolls.Count,Mode=OneWay}" FontSize="24"/></StackPanel></Border><Border Grid.Column="4" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="LATEST POLL"/><TextBlock Text="{x:Bind ViewModel.Status.LatestEventAt,Mode=OneWay}" FontSize="12"/></StackPanel></Border>
   </Grid>
   <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasActiveScans,Mode=OneWay,Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Autoscan queue" FontWeight="SemiBold"/><Border Padding="7,2" CornerRadius="8" Background="{StaticResource SurfaceBrush}"><TextBlock Text="{x:Bind ViewModel.ActiveScans.Count,Mode=OneWay}" FontSize="10"/></Border></StackPanel><TextBlock Text="Live scans created by autoscan sources." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><ListView ItemsSource="{x:Bind ViewModel.ActiveScans,Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanScan"><Grid Padding="14,10" ColumnSpacing="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}"/><TextBlock Grid.Column="1" Text="{x:Bind Mode}"/><TextBlock Grid.Column="2" Text="{x:Bind Path}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{x:Bind RequestedAt}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Border></StackPanel>
   <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasRunningPolls,Mode=OneWay,Converter={StaticResource BoolToVis}}"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing Width="16" Height="16" IsActive="True"/><TextBlock Text="Polling now" FontWeight="SemiBold"/><Border Padding="7,2" CornerRadius="8" Background="{StaticResource SurfaceBrush}"><TextBlock Text="{x:Bind ViewModel.RunningPolls.Count,Mode=OneWay}" FontSize="10"/></Border></StackPanel><TextBlock Text="Scan-source plugin calls currently in progress." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><ItemsControl ItemsSource="{x:Bind ViewModel.RunningPolls,Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="admin:AutoscanRunningPoll"><Border Margin="0,0,0,8" Padding="14" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel Spacing="5"><TextBlock Text="{x:Bind PluginId}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind CapabilityId}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{x:Bind StartedAt}" FontSize="11"/><TextBlock Text="{x:Bind ElapsedMs}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
   <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{x:Bind ActivityViews}" SelectedItem="{x:Bind ViewModel.ActivityView,Mode=TwoWay}" SelectionChanged="ActivityFilter_Changed"/><TextBox Grid.Column="1" PlaceholderText="Search scan history" Text="{x:Bind ViewModel.ActivityQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" KeyDown="ActivitySearch_KeyDown"/><ComboBox Grid.Column="2" ItemsSource="{x:Bind ActivityStatuses}" SelectedItem="{x:Bind ViewModel.ActivityStatus,Mode=TwoWay}" SelectionChanged="ActivityFilter_Changed"/><Button Grid.Column="3" Content="Refresh" Click="RefreshActivity_Click"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5"><Button Click="PreviousActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoBack,Mode=OneWay}"><FontIcon Glyph="&#xE76B;" FontSize="12"/></Button><Button Click="NextActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoForward,Mode=OneWay}"><FontIcon Glyph="&#xE76C;" FontSize="12"/></Button></StackPanel></Grid>
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Margin="16,12" Text="History" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.Scans,Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowScans,Mode=OneWay,Converter={StaticResource BoolToVis}}" MaxHeight="520"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanScan"><Grid Padding="16,11" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}"/><TextBlock Grid.Column="1" Text="{x:Bind Mode}"/><TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{x:Bind RequestedAt}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><ListView ItemsSource="{x:Bind ViewModel.Events,Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowPolls,Mode=OneWay,Converter={StaticResource BoolToVis}}" MaxHeight="520"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanEvent"><Grid Padding="16,11" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}"/><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind PluginId}"/><TextBlock Text="{x:Bind CapabilityId}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{x:Bind ChangesReturned}"/><TextBlock Text="{x:Bind ErrorMessage}" FontSize="10" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="3" Text="{x:Bind CompletedAt}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
  </StackPanel>

  <!-- Connections card -->
  <StackPanel x:Name="ConnectionsPanel" Visibility="Collapsed"><Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><Grid Padding="20,17"><TextBlock Text="Connections" FontSize="18" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButtonStyle}" Click="AddConnection_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="13"/><TextBlock Text="Add connection"/></StackPanel></Button></Grid><Grid Padding="16,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="Name"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="Kind"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="Source"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="URL"/></Grid><ListView ItemsSource="{x:Bind ViewModel.Connections,Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanConnection"><Grid Padding="16,12" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Kind}"/><TextBlock Grid.Column="2" Text="{x:Bind RequestIntegrationId}"/><TextBlock Grid.Column="3" Text="{x:Bind BaseUrl}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Tag="{x:Bind}" Click="EditConnection_Click"><FontIcon Glyph="&#xE70F;" FontSize="13"/></Button><Button Tag="{x:Bind}" Click="DeleteConnection_Click"><FontIcon Glyph="&#xE74D;" FontSize="13"/></Button></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel>

  <!-- Settings -->
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="22" MaxWidth="540" HorizontalAlignment="Left"><TextBlock Text="Autoscan can be enabled or disabled from the toggle in the page header. Tune polling behavior below." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/><NumberBox Header="Default poll interval (seconds)" Minimum="1" Value="{x:Bind ViewModel.DefaultPollIntervalSeconds,Mode=TwoWay}" Description="Used for sources that have no per-source interval set."/><NumberBox Header="Debounce (seconds)" Minimum="0" Value="{x:Bind ViewModel.DebounceSeconds,Mode=TwoWay}" Description="Coalesces rapid change events before triggering a scan."/><Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveSettings_Click"/></StackPanel>
 </StackPanel></ScrollViewer>
</Page>
