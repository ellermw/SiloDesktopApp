<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SiloPlayer.Views.Admin.AdminAutoscanPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:admin="using:SiloPlayer.Core.Models.Admin" xmlns:converters="using:SiloPlayer.Converters"
 Background="{StaticResource AppBackgroundBrush}" Loaded="Page_Loaded">
 <Page.Resources>
  <converters:BoolToVisibilityConverter x:Key="BoolToVis"/><converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
  <Style x:Key="AutoscanTabButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="3,11"/><Setter Property="CornerRadius" Value="0"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TableHeaderText" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/></Style>
 </Page.Resources>
 <ScrollViewer><StackPanel Padding="40,32,40,56" Spacing="24" MaxWidth="1380" HorizontalAlignment="Stretch">
  <!-- Current WebUI page header -->
  <Grid ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="9"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Autoscan" FontSize="38" FontWeight="SemiBold"/><Border x:Name="EnabledBadge" Padding="9,3" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"><TextBlock x:Name="EnabledBadgeText" FontSize="11"/></Border></StackPanel>
    <TextBlock MaxWidth="760" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource SecondaryTextBrush}" Text="Automatically detect library changes from installed scan-source plugins. Install them from the Plugins page, configure each source, bind a connection if it needs one, and tune polling intervals."/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><ToggleSwitch Header="Autoscan" IsOn="{x:Bind ViewModel.Enabled,Mode=TwoWay}" Toggled="Enabled_Toggled"/><Button Content="▶  Run now" Style="{StaticResource SecondaryButtonStyle}" Click="RunNow_Click"/></StackPanel>
  </Grid>
  <ProgressRing Width="28" Height="28" IsActive="{x:Bind ViewModel.IsLoading,Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading,Mode=OneWay,Converter={StaticResource BoolToVis}}"/>
  <TextBlock Text="{x:Bind ViewModel.ErrorMessage,Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.StatusMessage,Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/>
  <!-- WebUI line tabs -->
  <Grid BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" Spacing="24">
   <StackPanel><Button x:Name="SourcesTab" Content="Sources" Style="{StaticResource AutoscanTabButton}" Tag="0" Click="Tab_Click"/><Border x:Name="SourcesTabBar" Height="2" Background="{StaticResource AccentBrush}"/></StackPanel>
   <StackPanel><Button x:Name="ActivityTab" Content="Activity" Style="{StaticResource AutoscanTabButton}" Tag="1" Click="Tab_Click"/><Border x:Name="ActivityTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel><Button x:Name="ConnectionsTab" Content="Connections" Style="{StaticResource AutoscanTabButton}" Tag="2" Click="Tab_Click"/><Border x:Name="ConnectionsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
   <StackPanel><Button x:Name="SettingsTab" Content="Settings" Style="{StaticResource AutoscanTabButton}" Tag="3" Click="Tab_Click"/><Border x:Name="SettingsTabBar" Height="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed"/></StackPanel>
  </StackPanel></Grid>

  <!-- Sources: matching WebUI table hierarchy -->
  <StackPanel x:Name="SourcesPanel" Spacing="16"><Grid><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Text="Scan-source plugins are installed from the Plugins page. Add a source for each thing you want to watch."/><Button HorizontalAlignment="Right" Content="＋  Add source" Style="{StaticResource SecondaryButtonStyle}" Click="AddSource_Click"/></Grid>
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasSources,Mode=OneWay,Converter={StaticResource BoolToVis}}">
    <StackPanel><Grid Padding="16,11" ColumnSpacing="16" Background="{StaticResource SurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="SOURCE"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="CONNECTION"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="INTERVAL &amp; SETTINGS"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="ENABLED"/><TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="LAST RUN"/></Grid>
     <ListView ItemsSource="{x:Bind ViewModel.Sources,Mode=OneWay}" SelectionMode="None" Padding="0"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanSource"><Grid Padding="16,13" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind PluginId}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{x:Bind LastError}" FontSize="11" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind ConnectionId}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind DeliveryMode}"/><TextBlock Text="{x:Bind PollIntervalSeconds}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/></StackPanel><ToggleSwitch Grid.Column="3" IsOn="{x:Bind Enabled}" IsHitTestVisible="False" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind LastRunAt}" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right"><Button Content="Edit" Tag="{x:Bind}" Click="EditSource_Click"/><Button Content="Paths" Tag="{x:Bind}" Click="EditRewrites_Click"/><Button Content="⋯" Tag="{x:Bind}" Click="ManageWebhook_Click"/><Button Content="×" Tag="{x:Bind}" Click="DeleteSource_Click"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    </StackPanel>
   </Border>
   <Border Padding="32" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.HasSources,Mode=OneWay,Converter={StaticResource InverseBoolToVis}}"><TextBlock Text="No scan sources yet. Add one from an installed scan-source plugin." HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/></Border>
  </StackPanel>

  <!-- Activity -->
  <StackPanel x:Name="ActivityPanel" Spacing="20" Visibility="Collapsed"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="ACTIVE"/><TextBlock Text="{x:Bind ViewModel.Status.ActiveScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="1" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="QUEUED"/><TextBlock Text="{x:Bind ViewModel.Status.AcceptedScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="2" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="RUNNING SCANS"/><TextBlock Text="{x:Bind ViewModel.Status.RunningScans,Mode=OneWay,FallbackValue=0}" FontSize="24"/></StackPanel></Border><Border Grid.Column="3" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="POLLING"/><TextBlock Text="{x:Bind ViewModel.RunningPolls.Count,Mode=OneWay}" FontSize="24"/></StackPanel></Border><Border Grid.Column="4" Padding="16" CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Style="{StaticResource TableHeaderText}" Text="LATEST POLL"/><TextBlock Text="{x:Bind ViewModel.Status.LatestEventAt,Mode=OneWay}" FontSize="12"/></StackPanel></Border>
   </Grid>
   <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{x:Bind ActivityViews}" SelectedItem="{x:Bind ViewModel.ActivityView,Mode=TwoWay}" SelectionChanged="ActivityFilter_Changed"/><TextBox Grid.Column="1" PlaceholderText="Search scan history" Text="{x:Bind ViewModel.ActivityQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" KeyDown="ActivitySearch_KeyDown"/><ComboBox Grid.Column="2" ItemsSource="{x:Bind ActivityStatuses}" SelectedItem="{x:Bind ViewModel.ActivityStatus,Mode=TwoWay}" SelectionChanged="ActivityFilter_Changed"/><Button Grid.Column="3" Content="Refresh" Click="RefreshActivity_Click"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="5"><Button Content="‹" Click="PreviousActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoBack,Mode=OneWay}"/><Button Content="›" Click="NextActivity_Click" IsEnabled="{x:Bind ViewModel.CanGoForward,Mode=OneWay}"/></StackPanel></Grid>
   <Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><TextBlock Margin="16,12" Text="Scan history" FontWeight="SemiBold"/><ListView ItemsSource="{x:Bind ViewModel.Scans,Mode=OneWay}" MaxHeight="520"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanScan"><Grid Padding="16,11" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Status}"/><TextBlock Grid.Column="1" Text="{x:Bind Mode}"/><TextBlock Grid.Column="2" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{x:Bind RequestedAt}" FontSize="11"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
  </StackPanel>

  <!-- Connections card -->
  <StackPanel x:Name="ConnectionsPanel" Visibility="Collapsed"><Border CornerRadius="9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><StackPanel><Grid Padding="20,17"><TextBlock Text="Connections" FontSize="18" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Content="＋  Add connection" Style="{StaticResource SecondaryButtonStyle}" Click="AddConnection_Click"/></Grid><Grid Padding="16,10" Background="{StaticResource SurfaceBrush}" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource TableHeaderText}" Text="NAME"/><TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="KIND"/><TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="SOURCE"/><TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="URL"/></Grid><ListView ItemsSource="{x:Bind ViewModel.Connections,Mode=OneWay}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="admin:AutoscanConnection"><Grid Padding="16,12" ColumnSpacing="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="170"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Kind}"/><TextBlock Grid.Column="2" Text="{x:Bind RequestIntegrationId}"/><TextBlock Grid.Column="3" Text="{x:Bind BaseUrl}" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="✎" Tag="{x:Bind}" Click="EditConnection_Click"/><Button Content="×" Tag="{x:Bind}" Click="DeleteConnection_Click"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border></StackPanel>

  <!-- Settings -->
  <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="22" MaxWidth="540" HorizontalAlignment="Left"><TextBlock Text="Autoscan can be enabled or disabled from the toggle in the page header. Tune polling behavior below." Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/><NumberBox Header="Default poll interval (seconds)" Minimum="1" Value="{x:Bind ViewModel.DefaultPollIntervalSeconds,Mode=TwoWay}" Description="Used for sources that have no per-source interval set."/><NumberBox Header="Debounce (seconds)" Minimum="0" Value="{x:Bind ViewModel.DebounceSeconds,Mode=TwoWay}" Description="Coalesces rapid change events before triggering a scan."/><Button Content="Save settings" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveSettings_Click"/></StackPanel>
 </StackPanel></ScrollViewer>
</Page>
