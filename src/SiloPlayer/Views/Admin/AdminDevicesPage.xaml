<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels.Admin"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <!-- The WebUI uses quiet surface segments, not the Windows accent fill. -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource SurfaceHoverColor}" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{StaticResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{StaticResource PrimaryTextColor}" />
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <!-- Current WebUI uses a dedicated 1920px fleet console rather than the standard 1400px shell. -->
        <StackPanel x:Name="DevicesPageShell" Padding="40,24,40,48" Spacing="20" MaxWidth="1920" HorizontalAlignment="Center">
            <Grid x:Name="DevicesHeaderGrid" ColumnSpacing="28" RowSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="Devices" FontSize="48" FontWeight="Bold" />
                    <TextBlock Text="Inspect, tune, and reset per-profile playback overrides across the fleet. Filter by user, platform, or override pattern. Press ⌘K to jump."
                               FontSize="14" MaxWidth="680" TextWrapping="Wrap" HorizontalAlignment="Left"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Grid x:Name="DeviceSearchHost" Grid.Column="1" VerticalAlignment="Bottom">
                <TextBox x:Name="DeviceSearchBox"
                         Padding="34,0,44,0"
                         PlaceholderText="Search devices, users, IDs, profiles…"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="DeviceSearchBox_TextChanged" />
                <FontIcon Glyph="&#xE721;" FontSize="14"
                          Foreground="{StaticResource SecondaryTextBrush}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="12,0,0,0" IsHitTestVisible="False" />
                <Border x:Name="SearchShortcutHint"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="5,2" Margin="0,0,8,0"
                        IsHitTestVisible="False">
                    <TextBlock Text="&#x2318;K" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
                <Button x:Name="ClearSearchButton" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,5,0" Padding="6"
                        Background="Transparent" BorderThickness="0"
                        Click="ClearSearchButton_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="12"
                              Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
                </Grid>
            </Grid>

            <!-- Fleet pulse: stable totals, density cue, and grouping pivot. -->
            <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="16,12">
                <Grid x:Name="FleetPulseGrid" ColumnSpacing="22" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="FleetUsersStat" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.TotalUsers, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="USERS" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel x:Name="FleetDevicesStat" Grid.Column="1" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.TotalDevices, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="DEVICES" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel x:Name="FleetProfilesStat" Grid.Column="2" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.TotalProfiles, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="PROFILES" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel x:Name="FleetOverridesStat" Grid.Column="3" Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind ViewModel.TotalOverrides, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="OVERRIDES" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel x:Name="FleetDensityPanel" Grid.Column="4" Orientation="Horizontal" Spacing="3" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DENSITY" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,5,0" />
                        <Rectangle Width="4" Height="20" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.75" /><Rectangle Width="4" Height="16" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.65" />
                        <Rectangle Width="4" Height="13" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.55" /><Rectangle Width="4" Height="10" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.45" />
                        <Rectangle Width="4" Height="7" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.35" /><Rectangle Width="4" Height="4" Fill="{StaticResource PrimaryTextBrush}" Opacity="0.25" />
                    </StackPanel>
                    <StackPanel x:Name="FleetGroupPanel" Grid.Column="5" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="GROUP BY" FontSize="9" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ToggleButton x:Name="GroupUserButton" Content="User" Tag="user" IsChecked="True" Click="GroupBy_Click" Padding="10,4" />
                        <ToggleButton x:Name="GroupPlatformButton" Content="Platform" Tag="platform" Click="GroupBy_Click" Padding="10,4" />
                        <ToggleButton x:Name="GroupActivityButton" Content="Activity" Tag="activity" Click="GroupBy_Click" Padding="10,4" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DeviceScopePanel" Orientation="Horizontal" Spacing="0">
                <ToggleButton x:Name="AllDevicesButton" IsChecked="True" Click="DeviceScope_Click" Tag="all" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="All Devices" /><TextBlock Text="{x:Bind ViewModel.TotalDevices, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="OverridesButton" Click="DeviceScope_Click" Tag="overrides" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Devices with Overrides" /><TextBlock Text="{x:Bind ViewModel.DevicesWithOverrides, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                </ToggleButton>
            </StackPanel>
            </ScrollViewer>

            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />

            <Grid x:Name="DeviceWorkspaceGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="380" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <!-- Filter rail -->
                <Border x:Name="DeviceFilterRail" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" Padding="14,16" VerticalAlignment="Top">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="5">
                            <Grid><TextBlock Text="SAVED VIEWS" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /><Button Content="clear" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="3" Click="ClearFilters_Click" /></Grid>
                            <Button Tag="anomalies" Click="SavedView_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="⚠  Anomalies" /><TextBlock Text="{x:Bind ViewModel.AnomalyCount, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" /></Grid></Button>
                            <Button Tag="recent" Click="SavedView_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="◷  Updated &lt; 7d" /><TextBlock Text="{x:Bind ViewModel.UpdatedWeekCount, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" /></Grid></Button>
                            <Button Tag="hdr" Click="SavedView_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="✣  HDR-capable" /><TextBlock Text="{x:Bind ViewModel.HdrCapableCount, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" /></Grid></Button>
                            <Button Tag="subtitle" Click="SavedView_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="▣  Heavy customizers" /><TextBlock Text="{x:Bind ViewModel.HeavyCustomizerCount, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" /></Grid></Button>
                            <Button Tag="dormant" Click="SavedView_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Grid><TextBlock Text="⌁  Dormant 30d" /><TextBlock Text="{x:Bind ViewModel.DormantCount, Mode=OneWay}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" /></Grid></Button>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="PLATFORM" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="TV" Tag="platform:TV" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.TvCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="Mobile" Tag="platform:Mobile" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.MobileCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="Desktop" Tag="platform:Desktop" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.DesktopCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="OVERRIDE COUNT" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="none" Tag="override:none" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.NoOverrideCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="1-2" Tag="override:1-2" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.OneTwoOverrideCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="3-5" Tag="override:3-5" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.ThreeFiveOverrideCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="6+" Tag="override:6+" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.SixPlusOverrideCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="LAST SEEN" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="&lt;24h" Tag="recency:&lt;24h" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.DayCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="&lt;7d" Tag="recency:&lt;7d" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.WeekCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="&lt;30d" Tag="recency:&lt;30d" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.MonthCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                            <CheckBox Content="&gt;30d" Tag="recency:&gt;30d" Checked="Facet_Changed" Unchecked="Facet_Changed" /><TextBlock Text="{x:Bind ViewModel.OlderCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-29,8,6" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Grouped device list -->
                <Border x:Name="DeviceListPanel" Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Padding="14,11"><TextBlock Text="{x:Bind ViewModel.ResultsLabel, Mode=OneWay}" FontSize="10" CharacterSpacing="80" Foreground="{StaticResource SecondaryTextBrush}" /><ProgressRing HorizontalAlignment="Right" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" /></Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DeviceGroups, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AdminDeviceGroupViewModel">
                                        <Expander IsExpanded="{x:Bind IsExpanded}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <Grid MinWidth="280" Padding="4,3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{x:Bind Meta}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /></Grid>
                                            </Expander.Header>
                                            <ListView ItemsSource="{x:Bind Devices}" IsItemClickEnabled="True" ItemClick="DeviceList_ItemClick" SelectionMode="None" HorizontalContentAlignment="Stretch">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AdminDeviceCardViewModel">
                                                        <Grid Padding="12,9" ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Platform}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Activity}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" /><TextBlock Text="{x:Bind Overrides}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" /></StackPanel></Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- In-place detail panel -->
                <Border x:Name="DeviceDetailPanel" Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12" MinHeight="560" VerticalAlignment="Top">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520" Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="Select a device" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Pick a device from the list to inspect its per-profile overrides, tune controls, or reset individual keys." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Padding="20" Spacing="16" Visibility="{x:Bind ViewModel.IsDetailVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Grid x:Name="SelectedDeviceHeaderGrid" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=Device}" FontSize="22" FontWeight="Bold" /><TextBlock Text="{x:Bind ViewModel.SelectedDevice.User, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" /><TextBlock Text="{x:Bind ViewModel.SelectedDevice.DeviceId, Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><StackPanel x:Name="SelectedDeviceActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox x:Name="DeviceProfileComboBox" Width="250" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}" DisplayMemberPath="DisplayName" /><Button Content="Reset profile" Style="{StaticResource DestructiveButtonStyle}" Click="ResetProfile_Click" /></StackPanel></Grid>
                            <ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsDetailLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDetailLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                            <StackPanel Spacing="3"><TextBlock Text="Profile-specific settings" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Inherited rows show Silo's current manifest default. Saving creates a device override; Reset returns to the fallback chain." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsHost" Spacing="8" /></ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
