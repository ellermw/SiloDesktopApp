<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminNodesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>

        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
            <StackPanel Padding="40,24,40,24" Spacing="32" MaxWidth="1400" HorizontalAlignment="Center">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Stream Nodes"
                        FontSize="48"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Manage proxy and transcode workers that distribute playback load across your infrastructure."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <!-- ===== Status banner ===== -->
                <Border
                    x:Name="StatusBanner"
                    Background="{StaticResource AccentBackgroundBrush}"
                    CornerRadius="8"
                    Padding="14,10"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="StatusBannerText"
                        FontSize="13"
                        Foreground="{StaticResource AccentBrush}" />
                </Border>

                <!-- ===== Proxy Nodes section ===== -->
                <StackPanel Spacing="14">

                    <!-- Section header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="Proxy Nodes"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="ProxyNodeCountBadge"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                CornerRadius="10"
                                Padding="7,2,7,2">
                                <TextBlock
                                    x:Name="ProxyNodeCountText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>

                        <Button
                            x:Name="AddProxyNodeButton"
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddProxyNodeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add Proxy" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Info banner (blue-tinted surface-panel-subtle) -->
                    <Border
                        CornerRadius="12"
                        Padding="12">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.06" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE946;"
                                FontSize="16"
                                Foreground="{StaticResource AccentBrush}"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0" />
                            <TextBlock
                                Text="Proxy nodes relay streams to end users. The URL must be publicly accessible."
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Table card (surface-panel: CardBackgroundBrush, CornerRadius=26, border-0) -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="16"
                        BorderThickness="0"
                        Padding="0">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="20,14,20,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="URL" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Group" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="3" Text="Status" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Grid.Column="4" Text="Health" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="5" Text="Streams" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Grid.Column="6" Text="Egress" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="7" Text="Last Check" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Grid.Column="8" Text="Actions" FontSize="13" FontWeight="Medium" />
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                            <!-- Inline loading indicator -->
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Center"
                                Margin="0,24"
                                Width="32" Height="32" />

                            <!-- Inline error state -->
                            <StackPanel
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Padding="0,16"
                                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    FontSize="13"
                                    HorizontalAlignment="Center"
                                    TextWrapping="Wrap"
                                    MaxWidth="400" />
                                <Button
                                    Content="Retry"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Command="{x:Bind ViewModel.LoadCommand}" />
                            </StackPanel>

                            <!-- Proxy rows — populated in code-behind -->
                            <StackPanel x:Name="ProxyNodesPanel" Spacing="0" />

                            <!-- Empty state -->
                            <Border x:Name="ProxyEmptyState" Padding="20,32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock
                                        Text="No proxy nodes configured. Add a proxy node to enable distributed stream delivery."
                                        FontSize="14"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxWidth="420" />
                                    <Button
                                        x:Name="ProxyEmptyAddButton"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="AddProxyNodeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="Add Proxy" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Transcode Nodes section ===== -->
                <StackPanel Spacing="14">

                    <!-- Section header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                Text="Transcode Nodes"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />
                            <Border
                                x:Name="TranscodeNodeCountBadge"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                CornerRadius="10"
                                Padding="7,2,7,2">
                                <TextBlock
                                    x:Name="TranscodeNodeCountText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </StackPanel>

                        <Button
                            x:Name="AddTranscodeNodeButton"
                            Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddTranscodeNodeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add Transcode" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Info banner (amber-tinted surface-panel-subtle) -->
                    <Border
                        CornerRadius="12"
                        Padding="12">
                        <Border.Background>
                            <SolidColorBrush Color="#F59E0B" Opacity="0.06" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="16"
                                VerticalAlignment="Top"
                                Margin="0,1,0,0">
                                <FontIcon.Foreground>
                                    <SolidColorBrush Color="#F59E0B" />
                                </FontIcon.Foreground>
                            </FontIcon>
                            <TextBlock
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap">
                                <Run Text="Transcode nodes handle video transcoding internally. " />
                                <Run Text="Must be on the same network as proxy nodes and the backend." FontWeight="Bold" />
                                <Run Text=" Does not need a public URL." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Table card (surface-panel: CardBackgroundBrush, CornerRadius=26, border-0) -->
                    <Border
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="16"
                        BorderThickness="0"
                        Padding="0">
                        <StackPanel>
                            <!-- Table header -->
                            <Grid Padding="20,14,20,14" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Name" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="URL" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="Group" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="3" Text="Status" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Grid.Column="4" Text="Health" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="5" Text="Jobs" FontSize="13" FontWeight="Medium"/>
                                <TextBlock Grid.Column="6" Text="Last Check" FontSize="13" FontWeight="Medium"/><TextBlock Grid.Column="7" Text="Actions" FontSize="13" FontWeight="Medium"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />

                            <!-- Transcode rows — populated in code-behind -->
                            <StackPanel x:Name="TranscodeNodesPanel" Spacing="0" />

                            <!-- Empty state -->
                            <Border x:Name="TranscodeEmptyState" Padding="20,32" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock
                                        Text="No transcode nodes configured. Add a transcode node to offload video transcoding from the main server."
                                        FontSize="14"
                                        Foreground="{StaticResource SecondaryTextBrush}"
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        MaxWidth="420" />
                                    <Button
                                        x:Name="TranscodeEmptyAddButton"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Click="AddTranscodeNodeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="Add Transcode" FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
