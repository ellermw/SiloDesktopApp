<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>

        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <StackPanel x:Name="TasksPageShell" Padding="40,24,40,40" Spacing="24" MaxWidth="1400" HorizontalAlignment="Stretch">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Scheduled Tasks"
                        FontSize="48"
                        FontWeight="ExtraBold"
                        CharacterSpacing="-50"
                        LineHeight="46"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="View and manage background tasks. You can trigger tasks manually or adjust their schedules, including whether a task runs on server startup."
                        FontSize="16"
                        LineHeight="27"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="720"
                        HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Inline loading indicator -->
                <TextBlock
                    Text="Loading tasks..."
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="13" />

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- ===== Task groups — populated in code-behind ===== -->
                <StackPanel x:Name="TaskGroupsPanel" Spacing="24" />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
