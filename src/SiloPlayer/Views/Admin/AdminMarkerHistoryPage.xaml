<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminMarkerHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:vm="using:SiloPlayer.ViewModels.Admin"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVis" Invert="True" />
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel x:Name="MarkerHistoryPageShell" Padding="40,32,40,40" Spacing="24" MaxWidth="1400" HorizontalAlignment="Center">
            <Grid x:Name="MarkerHistoryHeaderGrid" ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="10">
                    <TextBlock x:Name="MarkerHistoryTitle"
                        Text="Marker History"
                        FontSize="48"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Recent manual intro, recap, credits, and preview marker edits across the server."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="760"
                        HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel x:Name="MarkerHistoryHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ComboBox
                        x:Name="LimitComboBox"
                        Width="128"
                        SelectedIndex="1"
                        SelectionChanged="LimitComboBox_SelectionChanged">
                        <ComboBoxItem Content="25 rows" Tag="25" />
                        <ComboBoxItem Content="50 rows" Tag="50" />
                        <ComboBoxItem Content="100 rows" Tag="100" />
                    </ComboBox>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.LoadCommand}"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <SymbolIcon Symbol="Refresh" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The WebUI keeps the table footprint stable while loading by
                 showing six row skeletons instead of replacing it with a spinner. -->
            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12">
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                    <Border Height="40" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" />
                </StackPanel>
            </Border>

            <StackPanel
                Spacing="10"
                HorizontalAlignment="Center"
                Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                <TextBlock
                    Text="Failed to load marker history."
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource ErrorBrush}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    MaxWidth="560"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}" />
                <Button
                    Content="Retry"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadCommand}" />
            </StackPanel>

            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                    <Grid MinWidth="1000">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid
                            Padding="16,12"
                            Background="{StaticResource SurfaceHoverBrush}"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="When" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Item" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Segment" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Change" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Actor" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Request" FontWeight="SemiBold" />
                        </Grid>

                        <ListView
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:MarkerHistoryRowViewModel">
                                    <Grid Padding="16,12" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="190" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind When}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <Button
                                                Content="{x:Bind ItemLabel}"
                                                Tag="{x:Bind ItemId}"
                                                Click="ItemLink_Click"
                                                Visibility="{x:Bind ItemId, Converter={StaticResource NullToVis}}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock
                                                Text="{x:Bind ItemLabel}"
                                                Visibility="{x:Bind ItemId, Converter={StaticResource InverseNullToVis}}"
                                                FontWeight="Medium"
                                                Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="{x:Bind ItemDetail}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Segment}" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                            <Border Background="{StaticResource SurfaceHoverBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind Action}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Change}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Spacing="2">
                                            <TextBlock Text="{x:Bind Actor}" FontWeight="Medium" />
                                            <TextBlock Text="{x:Bind ActorDetail}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Spacing="2">
                                            <TextBlock Text="{x:Bind Request}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind RequestDetail}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock
                    Text="No marker edits recorded."
                    HorizontalAlignment="Center"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
