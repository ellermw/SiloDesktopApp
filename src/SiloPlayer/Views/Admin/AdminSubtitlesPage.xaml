<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminSubtitlesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SubtitlesPageShell" Padding="40,32,40,40" Spacing="24" MaxWidth="1400" HorizontalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock x:Name="SubtitlesTitle"
                    Text="Subtitles"
                    Style="{StaticResource TitleTextStyle}"
                    FontSize="48"
                    FontWeight="Bold" />
                <TextBlock
                    Text="Manage stored subtitle files across the library — user uploads and provider downloads."
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}" Padding="16">
            <Grid x:Name="SubtitleStatsGrid" ColumnSpacing="24" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                    <StackPanel x:Name="TotalStoredStat" Grid.Column="0" Spacing="4">
                        <TextBlock Text="TOTAL STORED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="TotalStoredText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="UploadsStat" Grid.Column="1" Spacing="4">
                        <TextBlock Text="USER UPLOADS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="UploadsText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="ProviderDownloadsStat" Grid.Column="2" Spacing="4">
                        <TextBlock Text="PROVIDER DOWNLOADS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="ProviderDownloadsText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel x:Name="LanguagesStat" Grid.Column="3" Spacing="4">
                        <TextBlock Text="LANGUAGES ON PAGE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="LanguagesText" Text="0" FontSize="28" FontWeight="SemiBold" />
                    </StackPanel>
            </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16">
                <Grid x:Name="SubtitleFiltersGrid" ColumnSpacing="10" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="0"
                        PlaceholderText="Search release name…"
                        FontFamily="Consolas"
                        TextChanged="SearchBox_TextChanged" />

                    <VariableSizedWrapGrid x:Name="ProviderFiltersPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ProviderAllButton" Content="All" Tag="" CornerRadius="999" Padding="12,5" Margin="3" Click="ProviderFilter_Click" />
                        <Button x:Name="ProviderUploadButton" Content="Upload" Tag="upload" CornerRadius="999" Padding="12,5" Margin="3" Click="ProviderFilter_Click" />
                        <Button x:Name="ProviderOpenSubtitlesButton" Content="OpenSubtitles" Tag="opensubtitles" CornerRadius="999" Padding="12,5" Margin="3" Click="ProviderFilter_Click" />
                        <Button x:Name="ProviderSubDlButton" Content="SubDL" Tag="subdl" CornerRadius="999" Padding="12,5" Margin="3" Click="ProviderFilter_Click" />
                        <Button x:Name="ProviderSubSourceButton" Content="SubSource" Tag="subsource" CornerRadius="999" Padding="12,5" Margin="3" Click="ProviderFilter_Click" />
                    </VariableSizedWrapGrid>

                    <ComboBox x:Name="LanguageFilterComboBox" Grid.Column="2" SelectionChanged="Filter_Changed" />

                    <ComboBox x:Name="UserFilterComboBox" Grid.Column="3" SelectionChanged="Filter_Changed" />

                    <Button
                        x:Name="ResetFiltersButton"
                        Grid.Column="4"
                        Content="Reset filters"
                        VerticalAlignment="Center"
                        Click="ResetFilters_Click" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="SubtitlesTableScroll"
                          HorizontalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource CardStyle}" Padding="0" MinWidth="1320">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,12" ColumnSpacing="14" Background="{StaticResource SidebarAccentBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.55*"/>
                            <ColumnDefinition Width="0.35*"/><ColumnDefinition Width="0.65*"/><ColumnDefinition Width="0.65*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Media" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="File" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Language" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Provider" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Release" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Format" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="HI" FontWeight="SemiBold"/><TextBlock Grid.Column="7" Text="Uploader" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="8" Text="Added" FontWeight="SemiBold"/><TextBlock Grid.Column="9" Text="Actions" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressRing
                        Grid.Row="1"
                        x:Name="LoadingRing"
                        IsActive="False"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <ListView
                        Grid.Row="1"
                        x:Name="SubtitlesListView"
                        SelectionMode="None"
                        IsItemClickEnabled="False" />
                </Grid>
            </Border>
            </ScrollViewer>

            <Border x:Name="SubtitlesEmptyState" Style="{StaticResource CardStyle}"
                    Padding="24,56" Visibility="Collapsed">
                <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="SubtitlesEmptyTitle" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="SubtitlesEmptyDetail" FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button x:Name="SubtitlesEmptyResetButton" Content="Reset filters"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,12,0,0" Click="ResetFilters_Click" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />

            <Grid x:Name="SubtitlePaginationGrid" ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="PageSummaryText"
                    Grid.Column="0"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />
                <ComboBox x:Name="PageSizeComboBox" Grid.Column="1" SelectionChanged="PageSize_Changed">
                    <ComboBoxItem Content="25 / page" Tag="25" IsSelected="True" />
                    <ComboBoxItem Content="50 / page" Tag="50" />
                    <ComboBoxItem Content="100 / page" Tag="100" />
                </ComboBox>
                <Button x:Name="PrevPageButton" Grid.Column="2" Content="Previous" Click="PrevPage_Click" />
                <TextBlock x:Name="PageText" Grid.Column="3" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                <Button x:Name="NextPageButton" Grid.Column="4" Content="Next" Click="NextPage_Click" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
