<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Stat card: surface panel, no border -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Section card: border + radius=24 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            x:Name="ContentScrollViewer"
            IsScrollInertiaEnabled="True"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Center"
            SizeChanged="ContentScrollViewer_SizeChanged">

            <!-- webui parity: AdminDashboard inherits .admin-shell (1560px) from AdminLayout.
                 Match exactly at 1560 so the data grid has full webui breathing room. -->
            <StackPanel
                x:Name="AdminPageContent"
                Padding="40,32,40,40"
                Spacing="32"
                MaxWidth="1640"
                HorizontalAlignment="Center">

                <!-- ===== Header ===== -->
                <Grid x:Name="PageHeaderGrid" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: title + subtitle -->
                    <StackPanel x:Name="PageHeaderCopy" Grid.Column="0" Spacing="12" VerticalAlignment="Bottom">
                        <TextBlock
                            x:Name="PageTitleText"
                            Text="Dashboard"
                            FontSize="52"
                            FontWeight="ExtraBold"
                            CharacterSpacing="-50"
                            LineHeight="50"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Live sessions, content health, and server activity in one view."
                            FontSize="16"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Right: action buttons -->
                    <StackPanel x:Name="PageHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock x:Name="LastUpdatedText" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button
                            x:Name="RefreshButton"
                            MinWidth="132"
                            MinHeight="32"
                            Padding="12,6"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="RefreshButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Refresh" />
                                <TextBlock x:Name="RefreshButtonLabel" Text="Refresh" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ScanAllButton"
                            MinHeight="32"
                            Padding="12,6"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ScanAllButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3,7 L 3,5 C 3,3.9 3.9,3 5,3 L 7,3" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        <Path Data="M 17,3 L 19,3 C 20.1,3 21,3.9 21,5 L 21,7" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        <Path Data="M 21,17 L 21,19 C 21,20.1 20.1,21 19,21 L 17,21" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        <Path Data="M 7,21 L 5,21 C 3.9,21 3,20.1 3,19 L 3,17" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        <Path Data="M 7,12 L 17,12" Stroke="{StaticResource AccentForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="ScanAllButtonLabel" Text="Scan All Libraries" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click" />
                </StackPanel>

                <!-- ===== Stats Row ===== -->
                <Grid x:Name="StatsLoadingGrid" ColumnSpacing="14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:SkeletonBox Grid.Column="0" Height="96" CornerRadius="16" />
                    <controls:SkeletonBox Grid.Column="1" Height="96" CornerRadius="16" />
                    <controls:SkeletonBox Grid.Column="2" Height="96" CornerRadius="16" />
                    <controls:SkeletonBox Grid.Column="3" Height="96" CornerRadius="16" />
                    <controls:SkeletonBox Grid.Column="4" Height="96" CornerRadius="16" />
                </Grid>
                <Border x:Name="StatsErrorPanel"
                        Padding="0,16"
                        Visibility="Collapsed">
                    <TextBlock Text="Failed to load stats."
                               FontSize="14"
                               Foreground="{StaticResource ErrorBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <Grid x:Name="StatsGrid" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1: Active Streams -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Active Streams"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <Viewbox Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 22,12 L 18,12 L 15,21 L 9,3 L 6,12 L 2,12"
                                              Stroke="{StaticResource SecondaryTextBrush}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <TextBlock
                                x:Name="StatActiveStreams"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatActiveStreamsSub"
                                Text="0 sessions"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 2: Total Movies -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Total Movies"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE8B2;"
                                    FontSize="16"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatMovies"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatMoviesSub"
                                Text="of 0 items"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 3: Total Shows -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Total Shows"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE7F4;"
                                    FontSize="16"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatShows"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatShowsSub"
                                Text="0 files total"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 4: Users -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Users"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xE716;"
                                    FontSize="16"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatUsers"
                                Text="0"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatUsersSub"
                                Text="0 registered"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 5: Storage -->
                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock
                                    Text="Storage"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <FontIcon
                                    Glyph="&#xEDA2;"
                                    FontSize="16"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                x:Name="StatStorage"
                                Text="0 GB"
                                FontSize="28"
                                FontWeight="ExtraBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                CharacterSpacing="-30"
                                Margin="0,0,0,2" />
                            <TextBlock
                                x:Name="StatStorageSub"
                                Text="0 files"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="TraktActivityCard" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                    <StackPanel x:Name="TraktActivityContent" Spacing="12" />
                </Border>

                <!-- ===== Now Playing Section ===== -->
                <StackPanel x:Name="NowPlayingSection" Spacing="14" Visibility="Collapsed">
                    <!-- Header row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Now Playing"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="NowPlayingViewAll"
                            Grid.Column="1"
                            Text="View all 0 streams ›"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Center"
                            Tapped="ActivityLink_Tapped" />
                    </Grid>

                    <!-- Stream cards grid (2 columns) -->
                    <Grid x:Name="StreamCardsGrid" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>

                <!-- ===== Libraries + Users Two-Column Section ===== -->
                <Grid x:Name="LibraryUsersGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Libraries card -->
                    <Border x:Name="LibrariesCard" Grid.Column="0" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="36">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="Libraries"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ManageLibrariesLink"
                                    Grid.Column="1"
                                    Text="Manage ›"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center"
                                    Tapped="ManageLibrariesLink_Tapped" />
                            </Grid>
                            <!-- Library rows populated in code-behind -->
                            <StackPanel x:Name="LibrariesPanel" Spacing="8" />
                        </StackPanel>
                    </Border>

                    <!-- Users card -->
                    <Border x:Name="UsersCard" Grid.Column="1" Style="{StaticResource SectionCardStyle}">
                        <StackPanel Spacing="36">
                            <!-- Header -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="Users"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="ManageUsersLink"
                                    Grid.Column="1"
                                    Text="Manage ›"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    VerticalAlignment="Center"
                                    Tapped="ManageUsersLink_Tapped" />
                            </Grid>
                            <!-- User rows populated in code-behind -->
                            <StackPanel x:Name="UsersPanel" Spacing="0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Recent Activity Section ===== -->
                <Border x:Name="RecentActivitySection" Style="{StaticResource SectionCardStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="36">
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Recent Activity"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="ActivityViewAllLink"
                                Grid.Column="1"
                                Text="View all ›"
                                FontSize="11"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                Tapped="ActivityLink_Tapped" />
                        </Grid>
                        <!-- Activity items populated in code-behind -->
                        <StackPanel x:Name="ActivityPanel" Spacing="0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
