<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminCollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <!-- Main content -->
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- AdminCollections inherits the shared 1560px admin shell in the WebUI. -->
            <StackPanel Padding="32,24,32,40" Spacing="24" MaxWidth="1560" HorizontalAlignment="Stretch">

                <StackPanel x:Name="BrowsePanel" Spacing="24">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="Collections"
                            FontSize="48"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="Curate library shelves and sync them from MDBList or TMDB trending."
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <!-- Library picker + Add Collection button (top-right) -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <ComboBox
                            x:Name="LibraryPicker"
                            MinWidth="180"
                            CornerRadius="8"
                            FontSize="13"
                            SelectionChanged="LibraryPicker_SelectionChanged" />
                        <Button
                            x:Name="BrowseTemplatesButton"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center"
                            Click="BrowseTemplatesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                <TextBlock Text="Browse Templates" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CreateGroupButton"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center"
                            Click="CreateGroupButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                <TextBlock Text="New Group" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="AddCollectionButton"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Click="AddCollectionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add Collection" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ===== Collection boards ===== -->
                <StackPanel>
                        <!-- Inline loading indicator -->
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center"
                            Margin="0,24"
                            Width="32" Height="32" />

                        <!-- Inline error state -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="0,16"
                            Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                Foreground="{StaticResource ErrorBrush}"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="400" />
                            <Button
                                Content="Retry"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.LoadCommand}" />
                        </StackPanel>

                        <!-- Collection rows — populated in code-behind -->
                        <StackPanel x:Name="CollectionsPanel" Spacing="16" />

                        <!-- Empty state -->
                        <Border x:Name="EmptyState" Padding="20,64" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8B7;" FontSize="34" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No collections yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Create collections to curate library shelves, or sync them from MDBList or TMDB trending."
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" TextWrapping="Wrap" MaxWidth="390" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}" Click="BrowseTemplatesButton_Click" Content="Start from a template" />
                                    <Button Style="{StaticResource GhostButtonStyle}" Click="AddCollectionButton_Click" Content="Create from scratch" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                </StackPanel>

                </StackPanel>

                <!-- Dedicated collection editor workspace, matching the WebUI route structure. -->
                <StackPanel x:Name="EditorPanel" Spacing="24" Visibility="Collapsed">
                    <Button Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Click="EditorBackButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            <TextBlock Text="Back to Collections" />
                        </StackPanel>
                    </Button>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="EditorTitle" Text="Add Collection" FontSize="48" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="EditorSubtitle" Text="Build the collection in a full-page editor instead of a cramped dialog."
                                       FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ChangeSourceButton" Style="{StaticResource GhostButtonStyle}"
                                Content="Change Source Type" VerticalAlignment="Center" Click="ChangeSourceButton_Click" />
                    </Grid>

                    <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="24">
                        <ContentControl x:Name="EditorContent" HorizontalContentAlignment="Stretch" />
                    </Border>

                    <TextBlock x:Name="EditorError" Visibility="Collapsed" FontSize="13" Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Right" MaxWidth="620" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="Cancel" Click="EditorBackButton_Click" />
                        <Button x:Name="EditorSaveButton" Style="{StaticResource AccentButtonStyle}" Content="Save Collection" Click="EditorSaveButton_Click" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
