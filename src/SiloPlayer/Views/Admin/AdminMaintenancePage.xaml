<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminMaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <ScrollViewer
            IsScrollInertiaEnabled="True">

            <!-- webui parity: .page-shell { max-width: 1400px; margin-inline: auto; } -->
            <StackPanel x:Name="MaintenancePageShell" Padding="40,24,40,24" Spacing="24" MaxWidth="1400" HorizontalAlignment="Center">

                <!-- ===== Page header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Maintenance"
                        FontSize="48"
                        FontWeight="ExtraBold"
                        CharacterSpacing="-50"
                        LineHeight="46"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Operational tools that affect the whole catalog live here. Use this page for bulk import/export workflows and other future maintenance actions."
                        FontSize="16"
                        LineHeight="27"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        TextWrapping="Wrap"
                        MaxWidth="820"
                        HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Inline loading indicator -->
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center"
                    Margin="0,24"
                    Width="32" Height="32" />

                <!-- Inline error state -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="0,16"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="{StaticResource ErrorBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="400" />
                    <Button
                        Content="Retry"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.LoadCommand}" />
                </StackPanel>

                <!-- ===== Catalog Import & Export — actions bar ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                    <Grid x:Name="CatalogMaintenanceHeader" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock
                                Text="Catalog Import &amp; Export"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock
                                Text="Queue full catalog exports, import seeds from uploads or S3, and watch background job progress in one place."
                                FontSize="13"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                TextWrapping="Wrap"
                                MaxWidth="640"
                                HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel x:Name="CatalogMaintenanceActions" Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                    VerticalAlignment="Center">
                            <Button
                                x:Name="StartExportButton"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="12,6"
                                Click="StartExport_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    <TextBlock Text="Start Export" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="ImportCatalogButton"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="12,6"
                                Click="ImportCatalog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="13" />
                                    <TextBlock Text="Import Catalog" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Recent Catalog Imports ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Recent Catalog Imports"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Imports run in the background so progress stays visible while validation and writes are in flight."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="ImportJobsCountText" Text="0" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel x:Name="ImportJobsPanel" />
                    </StackPanel>
                </Border>

                <!-- ===== Recent Catalog Exports ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Recent Catalog Exports"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Export jobs run in the background and upload finished seeds to the private internal S3 bucket."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="ExportJobsCountText" Text="0" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel x:Name="ExportJobsPanel" />
                    </StackPanel>
                </Border>

                <!-- ===== Job History ===== -->
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="20,14" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock
                                    Text="Job History"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock
                                    Text="Recent background jobs across all types."
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Background="{StaticResource SurfaceRaisedBrush}"
                                        CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="AllJobsCountText" Text="0" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Border>
                                <Button Click="RefreshAllJobs_Click" Background="Transparent" BorderThickness="0"
                                        Padding="8" ToolTipService.ToolTip="Refresh job history">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"
                                              Foreground="{StaticResource SecondaryTextBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                        <StackPanel x:Name="AllJobsPanel" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
