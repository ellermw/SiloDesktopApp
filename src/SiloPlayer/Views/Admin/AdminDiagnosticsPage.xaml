<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.Admin.AdminDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="DiagnosticFieldStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style x:Key="DiagnosticHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" SizeChanged="ContentScrollViewer_SizeChanged">
            <StackPanel x:Name="AdminPageContent" MaxWidth="1640" HorizontalAlignment="Center" Padding="40,32,40,40" Spacing="24">
                <Grid x:Name="PageHeader" ColumnSpacing="24" RowSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="PageHeaderCopy" Spacing="8">
                        <TextBlock x:Name="PageTitle" Text="Client Diagnostics" FontSize="44" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Review client crash reports, device context, and correlated playback sessions."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="PageHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <TextBlock Text="Client uploads" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="UploadsSwitch" OnContent="" OffContent="" Toggled="UploadsSwitch_Toggled" />
                        </StackPanel>
                        <StackPanel Spacing="3" HorizontalAlignment="Right">
                            <TextBlock Text="RETENTION" FontSize="10" CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Right" />
                            <TextBlock x:Name="RetentionText" Text="Loading..." FontSize="13" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border x:Name="StatusBanner" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7BA;" FontSize="15"/><TextBlock x:Name="StatusBannerText" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16">
                    <Grid x:Name="FilterGrid" ColumnSpacing="10" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="USER" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><TextBox x:Name="UserIdBox" PlaceholderText="Any" InputScope="Number" Style="{StaticResource DiagnosticFieldStyle}"/></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="PLATFORM" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><ComboBox x:Name="PlatformBox" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="All platforms" Tag=""/><ComboBoxItem Content="Android" Tag="android"/><ComboBoxItem Content="Android TV" Tag="android-tv"/><ComboBoxItem Content="iOS" Tag="ios"/><ComboBoxItem Content="tvOS" Tag="tvos"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="REPORT TYPE" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><ComboBox x:Name="ReportTypeBox" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="All types" Tag=""/><ComboBoxItem Content="Crash" Tag="crash"/><ComboBoxItem Content="ANR" Tag="anr"/><ComboBoxItem Content="Native crash" Tag="native_crash"/><ComboBoxItem Content="Hang" Tag="hang"/><ComboBoxItem Content="Abnormal exit" Tag="abnormal_exit"/><ComboBoxItem Content="Manual" Tag="manual"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="3" Spacing="5"><TextBlock Text="FROM" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="FromDate"/><TimePicker x:Name="FromTime" Grid.Column="1" ClockIdentifier="24HourClock"/></Grid></StackPanel>
                        <StackPanel Grid.Column="4" Spacing="5"><TextBlock Text="TO" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="ToDate"/><TimePicker x:Name="ToTime" Grid.Column="1" ClockIdentifier="24HourClock"/></Grid></StackPanel>
                        <StackPanel Grid.Column="5" Spacing="5"><TextBlock Text="SHORT ID" FontSize="10" CharacterSpacing="100" Foreground="{StaticResource TertiaryTextBrush}"/><TextBox x:Name="ShortIdBox" PlaceholderText="Exact ID" CharacterCasing="Upper" Style="{StaticResource DiagnosticFieldStyle}"/></StackPanel>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button Style="{StaticResource AccentButtonStyle}" Content="Apply" Click="ApplyFilters_Click"/><Button x:Name="ClearButton" Style="{StaticResource SecondaryButtonStyle}" Click="ClearFilters_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="12"/><TextBlock Text="Clear"/></StackPanel></Button></StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="1120">
                            <Grid Padding="14,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/><ColumnDefinition Width="155"/><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Received" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="1" Text="Short ID" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="2" Text="User" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="3" Text="Platform" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="4" Text="Type" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="5" Text="Summary" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="6" Text="State" Style="{StaticResource DiagnosticHeaderStyle}"/><TextBlock Grid.Column="7" Text="Bundle" Style="{StaticResource DiagnosticHeaderStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"/>
                            <StackPanel x:Name="ReportRows"/>
                            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" Spacing="7" Padding="20,48">
                                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource SurfaceBrush}"><FontIcon Glyph="&#xE7BA;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <TextBlock Text="No diagnostic reports" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyDescription" MaxWidth="460" TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="LoadingText" Text="Loading diagnostic reports..." Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Padding="20,42"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid><Button x:Name="PreviousButton" Content="Previous" Style="{StaticResource SecondaryButtonStyle}" Click="Previous_Click"/><TextBlock x:Name="PageText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><Button x:Name="NextButton" Content="Next" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="Next_Click"/></Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DetailOverlay" Visibility="Collapsed" Background="#99000000" Tapped="DetailBackdrop_Tapped">
            <Border x:Name="DetailDrawer" Width="720" MaxWidth="900" HorizontalAlignment="Right" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Tapped="DetailDrawer_Tapped">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Padding="22,18"><StackPanel Spacing="5"><TextBlock x:Name="DetailTitle" Text="Report" FontFamily="Consolas" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DetailSubtitle" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Click="CloseDetail_Click" AutomationProperties.Name="Close report details"><FontIcon Glyph="&#xE711;"/></Button></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DetailContent" Padding="22,8,22,32" Spacing="20"/></ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
