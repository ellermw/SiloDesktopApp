<Page x:Class="SiloPlayer.Views.Admin.AdminHomeSectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Page.Resources>
    <!-- A row lights up on hover with the accent fill at 60% (hover:bg-accent/60); nothing else about a list item changes. -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#99203043"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#99203043"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#00000000"/>
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#99203043"/>
    <Style x:Key="HomeSectionRowContainer" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <DataTemplate x:Key="HomeSectionRowTemplate">
      <Grid x:Name="RowRoot" Padding="{Binding RowPadding}" Margin="{Binding RowMargin}" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/>
        </Grid.ColumnDefinitions>
        <!-- The dashed outline of an off row (a border-dashed line) and the hairline between two shown rows. -->
        <Rectangle Grid.ColumnSpan="5" Margin="-8,-5,-12,-5" RadiusX="18" RadiusY="18" StrokeThickness="1" StrokeDashArray="3,3" IsHitTestVisible="False"
                   Stroke="{ThemeResource SecondaryTextBrush}" Opacity="0.3" Visibility="{Binding CollapsedVisibility}"/>
        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top" Margin="116,-11,4,0" IsHitTestVisible="False" Background="{ThemeResource BorderBrush}" Opacity="0.75"
                Visibility="{Binding SeparatorVisibility}"/>
        <Grid Width="28" VerticalAlignment="Center" HorizontalAlignment="Center">
          <CheckBox x:Name="SelectBox" IsChecked="{Binding Selected, Mode=OneWay}" Visibility="{Binding SelectionVisibility}" MinWidth="0" Padding="0"
                    AutomationProperties.Name="{Binding SelectLabel}" Checked="RowSelectionChanged" Unchecked="RowSelectionChanged"/>
          <!-- lucide grip-vertical -->
          <Viewbox Width="18" Height="18" Visibility="{Binding GripVisibility}" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.7">
            <Canvas Width="24" Height="24">
              <Path Stroke="{ThemeResource SecondaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M10 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M10 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M10 19a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M16 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M16 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M16 19a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
            </Canvas>
          </Viewbox>
        </Grid>
        <Border x:Name="ArtHost" Grid.Column="1" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0">
          <Grid ColumnSpacing="8" Visibility="{Binding ExpandedVisibility}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" CharacterSpacing="-10" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                       MaxWidth="{Binding TitleMaxWidth}" Foreground="{ThemeResource PrimaryTextBrush}"/>
            <StackPanel x:Name="TagHost" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="MetaText" Visibility="{Binding ExpandedVisibility}" FontSize="13" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" Foreground="{ThemeResource SecondaryTextBrush}"/>
          <TextBlock x:Name="CollapsedText" Visibility="{Binding CollapsedVisibility}" FontSize="13.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"
                     Foreground="{ThemeResource SecondaryTextBrush}"/>
        </StackPanel>
        <ToggleSwitch Grid.Column="3" x:Name="ShownSwitch" IsOn="{Binding Shown, Mode=OneWay}" IsEnabled="{Binding CanWrite}" OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                      AutomationProperties.Name="{Binding ShownAccessibleLabel}" Toggled="ShownToggled" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Width="{Binding MenuWidth}" Height="36" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="10" BorderThickness="0" Background="Transparent"
                IsEnabled="{Binding CanWrite}" AutomationProperties.Name="{Binding MenuLabel}" Click="RowMenuClick" VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- lucide ellipsis -->
          <Viewbox Width="16" Height="16" IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
              <Path Stroke="{ThemeResource SecondaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M13 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M20 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0 M6 12a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
            </Canvas>
          </Viewbox>
        </Button>
      </Grid>
    </DataTemplate>
  </Page.Resources>
</Page>
