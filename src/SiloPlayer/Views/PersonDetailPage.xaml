<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.PersonDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}"
    SizeChanged="PersonDetailPage_SizeChanged">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Filter tab button styles -->
        <Style x:Key="FilterTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6,12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style x:Key="FilterTabActiveStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6,12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Skeleton while the person detail + filmography load.
             Approximates photo + header text + filmography grid. -->
        <ScrollViewer
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PersonSkeletonShell" Padding="40,32,40,48" Spacing="24"
                        MaxWidth="1400" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:SkeletonBox Grid.Column="0" Width="180" Height="270" CornerRadius="8" />
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top" Margin="0,8,0,0">
                        <controls:SkeletonText Width="320" Height="32" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="220" Height="14" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="600" Height="14" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="580" Height="14" HorizontalAlignment="Left" />
                        <controls:SkeletonText Width="540" Height="14" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>

                <!-- Filmography grid skeleton (inline poster placeholders — virtualization not needed for 12 lightweight controls). -->
                <controls:SkeletonText Width="140" Height="20" HorizontalAlignment="Left" />
                <StackPanel x:Name="PersonSkeletonGrid" Orientation="Horizontal" Spacing="12">
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                    <controls:SkeletonPoster />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="PersonUnavailableState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520" Margin="24" Visibility="Collapsed">
            <TextBlock x:Name="PersonUnavailableTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="PersonUnavailableDescription" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="PersonRetryButton" Content="Retry" HorizontalAlignment="Center" Click="RetryPerson_Click" />
        </StackPanel>

        <!-- Content -->
        <ScrollViewer
            x:Name="ContentScroll" Visibility="Collapsed">

            <Grid>
            <StackPanel x:Name="PersonContentShell" Padding="40,32,40,48"
                        MaxWidth="1400" HorizontalAlignment="Stretch">

                <!-- Header: photo + info -->
                <Grid x:Name="PersonHeader" ColumnSpacing="24" RowSpacing="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Photo (2:3 aspect, rounded) -->
                    <Border
                        x:Name="PersonPhotoBorder"
                        Grid.Column="0"
                        Width="180"
                        Height="270"
                        VerticalAlignment="Top"
                        CornerRadius="8"
                        Background="{StaticResource CardBackgroundBrush}">
                        <!-- Initials fallback -->
                        <TextBlock
                            x:Name="InitialsText"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Info column -->
                    <StackPanel x:Name="PersonInfo" Grid.Column="1" Spacing="0" VerticalAlignment="Top" Margin="0,4,0,0">

                        <controls:WrapPanel HorizontalSpacing="12" VerticalSpacing="12" Margin="0,0,0,12">
                            <TextBlock x:Name="PersonName" FontSize="30" FontWeight="SemiBold" CharacterSpacing="-25"
                                       LineHeight="36" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                            <StackPanel x:Name="PersonActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
                                <Button x:Name="RefreshPersonButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" FontSize="12" Padding="12,0" Click="RefreshPerson_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                                        <TextBlock x:Name="RefreshPersonLabel" Text="Refresh metadata" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EditPersonButton" Style="{StaticResource OutlineButtonStyle}" Height="32" MinHeight="0" FontSize="12" Padding="12,0" Click="EditPerson_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z m15 5 4 4" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                                        <TextBlock Text="Edit metadata" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </controls:WrapPanel>

                        <!-- Current WebUI renders person facts as independent
                             metadata badges below the name/actions row. -->
                        <controls:WrapPanel x:Name="PersonMetadataBadges" HorizontalSpacing="8" VerticalSpacing="8" Margin="0,0,0,16">
                            <Border x:Name="BirthDateBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,3">
                                <TextBlock x:Name="BirthDateText" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                            <Border x:Name="AgeBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,3">
                                <TextBlock x:Name="AgeText" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                            <Border x:Name="DeathDateBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,3">
                                <TextBlock x:Name="DeathDateText" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                            <Border x:Name="BirthplaceBadge" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="9,3">
                                <TextBlock x:Name="BirthplaceText" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" />
                            </Border>
                        </controls:WrapPanel>

                        <!-- Bio -->
                        <TextBlock
                            x:Name="BioText"
                            Style="{StaticResource BodyTextStyle}"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="672"
                            HorizontalAlignment="Left"
                            LineHeight="22.75"
                            LineStackingStrategy="BlockLineHeight"
                            FontSize="14"
                            MaxLines="0"
                            Margin="0" />

                        <!-- Show more toggle -->
                        <Button
                            x:Name="ShowMoreBioButton"
                            Style="{StaticResource GhostButtonStyle}"
                            Click="ShowMoreBio_Click"
                            Padding="0,4"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ShowMoreBioText"
                                Text="Show more"
                                FontSize="13"
                                Foreground="{StaticResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="PersonDivider" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Margin="-40,32,-40,32" />

                <!-- Filmography section -->
                <StackPanel Spacing="24">

                    <!-- Title + filter tabs + count -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Filmography"
                            FontSize="20" CharacterSpacing="-25" LineHeight="28" LineStackingStrategy="BlockLineHeight"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center" />

                        <!-- Filter tabs align to the right edge in the WebUI. -->
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="FilterAllButton"
                                Content="All"
                                Style="{StaticResource FilterTabActiveStyle}"
                                Click="FilterTab_Click"
                                Tag="all" />
                            <Button
                                x:Name="FilterMoviesButton"
                                Content="Movies"
                                Style="{StaticResource FilterTabStyle}"
                                Click="FilterTab_Click"
                                Tag="movie" />
                            <Button
                                x:Name="FilterSeriesButton"
                                Content="Series"
                                Style="{StaticResource FilterTabStyle}"
                                Click="FilterTab_Click"
                                Tag="series" />
                        </StackPanel>

                    </Grid>

                    <!-- Filmography grid -->
                    <ItemsRepeater x:Name="FilmographyRepeater" ElementPrepared="FilmographyRepeater_ElementPrepared">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                x:Name="FilmographyGridLayout"
                                MinItemWidth="{StaticResource PosterCardWidth}"
                                MinItemHeight="{StaticResource PosterCardTotalHeight}"
                                MinColumnSpacing="12"
                                MinRowSpacing="16"
                                ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:MediaItem">
                                <controls:PosterCard MediaItem="{x:Bind}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Empty state -->
                    <TextBlock
                        x:Name="FilmographyEmptyText"
                        Text="No items found."
                        FontSize="14"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0"
                        Visibility="Collapsed" />

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                        <Button Content="Retry" HorizontalAlignment="Left" Click="RetryPerson_Click" />
                    </StackPanel>

                    <!-- Loading-more spinner shown while the next filmography page is fetched -->
                    <StackPanel
                        x:Name="FilmographyLoadingMore"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                        <ProgressRing IsActive="True" Width="18" Height="18" />
                        <TextBlock Text="Loading more…"
                                   FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
                <Button x:Name="BackButton" Style="{StaticResource GhostButtonStyle}" Width="34" Height="34" MinWidth="0" MinHeight="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Click="BackButton_Click" AutomationProperties.Name="Go back"
                        Padding="6" CornerRadius="17" Background="{StaticResource SurfaceHoverBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="8,24,0,0">
                    <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Data="M15,18 L9,12 L15,6" Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                </Button>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
