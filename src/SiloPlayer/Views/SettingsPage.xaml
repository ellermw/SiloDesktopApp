<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SiloPlayer.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource ThemeFontFamily}"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:IntroSkipModeLabelConverter x:Key="IntroSkipModeLabel" />

        <!-- Active tab style (pill on surface) -->
        <Style x:Key="ActiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Inactive tab style -->
        <Style x:Key="InactiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <SolidColorBrush x:Key="SettingsRaisedBrush" Color="{Binding Color, Source={StaticResource SurfaceRaisedBrush}}" Opacity="0.65" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.9" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="{Binding Color, Source={StaticResource BorderBrush}}" Opacity="0.72" />

        <SolidColorBrush x:Key="SettingsPresetBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.82" />
        <Style x:Key="SettingsPresetStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Current SettingsGroup: sections sit on the page, divided by hairlines. -->
        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,28" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <Style x:Key="PersonalizeGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Settings row separator -->
        <Style x:Key="SettingsSeparator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True" HorizontalContentAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="SettingsPageShell" MaxWidth="1520" Margin="48,24,48,48">

            <!-- The WebUI keeps the back action floating above a wide page header. -->
            <Button x:Name="SettingsBackButton" Style="{StaticResource GhostButtonStyle}"
                    Width="40" Height="40" Padding="0" CornerRadius="20"
                    HorizontalAlignment="Left" Click="SettingsBackButton_Click"
                    AutomationProperties.Name="Go back" loc:Localized.Name="web.shell.pageBack.goBack">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>

            <!-- ===== Header ===== -->
            <Grid x:Name="SettingsHeaderGrid" Margin="0,40,0,0" ColumnSpacing="32" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="Settings" loc:Localized.Text="web.settings.layout.title" FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="SettingsHeaderSubtitle" Text="Make Silo work the way you like."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="SettingsSearchPanel" Grid.Column="1" Width="384" VerticalAlignment="Bottom" Spacing="8">
                    <Grid>
                    <TextBox x:Name="SettingsSearchBox" PlaceholderText="Search settings" loc:Localized.Placeholder="web.settings.search.placeholder"
                             Height="44" Padding="36,8,40,8" CornerRadius="12" TextChanged="SettingsSearchBox_TextChanged"
                             AutomationProperties.Name="Search settings" loc:Localized.Name="web.settings.search.placeholder">
                        <TextBox.HeaderTemplate>
                            <DataTemplate />
                        </TextBox.HeaderTemplate>
                    </TextBox>
                        <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource GhostButtonStyle}" Click="ClearSettingsSearch_Click" AutomationProperties.Name="Clear search" loc:Localized.Name="web.settings.search.clear" />
                    </Grid>
                    <TextBlock x:Name="SettingsSearchStatus" Text="Press Ctrl+K to search"
                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>

            <!-- ===== Status / Error ===== -->
            <StackPanel x:Name="SettingsStatusPanel" Margin="0,8,0,0">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource ErrorBrush}"
                    FontSize="13"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource AccentBrush}"
                    FontSize="13" />
            </StackPanel>

            <!-- Current WebUI /settings directory. The detail rail is only
                 shown after a section is opened. -->
            <StackPanel x:Name="SettingsOverviewPanel" Margin="0,32,0,0" Spacing="24" Visibility="Collapsed">
                <Button x:Name="SettingsCurrentProfileButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        MaxWidth="448" MinHeight="64" Padding="16,12" CornerRadius="16"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SettingsCurrentProfile_Click" />
                <StackPanel x:Name="SettingsOverviewGroups" Spacing="28" />
            </StackPanel>

            <Button x:Name="SettingsAllSettingsButton" Content="‹  All settings"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0,0,8,0"
                    Height="20" MinHeight="0" MinWidth="0" FontSize="14"
                    Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"
                    Click="SettingsAllSettings_Click" />

            <!-- ===== Settings Navigation: Two-column layout (sidebar + content) ===== -->
            <!-- Webui: SettingsLayout.tsx — grouped sidebar (220px) on desktop -->
            <Grid x:Name="SettingsLayoutGrid" Margin="0,40,0,0" Background="{StaticResource SettingsPanelBrush}" CornerRadius="27.2" BorderBrush="{StaticResource SettingsBorderBrush}" BorderThickness="1" MinHeight="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left sidebar navigation (grouped) -->
                <ScrollViewer x:Name="SettingsNavigationScroller" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel x:Name="SettingsNavigationGroups" Spacing="20">
                        <!-- Playback group -->
                        <StackPanel x:Name="PlaybackNavGroup" Spacing="2">
                            <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="PlaybackTab" Click="Tab_Click" Tag="Playback"
                                    Style="{StaticResource ActiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Playback" loc:Localized.Text="web.settings.playback.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SubtitlesTab" Click="Tab_Click" Tag="Subtitles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xED1E;" FontSize="16" />
                                    <TextBlock Text="Language &amp; Subtitles" loc:Localized.Text="web.settings.subtitleAppearance.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DevicesTab" Click="Tab_Click" Tag="Devices"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                                    <TextBlock Text="Your Devices" loc:Localized.Text="web.settings.device.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Appearance group -->
                        <StackPanel x:Name="AppearanceNavGroup" Spacing="2">
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
<Button x:Name="InterfaceTab" Click="Tab_Click" Tag="Interface"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="16" />
                                    <TextBlock Text="Navigation &amp; Cards" loc:Localized.Text="web.settings.interface.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TitlePagesTab" Click="Tab_Click" Tag="TitlePages" Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><TextBlock Text="Title Pages" loc:Localized.Text="web.settings.titlePages.title" /></Button>
                            <Button Visibility="Collapsed" x:Name="CardOverlaysTab" Click="Tab_Click" Tag="CardOverlays"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE81E;" FontSize="16" />
                                    <TextBlock Text="Card Overlays" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AccessibilityTab" Click="Tab_Click" Tag="Accessibility"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F3;" FontSize="16" />
                                    <TextBlock Text="Accessibility" loc:Localized.Text="web.settings.accessibility.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
</StackPanel>
                        <!-- Home & Discovery group -->
                        <StackPanel x:Name="HomeDiscoveryNavGroup" Spacing="2">
                            <TextBlock Text="HOME &amp; DISCOVERY" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="HomeScreenTab" Click="Tab_Click" Tag="HomeScreen"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xECA5;" FontSize="16" />
                                    <TextBlock Text="Home Screen" loc:Localized.Text="web.settings.homeScreen.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PersonalizeTab" Click="Tab_Click" Tag="Personalize"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE735;" FontSize="16" />
                                    <TextBlock Text="Personalize" loc:Localized.Text="web.settings.personalize.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibrariesTab" Click="Tab_Click" Tag="Libraries"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                    <TextBlock Text="Libraries" loc:Localized.Text="web.settings.library.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RequestsTab" Click="Tab_Click" Tag="Requests" Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock Text="Requests" loc:Localized.Text="web.settings.requests.title" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Connections group -->
                        <StackPanel x:Name="ConnectionsNavGroup" Spacing="2">
                            <TextBlock Text="CONNECTIONS" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="ConnectAppsTab" Click="Tab_Click" Tag="ConnectApps"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE839;" FontSize="16" />
                                    <TextBlock Text="Connect Apps" loc:Localized.Text="web.settings.connectApps.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WatchProvidersTab" Click="Tab_Click" Tag="WatchProviders"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                                    <TextBlock Text="Watch Providers" loc:Localized.Text="web.settings.watchProviders.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WebhookSyncTab" Click="Tab_Click" Tag="WebhookSync"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" />
                                    <TextBlock Text="Webhook Sync" loc:Localized.Text="web.settings.webhooks.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportTab" Click="Tab_Click" Tag="Import"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="16" />
                                    <TextBlock Text="History Import" loc:Localized.Text="web.settings.historyImport.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Account group -->
                        <StackPanel x:Name="AccountNavGroup" Spacing="2">
                            <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="AccountPasswordTab" Click="Tab_Click" Tag="Account"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                    <TextBlock Text="Account" loc:Localized.Text="web.settings.account.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ProfilesTab" Click="Tab_Click" Tag="Profiles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                    <TextBlock Text="Profiles" loc:Localized.Text="web.settings.profiles.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NotificationsSettingsTab" Click="Tab_Click" Tag="NotificationsSettings"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                                    <TextBlock Text="Notifications" loc:Localized.Text="web.settings.notifications.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PluginsTab" Click="Tab_Click" Tag="Plugins"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEA86;" FontSize="16" />
                                    <TextBlock Text="Plugins" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="YourDataTab" Click="Tab_Click" Tag="YourData"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEBC3;" FontSize="16" />
                                    <TextBlock Text="Your Data" loc:Localized.Text="web.settings.yourData.title" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SessionsTab" Click="Tab_Click" Tag="Sessions"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                                    <TextBlock Text="Signed-in sessions" loc:Localized.Text="web.settings.nav.sessions.label" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right column: all content panels stack here; only the
                     active one is Visible (Tab_Click toggles visibility). -->
                <StackPanel x:Name="SettingsContentPanel" Grid.Column="1" Padding="40,0,0,0"
                            HorizontalAlignment="Stretch">

            <!-- ===================================================================== -->
            <!-- ===== Navigation & Cards Panel (settings contract revision 5) ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="AccountPasswordPanel" Spacing="24" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Account" loc:Localized.Text="web.settings.account.title" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Manage the sign-in credential shared by every profile on this account." loc:Localized.Text="web.settings.account.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Password" loc:Localized.Text="web.settings.account.password.title" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Only the primary profile can change the shared account password. Your current password is required." loc:Localized.Text="web.settings.account.password.description"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <ProgressRing x:Name="AccountPasswordLoading" IsActive="False" Width="24" Height="24"
                                      HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Loading password settings" loc:Localized.Name="web.settings.account.password.loading" />
                        <StackPanel x:Name="AccountPasswordUnavailable" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Local password changes are unavailable." loc:Localized.Text="web.settings.account.password.unavailableTitle" FontWeight="SemiBold" />
                            <TextBlock Text="This account signs in through an external provider, or the active profile does not own the account credential." loc:Localized.Text="web.settings.account.password.unavailableBody"
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="AccountPasswordForm" MaxWidth="448" HorizontalAlignment="Left" Spacing="16" Visibility="Collapsed">
                            <PasswordBox x:Name="AccountCurrentPassword" Header="Current password" loc:Localized.Header="web.settings.account.password.current" HorizontalAlignment="Stretch"
                                         PasswordChanged="AccountPassword_Changed" />
                            <StackPanel Spacing="6">
                                <PasswordBox x:Name="AccountNewPassword" Header="New password" loc:Localized.Header="web.settings.account.password.new" PasswordChanged="AccountPassword_Changed" />
                                <TextBlock x:Name="AccountPasswordRequirements" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <PasswordBox x:Name="AccountConfirmPassword" Header="Confirm new password" loc:Localized.Header="web.settings.account.password.confirm" PasswordChanged="AccountPassword_Changed" />
                            <StackPanel x:Name="AccountSignOutOtherSessionsGroup" Spacing="4" Visibility="Collapsed">
                                <CheckBox x:Name="AccountSignOutOtherSessions" IsChecked="False"
                                          Checked="AccountSignOutOtherSessions_Changed" Unchecked="AccountSignOutOtherSessions_Changed"
                                          AutomationProperties.HelpText="{Binding Text, ElementName=AccountSignOutOtherSessionsDescription, Mode=OneWay}">
                                    <TextBlock Text="Sign out of other devices" loc:Localized.Text="web.settings.account.password.signOutOthers" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock x:Name="AccountSignOutOtherSessionsDescription" FontSize="12" TextWrapping="Wrap"
                                           Margin="32,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Other browsers and apps must sign in again with the new password. This app stays signed in, and API keys keep working." />
                            </StackPanel>
                            <Button x:Name="AccountPasswordSubmit" Content="Change password" Style="{StaticResource AccentButtonStyle}"
                                    Click="AccountPasswordSubmit_Click" />
                        </StackPanel>
                        <InfoBar x:Name="AccountPasswordMessage" IsOpen="False" IsClosable="False" />
                        <Button x:Name="AccountPasswordRetry" Content="Try again" loc:Localized.Content="common.tryAgain" Visibility="Collapsed" Click="AccountPasswordRetry_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="AccountSignInGroup" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sign-in" loc:Localized.Text="web.settings.accountSignIn.title" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Sign in to this account with your organization's sign-in provider." loc:Localized.Text="web.settings.accountSignIn.description" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="AccountSignInBody" MaxWidth="672" HorizontalAlignment="Stretch" Spacing="16" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="InterfacePanel" Spacing="24" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InterfaceTitleText" Text="Navigation &amp; cards" loc:Localized.Text="web.settings.interface.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="These choices sync between native desktop apps signed into this profile. Web, TV, mobile, and tablet clients keep their own matching-device layouts."
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="InterfaceStatusCard" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="InterfaceStatusTitle" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="InterfaceStatusText" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="InterfaceControls" Spacing="24">


                    <Border x:Name="InterfaceCardDeviceOverrideNotice" Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
