                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Audiobook fast-forward (seconds)" loc:Localized.Header="web.settings.playback.seek.forwardInterval" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.AudiobookSkipForwardSeconds, Mode=TwoWay}" />
                        <Button IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Content="Import this PC's old audiobook intervals" Command="{x:Bind ViewModel.ImportLegacySeekIntervalsCommand}" />

                    </StackPanel>
                </StackPanel></Border>

                <!-- Native-only capability, kept separate so the WebUI defaults card remains identical. -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Desktop playback" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Allow SiloCast control" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Use Silo on your phone to play and control videos on this PC. Keep both devices on the same local network." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                                <TextBlock x:Name="SiloCastStatusText" Text="Off" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <Button x:Name="SiloCastDisconnectButton" Content="Disconnect phone" Click="SiloCastDisconnect_Click" HorizontalAlignment="Left" Visibility="Collapsed" />
                            </StackPanel>
                            <ToggleSwitch x:Name="SiloCastToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="SiloCastToggle_Toggled" AutomationProperties.Name="Allow SiloCast control" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="HDMI audio bitstream passthrough" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Send Dolby Atmos/TrueHD, E-AC-3, AC-3, and DTS-HD directly to a compatible HDMI receiver. Leave off for speakers, headphones, Bluetooth, and USB audio." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AudioPassthroughToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AudioPassthroughToggle_Toggled" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="AI video upscaling (experimental)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Enhance 1080p and lower-resolution SDR video on larger displays. NVIDIA and Intel use driver video processing. AMD uses FSRCNNX neural upscaling; FSRCNNX can also be tested on NVIDIA and Intel GPUs. Original 4K and HDR video keep normal playback." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                                <TextBlock Text="Restart Silo for Windows Desktop App after changing this option. Intel and AMD support is experimental and needs hardware testing. Quality and power use depend on your GPU." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                                <TextBlock x:Name="RtxUpscalingHardwareText" Text="Checking graphics hardware…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="VideoUpscalingComboBox" Grid.Column="1" VerticalAlignment="Center" Width="240" IsEnabled="False" AutomationProperties.Name="AI video upscaling mode" SelectionChanged="VideoUpscalingComboBox_SelectionChanged">
                                <ComboBoxItem Content="Off" Tag="off" />
                                <ComboBoxItem Content="Automatic" Tag="automatic" />
                                <ComboBoxItem Content="NVIDIA RTX VSR" Tag="nvidia" />
                                <ComboBoxItem Content="Intel VSR (experimental)" Tag="intel" />
                                <ComboBoxItem Content="FSRCNNX AI (AMD / any GPU)" Tag="fsrcnnx" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="AppUpdatesSettingsCard" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Silo desktop updates" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="AppUpdateInstalledVersionText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="Always notify me about new releases. Choose whether Silo also downloads updates in the background and installs them when I close the app. You can review the changelog and update manually in either mode."
                                   FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="AppUpdateSettingsModeCombo" SelectionChanged="AppUpdateSettingsModeChanged" HorizontalAlignment="Stretch" MaxWidth="560"
                                  AutomationProperties.Name="Desktop update preference">
                            <ComboBoxItem Content="Notify me; I'll choose when to update" />
                            <ComboBoxItem Content="Download automatically; install when I close Silo" />
                        </ComboBox>
                        <ComboBox x:Name="AppUpdateSettingsChannelCombo" Header="Update channel" SelectionChanged="AppUpdateSettingsChannelChanged"
                                  HorizontalAlignment="Stretch" MaxWidth="560" AutomationProperties.Name="Desktop update channel">
                            <ComboBoxItem Content="Stable (default)" />
                            <ComboBoxItem Content="Beta" />
                        </ComboBox>
                        <TextBlock x:Name="AppUpdateSettingsBetaWarning" Visibility="Collapsed" Text="Beta releases may contain bugs. Choose Stable for regular approved updates."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="AppUpdateSettingsStatus" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Content="Check for updates / view changelog" Click="AppUpdateSettingsDetails_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="Automatic downloads defer to playback. Windows may request administrator approval to install."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Libraries Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="LibrariesPanel" Spacing="24" Margin="0" Visibility="Collapsed">

