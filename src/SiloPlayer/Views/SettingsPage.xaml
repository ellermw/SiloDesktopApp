                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font family" loc:Localized.Text="web.settings.subtitleAppearance.text.fontFamily" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontFamilyComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontFamily_Changed">
                                <ComboBoxItem Content="Sans-serif" loc:Localized.Content="web.settings.subtitleOptions.fontFamily.sansSerif" Tag="sans-serif" IsSelected="True" />
                                <ComboBoxItem Content="Serif" loc:Localized.Content="web.settings.subtitleOptions.fontFamily.serif" Tag="serif" />
                                <ComboBoxItem Content="Monospace" loc:Localized.Content="web.settings.subtitleOptions.fontFamily.monospace" Tag="monospace" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Font color -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font color" loc:Localized.Text="web.settings.subtitleAppearance.text.fontColor" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="SubtitleColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Slider Header="Text opacity (%)" Minimum="1" Maximum="100" StepFrequency="1" Width="260"
                                HorizontalAlignment="Left" Value="{x:Bind ViewModel.SubTextOpacity, Mode=TwoWay}"
                                ValueChanged="SubtitleTextOpacity_Changed" />

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Text outline -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text outline" loc:Localized.Text="web.settings.subtitleAppearance.text.outline" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch
                                x:Name="SubtitleOutlineToggle"
                                Grid.Column="1"
                                IsOn="True"
                                VerticalAlignment="Center"
                                OnContent="" OffContent=""
                                Toggled="SubtitleOutline_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid x:Name="SubtitleOutlineColorRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Outline color" loc:Localized.Text="web.settings.subtitleAppearance.text.outlineColor" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Only used when text outline is enabled." loc:Localized.Text="web.settings.subtitleAppearance.text.outlineColorDescription"
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleOutlineColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Background group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Background &amp; Position" loc:Localized.Text="web.settings.subtitleAppearance.background.title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Tune subtitle placement and contrast." loc:Localized.Text="web.settings.subtitleAppearance.background.description"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Background style -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background style" loc:Localized.Text="web.settings.subtitleAppearance.background.style" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleBgStyleComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitleBgStyle_Changed">
                                <ComboBoxItem Content="None" loc:Localized.Content="web.settings.subtitleOptions.backgroundStyle.none" Tag="none" />
                                <ComboBoxItem Content="Box" loc:Localized.Content="web.settings.subtitleOptions.backgroundStyle.box" Tag="box" />
                                <ComboBoxItem Content="Drop Shadow" loc:Localized.Content="web.settings.subtitleOptions.backgroundStyle.dropShadow" Tag="shadow" IsSelected="True" />
                                <ComboBoxItem Content="Outline" loc:Localized.Content="web.settings.subtitleOptions.backgroundStyle.outline" Tag="outline" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Background opacity -->
                        <Grid x:Name="SubtitleBgOpacityRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background opacity" loc:Localized.Text="web.settings.subtitleAppearance.background.opacity" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Only used for boxed subtitles." loc:Localized.Text="web.settings.subtitleAppearance.background.opacityDescription"
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Slider x:Name="SubtitleBgOpacitySlider" Width="160"
                                        Minimum="0" Maximum="100" StepFrequency="5" Value="80"
                                        ValueChanged="SubtitleBgOpacity_Changed" />
                                <TextBlock x:Name="SubtitleBgOpacityLabel" Text="80%"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid x:Name="SubtitleBgColorRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background color" loc:Localized.Text="web.settings.subtitleAppearance.background.color" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleBgColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle position" loc:Localized.Text="web.settings.subtitleAppearance.background.position" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitlePositionComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitlePosition_Changed">
                                <ComboBoxItem Content="Bottom" loc:Localized.Content="web.settings.subtitleOptions.position.bottom" Tag="bottom" IsSelected="True" />
                                <ComboBoxItem Content="Lower Third" loc:Localized.Content="web.settings.subtitleOptions.position.lowerThird" Tag="lower-third" />
                                <ComboBoxItem Content="Top" loc:Localized.Content="web.settings.subtitleOptions.position.top" Tag="top" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Home Screen Panel ===== -->
            <!-- ===================================================================== -->
            <ContentControl x:Name="HomeScreenPanel" HorizontalContentAlignment="Stretch" Margin="0" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Home screen" loc:Localized.Text="web.settings.homeScreen.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Choose the rows you see and their order. Only this profile changes, and it saves as you go." loc:Localized.Text="web.settings.homeScreen.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="HomePreferencesGroup" Style="{StaticResource SettingsGroupStyle}">
                  <StackPanel Spacing="16">
                    <TextBlock Text="Home preferences" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Spacing="8">
                      <TextBlock Text="Next up episodes" loc:Localized.Text="web.home.preferences.nextUpLabel" FontSize="14" FontWeight="Medium" />
                      <TextBlock Text="Keep the next episode of a show you're watching in Continue Watching, or give them their own row." loc:Localized.Text="web.home.preferences.nextUpHelp"
                                 FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox x:Name="NextUpModeComboBox" Width="240" SelectionChanged="NextUpModeComboBox_SelectionChanged"
                                  IsEnabled="{x:Bind ViewModel.CanChangeNextUpMode, Mode=OneWay}">
                          <ComboBoxItem Content="With Continue Watching" loc:Localized.Content="settingsManifest.ui.next_up_mode.option.combined" Tag="combined" />
                          <ComboBoxItem Content="Separate row" loc:Localized.Content="settingsManifest.ui.next_up_mode.option.separate" Tag="separate" />
                        </ComboBox>
                        <Button Content="Use server default" loc:Localized.Content="web.home.preferences.useServerDefault" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.ResetNextUpModeCommand}"
                                Visibility="{x:Bind ViewModel.NextUpHasOwnChoice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                      <TextBlock Text="{x:Bind ViewModel.NextUpInheritanceExplanation, Mode=OneWay}" TextWrapping="Wrap"
                                 Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                      <TextBlock Text="{x:Bind ViewModel.NextUpPreferenceError, Mode=OneWay}" TextWrapping="Wrap"
                                 Foreground="{StaticResource ErrorBrush}" FontSize="12" />
                      <Button Content="Try again" loc:Localized.Content="common.tryAgain" Command="{x:Bind ViewModel.RetryNextUpPreferenceCommand}"
                              Visibility="{x:Bind ViewModel.NextUpPreferenceError, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <StackPanel x:Name="NewEpisodesFirstGroup" Spacing="8"
                                Visibility="{x:Bind ViewModel.NewEpisodesPreferenceVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                      <Border Style="{StaticResource SettingsSeparator}" />
                      <TextBlock Text="Show new episodes first" loc:Localized.Text="web.home.preferences.newReleasesFirstLabel" FontSize="14" FontWeight="Medium" />
                      <TextBlock x:Name="NewEpisodesFirstDescription" Text="Move a show you're caught up on to the front of Continue Watching and Next Up when a new episode or season arrives." loc:Localized.Text="web.home.preferences.newReleasesFirstHelp"
                                 TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                      <ToggleSwitch x:Name="NewEpisodesFirstToggle" AutomationProperties.Name="Show new episodes first" loc:Localized.Name="web.home.preferences.newReleasesFirstLabel"
                                    AutomationProperties.HelpText="Only this profile changes." loc:Localized.Help="web.home.rows.remove.onlyThisProfile"
                                    IsOn="{x:Bind ViewModel.ShowNewEpisodesFirst, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanChangeNewEpisodesFirst, Mode=OneWay}" />
                      <TextBlock Text="Only this profile changes, and it saves as you go." TextWrapping="Wrap"
                                 Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                      <TextBlock Text="{x:Bind ViewModel.NewEpisodesInheritanceExplanation, Mode=OneWay}" TextWrapping="Wrap"
                                 Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                      <Button Content="Use server default" loc:Localized.Content="web.home.preferences.useServerDefault" Style="{StaticResource GhostButtonStyle}"
                              Command="{x:Bind ViewModel.ResetNewEpisodesPreferenceCommand}"
                              Visibility="{x:Bind ViewModel.NewEpisodesHasOwnChoice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                      <TextBlock Text="Saving Home preference…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                 Visibility="{x:Bind ViewModel.IsNewEpisodesPreferencePending, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                      <TextBlock x:Name="NewEpisodesFirstError" Text="{x:Bind ViewModel.NewEpisodesPreferenceError, Mode=OneWay}"
                                 TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" FontSize="13"
                                 Visibility="{x:Bind ViewModel.NewEpisodesPreferenceError, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                      <Button x:Name="NewEpisodesFirstRetry" Content="Try again" loc:Localized.Content="common.tryAgain" Command="{x:Bind ViewModel.RetryNewEpisodesPreferenceCommand}"
                              Visibility="{x:Bind ViewModel.NewEpisodesPreferenceError, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsSeparator}" />
                    <ToggleSwitch Header="Hide watched items" loc:Localized.Header="web.home.preferences.hideWatchedLabel" IsOn="{x:Bind ViewModel.HideWatchedItems, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeHomePreference, Mode=OneWay}" />
                    <TextBlock Text="Remove titles you've finished from ordinary rows. Hero banners and watch-history rows keep them." loc:Localized.Text="web.home.preferences.hideWatchedHelp"
                               TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                  </StackPanel>
                </Border>
                <!-- Scope group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Page" loc:Localized.Text="web.home.rows.page.pageSwitcher" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Pick the home screen or library-specific view you want to customize."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Editing scope" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Changes apply only to the selected home screen."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HomeScopeComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center" SelectionChanged="HomeScopeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Home" loc:Localized.Content="web.home.rows.pages.home" Tag="home" IsSelected="True" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

<!-- Sections group -->
                <Border x:Name="HomeRowsGroup" Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rows" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Drag rows to change their order. Hidden rows stay here so you can bring them back."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="+ Add row" Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}"
                                        Padding="14,7" Click="HomeSectionsAdd_Click" />
                                <Button Content="+ Add Section" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}"
                                        Padding="14,7" Click="HomeSectionsAddCustom_Click" />
                                <Button x:Name="HomeLayoutMoreButton" Content="More" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7">
                                  <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="Export layout" loc:Localized.Text="web.settings.homeScreen.export" Click="HomeExport_Click" />
                                    <MenuFlyoutItem Text="Import layout…" loc:Localized.Text="web.settings.homeScreen.import" Click="HomeImport_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Reset this page to the server's rows…" IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}" Click="HomeSectionsReset_Click" />
                                  </MenuFlyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="HomeSectionsCountText" Grid.Column="1" Text="0 sections"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="24" Height="24" />
                        <TextBlock Text="Saving your changes…" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{x:Bind ViewModel.IsSavingHomeSections, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <Button Content="Reload rows" loc:Localized.Content="web.settings.homeScreen.reloadRows" Click="HomeRowsReload_Click" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />

                        <!-- Section items (built in code-behind) -->
                        <StackPanel x:Name="HomeSectionItemsContainer" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Visibility="Collapsed" Style="{StaticResource SettingsGroupStyle}"><StackPanel Spacing="12">
                    <TextBlock Text="Export and import" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Move saved layout overrides between profiles or servers. Private history and credentials are excluded." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="HomeExportButton" Content="Export layout" loc:Localized.Content="web.settings.homeScreen.export" Click="HomeExport_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="HomeImportButton" Content="Import layout" Click="HomeImport_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    </controls:WrapPanel>
                </StackPanel></Border>
            </StackPanel>
            </ContentControl>

            <!-- ===================================================================== -->
            <!-- ===== Card Overlays Panel ===== -->
            <!-- ===================================================================== -->


            <!-- ===================================================================== -->
            <!-- ===== Personalize Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="RequestsPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Watchlist requests" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Automatically request titles outside your library when you add them to your watchlist. Turning this off keeps existing requests." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ToggleSwitch x:Name="WatchlistAutoRequestToggle" Header="Request titles added to watchlist" Toggled="WatchlistAutoRequestToggle_Toggled" Visibility="Collapsed" />
                        <TextBlock x:Name="WatchlistRequestSettingStatus" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="PersonalizePanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PersonalizeTitleText" Text="Personalize" loc:Localized.Text="web.settings.personalize.title" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Pick titles you love so your home, recommendations, and &quot;For You&quot; rows reflect your taste." loc:Localized.Text="web.settings.personalize.subtitle" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource PersonalizeGroupStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="PersonalizeTasteIcon" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE735;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Refine your taste profile" loc:Localized.Text="web.settings.personalize.refineTitle" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                                <TextBlock Text="Browse popular titles and pick the ones you love. Already-favorited titles will be marked, so you can add to (or trim) your picks any time." loc:Localized.Text="web.settings.personalize.refineDescription" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="PersonalizePickerButton" Content="Open the picker  →" Style="{StaticResource AccentButtonStyle}" Height="36" FontSize="14" FontWeight="Medium" Padding="16,8" HorizontalAlignment="Left" Click="OpenTasteSeed_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="NotInterestedPanel" Style="{StaticResource PersonalizeGroupStyle}" Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBackgroundBrush}" VerticalAlignment="Top">
                            <SymbolIcon Symbol="Dislike" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock Text="Not interested" loc:Localized.Text="web.settings.notInterestedList.title" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Titles you marked Not interested stay out of your recommendations, and similar titles rank lower. You can still find and play them anywhere else." loc:Localized.Text="web.settings.notInterestedList.description" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="NotInterestedLoading" Text="Loading…" loc:Localized.Text="web.settings.notInterestedList.loading" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                            <StackPanel x:Name="NotInterestedErrorPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="NotInterestedError" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                                <Button x:Name="NotInterestedRetry" Content="Retry" loc:Localized.Content="common.retry" Click="NotInterestedRetry_Click" HorizontalAlignment="Left" Style="{StaticResource OutlineButtonStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="NotInterestedRows" Spacing="0" />
                            <TextBlock x:Name="NotInterestedEmpty" Text="Nothing yet. Choose Not Interested from a movie or show's menu." loc:Localized.Text="web.settings.notInterestedList.empty" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                            <Button x:Name="NotInterestedMore" Content="Show more" Click="NotInterestedMore_Click" HorizontalAlignment="Left" Style="{StaticResource OutlineButtonStyle}" Visibility="Collapsed" />
                            <TextBlock x:Name="NotInterestedMoreError" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource PersonalizeGroupStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="PersonalizeTourIcon" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Replay the feature tour" loc:Localized.Text="web.settings.personalize.tourTitle" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                                <TextBlock Text="A two-minute walkthrough of what this server can do — watch together, requests, watchlists, and the playback settings worth knowing about." loc:Localized.Text="web.settings.personalize.tourDescription"
                                           FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="StartFeatureTourButton" Content="Start the tour" loc:Localized.Content="web.settings.personalize.startTour"
                                    Style="{StaticResource OutlineButtonStyle}" Height="36" FontSize="14" FontWeight="Medium" Padding="16,8" HorizontalAlignment="Left"
                                    Click="StartFeatureTour_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel x:Name="PersonalizeFavoritesRow" Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <FontIcon Glyph="&#xEB51;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="PersonalizeFavoritesText" Text="Loading favorites…" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Import Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="ImportPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="History import" loc:Localized.Text="web.settings.historyImport.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Import watch history from an external media server into a Silo profile." loc:Localized.Text="web.settings.historyImport.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== New import — source + credentials + start button ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="New import" loc:Localized.Text="web.settings.historyImport.newImport.title" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Choose a source, sign in, and pick a profile to receive the watch history." loc:Localized.Text="web.settings.historyImport.newImport.description"
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Source cards — 3-up grid (Emby / Jellyfin / Plex) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ImportSourceEmbyCard" Grid.Column="0" TabIndex="0" Tag="emby"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#1DCFA1">
                                            <TextBlock Text="E" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Emby" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Emby Connect or direct server"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourceJellyfinCard" Grid.Column="2" TabIndex="2" Tag="jellyfin"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#00A4DC">
                                            <TextBlock Text="J" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Jellyfin" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Direct server URL + credentials" loc:Localized.Text="web.settings.historyImport.source.jellyfin"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourcePlexCard" Grid.Column="1" TabIndex="1" Tag="plex"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#E5A00D">
                                            <TextBlock Text="P" FontSize="15" FontWeight="SemiBold" Foreground="Black"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Plex" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Plex account or direct server" loc:Localized.Text="web.settings.historyImport.source.plex"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Mode selector — only for Emby and Plex (Jellyfin is single-mode) -->
                        <StackPanel x:Name="ImportEmbyModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportEmbyConnectModeBtn" Content="Emby Connect" loc:Localized.Content="web.settings.historyImport.mode.embyConnect" Tag="connect"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportEmbySavedModeBtn" Content="Saved Server" loc:Localized.Content="web.settings.historyImport.savedServer" Tag="saved"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="ImportPlexModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportPlexOAuthModeBtn" Content="Plex Account" loc:Localized.Content="web.settings.historyImport.mode.plexAccount" Tag="oauth"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportPlexSavedModeBtn" Content="Saved Server" loc:Localized.Content="web.settings.historyImport.savedServer" Tag="saved"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <!-- ===== Auth panels (one visible at a time) ===== -->

                        <!-- Emby Connect form -->
                        <StackPanel x:Name="ImportEmbyConnectPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Email or Username" loc:Localized.Text="web.settings.historyImport.emailOrUsername" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbyConnectUsernameBox"
                                             Text="{x:Bind ViewModel.EmbyConnectUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Password" loc:Localized.Text="web.settings.historyImport.password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbyConnectPasswordBox"
                                                 PasswordChanged="EmbyConnectPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="EmbyConnectLoginButton" Content="Find Servers" loc:Localized.Content="web.settings.historyImport.findServers"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="EmbyConnectLogin_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="EmbyConnectConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" loc:Localized.Text="web.settings.historyImport.connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" loc:Localized.Text="web.settings.historyImport.server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="EmbyConnectServerCombo" PlaceholderText="Choose a server" loc:Localized.Placeholder="web.settings.historyImport.chooseServer"
                                                  SelectionChanged="EmbyConnectServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <TextBlock Text="Silo will exchange the server's temporary access key for a local Emby token and use it only for this import."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Emby Saved form -->
                        <StackPanel x:Name="ImportEmbySavedPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock x:Name="EmbySavedSourcesLoadingText" Text="Loading saved servers…" loc:Localized.Text="web.settings.historyImport.loadingSavedServers" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                            <Border x:Name="EmbySavedSourcesEmptyNotice" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <TextBlock Text="No admin-defined Emby servers are available yet." FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="EmbySavedSourcesFields" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved Server" loc:Localized.Text="web.settings.historyImport.savedServer" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="EmbySavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="EmbySavedSource_SelectionChanged" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Emby Username" loc:Localized.Text="web.settings.historyImport.embyUsername" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbySavedUsernameBox"
                                             Text="{x:Bind ViewModel.EmbySavedUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Emby Password" loc:Localized.Text="web.settings.historyImport.embyPassword" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbySavedPasswordBox"
                                                 PasswordChanged="EmbySavedPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        </StackPanel>

                        <!-- Plex OAuth form -->
                        <StackPanel x:Name="ImportPlexOAuthPanel" Spacing="12" Visibility="Collapsed">
                            <!-- Pending spinner + status -->
                            <Border x:Name="PlexAuthPendingPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ProgressRing IsActive="True" Width="18" Height="18" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="PlexAuthPendingText" Text="Finishing Plex sign-in…" FontSize="13"
                                                   FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Continue in Plex, then you'll be returned here automatically." loc:Localized.Text="web.settings.historyImport.plexContinue"
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Error panel -->
                            <Border x:Name="PlexAuthErrorPanel" Visibility="Collapsed"
                                    Background="#331F1F1F"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource ErrorBrush}" />
                                        <TextBlock x:Name="PlexAuthErrorText" FontSize="13"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Content="Try again" loc:Localized.Content="web.settings.historyImport.tryAgain" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- Sign-in button -->
                            <Button x:Name="PlexAuthSignInButton" Content="Sign in with Plex" loc:Localized.Content="web.settings.historyImport.signInWithPlex"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="PlexAuthStart_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="PlexAuthConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" loc:Localized.Text="web.settings.historyImport.connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" loc:Localized.Text="web.settings.historyImport.server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="PlexOAuthServerCombo" PlaceholderText="Choose a server" loc:Localized.Placeholder="web.settings.historyImport.chooseServer"
                                                  SelectionChanged="PlexOAuthServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <Button Content="Reconnect Plex Account" loc:Localized.Content="web.settings.historyImport.reconnectPlex" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plex Saved form -->
                        <StackPanel x:Name="ImportPlexSavedPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock x:Name="PlexSavedSourcesLoadingText" Text="Loading saved servers…" loc:Localized.Text="web.settings.historyImport.loadingSavedServers" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                            <Border x:Name="PlexSavedSourcesEmptyNotice" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <TextBlock Text="No admin-defined Plex servers are available yet." FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="PlexSavedSourcesFields" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved Server" loc:Localized.Text="web.settings.historyImport.savedServer" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="PlexSavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="PlexSavedSource_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Plex Auth Token" loc:Localized.Text="web.settings.historyImport.plexToken" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <PasswordBox x:Name="PlexSavedTokenBox" PlaceholderText="Your Plex authentication token" loc:Localized.Placeholder="web.settings.historyImport.plexTokenPlaceholder"
                                             PasswordChanged="PlexSavedToken_Changed"
                                             Style="{StaticResource DarkPasswordBoxStyle}" MaxWidth="420" />
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Jellyfin direct form -->
                        <StackPanel x:Name="ImportJellyfinPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Jellyfin Server URL" loc:Localized.Text="web.settings.historyImport.jellyfinServerUrl" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="JellyfinServerUrlBox"
                                         PlaceholderText="https://jellyfin.example.com"
                                         Text="{x:Bind ViewModel.JellyfinServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Jellyfin Username" loc:Localized.Text="web.settings.historyImport.jellyfinUsername" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="JellyfinUsernameBox"
                                             Text="{x:Bind ViewModel.JellyfinUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Jellyfin Password" loc:Localized.Text="web.settings.historyImport.jellyfinPassword" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="JellyfinPasswordBox"
                                                 PasswordChanged="JellyfinPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Enter the base URL for the Jellyfin server you want to import from." loc:Localized.Text="web.settings.historyImport.jellyfinHelp"
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Divider before target row -->
                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Profile + Start Import row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Import into profile" loc:Localized.Text="web.settings.historyImport.importIntoProfile" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ImportProfileCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="ImportProfile_SelectionChanged"
                                          PlaceholderText="Choose a profile" loc:Localized.Placeholder="web.settings.historyImport.chooseProfile" />
                            </StackPanel>
                            <Button x:Name="StartImportButton" Grid.Column="1"
                                    Content="Start Import" loc:Localized.Content="web.settings.historyImport.startImport" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" Padding="24,10"
                                    Click="StartImport_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Latest import / selected run summary ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RunSummaryTitle" Text="Latest import" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="RunSummarySubtitle" Text="Results from the most recent import run."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Run summary card is built programmatically into this container -->
                        <StackPanel x:Name="RunSummaryContainer" Spacing="14" />
                    </StackPanel>
                </Border>

                <!-- ===== Import history list ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Import history" loc:Localized.Text="web.settings.historyImport.history.title" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Select a past run to view its details above." loc:Localized.Text="web.settings.historyImport.history.description"
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="20" Height="20" />
                        <StackPanel x:Name="ImportRunsContainer" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Plugins Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="PluginsPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Plugin Settings" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Configure user-level settings for installed plugins."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Plugin cards (built in code-behind) -->
                <StackPanel x:Name="PluginCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Sessions Panel ===== -->
            <!-- ===================================================================== -->
            <!-- ===== Webhook Sync Panel ===== -->
            <StackPanel x:Name="WebhookSyncPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Webhook Sync" loc:Localized.Text="web.settings.webhooks.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Receive watched, stop, and progress events from Plex, Emby, and Jellyfin." loc:Localized.Text="web.settings.webhooks.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Add a connection" loc:Localized.Text="web.settings.webhooks.add.title" FontSize="16" FontWeight="Medium" />
                            <TextBlock Text="Create a provider-specific webhook endpoint and choose the default Silo profile." loc:Localized.Text="web.settings.webhooks.add.description"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Provider" loc:Localized.Text="web.settings.webhooks.add.provider" FontSize="13" FontWeight="Medium" />
                            <ComboBox x:Name="WebhookProviderCombo" Width="260" HorizontalAlignment="Left"
                                      SelectionChanged="WebhookProviderCombo_SelectionChanged">
                                <ComboBoxItem Content="Plex" Tag="plex" IsSelected="True" />
                                <ComboBoxItem Content="Emby" Tag="emby" />
                                <ComboBoxItem Content="Jellyfin" Tag="jellyfin" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="WebhookPlexAuthPanel" Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Plex account" loc:Localized.Text="web.settings.webhooks.add.plexAccount" FontSize="13" FontWeight="Medium" />
                                    <TextBlock x:Name="WebhookPlexAuthStatus" Text="Authorize via plex.tv to discover your servers"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button x:Name="WebhookPlexSignInButton" Grid.Column="1" Content="Sign in to Plex"
                                        Style="{StaticResource AccentButtonStyle}" Click="WebhookPlexSignIn_Click" />
                            </Grid>
                            <Grid x:Name="WebhookPlexServerRow" ColumnSpacing="12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Server" loc:Localized.Text="web.settings.webhooks.add.server" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="The Plex Media Server that will send webhook events." loc:Localized.Text="web.settings.webhooks.add.serverHint"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="WebhookPlexServerCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                          PlaceholderText="Select a server" loc:Localized.Placeholder="web.settings.webhooks.add.selectServer" SelectionChanged="WebhookCreateField_Changed" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="WebhookManualServerPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Connection name" loc:Localized.Text="web.settings.webhooks.connectionName" FontSize="13" FontWeight="Medium" />
                            <TextBox x:Name="WebhookManualServerName" PlaceholderText="My Emby Server"
                                     TextChanged="WebhookCreateField_Changed" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default profile" loc:Localized.Text="web.settings.webhooks.defaultProfile" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="The signed-in external user is linked to this profile when the connection is created." loc:Localized.Text="web.settings.webhooks.add.defaultProfileHint"
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="WebhookDefaultProfileCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      PlaceholderText="Choose a profile" loc:Localized.Placeholder="web.settings.webhooks.chooseProfile" SelectionChanged="WebhookCreateField_Changed" />
                        </Grid>
                        <Button x:Name="WebhookCreateConnectionButton" Content="Create connection"
                                HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="WebhookCreateConnection_Click" />
                    </StackPanel>
                </Border>

                <!-- Connections list -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Connected servers" loc:Localized.Text="web.settings.webhooks.servers.title" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Manage webhook endpoints, provider setup instructions, and profile mappings." loc:Localized.Text="web.settings.webhooks.servers.description"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="WebhookConnectionsPanel" Spacing="8" />
                        <TextBlock x:Name="NoConnectionsText"
                                   Text="No webhook connections yet. Create one above to generate a provider-specific endpoint."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Padding="0,16"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WebhookConnectionDetail" Spacing="24" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="WebhookDetailName" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="WebhookDetailHealth" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="WebhookDetailStatus" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Webhook URL" loc:Localized.Text="web.settings.webhooks.detail.webhookUrl" FontSize="13" FontWeight="Medium" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="WebhookUrlBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                                <Button Grid.Column="1" Content="Copy" loc:Localized.Content="web.settings.webhooks.detail.copy" Click="WebhookCopyUrl_Click" />
                                <Button Grid.Column="2" Content="Rotate" loc:Localized.Content="web.settings.webhooks.detail.rotate" Click="WebhookRotate_Click" />
                                <Button x:Name="WebhookDeleteConnectionButton" Grid.Column="3" Content="Delete" Click="WebhookDelete_Click" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Connection name" loc:Localized.Text="web.settings.webhooks.connectionName" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="WebhookConnectionNameBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Default profile" loc:Localized.Text="web.settings.webhooks.defaultProfile" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="WebhookConnectionProfileCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Save connection" loc:Localized.Content="web.settings.webhooks.detail.save" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                Click="WebhookSaveConnection_Click" />
                        <TextBlock Text="Profile mapping" loc:Localized.Text="web.settings.webhooks.mapping.title" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Map each external user to a Silo profile. Unmapped users are ignored." loc:Localized.Text="web.settings.webhooks.mapping.description" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel x:Name="WebhookActorsHost" Spacing="8" />
                        <Button x:Name="WebhookSaveActorsButton" Content="Save mappings" loc:Localized.Content="web.settings.webhooks.mapping.save" HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}" Click="WebhookSaveActors_Click" />
                        <StackPanel x:Name="WebhookSetupInstructionsHost" />
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Recent deliveries" loc:Localized.Text="web.settings.webhooks.deliveries.title" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Latest webhook requests for this connection." loc:Localized.Text="web.settings.webhooks.deliveries.description" FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WebhookEventSearchBox" PlaceholderText="Search events..." loc:Localized.Placeholder="web.settings.webhooks.deliveries.search"
                                     TextChanged="WebhookEventFilter_Changed" />
                            <ComboBox x:Name="WebhookEventOutcomeFilter" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="WebhookEventFilter_Changed">
                                <ComboBoxItem Content="All outcomes" loc:Localized.Content="web.settings.webhooks.deliveries.allOutcomes" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="Applied" loc:Localized.Content="web.settings.webhooks.outcome.applied" Tag="applied" />
                                <ComboBoxItem Content="Ignored" loc:Localized.Content="web.settings.webhooks.outcome.ignored" Tag="ignored" />
                                <ComboBoxItem Content="Unmatched" loc:Localized.Content="web.settings.webhooks.outcome.unmatched" Tag="unmatched" />
                                <ComboBoxItem Content="Skipped" loc:Localized.Content="web.settings.webhooks.outcome.skipped" Tag="skipped" />
                                <ComboBoxItem Content="Rejected" loc:Localized.Content="web.settings.webhooks.outcome.rejected" Tag="rejected" />
                                <ComboBoxItem Content="Error" loc:Localized.Content="web.settings.webhooks.outcome.error" Tag="error" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="WebhookEventsHost" Spacing="8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="WebhookEventsFirst" Content="First" Click="WebhookEventsFirst_Click" />
                            <Button x:Name="WebhookEventsPrevious" Grid.Column="1" Content="Previous" Click="WebhookEventsPrevious_Click" />
                            <TextBlock x:Name="WebhookEventsPageLabel" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="WebhookEventsNext" Grid.Column="3" Content="Next" Click="WebhookEventsNext_Click" />
                            <Button x:Name="WebhookEventsLast" Grid.Column="4" Content="Last" Click="WebhookEventsLast_Click" />
                        </Grid>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== Watch Providers Panel ===== -->
            <StackPanel x:Name="WatchProvidersPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Watch Providers" loc:Localized.Text="web.settings.watchProviders.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Connect external trackers to import watch history, sync progress, and scrobble playback."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <StackPanel x:Name="WatchProvidersCardsPanel" Spacing="12" />
                <TextBlock x:Name="NoWatchProvidersText"
                           Text="No watch providers are registered on this server." loc:Localized.Text="web.settings.watchProviders.none"
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Padding="0,16"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Your Devices Panel ===== -->
            <StackPanel x:Name="DevicesPanel" Spacing="20" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your devices" loc:Localized.Text="web.settings.device.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Every phone, tablet, TV and browser you watch on. Pick one to see what's set differently there and change it — from here, whichever device you're holding." loc:Localized.Text="web.settings.device.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="DevicesLoadingRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left" />
                <StackPanel x:Name="DevicesContentHost" Spacing="12" />
            </StackPanel>

            <!-- ===== Connect Apps Panel ===== -->
            <StackPanel x:Name="ConnectAppsPanel" Spacing="20" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ConnectAppsTitleText" Text="Connect Apps" loc:Localized.Text="web.settings.connectApps.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Exactly what to type on a sign-in screen. Pick the kind of app you're using — the credentials are different for each." loc:Localized.Text="web.settings.connectApps.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="ConnectAppsLoadingRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left" />
                <StackPanel x:Name="ConnectAppsContentHost" Spacing="12" />
            </StackPanel>

            <!-- ===== Notification Settings Panel ===== -->
            <StackPanel x:Name="NotificationsSettingsPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <ContentControl x:Name="NotificationsSettingsHost" />
            </StackPanel>

            <!-- ===== Profiles Panel ===== -->
            <StackPanel x:Name="ProfilesPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profiles" loc:Localized.Text="web.settings.profiles.title" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage profile names, PINs, and access rules." loc:Localized.Text="web.settings.profiles.subtitle"
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button x:Name="AddProfileButton" Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Top"
                            Click="AddProfileButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="New profile" loc:Localized.Text="web.settings.profiles.newProfile" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="ProfileLimitText" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{StaticResource SecondaryTextBrush}" />
                <StackPanel x:Name="HouseholdStreamsPanel" Spacing="8" />
                <StackPanel x:Name="ProfileCardsPanel" Spacing="8" />
                <TextBlock x:Name="NoProfilesText" Text="No profiles yet&#x0a;Create a profile to manage access and playback identity."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Accessibility Panel ===== -->
            <StackPanel x:Name="AccessibilityPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock x:Name="AccessibilityTitleText" Text="Accessibility" loc:Localized.Text="web.settings.accessibility.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Text size, weight, contrast, and date and time formats." loc:Localized.Text="web.settings.nav.accessibility.description" FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Readability -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Readability" loc:Localized.Text="web.settings.accessibility.readabilityTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Increase text size, strengthen type weight, and raise contrast for clearer reading." loc:Localized.Text="web.settings.accessibility.readabilityDescription"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Text size" loc:Localized.Text="web.settings.accessibility.textSize" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextSizeButtons" Orientation="Horizontal" Spacing="8" />

                        <TextBlock Text="Text weight" loc:Localized.Text="web.settings.accessibility.textWeight" FontSize="14" FontWeight="Medium" Margin="0,8,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextWeightButtons" Orientation="Horizontal" Spacing="8" />

                        <TextBlock Text="Contrast" loc:Localized.Text="web.settings.accessibility.contrast" FontSize="14" FontWeight="Medium" Margin="0,8,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="ContrastButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" loc:Localized.Text="web.settings.accessibility.previewTitle" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="See how text looks with your current readability settings." loc:Localized.Text="web.settings.accessibility.previewDescription"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="The quick brown fox jumps over the lazy dog" loc:Localized.Text="web.settings.accessibility.previewHeadline"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="This sample paragraph reflects your current text size, weight, and contrast preferences. Adjustments take effect across the entire interface." loc:Localized.Text="web.settings.accessibility.previewParagraph"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Secondary text · Metadata · Captions" loc:Localized.Text="web.settings.accessibility.previewSecondary"
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Date &amp; time" loc:Localized.Text="web.settings.accessibility.dateTimeTitle" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Choose how dates and clock times are displayed across the app. Saved for the active profile." loc:Localized.Text="web.settings.accessibility.dateTimeDescription" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Date format" loc:Localized.Text="web.settings.accessibility.dateFormat" FontSize="14" FontWeight="Medium" />
                        <StackPanel x:Name="DateFormatButtons" Orientation="Horizontal" Spacing="8" />
                        <TextBlock Text="Time format" loc:Localized.Text="web.settings.accessibility.timeFormat" FontSize="14" FontWeight="Medium" Margin="0,6,0,0" />
                        <StackPanel x:Name="TimeFormatButtons" Orientation="Horizontal" Spacing="8" />
                        <TextBlock x:Name="DateTimePreviewText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel x:Name="YourDataPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="Your Data" loc:Localized.Text="web.settings.yourData.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Export this profile's own data, or import a previous export to merge it back."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="YourDataLoadingRing" IsActive="False" HorizontalAlignment="Left" Width="24" Height="24" />
                <StackPanel x:Name="YourDataContentHost" Spacing="16" />
            </StackPanel>

            <StackPanel x:Name="SessionsPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Signed-in sessions" loc:Localized.Text="web.settings.sessions.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="See where your account is signed in, and sign out any session you don't recognize." loc:Localized.Text="web.settings.sessions.description"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Session cards container (built in code-behind) -->
                <StackPanel x:Name="SessionCardsContainer" Spacing="12" />
            </StackPanel>

                </StackPanel>
                <!-- /Grid.Column="1" content column -->
            </Grid>
            <!-- /two-column sidebar + content grid -->

        </StackPanel>
    </ScrollViewer>
</Page>
