                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Toggle which libraries appear in your navigation and customize playback defaults per library." loc:Localized.Text="web.settings.library.subtitle"
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Browsing" loc:Localized.Text="web.settings.library.browsing.title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="These preferences apply to this profile on the current device." loc:Localized.Text="web.settings.library.browsing.description"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Remember library pages" loc:Localized.Text="web.settings.library.rememberPages.label" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Return each library to the last tab, sort, and filters used on this profile and device." loc:Localized.Text="web.settings.library.rememberPages.description"
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RememberLibraryPagesToggle" Grid.Column="1"
                                          IsOn="True" OnContent="" OffContent=""
                                          VerticalAlignment="Center" Toggled="RememberLibraryPagesToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="LibraryVisibilitySummary" Style="{StaticResource SettingsGroupStyle}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="{x:Bind ViewModel.VisibleLibraryCount, Mode=OneWay}" />
                            <Run Text=" of " />
                            <Run Text="{x:Bind ViewModel.TotalLibraryCount, Mode=OneWay}" />
                            <Run Text=" libraries visible for this profile." />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                    IsEnabled="{x:Bind ViewModel.CanShowAllLibraries, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ShowAllLibrariesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE890;" FontSize="13" />
                                    <TextBlock Text="Show all" loc:Localized.Text="web.settings.library.showAll" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                    IsEnabled="{x:Bind ViewModel.CanHideAllLibraries, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.HideAllLibrariesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED1A;" FontSize="13" />
                                    <TextBlock Text="Hide all" loc:Localized.Text="web.settings.library.hideAll" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Library cards container (built in code-behind) -->
                <StackPanel x:Name="LibraryCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Subtitles Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="SubtitlesPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock x:Name="SubtitlesTitleText" Text="Language &amp; Subtitles" loc:Localized.Text="web.settings.subtitleAppearance.title" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Preferred languages, when subtitles appear, and how they look for this profile."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Languages &amp; subtitles" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="These preferences decide the spoken, metadata, and subtitle languages Silo chooses by default."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />
<Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Spoken language" loc:Localized.Text="web.settings.subtitleAppearance.language.spokenLabel" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Prefer a spoken language for this profile when multiple tracks are available." loc:Localized.Text="web.settings.subtitleAppearance.language.spokenDescription"
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SpokenLanguageComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SpokenLanguageComboBox_SelectionChanged" />
                        </Grid>
<Border Style="{StaticResource SettingsSeparator}" />
<Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="430" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                <TextBlock Text="Metadata language" loc:Localized.Text="web.settings.metadataLanguage.label" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose the fallback for titles and descriptions, then add exceptions based on each item's original language. Missing descriptions can be translated automatically when AI translation is enabled." loc:Localized.Text="web.settings.metadataLanguage.description" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <ComboBox x:Name="MetadataLanguageComboBox" HorizontalAlignment="Stretch" SelectionChanged="MetadataLanguageComboBox_SelectionChanged" />
                                <StackPanel x:Name="MetadataLanguageExceptionsPanel" Spacing="0" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MetadataExceptionSourceComboBox" Grid.Column="0" HorizontalAlignment="Stretch" PlaceholderText="Choose original language" loc:Localized.Placeholder="web.settings.metadataLanguage.newSourcePlaceholder"
                                              SelectionChanged="MetadataExceptionSourceComboBox_SelectionChanged" />
                                    <Button x:Name="AddMetadataLanguageExceptionButton" Grid.Column="1" Content="Add exception" loc:Localized.Content="web.settings.metadataLanguage.addException"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                            Click="AddMetadataLanguageException_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
<Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle language" loc:Localized.Text="web.settings.subtitleAppearance.subtitles.languageLabel" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Pick a subtitle language or leave subtitles off by default." loc:Localized.Text="web.settings.subtitleAppearance.subtitles.languageDescription" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleLanguageComboBox" Grid.Column="1" Width="220" SelectionChanged="SubtitleLanguageComboBox_SelectionChanged" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle behavior" loc:Localized.Text="web.settings.subtitleAppearance.subtitles.behaviorLabel" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Decide when subtitles should appear." loc:Localized.Text="web.settings.subtitleAppearance.subtitles.behaviorDescription" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleModeComboBox" Grid.Column="1" Width="220" SelectionChanged="SubtitleModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" loc:Localized.Content="settingsManifest.playback.subtitle_mode.option.auto" Tag="auto" /><ComboBoxItem Content="Always" loc:Localized.Content="settingsManifest.playback.subtitle_mode.option.always" Tag="always" /><ComboBoxItem Content="Off" loc:Localized.Content="settingsManifest.playback.subtitle_mode.option.off" Tag="off" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Show forced subtitles" loc:Localized.Text="settingsManifest.playback.show_forced_subtitles.label" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Display forced subtitles for foreign-language dialogue." loc:Localized.Text="web.settings.subtitleAppearance.subtitles.forcedDescription" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ForcedSubtitlesToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowForcedSubtitles, Mode=TwoWay}" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" loc:Localized.Text="web.settings.subtitleAppearance.preview.title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="How subtitles look for this profile on every device." loc:Localized.Text="web.settings.subtitleAppearance.preview.description"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <!-- 16:9 preview box -->
                        <Border CornerRadius="20" Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F0F1A" Offset="0" />
                                    <GradientStop Color="#1A1A3E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Height="200">
                                <StackPanel x:Name="SubtitlePreviewStack" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Margin="0,0,0,24" Spacing="4">
                                    <Border x:Name="SubtitlePreviewBg1" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine1"
                                                   Text="Sample subtitle text" loc:Localized.Text="web.settings.subtitleAppearance.preview.sampleLine1"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SubtitlePreviewBg2" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine2"
                                                   Text="tuned for readability" loc:Localized.Text="web.settings.subtitleAppearance.preview.sampleLine2"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="SubtitleSaveButton" Content="Save Appearance" loc:Localized.Content="web.settings.subtitleAppearance.preview.save" Style="{StaticResource AccentButtonStyle}"
                                    Padding="16,8" Click="SubtitleSave_Click" />
                            <Button x:Name="SubtitleDiscardButton" Content="Discard Changes" loc:Localized.Content="web.settings.subtitleAppearance.preview.discard" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Click="SubtitleDiscard_Click" />
                            <Button x:Name="SubtitleResetButton" Content="Reset Appearance" Style="{StaticResource GhostButtonStyle}"
                                    Padding="16,8" Click="SubtitleReset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Timing" loc:Localized.Text="web.settings.subtitleAppearance.timing.title" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="SubtitleTimingDescription" Text="Subtitle timing is loading…" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="Subtitle offset" loc:Localized.Text="web.settings.subtitleAppearance.timing.offset" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Negative values show subtitles earlier, positive values later." loc:Localized.Text="web.settings.subtitleAppearance.timing.offsetDescription" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SubtitleEarlierButton" Content="−" AutomationProperties.Name="Show subtitles 100 ms earlier" Click="SubtitleEarlier_Click" />
                            <TextBlock x:Name="SubtitleOffsetLabel" Text="0 ms" MinWidth="82" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                            <Button x:Name="SubtitleLaterButton" Content="+" AutomationProperties.Name="Show subtitles 100 ms later" Click="SubtitleLater_Click" />
                            <Button x:Name="SubtitleOffsetResetButton" Content="Reset" loc:Localized.Content="web.settings.subtitleAppearance.timing.reset" Click="SubtitleOffsetReset_Click" />
                        </StackPanel>
                        <Button x:Name="SubtitleReloadButton" Content="Reload subtitle preferences" Click="SubtitleReload_Click" />
                    </StackPanel>
                </Border>

                <!-- Text group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Text" loc:Localized.Text="web.settings.subtitleAppearance.text.title" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Adjust the look and readability of subtitle text." loc:Localized.Text="web.settings.subtitleAppearance.text.description"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Font size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" loc:Localized.Text="web.settings.subtitleAppearance.text.fontSize" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontSizeComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontSize_Changed">
                                <ComboBoxItem Content="Small" loc:Localized.Content="web.settings.subtitleOptions.fontSize.small" Tag="small" />
                                <ComboBoxItem Content="Medium" loc:Localized.Content="web.settings.subtitleOptions.fontSize.medium" Tag="medium" />
                                <ComboBoxItem Content="Large" loc:Localized.Content="web.settings.subtitleOptions.fontSize.large" Tag="large" IsSelected="True" />
                                <ComboBoxItem Content="X-Large" loc:Localized.Content="web.settings.subtitleOptions.fontSize.xLarge" Tag="xlarge" />
                                <ComboBoxItem Content="XX-Large" loc:Localized.Content="web.settings.subtitleOptions.fontSize.xxLarge" Tag="xxlarge" />
                            </ComboBox>
