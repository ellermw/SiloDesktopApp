                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Video fast-forward (seconds)" loc:Localized.Header="web.settings.playback.seek.forwardInterval" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.VideoSkipForwardSeconds, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="8"><TextBlock Text="Audiobooks" loc:Localized.Text="web.settings.playback.seek.audiobookTitle" FontSize="14" FontWeight="Medium" />
