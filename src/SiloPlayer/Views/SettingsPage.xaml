<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    FontFamily="{StaticResource ThemeFontFamily}"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Active tab style (pill on surface) -->
        <Style x:Key="ActiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Inactive tab style -->
        <Style x:Key="InactiveTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <SolidColorBrush x:Key="SettingsRaisedBrush" Color="{Binding Color, Source={StaticResource SurfaceRaisedBrush}}" Opacity="0.65" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.9" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="{Binding Color, Source={StaticResource BorderBrush}}" Opacity="0.72" />

        <SolidColorBrush x:Key="SettingsPresetBrush" Color="{Binding Color, Source={StaticResource SurfaceBrush}}" Opacity="0.82" />
        <Style x:Key="SettingsPresetStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Current raised settings surfaces. -->
        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsRaisedBrush}" />
            <Setter Property="CornerRadius" Value="27.2" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PersonalizeGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SettingsPanelBrush}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- Settings row separator -->
        <Style x:Key="SettingsSeparator" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16,0,16" />
        </Style>
    </Page.Resources>

    <ScrollViewer IsScrollInertiaEnabled="True">
        <StackPanel x:Name="SettingsPageShell" MaxWidth="1520" Margin="48,24,48,48">

            <!-- The WebUI keeps the back action floating above a wide page header. -->
            <Button x:Name="SettingsBackButton" Style="{StaticResource GhostButtonStyle}"
                    Width="40" Height="40" Padding="0" CornerRadius="20"
                    HorizontalAlignment="Left" Click="SettingsBackButton_Click"
                    AutomationProperties.Name="Go back">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>

            <!-- ===== Header ===== -->
            <Grid x:Name="SettingsHeaderGrid" Margin="0,40,0,0" ColumnSpacing="32" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Text="Settings" FontSize="48" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock x:Name="SettingsHeaderSubtitle" Text="Make Silo work the way you like."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="SettingsSearchPanel" Grid.Column="1" Width="384" VerticalAlignment="Bottom" Spacing="8">
                    <Grid>
                    <TextBox x:Name="SettingsSearchBox" PlaceholderText="Search settings"
                             Height="44" Padding="36,8,40,8" CornerRadius="12" TextChanged="SettingsSearchBox_TextChanged"
                             AutomationProperties.Name="Search settings">
                        <TextBox.HeaderTemplate>
                            <DataTemplate />
                        </TextBox.HeaderTemplate>
                    </TextBox>
                        <FontIcon Glyph="&#xE721;" FontSize="16" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,0,6,0" Style="{StaticResource GhostButtonStyle}" Click="ClearSettingsSearch_Click" AutomationProperties.Name="Clear search" />
                    </Grid>
                    <TextBlock x:Name="SettingsSearchStatus" Text="Press Ctrl+K to search"
                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>

            <!-- ===== Status / Error ===== -->
            <StackPanel Margin="0,8,0,0">
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />
                <TextBlock
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource ErrorBrush}"
                    FontSize="13"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                    Foreground="{StaticResource AccentBrush}"
                    FontSize="13" />
            </StackPanel>

            <!-- Current WebUI /settings directory. The detail rail is only
                 shown after a section is opened. -->
            <StackPanel x:Name="SettingsOverviewPanel" Margin="0,32,0,0" Spacing="24" Visibility="Collapsed">
                <Button x:Name="SettingsCurrentProfileButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        MaxWidth="448" MinHeight="64" Padding="16,12" CornerRadius="16"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="SettingsCurrentProfile_Click" />
                <StackPanel x:Name="SettingsOverviewGroups" Spacing="28" />
            </StackPanel>

            <Button x:Name="SettingsAllSettingsButton" Content="‹  All settings"
                    HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0,0,8,0"
                    Height="20" MinHeight="0" MinWidth="0" FontSize="14"
                    Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed"
                    Click="SettingsAllSettings_Click" />

            <!-- ===== Settings Navigation: Two-column layout (sidebar + content) ===== -->
            <!-- Webui: SettingsLayout.tsx — grouped sidebar (220px) on desktop -->
            <Grid x:Name="SettingsLayoutGrid" Margin="0,40,0,0" Background="{StaticResource SettingsPanelBrush}" CornerRadius="27.2" BorderBrush="{StaticResource SettingsBorderBrush}" BorderThickness="1" MinHeight="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left sidebar navigation (grouped) -->
                <ScrollViewer x:Name="SettingsNavigationScroller" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,12,0">
                    <StackPanel x:Name="SettingsNavigationGroups" Spacing="20">
                        <!-- Playback group -->
                        <StackPanel x:Name="PlaybackNavGroup" Spacing="2">
                            <TextBlock Text="PLAYBACK" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="PlaybackTab" Click="Tab_Click" Tag="Playback"
                                    Style="{StaticResource ActiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Playback" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SubtitlesTab" Click="Tab_Click" Tag="Subtitles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xED1E;" FontSize="16" />
                                    <TextBlock Text="Subtitles" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DevicesTab" Click="Tab_Click" Tag="Devices"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                                    <TextBlock Text="Your Devices" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Appearance group -->
                        <StackPanel x:Name="AppearanceNavGroup" Spacing="2">
                            <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
<Button x:Name="InterfaceTab" Click="Tab_Click" Tag="Interface"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F8;" FontSize="16" />
                                    <TextBlock Text="Navigation &amp; Cards" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CardOverlaysTab" Click="Tab_Click" Tag="CardOverlays"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE81E;" FontSize="16" />
                                    <TextBlock Text="Card Overlays" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AccessibilityTab" Click="Tab_Click" Tag="Accessibility"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE7F3;" FontSize="16" />
                                    <TextBlock Text="Accessibility" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
</StackPanel>
                        <!-- Home & Discovery group -->
                        <StackPanel x:Name="HomeDiscoveryNavGroup" Spacing="2">
                            <TextBlock Text="HOME &amp; DISCOVERY" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="HomeScreenTab" Click="Tab_Click" Tag="HomeScreen"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xECA5;" FontSize="16" />
                                    <TextBlock Text="Home Screen" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PersonalizeTab" Click="Tab_Click" Tag="Personalize"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE735;" FontSize="16" />
                                    <TextBlock Text="Personalize" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="LibrariesTab" Click="Tab_Click" Tag="Libraries"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                                    <TextBlock Text="Libraries" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RequestsTab" Click="Tab_Click" Tag="Requests" Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock Text="Requests" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Connections group -->
                        <StackPanel x:Name="ConnectionsNavGroup" Spacing="2">
                            <TextBlock Text="CONNECTIONS" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="ConnectAppsTab" Click="Tab_Click" Tag="ConnectApps"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE839;" FontSize="16" />
                                    <TextBlock Text="Connect Apps" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WatchProvidersTab" Click="Tab_Click" Tag="WatchProviders"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE823;" FontSize="16" />
                                    <TextBlock Text="Watch Providers" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WebhookSyncTab" Click="Tab_Click" Tag="WebhookSync"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE968;" FontSize="16" />
                                    <TextBlock Text="Webhook Sync" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportTab" Click="Tab_Click" Tag="Import"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B5;" FontSize="16" />
                                    <TextBlock Text="History Import" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Account group -->
                        <StackPanel x:Name="AccountNavGroup" Spacing="2">
                            <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="180" Foreground="{StaticResource TertiaryTextBrush}"
                                       Margin="12,0,0,6" />
                            <Button x:Name="AccountPasswordTab" Click="Tab_Click" Tag="Account"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                                    <TextBlock Text="Account" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ProfilesTab" Click="Tab_Click" Tag="Profiles"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                    <TextBlock Text="Profiles" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="NotificationsSettingsTab" Click="Tab_Click" Tag="NotificationsSettings"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                                    <TextBlock Text="Notifications" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PluginsTab" Click="Tab_Click" Tag="Plugins"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xEA86;" FontSize="16" />
                                    <TextBlock Text="Plugins" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SessionsTab" Click="Tab_Click" Tag="Sessions"
                                    Style="{StaticResource InactiveTabStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                                    <TextBlock Text="Signed-in sessions" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Right column: all content panels stack here; only the
                     active one is Visible (Tab_Click toggles visibility). -->
                <StackPanel x:Name="SettingsContentPanel" Grid.Column="1" Padding="40,0,0,0"
                            HorizontalAlignment="Stretch">

            <!-- ===================================================================== -->
            <!-- ===== Navigation & Cards Panel (settings contract revision 5) ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="AccountPasswordPanel" Spacing="24" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Account" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Manage the sign-in credential shared by every profile on this account."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Only the primary profile can change the shared account password. Your current password is required."
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <ProgressRing x:Name="AccountPasswordLoading" IsActive="False" Width="24" Height="24"
                                      HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Loading password settings" />
                        <StackPanel x:Name="AccountPasswordUnavailable" Spacing="4" Visibility="Collapsed">
                            <TextBlock Text="Local password changes are unavailable." FontWeight="SemiBold" />
                            <TextBlock Text="This account signs in through an external provider, or the active profile does not own the account credential."
                                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="AccountPasswordForm" MaxWidth="448" HorizontalAlignment="Left" Spacing="16" Visibility="Collapsed">
                            <PasswordBox x:Name="AccountCurrentPassword" Header="Current password" HorizontalAlignment="Stretch"
                                         PasswordChanged="AccountPassword_Changed" />
                            <StackPanel Spacing="6">
                                <PasswordBox x:Name="AccountNewPassword" Header="New password" PasswordChanged="AccountPassword_Changed" />
                                <TextBlock x:Name="AccountPasswordRequirements" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <PasswordBox x:Name="AccountConfirmPassword" Header="Confirm new password" PasswordChanged="AccountPassword_Changed" />
                            <Button x:Name="AccountPasswordSubmit" Content="Change password" Style="{StaticResource AccentButtonStyle}"
                                    Click="AccountPasswordSubmit_Click" />
                        </StackPanel>
                        <InfoBar x:Name="AccountPasswordMessage" IsOpen="False" IsClosable="False" />
                        <Button x:Name="AccountPasswordRetry" Content="Try again" Visibility="Collapsed" Click="AccountPasswordRetry_Click" />
                    </StackPanel>
                </Border>
                <Border x:Name="AccountSignInGroup" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Sign-in" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Sign in to this account with your organization's sign-in provider." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="AccountSignInBody" MaxWidth="672" HorizontalAlignment="Stretch" Spacing="16" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="InterfacePanel" Spacing="24" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="InterfaceTitleText" Text="Navigation &amp; cards" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="These choices sync between native desktop apps signed into this profile. Web, TV, mobile, and tablet clients keep their own matching-device layouts."
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border x:Name="InterfaceStatusCard" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="InterfaceStatusTitle" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="InterfaceStatusText" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="InterfaceControls" Spacing="24">

                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Card preset" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Start with a complete layout, then adjust poster size or captions below."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="InterfaceCardDeviceOverrideNotice" Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Padding="14" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="This PC has a higher-priority device card layout. Clear it before editing the layout shared by desktop apps."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="Use desktop-family layout" Click="ClearInterfaceCardDeviceOverride_Click" />
                                </Grid>
                            </Border>
                            <Grid x:Name="InterfacePresetGrid" ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Name="BalancedCardPreset" Tag="standard:title_metadata" Click="CardPreset_Click"
                                        Style="{StaticResource SettingsPresetStyle}">
                                    <Grid Tag="preset-icon-row" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                        <TextBlock Text="Balanced" FontWeight="SemiBold" />
                                        <TextBlock Text="Standard posters with titles and metadata." FontSize="12" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                        <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Top" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24"><Path Data="M20 6L9 17l-5-5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                                <Button x:Name="CompactCardPreset" Grid.Column="1" Tag="compact:title" Click="CardPreset_Click"
                                        Style="{StaticResource SettingsPresetStyle}">
                                    <Grid Tag="preset-icon-row" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                        <TextBlock Text="Compact" FontWeight="SemiBold" />
                                        <TextBlock Text="More posters on screen with titles only." FontSize="12" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                        <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Top" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24"><Path Data="M20 6L9 17l-5-5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                                <Button x:Name="CinemaCardPreset" Grid.Row="1" Tag="large:title" Click="CardPreset_Click"
                                        Style="{StaticResource SettingsPresetStyle}">
                                    <Grid Tag="preset-icon-row" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                        <TextBlock Text="Cinema" FontWeight="SemiBold" />
                                        <TextBlock Text="Large posters with titles only." FontSize="12" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                        <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Top" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24"><Path Data="M20 6L9 17l-5-5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                                <Button x:Name="ArtworkCardPreset" Grid.Row="1" Grid.Column="1" Tag="large:artwork" Click="CardPreset_Click"
                                        Style="{StaticResource SettingsPresetStyle}">
                                    <Grid Tag="preset-icon-row" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                        <TextBlock Text="Artwork only" FontWeight="SemiBold" />
                                        <TextBlock Text="Large artwork without caption rows." FontSize="12" LineHeight="19.5" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                        <Viewbox Grid.Column="1" Width="16" Height="16" VerticalAlignment="Top" Visibility="Collapsed">
                                            <Canvas Width="24" Height="24"><Path Data="M20 6L9 17l-5-5" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Poster cards" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Fine-tune density and the rows shown below artwork. Changes apply immediately."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Poster size" FontSize="13" FontWeight="SemiBold" />
                                        <controls:WrapPanel x:Name="InterfacePosterSizeChoices" HorizontalSpacing="8" VerticalSpacing="8" />
                                        <ComboBox x:Name="InterfacePosterSizeCombo" Visibility="Collapsed" HorizontalAlignment="Stretch"
                                                  SelectionChanged="InterfaceCardOption_SelectionChanged">
                                            <ComboBoxItem Content="Compact" Tag="compact" />
                                            <ComboBoxItem Content="Standard" Tag="standard" />
                                            <ComboBoxItem Content="Large" Tag="large" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Caption" FontSize="13" FontWeight="SemiBold" />
                                        <controls:WrapPanel x:Name="InterfaceCaptionChoices" HorizontalSpacing="8" VerticalSpacing="8" />
                                        <ComboBox x:Name="InterfaceCaptionCombo" Visibility="Collapsed" HorizontalAlignment="Stretch"
                                                  SelectionChanged="InterfaceCardOption_SelectionChanged">
                                            <ComboBoxItem Content="Title &amp; metadata" Tag="title_metadata" />
                                            <ComboBoxItem Content="Title only" Tag="title" />
                                            <ComboBoxItem Content="Artwork only" Tag="artwork" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="12" Padding="16" MinHeight="176">
                                    <StackPanel x:Name="InterfaceCardPreview" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Top" />
                                </Border>
                            </Grid>
                            <Button x:Name="ResetDesktopCardLayoutButton" Content="Reset desktop-family card layout"
                                    HorizontalAlignment="Left" Click="ResetDesktopCardLayout_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Primary menu" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Choose the ordered shortcuts at the top of the desktop menu. Home stays available; search and profile controls are fixed."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="WINDOWS DESKTOP" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="160" Foreground="{StaticResource TertiaryTextBrush}" />
                            <Border x:Name="InterfaceMenuDeviceOverrideNotice" Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                    Padding="14" Visibility="Collapsed">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="This PC has a higher-priority device menu. Clear it before editing the menu shared by desktop apps."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="Use desktop-family menu" Click="ClearInterfaceMenuDeviceOverride_Click" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="InterfacePrimaryMenuHost" Spacing="8" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="InterfaceAddMenuCombo" HorizontalAlignment="Stretch"
                                          PlaceholderText="Choose destination or shortcut" />
                                <Button Grid.Column="1" Content="Add to menu" Click="AddInterfaceMenuItem_Click" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveInterfaceMenuButton" Content="Save menu" Click="SaveInterfaceMenu_Click" />
                                <Button Content="Reset to default" Click="ResetInterfaceMenu_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="TitleArtSettingsGroup" Style="{StaticResource SettingsGroupStyle}"
                            Visibility="{x:Bind ViewModel.TitleArtSupported, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Title pages" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="How a movie or show is named at the top of its page." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnSpacing="16" Tag="title-art-row">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="Show title art" FontSize="14" FontWeight="Medium" /><TextBlock Text="Use logo artwork as the title when available." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                <ToggleSwitch x:Name="TitleArtToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowTitleArt, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEditTitleArt, Mode=OneWay}" OnContent="" OffContent="" Toggled="TitleArt_Toggled" />
                            </Grid>
                            <Grid ColumnSpacing="16" Tag="title-art-row">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock Text="Apply to all devices" FontSize="14" FontWeight="Medium" /><TextBlock Text="Use this choice on every device signed into this profile." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                <ToggleSwitch x:Name="TitleArtAllDevicesToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.TitleArtAllDevices, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanEditTitleArt, Mode=OneWay}" OnContent="" OffContent="" Toggled="TitleArtAllDevices_Toggled" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.TitleArtErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                            <Button Content="Try again" Click="TitleArtRetry_Click" Visibility="{x:Bind ViewModel.TitleArtReadFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.TitleArtExplanation, Mode=OneWay}" FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Playback Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="PlaybackPanel" Spacing="24" Margin="0">

                <StackPanel Spacing="12">
                    <TextBlock x:Name="PlaybackTitleText" Text="Playback" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Choose the defaults Silo should use when playback starts."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Defaults group mirrors the current WebUI settings surface. -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Defaults" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="These preferences apply unless a library or item has a more specific playback choice."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Preferred quality -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Preferred quality" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="The resolution your profile should request when playback begins. Auto lets Silo pick based on your connection."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="QualityComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="QualityComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="auto" />
                                <ComboBoxItem Content="Original quality" Tag="original" />
                                <ComboBoxItem Content="480p" Tag="480p" />
                                <ComboBoxItem Content="720p" Tag="720p" />
                                <ComboBoxItem Content="1080p" Tag="1080p" />
                                <ComboBoxItem Content="4K" Tag="2160p" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Maximum bitrate -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Maximum bitrate" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Cap how much bandwidth playback may use. No limit means Silo picks for the chosen resolution."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="MaxBitrateComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="MaxBitrateComboBox_SelectionChanged">
                                <ComboBoxItem Content="No limit" Tag="" />
                                <ComboBoxItem Content="1.5 Mbps" Tag="1500" />
                                <ComboBoxItem Content="2 Mbps" Tag="2000" />
                                <ComboBoxItem Content="4 Mbps" Tag="4000" />
                                <ComboBoxItem Content="6 Mbps" Tag="6000" />
                                <ComboBoxItem Content="10 Mbps" Tag="10000" />
                                <ComboBoxItem Content="15 Mbps" Tag="15000" />
                                <ComboBoxItem Content="20 Mbps" Tag="20000" />
                                <ComboBoxItem Content="40 Mbps" Tag="40000" />
                                <ComboBoxItem Content="60 Mbps" Tag="60000" />
                                <ComboBoxItem Content="100 Mbps" Tag="100000" />
                                <ComboBoxItem Content="200 Mbps" Tag="200000" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Spoken language -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Spoken language" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Prefer a spoken language for this profile when multiple tracks are available."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="SpokenLanguageComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SpokenLanguageComboBox_SelectionChanged" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Metadata language -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="430" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Top">
                                <TextBlock Text="Metadata language" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose the fallback for titles and descriptions, then add exceptions based on each item's original language. Missing descriptions can be translated automatically when AI translation is enabled." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="12">
                                <ComboBox x:Name="MetadataLanguageComboBox" HorizontalAlignment="Stretch" SelectionChanged="MetadataLanguageComboBox_SelectionChanged" />
                                <StackPanel x:Name="MetadataLanguageExceptionsPanel" Spacing="0" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MetadataExceptionSourceComboBox" Grid.Column="0" HorizontalAlignment="Stretch" PlaceholderText="Choose original language"
                                              SelectionChanged="MetadataExceptionSourceComboBox_SelectionChanged" />
                                    <Button x:Name="AddMetadataLanguageExceptionButton" Grid.Column="1" Content="Add exception"
                                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                                            Click="AddMetadataLanguageException_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Skip intros -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Skip intros" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Never offer a skip, ask to skip, or skip automatically with Undo."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="IntroSkipModeCombo"
                                Grid.Column="1"
                                ItemsSource="{x:Bind ViewModel.IntroModeChoices}"
                                SelectedItem="{x:Bind ViewModel.IntroSkipMode, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Skip credits -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Auto-skip credits" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Move through end credits automatically when a skip is available."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSkipCreditsToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoSkipCredits, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Skip recaps -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Auto-skip recaps" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Skip 'previously on…' recaps automatically when Silo can detect them."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSkipRecapToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoSkipRecap, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Next episode preview -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Start next at preview" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Begin the next episode when the current one reaches its next-episode preview teaser, rather than waiting for the end credits."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoPlayNextPreviewToggle"
                                Grid.Column="1"
                                IsOn="{x:Bind ViewModel.AutoPlayNextPreview, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Auto-play next episode" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Start the next episode automatically after the current one ends." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" VerticalAlignment="Center" OnContent="" OffContent="" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2"><TextBlock Text="Show advisory age" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Show recommended minimum viewer ages on item details. This does not change profile access limits."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ShowAdvisoryAge, Mode=TwoWay}" OnContent="" OffContent="" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />

                        <StackPanel Spacing="8">
                            <ToggleSwitch Header="Play theme music on detail pages" IsOn="{x:Bind ViewModel.ThemeMusicEnabled, Mode=TwoWay}" />
                            <ToggleSwitch Header="Loop theme music" IsOn="{x:Bind ViewModel.ThemeMusicLoop, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.ThemeMusicEnabled, Mode=OneWay}" />
                            <TextBlock Text="Optional background audio stops when you start playback, open a trailer or leave the details."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Next up episodes -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Next up episodes" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Choose whether upcoming episodes stay with Continue Watching or get their own row."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="NextUpModeComboBox" Width="240" VerticalAlignment="Center" SelectionChanged="NextUpModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="With Continue Watching" Tag="combined" />
                                    <ComboBoxItem Content="Separate row" Tag="separate" />
                                </ComboBox>
                                <Button Content="Reset" Style="{StaticResource GhostButtonStyle}" Command="{x:Bind ViewModel.ResetNextUpModeCommand}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupStyle}"><StackPanel Spacing="16">
                    <TextBlock Text="Seek controls" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Choose how far playback moves when you rewind or fast-forward." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SeekSettingsStatus, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Spacing="8"><TextBlock Text="Video" FontSize="14" FontWeight="Medium" />
                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Video rewind (seconds)" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.VideoSkipBackSeconds, Mode=TwoWay}" />
                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Video fast-forward (seconds)" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.VideoSkipForwardSeconds, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="8"><TextBlock Text="Audiobooks" FontSize="14" FontWeight="Medium" />
                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Audiobook rewind (seconds)" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.AudiobookSkipBackSeconds, Mode=TwoWay}" />
                        <ComboBox IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Header="Audiobook fast-forward (seconds)" ItemsSource="{x:Bind ViewModel.SeekIntervalChoices}" SelectedItem="{x:Bind ViewModel.AudiobookSkipForwardSeconds, Mode=TwoWay}" />
                        <Button IsEnabled="{x:Bind ViewModel.SeekSettingsAvailable, Mode=OneWay}" Content="Import this PC's old audiobook intervals" Command="{x:Bind ViewModel.ImportLegacySeekIntervalsCommand}" />

                    </StackPanel>
                </StackPanel></Border>

                <!-- Native-only capability, kept separate so the WebUI defaults card remains identical. -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Desktop playback" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="HDMI audio bitstream passthrough" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Send Dolby Atmos/TrueHD, E-AC-3, AC-3, and DTS-HD directly to a compatible HDMI receiver. Leave off for speakers, headphones, Bluetooth, and USB audio." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AudioPassthroughToggle" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" Toggled="AudioPassthroughToggle_Toggled" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="AI video upscaling (experimental)" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Enhance 1080p and lower-resolution SDR video on larger displays. NVIDIA and Intel use driver video processing. AMD uses FSRCNNX neural upscaling; FSRCNNX can also be tested on NVIDIA and Intel GPUs. Original 4K and HDR video keep normal playback." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                                <TextBlock Text="Restart Silo for Windows Desktop App after changing this option. Intel and AMD support is experimental and needs hardware testing. Quality and power use depend on your GPU." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="680" />
                                <TextBlock x:Name="RtxUpscalingHardwareText" Text="Checking graphics hardware…" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="VideoUpscalingComboBox" Grid.Column="1" VerticalAlignment="Center" Width="240" IsEnabled="False" AutomationProperties.Name="AI video upscaling mode" SelectionChanged="VideoUpscalingComboBox_SelectionChanged">
                                <ComboBoxItem Content="Off" Tag="off" />
                                <ComboBoxItem Content="Automatic" Tag="automatic" />
                                <ComboBoxItem Content="NVIDIA RTX VSR" Tag="nvidia" />
                                <ComboBoxItem Content="Intel VSR (experimental)" Tag="intel" />
                                <ComboBoxItem Content="FSRCNNX AI (AMD / any GPU)" Tag="fsrcnnx" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Libraries Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="LibrariesPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Libraries" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Toggle which libraries appear in your navigation and customize playback defaults per library."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Browsing" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="These preferences apply to this profile on the current device."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Remember library pages" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Return each library to the last tab, sort, and filters used on this profile and device."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RememberLibraryPagesToggle" Grid.Column="1"
                                          IsOn="True" OnContent="" OffContent=""
                                          VerticalAlignment="Center" Toggled="RememberLibraryPagesToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="LibraryVisibilitySummary" Style="{StaticResource SettingsGroupStyle}" Padding="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}">
                            <Run Text="{x:Bind ViewModel.VisibleLibraryCount, Mode=OneWay}" />
                            <Run Text=" of " />
                            <Run Text="{x:Bind ViewModel.TotalLibraryCount, Mode=OneWay}" />
                            <Run Text=" libraries visible for this profile." />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                    IsEnabled="{x:Bind ViewModel.CanShowAllLibraries, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ShowAllLibrariesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE890;" FontSize="13" />
                                    <TextBlock Text="Show all" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Padding="14,7"
                                    IsEnabled="{x:Bind ViewModel.CanHideAllLibraries, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.HideAllLibrariesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xED1A;" FontSize="13" />
                                    <TextBlock Text="Hide all" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Library cards container (built in code-behind) -->
                <StackPanel x:Name="LibraryCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Subtitles Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="SubtitlesPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock x:Name="SubtitlesTitleText" Text="Subtitles" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Choose when subtitles appear and how they look during playback."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Behavior" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="These preferences decide which subtitles Silo chooses by default."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle language" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Pick a subtitle language or leave subtitles off by default." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleLanguageComboBox" Grid.Column="1" Width="220" SelectionChanged="SubtitleLanguageComboBox_SelectionChanged" />
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle behavior" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Decide when subtitles should appear." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleModeComboBox" Grid.Column="1" Width="220" SelectionChanged="SubtitleModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Auto" Tag="auto" /><ComboBoxItem Content="Always" Tag="always" /><ComboBoxItem Content="Off" Tag="off" />
                            </ComboBox>
                        </Grid>
                        <Border Style="{StaticResource SettingsSeparator}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Show forced subtitles" FontSize="14" FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Display forced subtitles for foreign-language dialogue." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ForcedSubtitlesToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.ShowForcedSubtitles, Mode=TwoWay}" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="This sample reflects the current subtitle appearance."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <!-- 16:9 preview box -->
                        <Border CornerRadius="20" Margin="0,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0F0F1A" Offset="0" />
                                    <GradientStop Color="#1A1A3E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Height="200">
                                <StackPanel x:Name="SubtitlePreviewStack" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Margin="0,0,0,24" Spacing="4">
                                    <Border x:Name="SubtitlePreviewBg1" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine1"
                                                   Text="Sample subtitle text"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SubtitlePreviewBg2" Background="#CC000000" CornerRadius="4" Padding="12,4"
                                            HorizontalAlignment="Center">
                                        <TextBlock x:Name="SubtitlePreviewLine2"
                                                   Text="tuned for readability"
                                                   FontSize="16" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Save Appearance" Style="{StaticResource AccentButtonStyle}"
                                    Padding="16,8" Click="SubtitleSave_Click" />
                            <Button Content="Discard Changes" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="16,8" Click="SubtitleDiscard_Click" />
                            <Button x:Name="SubtitleResetButton" Content="Reset Appearance" Style="{StaticResource GhostButtonStyle}"
                                    Padding="16,8" Click="SubtitleReset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Text group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Text" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Adjust the look and readability of subtitle text."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Font size -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font size" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontSizeComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontSize_Changed">
                                <ComboBoxItem Content="Small" Tag="small" />
                                <ComboBoxItem Content="Medium" Tag="medium" />
                                <ComboBoxItem Content="Large" Tag="large" IsSelected="True" />
                                <ComboBoxItem Content="X-Large" Tag="xlarge" />
                                <ComboBoxItem Content="XX-Large" Tag="xxlarge" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Font family -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font family" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SubtitleFontFamilyComboBox" Grid.Column="1" Width="192"
                                      SelectionChanged="SubtitleFontFamily_Changed">
                                <ComboBoxItem Content="Sans-serif" Tag="sans-serif" IsSelected="True" />
                                <ComboBoxItem Content="Serif" Tag="serif" />
                                <ComboBoxItem Content="Monospace" Tag="monospace" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Font color -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Font color" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel x:Name="SubtitleColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Slider Header="Text opacity (%)" Minimum="1" Maximum="100" StepFrequency="1" Width="260"
                                HorizontalAlignment="Left" Value="{x:Bind ViewModel.SubTextOpacity, Mode=TwoWay}"
                                ValueChanged="SubtitleTextOpacity_Changed" />

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Text outline -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Text outline" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <ToggleSwitch
                                x:Name="SubtitleOutlineToggle"
                                Grid.Column="1"
                                IsOn="True"
                                VerticalAlignment="Center"
                                OnContent="" OffContent=""
                                Toggled="SubtitleOutline_Toggled" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid x:Name="SubtitleOutlineColorRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Outline color" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Only used when text outline is enabled."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleOutlineColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Background group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Background &amp; Position" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Tune subtitle placement and contrast."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <!-- Background style -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background style" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitleBgStyleComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitleBgStyle_Changed">
                                <ComboBoxItem Content="None" Tag="none" />
                                <ComboBoxItem Content="Box" Tag="box" />
                                <ComboBoxItem Content="Drop Shadow" Tag="shadow" IsSelected="True" />
                                <ComboBoxItem Content="Outline" Tag="outline" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Background opacity -->
                        <Grid x:Name="SubtitleBgOpacityRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background opacity" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Only used for boxed subtitles."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Slider x:Name="SubtitleBgOpacitySlider" Width="160"
                                        Minimum="0" Maximum="100" StepFrequency="5" Value="80"
                                        ValueChanged="SubtitleBgOpacity_Changed" />
                                <TextBlock x:Name="SubtitleBgOpacityLabel" Text="80%"
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                           Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid x:Name="SubtitleBgColorRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Background color" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleBgColorSwatches" Grid.Column="1" Orientation="Horizontal" Spacing="8" />
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparator}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Subtitle position" FontSize="14" FontWeight="Medium"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="SubtitlePositionComboBox" Grid.Column="1" Width="192"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SubtitlePosition_Changed">
                                <ComboBoxItem Content="Bottom" Tag="bottom" IsSelected="True" />
                                <ComboBoxItem Content="Lower Third" Tag="lower-third" />
                                <ComboBoxItem Content="Top" Tag="top" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Home Screen Panel ===== -->
            <!-- ===================================================================== -->
            <ContentControl x:Name="HomeScreenPanel" HorizontalContentAlignment="Stretch" Margin="0" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Home screen" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Choose the rows you see and their order. Only this profile changes, and it saves as you go."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Style="{StaticResource SettingsGroupStyle}"><StackPanel Spacing="12">
                    <TextBlock Text="Home preferences" FontSize="14" FontWeight="SemiBold" />
                    <ToggleSwitch Header="Hide watched items" IsOn="{x:Bind ViewModel.HideWatchedItems, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeHomePreference, Mode=OneWay}" />
                    <TextBlock Text="Hide watched items from most Home sections. Featured and watch-history sections keep them." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                </StackPanel></Border>

                <!-- Scope group -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="Page" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Pick the home screen or library-specific view you want to customize."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Editing scope" FontSize="14" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="Changes apply only to the selected home screen."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HomeScopeComboBox" Grid.Column="1" Width="220"
                                      VerticalAlignment="Center" SelectionChanged="HomeScopeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Home" Tag="home" IsSelected="True" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sections group -->
                <Border x:Name="HomeRowsGroup" Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rows" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Drag rows to change their order. Hidden rows stay here so you can bring them back."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="+ Add row" Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}"
                                        Padding="14,7" Click="HomeSectionsAdd_Click" />
                                <Button Content="+ Add Section" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}"
                                        Padding="14,7" Click="HomeSectionsAddCustom_Click" />
                                <Button Content="More" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7">
                                  <Button.Flyout><MenuFlyout>
                                    <MenuFlyoutItem Text="Export layout" Click="HomeExport_Click" />
                                    <MenuFlyoutItem Text="Import layout…" Click="HomeImport_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Reset this page to the server's rows…" IsEnabled="{x:Bind ViewModel.CanEditHomeSections, Mode=OneWay}" Click="HomeSectionsReset_Click" />
                                  </MenuFlyout></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="HomeSectionsCountText" Grid.Column="1" Text="0 sections"
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingHomeSections, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="24" Height="24" />
                        <TextBlock Text="Saving your changes…" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                   Visibility="{x:Bind ViewModel.IsSavingHomeSections, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <Button Content="Reload rows" Click="HomeRowsReload_Click" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.HomeSectionsEditStateMessage, Mode=OneWay, Converter={StaticResource NullToVis}}" />

                        <!-- Section items (built in code-behind) -->
                        <StackPanel x:Name="HomeSectionItemsContainer" Spacing="8" />
                    </StackPanel>
                </Border>

                <Border Visibility="Collapsed" Style="{StaticResource SettingsGroupStyle}"><StackPanel Spacing="12">
                    <TextBlock Text="Export and import" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Move saved layout overrides between profiles or servers. Private history and credentials are excluded." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button x:Name="HomeExportButton" Content="Export layout" Click="HomeExport_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="HomeImportButton" Content="Import layout" Click="HomeImport_Click" Style="{StaticResource SecondaryButtonStyle}" />
                    </controls:WrapPanel>
                </StackPanel></Border>
            </StackPanel>
            </ContentControl>

            <!-- ===================================================================== -->
            <!-- ===== Card Overlays Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="CardOverlaysPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CardOverlaysTitleText" Text="Card Overlays" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Choose which badges appear on poster cards, where they sit, and how they look. Inspired by Kometa." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="CardOverlaysDisabledBanner" Style="{StaticResource SettingsGroupStyle}" Visibility="Collapsed">
                    <TextBlock Text="Card overlays have been disabled by your server administrator." TextWrapping="Wrap" />
                </Border>
                <StackPanel x:Name="CardOverlaysGeneralHost" Spacing="12" />
                <StackPanel x:Name="CardOverlaysContentHost" Spacing="24">
                    <Border Style="{StaticResource SettingsGroupStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Live preview of your current overlay configuration." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border Width="178" Height="267" HorizontalAlignment="Center" CornerRadius="12" Background="#30394A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid Margin="8">
                                    <StackPanel x:Name="OverlayPreviewTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="4" />
                                    <StackPanel x:Name="OverlayPreviewTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="4" />
                                    <StackPanel x:Name="OverlayPreviewBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="4" />
                                    <StackPanel x:Name="OverlayPreviewBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="4" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button x:Name="OverlayMoviePreviewButton" Content="Movie" Tag="movie"
                                        Style="{StaticResource ActiveTabStyle}" Padding="12,5"
                                        Click="OverlayPreviewVariant_Click" />
                                <Button x:Name="OverlayShowPreviewButton" Content="Show" Tag="show"
                                        Style="{StaticResource InactiveTabStyle}" Padding="12,5"
                                        Click="OverlayPreviewVariant_Click" />
                                <Button x:Name="OverlayRequestedPreviewButton" Content="Requested title" Tag="requested" Visibility="Collapsed"
                                        Style="{StaticResource InactiveTabStyle}" Padding="12,5" Click="OverlayPreviewVariant_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="CardOverlayOverlaysTab" Content="Overlays" Tag="overlays"
                                Style="{StaticResource ActiveTabStyle}" Click="CardOverlaySectionTab_Click" />
                        <Button x:Name="CardOverlayStyleTab" Content="Style" Tag="style"
                                Style="{StaticResource InactiveTabStyle}" Click="CardOverlaySectionTab_Click" />
                    </StackPanel>
                    <StackPanel x:Name="CardOverlayControlsContainer" Spacing="18" />
                    <StackPanel x:Name="CardOverlayStylePanel" Spacing="18" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Preset" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="A preset controls the base appearance of every badge. You can override the accent color of individual badges in the Overlays tab." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <controls:WrapPanel x:Name="CardOverlayPresetHost" HorizontalSpacing="8" VerticalSpacing="8" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="How styling works" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Where to find what." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="• Preset sets the badge shape, background, font, and whether icons show by default.&#x0a;• Accent color (per overlay) tints that badge — gold for IMDb, red for RT, etc.&#x0a;• Icon toggle (per overlay) overrides the preset's icon default for a single overlay.&#x0a;• Position picks which corner the badge sits in. Multiple badges in the same corner stack vertically."
                                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="22" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Personalize Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="RequestsPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Watchlist requests" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Automatically request titles outside your library when you add them to your watchlist. Turning this off keeps existing requests." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                        <ToggleSwitch x:Name="WatchlistAutoRequestToggle" Header="Request titles added to watchlist" Toggled="WatchlistAutoRequestToggle_Toggled" Visibility="Collapsed" />
                        <TextBlock x:Name="WatchlistRequestSettingStatus" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel x:Name="PersonalizePanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PersonalizeTitleText" Text="Personalize" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Pick titles you love so your home, recommendations, and &quot;For You&quot; rows reflect your taste." FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource PersonalizeGroupStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="PersonalizeTasteIcon" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE735;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Refine your taste profile" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                                <TextBlock Text="Browse popular titles and pick the ones you love. Already-favorited titles will be marked, so you can add to (or trim) your picks any time." FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="PersonalizePickerButton" Content="Open the picker  →" Style="{StaticResource AccentButtonStyle}" Height="36" FontSize="14" FontWeight="Medium" Padding="16,8" HorizontalAlignment="Left" Click="OpenTasteSeed_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource PersonalizeGroupStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="PersonalizeTourIcon" Width="48" Height="48" CornerRadius="24" Background="{StaticResource AccentBackgroundBrush}">
                            <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Replay the feature tour" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                                <TextBlock Text="A two-minute walkthrough of what this server can do — watch together, requests, watchlists, and the playback settings worth knowing about."
                                           FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="StartFeatureTourButton" Content="Start the tour"
                                    Style="{StaticResource OutlineButtonStyle}" Height="36" FontSize="14" FontWeight="Medium" Padding="16,8" HorizontalAlignment="Left"
                                    Click="StartFeatureTour_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel x:Name="PersonalizeFavoritesRow" Orientation="Horizontal" Spacing="8" Margin="8,0">
                    <FontIcon Glyph="&#xEB51;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="PersonalizeFavoritesText" Text="Loading favorites…" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Import Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="ImportPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <!-- ===== Header ===== -->
                <StackPanel Spacing="12">
                    <TextBlock Text="History import" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Import watch history from an external media server into a Silo profile."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- ===== New import — source + credentials + start button ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="New import" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Choose a source, sign in, and pick a profile to receive the watch history."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Source cards — 3-up grid (Emby / Jellyfin / Plex) -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ImportSourceEmbyCard" Grid.Column="0" TabIndex="0" Tag="emby"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#1DCFA1">
                                            <TextBlock Text="E" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Emby" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Emby Connect or direct server"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourceJellyfinCard" Grid.Column="2" TabIndex="2" Tag="jellyfin"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#00A4DC">
                                            <TextBlock Text="J" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Jellyfin" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Direct server URL + credentials"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="ImportSourcePlexCard" Grid.Column="1" TabIndex="1" Tag="plex"
                                    Click="ImportSourceCard_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    BorderThickness="1" CornerRadius="12" Padding="16,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8" Background="#E5A00D">
                                            <TextBlock Text="P" FontSize="15" FontWeight="SemiBold" Foreground="Black"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Plex" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Plex account or direct server"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Mode selector — only for Emby and Plex (Jellyfin is single-mode) -->
                        <StackPanel x:Name="ImportEmbyModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportEmbyConnectModeBtn" Content="Emby Connect" Tag="connect"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportEmbySavedModeBtn" Content="Saved Server" Tag="saved"
                                    Click="ImportEmbyMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <StackPanel x:Name="ImportPlexModeSelector" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <Button x:Name="ImportPlexOAuthModeBtn" Content="Plex Account" Tag="oauth"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="ImportPlexSavedModeBtn" Content="Saved Server" Tag="saved"
                                    Click="ImportPlexMode_Click" Padding="14,8"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <!-- ===== Auth panels (one visible at a time) ===== -->

                        <!-- Emby Connect form -->
                        <StackPanel x:Name="ImportEmbyConnectPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Email or Username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbyConnectUsernameBox"
                                             Text="{x:Bind ViewModel.EmbyConnectUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbyConnectPasswordBox"
                                                 PasswordChanged="EmbyConnectPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <Button x:Name="EmbyConnectLoginButton" Content="Find Servers"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="EmbyConnectLogin_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="EmbyConnectConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="EmbyConnectServerCombo" PlaceholderText="Choose a server"
                                                  SelectionChanged="EmbyConnectServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <TextBlock Text="Silo will exchange the server's temporary access key for a local Emby token and use it only for this import."
                                               FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Emby Saved form -->
                        <StackPanel x:Name="ImportEmbySavedPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock x:Name="EmbySavedSourcesLoadingText" Text="Loading saved servers…" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                            <Border x:Name="EmbySavedSourcesEmptyNotice" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <TextBlock Text="No admin-defined Emby servers are available yet." FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="EmbySavedSourcesFields" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved Server" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="EmbySavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="EmbySavedSource_SelectionChanged" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Emby Username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="EmbySavedUsernameBox"
                                             Text="{x:Bind ViewModel.EmbySavedUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Emby Password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="EmbySavedPasswordBox"
                                                 PasswordChanged="EmbySavedPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        </StackPanel>

                        <!-- Plex OAuth form -->
                        <StackPanel x:Name="ImportPlexOAuthPanel" Spacing="12" Visibility="Collapsed">
                            <!-- Pending spinner + status -->
                            <Border x:Name="PlexAuthPendingPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <ProgressRing IsActive="True" Width="18" Height="18" />
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="PlexAuthPendingText" Text="Finishing Plex sign-in…" FontSize="13"
                                                   FontWeight="Medium" Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="Continue in Plex, then you'll be returned here automatically."
                                                   FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Error panel -->
                            <Border x:Name="PlexAuthErrorPanel" Visibility="Collapsed"
                                    Background="#331F1F1F"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource ErrorBrush}" />
                                        <TextBlock x:Name="PlexAuthErrorText" FontSize="13"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Content="Try again" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" />
                                </StackPanel>
                            </Border>

                            <!-- Sign-in button -->
                            <Button x:Name="PlexAuthSignInButton" Content="Sign in with Plex"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,8"
                                    Click="PlexAuthStart_Click" />

                            <!-- Connected panel -->
                            <Border x:Name="PlexAuthConnectedPanel" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#4ADE80" />
                                        <TextBlock Text="Connected" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Server" FontSize="13"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ComboBox x:Name="PlexOAuthServerCombo" PlaceholderText="Choose a server"
                                                  SelectionChanged="PlexOAuthServer_SelectionChanged"
                                                  HorizontalAlignment="Stretch" MaxWidth="420" />
                                    </StackPanel>
                                    <Button Content="Reconnect Plex Account" Click="PlexAuthStart_Click"
                                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plex Saved form -->
                        <StackPanel x:Name="ImportPlexSavedPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock x:Name="PlexSavedSourcesLoadingText" Text="Loading saved servers…" FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                            <Border x:Name="PlexSavedSourcesEmptyNotice" Visibility="Collapsed"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                                <TextBlock Text="No admin-defined Plex servers are available yet." FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel x:Name="PlexSavedSourcesFields" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Saved Server" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="PlexSavedSourceCombo" HorizontalAlignment="Stretch" MaxWidth="420"
                                          SelectionChanged="PlexSavedSource_SelectionChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Plex Auth Token" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <PasswordBox x:Name="PlexSavedTokenBox" PlaceholderText="Your Plex authentication token"
                                             PasswordChanged="PlexSavedToken_Changed"
                                             Style="{StaticResource DarkPasswordBoxStyle}" MaxWidth="420" />
                            </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Jellyfin direct form -->
                        <StackPanel x:Name="ImportJellyfinPanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Jellyfin Server URL" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="JellyfinServerUrlBox"
                                         PlaceholderText="https://jellyfin.example.com"
                                         Text="{x:Bind ViewModel.JellyfinServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBoxStyle}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Jellyfin Username" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="JellyfinUsernameBox"
                                             Text="{x:Bind ViewModel.JellyfinUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Jellyfin Password" FontSize="13"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <PasswordBox x:Name="JellyfinPasswordBox"
                                                 PasswordChanged="JellyfinPassword_Changed"
                                                 Style="{StaticResource DarkPasswordBoxStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Enter the base URL for the Jellyfin server you want to import from."
                                       FontSize="12" Foreground="{StaticResource TertiaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Divider before target row -->
                        <Border Style="{StaticResource SettingsSeparator}" />

                        <!-- Profile + Start Import row -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="Import into profile" FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ImportProfileCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="ImportProfile_SelectionChanged"
                                          PlaceholderText="Choose a profile" />
                            </StackPanel>
                            <Button x:Name="StartImportButton" Grid.Column="1"
                                    Content="Start Import" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" Padding="24,10"
                                    Click="StartImport_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Latest import / selected run summary ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="RunSummaryTitle" Text="Latest import" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock x:Name="RunSummarySubtitle" Text="Results from the most recent import run."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Run summary card is built programmatically into this container -->
                        <StackPanel x:Name="RunSummaryContainer" Spacing="14" />
                    </StackPanel>
                </Border>

                <!-- ===== Import history list ===== -->
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Import history" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="Select a past run to view its details above."
                                       FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ProgressRing
                            IsActive="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingImportRuns, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Left"
                            Width="20" Height="20" />
                        <StackPanel x:Name="ImportRunsContainer" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Plugins Panel ===== -->
            <!-- ===================================================================== -->
            <StackPanel x:Name="PluginsPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Plugin Settings" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Configure user-level settings for installed plugins."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingPlugins, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Plugin cards (built in code-behind) -->
                <StackPanel x:Name="PluginCardsContainer" Spacing="12" />
            </StackPanel>

            <!-- ===================================================================== -->
            <!-- ===== Sessions Panel ===== -->
            <!-- ===================================================================== -->
            <!-- ===== Webhook Sync Panel ===== -->
            <StackPanel x:Name="WebhookSyncPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Webhook Sync" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Receive watched, stop, and progress events from Plex, Emby, and Jellyfin."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Add a connection" FontSize="16" FontWeight="Medium" />
                            <TextBlock Text="Create a provider-specific webhook endpoint and choose the default Silo profile."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Provider" FontSize="13" FontWeight="Medium" />
                            <ComboBox x:Name="WebhookProviderCombo" Width="260" HorizontalAlignment="Left"
                                      SelectionChanged="WebhookProviderCombo_SelectionChanged">
                                <ComboBoxItem Content="Plex" Tag="plex" IsSelected="True" />
                                <ComboBoxItem Content="Emby" Tag="emby" />
                                <ComboBoxItem Content="Jellyfin" Tag="jellyfin" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="WebhookPlexAuthPanel" Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Plex account" FontSize="13" FontWeight="Medium" />
                                    <TextBlock x:Name="WebhookPlexAuthStatus" Text="Authorize via plex.tv to discover your servers"
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Button x:Name="WebhookPlexSignInButton" Grid.Column="1" Content="Sign in to Plex"
                                        Style="{StaticResource AccentButtonStyle}" Click="WebhookPlexSignIn_Click" />
                            </Grid>
                            <Grid x:Name="WebhookPlexServerRow" ColumnSpacing="12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Server" FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="The Plex Media Server that will send webhook events."
                                               FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="WebhookPlexServerCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                          PlaceholderText="Select a server" SelectionChanged="WebhookCreateField_Changed" />
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="WebhookManualServerPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Connection name" FontSize="13" FontWeight="Medium" />
                            <TextBox x:Name="WebhookManualServerName" PlaceholderText="My Emby Server"
                                     TextChanged="WebhookCreateField_Changed" />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Default profile" FontSize="13" FontWeight="Medium" />
                                <TextBlock Text="The signed-in external user is linked to this profile when the connection is created."
                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="WebhookDefaultProfileCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      PlaceholderText="Choose a profile" SelectionChanged="WebhookCreateField_Changed" />
                        </Grid>
                        <Button x:Name="WebhookCreateConnectionButton" Content="Create connection"
                                HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="WebhookCreateConnection_Click" />
                    </StackPanel>
                </Border>

                <!-- Connections list -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Connected servers" FontSize="16" FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Manage webhook endpoints, provider setup instructions, and profile mappings."
                                       FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="WebhookConnectionsPanel" Spacing="8" />
                        <TextBlock x:Name="NoConnectionsText"
                                   Text="No webhook connections yet. Create one above to generate a provider-specific endpoint."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Padding="0,16"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="WebhookConnectionDetail" Spacing="24" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="WebhookDetailName" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="WebhookDetailHealth" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="WebhookDetailStatus" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Webhook URL" FontSize="13" FontWeight="Medium" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="WebhookUrlBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                                <Button Grid.Column="1" Content="Copy" Click="WebhookCopyUrl_Click" />
                                <Button Grid.Column="2" Content="Rotate" Click="WebhookRotate_Click" />
                                <Button x:Name="WebhookDeleteConnectionButton" Grid.Column="3" Content="Delete" Click="WebhookDelete_Click" />
                            </Grid>
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Connection name" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="WebhookConnectionNameBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Default profile" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="WebhookConnectionProfileCombo" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Button Content="Save connection" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}"
                                Click="WebhookSaveConnection_Click" />
                        <TextBlock Text="Profile mapping" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Map each external user to a Silo profile. Unmapped users are ignored." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel x:Name="WebhookActorsHost" Spacing="8" />
                        <Button x:Name="WebhookSaveActorsButton" Content="Save mappings" HorizontalAlignment="Right"
                                Style="{StaticResource AccentButtonStyle}" Click="WebhookSaveActors_Click" />
                        <StackPanel x:Name="WebhookSetupInstructionsHost" />
                    </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Recent deliveries" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Latest webhook requests for this connection." FontSize="12"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WebhookEventSearchBox" PlaceholderText="Search events..."
                                     TextChanged="WebhookEventFilter_Changed" />
                            <ComboBox x:Name="WebhookEventOutcomeFilter" Grid.Column="1"
                                      HorizontalAlignment="Stretch" SelectionChanged="WebhookEventFilter_Changed">
                                <ComboBoxItem Content="All outcomes" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="Applied" Tag="applied" />
                                <ComboBoxItem Content="Ignored" Tag="ignored" />
                                <ComboBoxItem Content="Unmatched" Tag="unmatched" />
                                <ComboBoxItem Content="Skipped" Tag="skipped" />
                                <ComboBoxItem Content="Rejected" Tag="rejected" />
                                <ComboBoxItem Content="Error" Tag="error" />
                            </ComboBox>
                        </Grid>
                        <StackPanel x:Name="WebhookEventsHost" Spacing="8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="WebhookEventsFirst" Content="First" Click="WebhookEventsFirst_Click" />
                            <Button x:Name="WebhookEventsPrevious" Grid.Column="1" Content="Previous" Click="WebhookEventsPrevious_Click" />
                            <TextBlock x:Name="WebhookEventsPageLabel" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="WebhookEventsNext" Grid.Column="3" Content="Next" Click="WebhookEventsNext_Click" />
                            <Button x:Name="WebhookEventsLast" Grid.Column="4" Content="Last" Click="WebhookEventsLast_Click" />
                        </Grid>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== Watch Providers Panel ===== -->
            <StackPanel x:Name="WatchProvidersPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Watch Providers" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Connect external trackers to import watch history, sync progress, and scrobble playback."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingWatchProviders, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <StackPanel x:Name="WatchProvidersCardsPanel" Spacing="12" />
                <TextBlock x:Name="NoWatchProvidersText"
                           Text="No watch providers are registered on this server."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Padding="0,16"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Your Devices Panel ===== -->
            <StackPanel x:Name="DevicesPanel" Spacing="20" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="Your devices" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Every phone, tablet, TV and browser you watch on. Pick one to see what's set differently there and change it — from here, whichever device you're holding."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="DevicesLoadingRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left" />
                <StackPanel x:Name="DevicesContentHost" Spacing="12" />
            </StackPanel>

            <!-- ===== Connect Apps Panel ===== -->
            <StackPanel x:Name="ConnectAppsPanel" Spacing="20" Margin="0" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ConnectAppsTitleText" Text="Connect Apps" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="Exactly what to type on a sign-in screen. Pick the kind of app you're using — the credentials are different for each."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ProgressRing x:Name="ConnectAppsLoadingRing" IsActive="False" Width="28" Height="28" HorizontalAlignment="Left" />
                <StackPanel x:Name="ConnectAppsContentHost" Spacing="12" />
            </StackPanel>

            <!-- ===== Notification Settings Panel ===== -->
            <StackPanel x:Name="NotificationsSettingsPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <ContentControl x:Name="NotificationsSettingsHost" />
            </StackPanel>

            <!-- ===== Profiles Panel ===== -->
            <StackPanel x:Name="ProfilesPanel" Spacing="24" Margin="0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Profiles" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage profile names, PINs, and access rules."
                                   FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button x:Name="AddProfileButton" Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Top"
                            Click="AddProfileButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="New profile" />
                        </StackPanel>
                    </Button>
                </Grid>
                <StackPanel x:Name="HouseholdStreamsPanel" Spacing="8" />
                <StackPanel x:Name="ProfileCardsPanel" Spacing="8" />
                <TextBlock x:Name="NoProfilesText" Text="No profiles yet&#x0a;Create a profile to manage access and playback identity."
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>

            <!-- ===== Accessibility Panel ===== -->
            <StackPanel x:Name="AccessibilityPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock x:Name="AccessibilityTitleText" Text="Accessibility" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>

                <!-- Readability -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Readability" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="Increase text size, strengthen type weight, and raise contrast for clearer reading."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Text size" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextSizeButtons" Orientation="Horizontal" Spacing="8" />

                        <TextBlock Text="Text weight" FontSize="14" FontWeight="Medium" Margin="0,8,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="TextWeightButtons" Orientation="Horizontal" Spacing="8" />

                        <TextBlock Text="Contrast" FontSize="14" FontWeight="Medium" Margin="0,8,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <StackPanel x:Name="ContrastButtons" Orientation="Horizontal" Spacing="8" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="16" Padding="20,16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock Text="See how text looks with your current readability settings."
                                   FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="The quick brown fox jumps over the lazy dog"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="This sample paragraph reflects your current text size, weight, and contrast preferences. Adjustments take effect across the entire interface."
                                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Secondary text · Metadata · Captions"
                                           FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Date &amp; time" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Choose how dates and clock times are displayed across the app. Saved for the active profile." FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="Date format" FontSize="14" FontWeight="Medium" />
                        <StackPanel x:Name="DateFormatButtons" Orientation="Horizontal" Spacing="8" />
                        <TextBlock Text="Time format" FontSize="14" FontWeight="Medium" Margin="0,6,0,0" />
                        <StackPanel x:Name="TimeFormatButtons" Orientation="Horizontal" Spacing="8" />
                        <TextBlock x:Name="DateTimePreviewText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel x:Name="SessionsPanel" Spacing="24" Margin="0" Visibility="Collapsed">

                <StackPanel Spacing="12">
                    <TextBlock Text="Signed-in sessions" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock Text="See where your account is signed in, and sign out any session you don't recognize."
                               FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoadingSessions, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" />

                <!-- Session cards container (built in code-behind) -->
                <StackPanel x:Name="SessionCardsContainer" Spacing="12" />
            </StackPanel>

                </StackPanel>
                <!-- /Grid.Column="1" content column -->
            </Grid>
            <!-- /two-column sidebar + content grid -->

        </StackPanel>
    </ScrollViewer>
</Page>
