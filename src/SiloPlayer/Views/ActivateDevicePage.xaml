<?xml version="1.0" encoding="utf-8"?>
<Page xmlns:loc="using:SiloPlayer.Services"
    x:Class="SiloPlayer.Views.ActivateDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    FontFamily="{StaticResource ThemeFontFamily}"
    Background="{StaticResource AppBackgroundBrush}" loc:Localized.Direction="True">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
    </Page.Resources>

    <!-- The auth shell the sign-in pages use: artwork behind a readability scrim, one centered glass card.
         Official page: web/src/pages/ActivateDevice.tsx (silo-server 3b2b32168, #4652). -->
    <Grid helpers:AuthBackdrop.Enabled="True">
        <Image FlowDirection="LeftToRight"
            Source="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource UrlToImage}}"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            helpers:AuthBackdrop.ReadabilityScrim="True"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
        <StackPanel x:Name="ActivateLayout"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="448"
            Margin="24"
            Spacing="16">

            <Border x:Name="ActivateCard" Style="{StaticResource GlassCardStyle}" Padding="52,24" CornerRadius="12" BorderThickness="0">
                <StackPanel Spacing="24">
                    <!-- Header: server name, its address, what this page does -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="ServerNameTitle"
                            Text="{x:Bind ViewModel.DisplayServerName, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="ExtraBold"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />
                        <TextBlock
                            x:Name="ServerHostText"
                            Text="{x:Bind ViewModel.ServerHost, Mode=OneWay}"
                            FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock
                            Text="Sign in a TV, app, or other device." loc:Localized.Text="web.auth.activate.description"
                            Style="{StaticResource SecondaryTextStyle}"
                            Margin="0,8,0,0"
                            FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Code entry -->
                    <StackPanel
                        x:Name="CodeForm"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowCodeForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Enter the code shown on your device" loc:Localized.Text="web.auth.activate.codeLabel"
                                FontSize="14"
                                FontWeight="Medium"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="CodeBox"
                                Text="{x:Bind ViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="1234 5678"
                                CharacterCasing="Upper"
                                TextChanged="CodeBox_TextChanged"
                                KeyDown="CodeBox_KeyDown" />
                        </StackPanel>
                        <Button
                            x:Name="ContinueButton"
                            Content="Continue" loc:Localized.Content="web.ui.continue"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            IsEnabled="{x:Bind ViewModel.CanSubmitCode, Mode=OneWay}"
                            Command="{x:Bind ViewModel.SubmitCodeCommand}" />
                    </StackPanel>

                    <!-- Looking up -->
                    <StackPanel
                        x:Name="LookingUp"
                        Orientation="Horizontal" Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressRing IsActive="True" Width="20" Height="20" />
                        <TextBlock
                            Text="Looking up the code..." loc:Localized.Text="web.auth.activate.lookingUp"
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- A Quick Connect code is looked up only for a signed-in account -->
                    <StackPanel
                        x:Name="QuickConnectSignIn"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowQuickConnectSignIn, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.QuickConnectSignInText, Mode=OneWay}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                        <Button
                            Content="Sign in to approve" loc:Localized.Content="web.auth.activate.signInToApprove"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Click="SignInButton_Click" />
                        <Button
                            Content="Enter another code" loc:Localized.Content="web.auth.activate.enterAnotherCode"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Command="{x:Bind ViewModel.ClearCodeCommand}" />
                    </StackPanel>

                    <!-- Not found, rate limited, impersonating or failed -->
                    <StackPanel
                        x:Name="LoadErrorPanel"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowLoadError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            x:Name="LoadErrorText"
                            Text="{x:Bind ViewModel.LoadErrorText, Mode=OneWay}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Assertive" />
                        <Button
                            Content="Try again" loc:Localized.Content="common.tryAgain"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Visibility="{x:Bind ViewModel.ShowTryAgain, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Command="{x:Bind ViewModel.RetryLookupCommand}" />
                        <Button
                            Content="Enter another code" loc:Localized.Content="web.auth.activate.enterAnotherCode"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Command="{x:Bind ViewModel.ClearCodeCommand}" />
                    </StackPanel>

                    <!-- The request: who is asking, the code to compare, and what the person can do -->
                    <StackPanel
                        x:Name="DetailsPanel"
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="HeadingText"
                                Text="{x:Bind ViewModel.HeadingText, Mode=OneWay}"
                                FontSize="18" FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowHeading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                x:Name="DeviceLineText"
                                Text="{x:Bind ViewModel.DeviceLineText, Mode=OneWay}"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="14" TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowDeviceLine, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Compare this with the code the device shows -->
                        <Border
                            x:Name="MatchCodeCard"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="6" Padding="16"
                            Visibility="{x:Bind ViewModel.ShowMatchCode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="Make sure this code matches" loc:Localized.Text="web.auth.activate.checkTv"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    FontSize="14" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="MatchCodeText"
                                    Text="{x:Bind ViewModel.DisplayCode, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.SpokenCode, Mode=OneWay}"
                                    FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" CharacterSpacing="120"
                                    Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- A remote-playback request comes from a Silo app, which approves it; this page can only decline -->
                        <StackPanel
                            x:Name="RemotePlaybackPanel"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.ShowRemotePlayback, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="This request comes from the Silo app that sent playback to this TV. Approve it in that app." loc:Localized.Text="web.auth.activate.remotePlaybackApproveInApp"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                            <TextBlock
                                Text="The TV plays with the profile chosen in the app instead of signing in, so this page can't approve it." loc:Localized.Text="web.auth.activate.remotePlaybackCantApprove"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                            <Button
                                x:Name="RemoteDeclineButton"
                                Content="Decline" loc:Localized.Content="web.auth.activate.notNow"
                                Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="16,12"
                                Visibility="{x:Bind ViewModel.ShowRemoteDecline, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DenyCommand}" />
                        </StackPanel>

                        <!-- Signed out -->
                        <StackPanel
                            x:Name="SignedOutPanel"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.ShowSignedOut, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="{x:Bind ViewModel.SignedOutText, Mode=OneWay}"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                            <Button
                                Content="Sign in to approve" loc:Localized.Content="web.auth.activate.signInToApprove"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="16,12"
                                Click="SignInButton_Click" />
                        </StackPanel>

                        <!-- An admin viewing as someone cannot approve -->
                        <TextBlock
                            x:Name="ImpersonationBlock"
                            Text="{x:Bind ViewModel.ImpersonationText, Mode=OneWay}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="{x:Bind ViewModel.ShowImpersonation, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!-- Signed in: approve or decline -->
                        <StackPanel
                            x:Name="ApprovalPanel"
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.ShowApproval, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                x:Name="SignedInAsText"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                            <TextBlock
                                Text="This gives it access to your profiles. Profiles with a PIN stay locked." loc:Localized.Text="web.auth.activate.profilesShared"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowProfilesShared, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                Text="Only approve this if you started the sign-in yourself." loc:Localized.Text="web.auth.activate.onlyApproveTv"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                FontSize="14" FontWeight="Medium" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="RequestedFromText"
                                Text="{x:Bind ViewModel.RequestedFromText, Mode=OneWay}"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="12" TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.ShowRequestedFrom, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                            <!-- A Quick Connect approval signs the device in as one chosen profile -->
                            <StackPanel
                                x:Name="QuickConnectPanel"
                                Spacing="16"
                                Visibility="{x:Bind ViewModel.ShowQuickConnectApproval, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    Text="Loading your profiles..." loc:Localized.Text="web.auth.quickConnect.loadingProfiles"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    FontSize="14"
                                    Visibility="{x:Bind ViewModel.ShowQuickConnectLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <StackPanel
                                    Spacing="12"
                                    Visibility="{x:Bind ViewModel.ShowQuickConnectLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock
                                        Text="Couldn't load your profiles." loc:Localized.Text="web.auth.quickConnect.loadFailed"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                                    <Button
                                        Content="Try again" loc:Localized.Content="common.tryAgain"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Padding="16,12"
                                        Command="{x:Bind ViewModel.RetryProfilesCommand}" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="16"
                                    Visibility="{x:Bind ViewModel.ShowQuickConnectChoices, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.QuickConnectProfileLabel, Mode=OneWay}"
                                            FontSize="14" FontWeight="Medium" TextWrapping="Wrap"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                        <StackPanel x:Name="ProfileChoices" Spacing="8" />
                                    </StackPanel>
                                    <StackPanel
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.ShowQuickConnectPin, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.QuickConnectPinLabel, Mode=OneWay}"
                                            FontSize="14" FontWeight="Medium" TextWrapping="Wrap"
                                            Foreground="{StaticResource PrimaryTextBrush}" />
                                        <PasswordBox
                                            x:Name="QuickConnectPinBox"
                                            Style="{StaticResource DarkPasswordBoxStyle}"
                                            IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                                            PasswordChanged="QuickConnectPinBox_PasswordChanged" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="QuickConnectErrorText"
                                        Text="{x:Bind ViewModel.QuickConnectErrorText, Mode=OneWay}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                                        Visibility="{x:Bind ViewModel.ShowQuickConnectError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Spacing="12">
                                        <Button
                                            x:Name="QuickConnectApproveButton"
                                            Content="{x:Bind ViewModel.ApproveButtonText, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="16,12"
                                            IsEnabled="{x:Bind ViewModel.CanApproveQuickConnect, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ApproveQuickConnectCommand}" />
                                        <Button
                                            x:Name="QuickConnectDeclineButton"
                                            Content="Decline" loc:Localized.Content="web.auth.activate.notNow"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Padding="16,12"
                                            IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.DenyCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- An ordinary device sign-in -->
                            <StackPanel
                                x:Name="PlainApprovalPanel"
                                Spacing="12"
                                Visibility="{x:Bind ViewModel.ShowPlainApproval, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <Button
                                    x:Name="ApproveButton"
                                    Content="{x:Bind ViewModel.ApproveButtonText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,12"
                                    IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ApproveCommand}" />
                                <Button
                                    x:Name="DeclineButton"
                                    Content="Decline" loc:Localized.Content="web.auth.activate.notNow"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,12"
                                    IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.DenyCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- A decision that failed -->
                        <TextBlock
                            x:Name="ActionErrorText"
                            Text="{x:Bind ViewModel.ActionErrorText, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Assertive"
                            Visibility="{x:Bind ViewModel.ShowActionError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!-- What became of the request, announced when it changes -->
                        <TextBlock
                            x:Name="ResultText"
                            Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14" LineHeight="22" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite"
                            Visibility="{x:Bind ViewModel.ShowResult, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!-- Manual entry again; a link carries its request in its token, so only once that expired -->
                        <Button
                            x:Name="EnterAnotherGhostButton"
                            Content="Enter another code" loc:Localized.Content="web.auth.activate.enterAnotherCode"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Visibility="{x:Bind ViewModel.ShowEnterAnotherGhost, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Command="{x:Bind ViewModel.ClearCodeCommand}" />
                        <Button
                            x:Name="EnterAnotherOutlineButton"
                            Content="Enter another code" loc:Localized.Content="web.auth.activate.enterAnotherCode"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Visibility="{x:Bind ViewModel.ShowEnterAnotherOutline, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Command="{x:Bind ViewModel.ClearCodeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
