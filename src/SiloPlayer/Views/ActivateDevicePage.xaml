<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiloPlayer.Views.ActivateDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:SiloPlayer.Converters"
    mc:Ignorable="d"
    Background="{StaticResource AppBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </Page.Resources>

    <!-- Full-page centered auth shell (matches LoginPage layout) -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Image
            Source="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay}"
            Stretch="UniformToFill"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False"
            AutomationProperties.AccessibilityView="Raw" />
        <Border
            Background="#B3000000"
            Visibility="{x:Bind ViewModel.LoginBackgroundUrl, Mode=OneWay, Converter={StaticResource NullToVis}}"
            IsHitTestVisible="False" />
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="420"
            Spacing="16">

            <!-- Glass card -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="24">
                    <!-- Header -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="ServerNameTitle"
                            Text="{x:Bind ViewModel.ServerName, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="ExtraBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            CharacterSpacing="-40" />

                        <TextBlock
                            Text="Approve sign-in for the device you're trying to use."
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="14"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Error message -->
                    <Border
                        Background="#2DEF6B73"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                            Foreground="{StaticResource ErrorBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- Status message -->
                    <Border
                        Background="#2D5BC16B"
                        CornerRadius="8"
                        Padding="12,10"
                        Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}">
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            TextWrapping="Wrap"
                            FontSize="13" />
                    </Border>

                    <!-- Code entry form (shown when no active request) -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowCodeForm, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="Enter the code from your screen"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBox
                                x:Name="CodeBox"
                                Text="{x:Bind ViewModel.CodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DarkTextBoxStyle}"
                                PlaceholderText="ABCD-EFGH"
                                CharacterCasing="Upper"
                                TextChanged="CodeBox_TextChanged"
                                KeyDown="CodeBox_KeyDown" />
                        </StackPanel>

                        <Button
                            Content="Continue"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,12"
                            Command="{x:Bind ViewModel.SubmitCodeCommand}" />
                    </StackPanel>

                    <!-- Loading indicator -->
                    <StackPanel
                        Spacing="8"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ProgressRing IsActive="True" Width="28" Height="28" />
                        <TextBlock
                            Text="Loading device request..."
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="13"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Not found state -->
                    <StackPanel
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.ShowNotFound, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Text="That sign-in request could not be found."
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14"
                            TextWrapping="Wrap" />
                        <Button
                            Content="Enter another code"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,10"
                            Command="{x:Bind ViewModel.ClearCodeCommand}" />
                    </StackPanel>

                    <!-- Details + actions -->
                    <StackPanel
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowDetails, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                        <!-- Device details card -->
                        <Border
                            Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.DeviceDisplayName, Mode=OneWay}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Details.DevicePlatform, Mode=OneWay}"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        FontSize="13"
                                        Visibility="{x:Bind ViewModel.Details.DevicePlatform, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Details.IpAddressHint, Mode=OneWay}"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        FontSize="13"
                                        Visibility="{x:Bind ViewModel.Details.IpAddressHint, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.RequestDescription, Mode=OneWay}"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        FontSize="13"
                                        Margin="0,6,0,0"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel
                                    Spacing="2"
                                    Visibility="{x:Bind ViewModel.Details.MatchCode, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                    <TextBlock
                                        Text="MATCH CODE"
                                        FontSize="11"
                                        CharacterSpacing="120"
                                        Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Details.MatchCode, Mode=OneWay}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Sign-in prompt (not signed in) -->
                        <StackPanel
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.ShowSignInPrompt, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Text="You need to sign in on this device before you can approve another device."
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                            <Button
                                Content="Sign in to approve"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="16,10"
                                Click="SignInButton_Click" />
                        </StackPanel>

                        <!-- Approve/Deny (signed in + pending) -->
                        <StackPanel
                            Spacing="10"
                            Visibility="{x:Bind ViewModel.CanShowApproveButtons, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                x:Name="SignedInAsText"
                                Style="{StaticResource SecondaryTextStyle}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                            <Button
                                Content="{x:Bind ViewModel.ApprovalButtonText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="16,12"
                                Command="{x:Bind ViewModel.ApproveCommand}"
                                IsEnabled="{x:Bind ViewModel.IsActing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                            <Button
                                Content="Deny"
                                Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Padding="16,10"
                                Command="{x:Bind ViewModel.DenyCommand}"
                                IsEnabled="{x:Bind ViewModel.IsActing, Mode=OneWay, Converter={StaticResource InverseBool}}" />
                        </StackPanel>

                        <!-- Status messages for non-pending states -->
                        <TextBlock
                            Text="Approved. Finish sign-in on the device."
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsApproved, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            Text="This device is already signed in."
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsConsumed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            Text="This sign-in request was denied."
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsDenied, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <TextBlock
                            Text="This sign-in request has expired."
                            Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsExpired, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <!-- Enter another code (only when code-based, not token deep link) -->
                        <Button
                            Content="Enter another code"
                            Style="{StaticResource OutlineButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="16,10"
                            Command="{x:Bind ViewModel.ClearCodeCommand}"
                            Visibility="{x:Bind ViewModel.CanEnterAnotherCode, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
