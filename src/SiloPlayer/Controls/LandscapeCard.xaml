<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.LandscapeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="315"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    KeyDown="OnCardKeyDown"
    GotFocus="OnCardGotFocus"
    LostFocus="OnCardLostFocus"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited">

    <Grid
        x:Name="RootGrid"
        Width="315"
        Background="Transparent"
        CacheMode="BitmapCache">

        <Grid.RowDefinitions>
            <RowDefinition Height="177" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Backdrop image area (16:9 aspect, rounded) —
             B32: image click starts playback (→ PlayerService.PlayAsync),
             text click (below) navigates to the detail page. -->
        <Grid Grid.Row="0" CornerRadius="12" Tapped="OnImageTapped" Background="Transparent">
            <!-- Card background for hover -->
            <Border
                x:Name="CardBackground"
                Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12" />

            <TextBlock
                x:Name="NoImageText"
                Text="No Image"
                FontSize="13"
                Foreground="{StaticResource SecondaryTextBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Actual backdrop image — hover zoom on image only (not the
                 whole card) so the rounded clip frame stays still. -->
            <Image
                x:Name="BackdropImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="HoverTransform" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>

            <!-- Progress bar at bottom -->
            <Grid
                x:Name="ProgressContainer"
                VerticalAlignment="Bottom"
                Height="3"
                Visibility="Collapsed">
                <!-- Track -->
                <Border
                    Background="#40FFFFFF"
                    CornerRadius="0,0,12,12" />
                <!-- Fill -->
                <Border
                    x:Name="ProgressFill"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="0,0,0,12"
                    HorizontalAlignment="Left" />
            </Grid>

            <!-- Remaining time badge -->
            <Border
                x:Name="RemainingBadge"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,8,8"
                Background="#B3000000"
                CornerRadius="4"
                Padding="6,2"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="RemainingText"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="White" />
            </Border>

            <Border
                x:Name="CurrentItemBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Background="{StaticResource AccentBrush}"
                CornerRadius="12"
                Padding="9,5"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentForegroundBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="NOW VIEWING" FontSize="10" FontWeight="SemiBold"
                               CharacterSpacing="80"
                               Foreground="{StaticResource AccentForegroundBrush}" />
                </StackPanel>
            </Border>

            <Border
                x:Name="EpisodeWatchedBadge"
                Width="28" Height="28"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="8"
                Background="#A6000000"
                CornerRadius="14"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#4ADE80"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Hover overlays — MUST be last so they paint on top of image/gradient/progress/badges.
                 Z-order: background → image → gradient → progress → remaining badge → dim → play → border. -->
            <StackPanel x:Name="OverlayTopLeft" Orientation="Vertical" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" />
            <StackPanel x:Name="OverlayTopRight" Orientation="Vertical" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" />
            <StackPanel x:Name="OverlayBottomLeft" Orientation="Vertical" Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,8,8,24" />
            <StackPanel x:Name="OverlayBottomRight" Orientation="Vertical" Spacing="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8,8,8,56" />

            <Border
                x:Name="HoverDim"
                CornerRadius="12"
                Background="#55000000"
                Opacity="0"
                IsHitTestVisible="False" />

            <!-- Circular Play button — fades and scales in on hover. -->
            <Button
                x:Name="HoverPlayButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="44" Height="44"
                CornerRadius="22"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0"
                Tapped="OnPlayTapped"
                RenderTransformOrigin="0.5,0.5">
                <Button.Resources>
                    <!-- The accent circle below owns every visible hover/press
                         state. Suppress the stock WinUI Button template's
                         rectangular state layer so it cannot appear behind
                         the circle when the pointer enters the play action. -->
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Button.Resources>
                <Button.RenderTransform>
                    <CompositeTransform x:Name="HoverPlayButtonTransform" ScaleX="0.7" ScaleY="0.7" />
                </Button.RenderTransform>
                <Grid Width="44" Height="44">
                    <Ellipse Fill="{StaticResource AccentBrush}" />
                    <FontIcon
                        x:Name="HoverPlayIcon"
                        Glyph="&#xE768;"
                        FontSize="18"
                        Foreground="{StaticResource AccentForegroundBrush}"
                        Margin="3,0,0,0" />
                </Grid>
            </Button>

            <!-- Current WebUI MediaItemMenu trigger: translucent ellipsis in
                 the top-right, revealed on hover. -->
            <Button
                x:Name="DismissButton"
                Width="36" Height="36"
                CornerRadius="6"
                Padding="0"
                Background="#AA000000"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,12,12"
                Opacity="0"
                IsHitTestVisible="True"
                Click="DismissButton_Click"
                Tapped="DismissButton_Tapped"
                AutomationProperties.Name="More actions"
                ToolTipService.ToolTip="More actions"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="White" />
            </Button>

            <!-- Hover accent border — topmost layer -->
            <Border
                x:Name="CurrentItemBorder"
                CornerRadius="12"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        </Grid>

        <!-- Text below image — B32: text click navigates to details -->
        <StackPanel Grid.Row="1" Margin="2,10,2,0" Spacing="2" Background="Transparent">
            <!-- Title -->
            <Button x:Name="HeadingButton" Click="OnHeadingClick"
                    Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </Button>
            <!-- Episode context: "Series Title · S1 E3" -->
            <Button x:Name="SubtitleButton" Click="OnMetadataClick"
                    Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed">
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </Button>
            <Button x:Name="TimeLeftButton" Click="OnMetadataClick"
                    Padding="0" MinWidth="0" MinHeight="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                    Visibility="Collapsed">
                <TextBlock
                    x:Name="TimeLeftText"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="1" />
            </Button>
            <!-- Badge row (e.g. "SEASON PREMIERE") — WebUI parity with ContinueWatchingCard.
                 Uses a rounded-full pill with emerald accent. Visible only when the server
                 attaches a badge string to the section item. -->
            <Border
                x:Name="BadgePill"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Height="18"
                Padding="8,0"
                CornerRadius="9"
                BorderThickness="1"
                BorderBrush="#4D34D399"
                Background="#1A34D399"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="BadgeText"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="80"
                    Foreground="#6EE7B7"
                    VerticalAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
