<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.NotificationSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SiloPlayer.Services"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:models="using:SiloPlayer.Core.Models.Notifications">
    <UserControl.Resources>
        <!-- This control is constructed in code, outside SettingsPage's resource scope. -->
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="{Binding Color, Source={StaticResource BorderBrush}}" Opacity="0.72" />
        <Style x:Key="SettingsGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,28" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <StackPanel Spacing="24">
        <TextBlock Text="Notifications" loc:Localized.Text="web.settings.notifications.title" FontSize="30" FontWeight="SemiBold" />
        <ProgressRing Width="30" Height="30" HorizontalAlignment="Center"
                      IsActive="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}" />
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}" />

        <Border Style="{StaticResource SettingsGroupStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="New Episode Notifications" loc:Localized.Text="web.settings.notifications.episodes.title" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Choose which series relationships notify this profile when a new episode arrives." loc:Localized.Text="web.settings.notifications.episodes.description"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Enable notifications" loc:Localized.Text="web.settings.notifications.episodes.enable" FontWeight="SemiBold" />
                        <TextBlock Text="Master switch for this profile" loc:Localized.Text="web.settings.notifications.episodes.enableHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" Toggled="NotificationPreference_Toggled" />
                </Grid>
                <Grid><TextBlock Text="Favorites" loc:Localized.Text="web.notifications.preferences.favorites" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding NotifyFavorites, Mode=TwoWay}" IsEnabled="{Binding NotificationsEnabled}" Toggled="NotificationPreference_Toggled" /></Grid>
                <Grid><TextBlock Text="Watchlist" loc:Localized.Text="web.notifications.preferences.watchlist" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding NotifyWatchlist, Mode=TwoWay}" IsEnabled="{Binding NotificationsEnabled}" Toggled="NotificationPreference_Toggled" /></Grid>
                <Grid><TextBlock Text="Continue Watching" loc:Localized.Text="web.notifications.preferences.continueWatching" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding NotifyContinueWatching, Mode=TwoWay}" IsEnabled="{Binding NotificationsEnabled}" Toggled="NotificationPreference_Toggled" /></Grid>
                <Grid><TextBlock Text="Next Up" loc:Localized.Text="web.notifications.preferences.nextUp" /><ToggleSwitch HorizontalAlignment="Right" IsOn="{Binding NotifyNextUp, Mode=TwoWay}" IsEnabled="{Binding NotificationsEnabled}" Toggled="NotificationPreference_Toggled" /></Grid>
                <Button x:Name="NotificationSeriesLink" Content="See which series notify you" loc:Localized.Content="web.settings.notifications.episodes.seriesLink" HorizontalAlignment="Left" Click="SeeSeries_Click" Style="{StaticResource GhostButtonStyle}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsGroupStyle}" Visibility="{Binding HasWebPush, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="14">
                <TextBlock Text="Browser Notifications" loc:Localized.Text="web.settings.notifications.push.title" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Get notified even when Silo is closed. Notifications are encrypted end-to-end — the browser vendor's push service never sees their content." loc:Localized.Text="web.settings.notifications.push.description"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Browser subscriptions are enabled from Silo's WebUI. This Windows app can review and remove the browsers registered to this profile."
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Button Content="Open browser notification settings" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="OpenBrowserSettings_Click" />
                <TextBlock Text="No browser subscriptions." Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding HasWebPushSubscriptions, Converter={StaticResource InverseBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding WebPushSubscriptions}" Visibility="{Binding HasWebPushSubscriptions, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WebPushSubscriptionView">
                            <Grid ColumnSpacing="12" Padding="0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind DeviceName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind DeliveryHealthText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove" loc:Localized.Content="web.settings.notifications.push.remove" Tag="{x:Bind Id}" Style="{StaticResource SecondaryButtonStyle}" Click="RemovePush_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsGroupStyle}" Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="14">
                <TextBlock Text="Email Notifications" loc:Localized.Text="web.settings.notifications.email.title" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Per profile: each profile verifies its own address and picks its own frequency." loc:Localized.Text="web.settings.notifications.email.description"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Email this profile's notifications" loc:Localized.Text="web.settings.notifications.email.enable" FontWeight="SemiBold" />
                        <TextBlock Text="Notifications you'd see in the inbox, delivered by email" loc:Localized.Text="web.settings.notifications.email.enableHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="EmailEnabledToggle" Grid.Column="1" IsOn="{Binding IsEmailEnabled}" IsEnabled="{Binding CanToggleEmail}" Toggled="EmailEnabled_Toggled" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Deliver to" loc:Localized.Text="web.settings.notifications.email.deliverTo" />
                        <TextBlock Text="{Binding EmailDestinationText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="{Binding EmailPreferences.CanEditAddress, Converter={StaticResource BoolToVis}}">
                        <Button Content="Remove" loc:Localized.Content="web.settings.notifications.email.remove" Style="{StaticResource SecondaryButtonStyle}" Click="ClearEmail_Click"
                                Visibility="{Binding HasVerifiedEmail, Converter={StaticResource BoolToVis}}" />
                        <Button x:Name="EmailAddressActionButton" Content="{Binding EmailAddressActionText}" Style="{StaticResource SecondaryButtonStyle}" Click="ToggleEmailEditor_Click" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="EmailAddressEditor" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBox x:Name="EmailAddressInput" Width="280" PlaceholderText="name@example.com" loc:Localized.Placeholder="web.settings.notifications.email.addressPlaceholder" Text="{Binding EmailAddressInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="EmailAddressInput_KeyDown" />
                    <Button Content="Send verification" loc:Localized.Content="web.settings.notifications.email.requestVerification" Style="{StaticResource AccentButtonStyle}" Click="SetEmail_Click" />
                </StackPanel>
                <TextBlock Text="{Binding EmailPendingText}" Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap"
                           Visibility="{Binding HasPendingEmail, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="Child profiles can't receive email notifications." loc:Localized.Text="web.settings.notifications.email.childProfile" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding EmailPreferences.CanEditAddress, Converter={StaticResource InverseBoolToVis}}" />
                <Grid ColumnSpacing="16" Visibility="{Binding IsEmailEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Frequency" loc:Localized.Text="web.settings.notifications.frequency.label" />
                        <TextBlock Text="{Binding EmailDigestDescription}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="EmailModeCombo" Grid.Column="1" SelectionChanged="EmailModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Daily digest" loc:Localized.Content="web.settings.notifications.frequency.dailyDigest" Tag="daily_digest" />
                        <ComboBoxItem Content="Every episode" loc:Localized.Content="web.settings.notifications.frequency.perEpisode" Tag="per_episode" />
                        <ComboBoxItem Content="Every episode + daily digest" loc:Localized.Content="web.settings.notifications.frequency.perEpisodeAndDigest" Tag="per_episode_and_digest" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsGroupStyle}" Visibility="{Binding HasDiscord, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="14">
                <TextBlock Text="Discord Notifications" loc:Localized.Text="web.settings.notifications.discord.title" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Account-wide: the Silo bot sends direct messages covering every profile on this account. You must share a Discord server with the bot." loc:Localized.Text="web.settings.notifications.discord.description"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DiscordPrimaryNotice}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding DiscordPrimaryNoticeVisible, Converter={StaticResource BoolToVis}}" />
                <Grid ColumnSpacing="16" Visibility="{Binding DiscordPreferences.Linked, Converter={StaticResource InverseBoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Link your Discord account" loc:Localized.Text="web.settings.notifications.discord.link" FontWeight="SemiBold" />
                        <TextBlock Text="Authorize on Discord so the bot knows who to message" loc:Localized.Text="web.settings.notifications.discord.linkHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Link Discord" loc:Localized.Content="web.settings.notifications.discord.linkButton" Style="{StaticResource AccentButtonStyle}" Click="LinkDiscord_Click" IsEnabled="{Binding CanManageDiscord}" />
                </Grid>
                <StackPanel Spacing="14" Visibility="{Binding DiscordPreferences.Linked, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding DiscordPreferences.DiscordUsername}" FontWeight="SemiBold" />
                            <TextBlock Text="Notifications you'd see in the inbox, delivered as a DM" loc:Localized.Text="web.settings.notifications.discord.enableHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="DiscordEnabledToggle" IsOn="{Binding IsDiscordEnabled}" Toggled="DiscordEnabled_Toggled" IsEnabled="{Binding CanManageDiscord}" />
                            <Button Content="Unlink" loc:Localized.Content="web.settings.notifications.discord.unlink" Style="{StaticResource DestructiveButtonStyle}" Click="UnlinkDiscord_Click" IsEnabled="{Binding CanManageDiscord}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{Binding IsDiscordEnabled, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Frequency" loc:Localized.Text="web.settings.notifications.frequency.label" />
                            <TextBlock Text="{Binding DiscordDigestDescription}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="DiscordModeCombo" Grid.Column="1" SelectionChanged="DiscordModeCombo_SelectionChanged" IsEnabled="{Binding CanManageDiscord}">
                            <ComboBoxItem Content="Daily digest" loc:Localized.Content="web.settings.notifications.frequency.dailyDigest" Tag="daily_digest" />
                            <ComboBoxItem Content="Every episode" loc:Localized.Content="web.settings.notifications.frequency.perEpisode" Tag="per_episode" />
                            <ComboBoxItem Content="Every episode + daily digest" loc:Localized.Content="web.settings.notifications.frequency.perEpisodeAndDigest" Tag="per_episode_and_digest" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding DiscordPreferences.LinkFailure}" Foreground="#F59E0B" FontSize="12"
                               Visibility="{Binding DiscordPreferences.LinkFailure, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsGroupStyle}" Visibility="{Binding HasWebhooks, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="14">
                <TextBlock Text="Webhooks" loc:Localized.Text="web.settings.notifications.webhooks.title" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Send this profile's notifications to a webhook URL. Discord URLs render as native embeds; other URLs receive signed JSON." loc:Localized.Text="web.settings.notifications.webhooks.description"
                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="No webhooks yet." loc:Localized.Text="web.settings.notifications.webhooks.empty" Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="{Binding HasWebhookEntries, Converter={StaticResource InverseBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Webhooks}" Visibility="{Binding HasWebhookEntries, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationWebhook">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4">
                                <StackPanel Spacing="9">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind TypeLabel}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{x:Bind UrlHost}" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{x:Bind StateLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled}" Tag="{x:Bind}" Toggled="WebhookEnabled_Toggled" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind EnabledReasonsText}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{x:Bind DeliveryStatusText}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap"
                                               Visibility="{x:Bind DeliveryStatusText, Converter={StaticResource NullToVis}}" />
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Button Content="Test" loc:Localized.Content="web.settings.notifications.webhooks.test" Tag="{x:Bind Id}" Style="{StaticResource SecondaryButtonStyle}" Click="TestWebhook_Click" />
                                        <Button Content="Edit" loc:Localized.Content="web.settings.notifications.webhooks.edit" Tag="{x:Bind}" Style="{StaticResource SecondaryButtonStyle}" Click="EditWebhook_Click" />
                                        <Button Content="Rotate secret" loc:Localized.Content="web.settings.notifications.webhooks.rotateSecret" Tag="{x:Bind}" Style="{StaticResource SecondaryButtonStyle}" Click="RotateSecret_Click"
                                                Visibility="{x:Bind CanRotateSecret, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Delete" loc:Localized.Content="web.settings.notifications.webhooks.delete" Tag="{x:Bind}" Style="{StaticResource DestructiveButtonStyle}" Click="DeleteWebhook_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="＋  Add webhook" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanAddWebhook}" Click="AddWebhook_Click" />
                    <TextBlock Text="{Binding WebhookLimitText}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"
                               Visibility="{Binding IsWebhookLimitReached, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
