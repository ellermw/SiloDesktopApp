<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.AudiobookNowListening"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,16">
            <Button HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}"
                    Padding="12,6" Margin="-8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" Click="Collapse_Click"
                    AutomationProperties.Name="Back to player">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE70D;" FontSize="16" />
                    <TextBlock Text="Back to player" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" HorizontalAlignment="Right"
                    Style="{StaticResource SubtleButtonStyle}" Width="40" Height="40" Padding="0"
                    ToolTipService.ToolTip="Audiobook settings"
                    AutomationProperties.Name="Audiobook settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="ListeningLayout" Margin="64,8,64,40" HorizontalAlignment="Stretch"
                  VerticalAlignment="Center" ColumnSpacing="40" RowSpacing="40">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ListeningCover" Grid.Column="0" Width="360" Height="360" CornerRadius="16"
                        Background="{StaticResource CardBackgroundBrush}">
                    <Grid>
                        <FontIcon x:Name="CoverPlaceholder" Glyph="&#xE82D;" FontSize="72"
                                  Foreground="{StaticResource SecondaryTextBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="CoverArtwork" />
                        <Image x:Name="CoverImage" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel x:Name="ListeningInfo" Grid.Column="1" MaxWidth="576" HorizontalAlignment="Left" Spacing="32" VerticalAlignment="Center">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold" LineHeight="36" LineStackingStrategy="BlockLineHeight" CharacterSpacing="-25"
                                   TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock x:Name="AuthorText" FontSize="16" LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="NarratorText" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="ChapterPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="ChapterNumberText" FontSize="11" FontWeight="SemiBold" LineHeight="16.5" LineStackingStrategy="BlockLineHeight"
                                   CharacterSpacing="180" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="ChapterTitleText" FontSize="18" FontWeight="Medium" LineHeight="28" LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Height="44"
                                Margin="8,0" ValueChanged="SeekSlider_ValueChanged"
                                AutomationProperties.Name="Playback position" />
                        <Grid>
                            <TextBlock x:Name="CurrentTimeText" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button x:Name="RightTimeButton" HorizontalAlignment="Right"
                                    Style="{StaticResource SubtleButtonStyle}" Padding="0"
                                    FontSize="12" Click="RightTime_Click"
                                    ToolTipService.ToolTip="Toggle total, remaining, or remaining at current speed"
                                    AutomationProperties.Name="Toggle time display" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ListeningTransport" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button x:Name="PreviousChapterButton" Style="{StaticResource SubtleButtonStyle}" Width="40" Height="40" Padding="0"
                                Click="PreviousChapter_Click" ToolTipService.ToolTip="Previous chapter (P)"
                                AutomationProperties.Name="Previous chapter">
                            <FontIcon Glyph="&#xE892;" FontSize="17" />
                        </Button>
                        <Button x:Name="SkipBackButton" Style="{StaticResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF" Padding="0"
                                Click="SkipBack_Click" ToolTipService.ToolTip="Skip back">
                            <Grid><FontIcon Glyph="&#xE777;" FontSize="28"/><TextBlock x:Name="SkipBackText" Text="15" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Button>
                        <Button x:Name="PlayPauseButton" Width="80" Height="80" Padding="0" CornerRadius="40" BorderThickness="0"
                                Background="White" Click="PlayPause_Click"
                                ToolTipService.ToolTip="Pause (space)" AutomationProperties.Name="Pause">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="32" Foreground="#FF0C0C0C" />
                        </Button>
                        <Button x:Name="SkipForwardButton" Style="{StaticResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#1AFFFFFF" Padding="0"
                                Click="SkipForward_Click" ToolTipService.ToolTip="Skip forward">
                            <Grid><FontIcon Glyph="&#xE777;" FontSize="28" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1"/></FontIcon.RenderTransform></FontIcon><TextBlock x:Name="SkipForwardText" Text="30" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Button>
                        <Button x:Name="NextChapterButton" Style="{StaticResource SubtleButtonStyle}" Width="40" Height="40" Padding="0"
                                Click="NextChapter_Click" ToolTipService.ToolTip="Next chapter (N)"
                                AutomationProperties.Name="Next chapter">
                            <FontIcon Glyph="&#xE893;" FontSize="17" />
                        </Button>
                    </StackPanel>

                    <controls:WrapPanel x:Name="ListeningUtilities" HorizontalSpacing="24" VerticalSpacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MuteButton" Click="Mute_Click" Style="{StaticResource SubtleButtonStyle}" Width="36" Height="36" Padding="0"
                                ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="15" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100"
                                ValueChanged="VolumeSlider_ValueChanged" AutomationProperties.Name="Volume" />
                        </StackPanel>
                        <Button x:Name="SleepButton" Style="{StaticResource SubtleButtonStyle}" Height="40" Padding="8"
                                ToolTipService.ToolTip="Sleep timer" AutomationProperties.Name="Sleep timer">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="SleepTimerText" Text="Sleep" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChaptersButton" Style="{StaticResource SubtleButtonStyle}" Width="40" Height="40" Padding="8"
                                ToolTipService.ToolTip="Chapters" AutomationProperties.Name="Chapters">
                            <FontIcon Glyph="&#xE8A9;" FontSize="15" />
                        </Button>
                        <Button x:Name="SpeedButton" Style="{StaticResource SubtleButtonStyle}"
                                Width="52" Height="40" Padding="9,7" Content="1×" FontSize="13"
                                ToolTipService.ToolTip="Playback speed" AutomationProperties.Name="Playback speed" />
                    </controls:WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
