<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.ServerActivityButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ServerActivity.tsx uses a two-second opacity pulse while activity
             exists. Keep the animation on the badge only so the trigger stays
             visually stable and its hit target never moves. -->
        <Storyboard x:Name="CountBadgePulse" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CountBadge"
                Storyboard.TargetProperty="Opacity"
                Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0.62">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Width="44" Height="44">
        <Button
            x:Name="RootButton"
            Background="Transparent"
            BorderThickness="0"
            Width="36"
            Height="36"
            Padding="0"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Click="RootButton_Click"
            AutomationProperties.Name="Server activity"
            ToolTipService.ToolTip="Server Activity">
            <Grid Width="36" Height="36">
            <!-- Lucide Activity: the WebUI uses the pulse line, not a heart or
                 a platform font glyph whose shape varies by Windows version. -->
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="ActivityIcon"
                              Data="M 22,12 L 18,12 L 15,21 L 9,3 L 6,12 L 2,12"
                              Stroke="{StaticResource SecondaryTextBrush}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent" />
                    </Canvas>
                </Viewbox>
            </Grid>
            <Button.Flyout>
                <Flyout x:Name="ActivityFlyout" Placement="BottomEdgeAlignedRight">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="320" />
                            <Setter Property="MaxWidth" Value="360" />
                            <Setter Property="CornerRadius" Value="16" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <!-- Current WebUI caps the activity body at 400px and scrolls
                         it. Without this bound a large accepted-scan queue can
                         grow the flyout to nearly the full window height. -->
                    <ScrollViewer
                        Width="320"
                        MaxHeight="400"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PopoverRoot" Width="320" />
                    </ScrollViewer>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Border
            x:Name="CountBadge"
            Background="#EF4444"
            CornerRadius="9"
            Height="18"
            MinWidth="18"
            Padding="4,0,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,2,2,0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="CountBadgeText"
                Text="0"
                FontSize="10"
                FontWeight="Bold"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LineHeight="12" />
        </Border>
        <!-- WebUI connection-problem marker: red, ringed, and distinct
             from the active-count badge. -->
        <Border
            x:Name="DisconnectedDot"
            Width="10"
            Height="10"
            CornerRadius="5"
            Background="#EF4444"
            BorderBrush="{StaticResource AppBackgroundBrush}"
            BorderThickness="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,2,2"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
