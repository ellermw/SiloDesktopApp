<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.SubtitleAppearanceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    CloseButtonText="Done"
    DefaultButton="Close"
    Background="#F1111114"
    Foreground="White">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="PanelSectionLabel" Color="#73FFFFFF" />
        <SolidColorBrush x:Key="PanelRowLabel" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="PanelDivider" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="PanelFooterText" Color="#66FFFFFF" />
    </ContentDialog.Resources>

    <Grid Width="620" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Preview -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable body -->
            <RowDefinition Height="Auto" />
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,16">
            <TextBlock
                Text="CAPTIONS"
                FontSize="10"
                FontWeight="SemiBold"
                CharacterSpacing="220"
                Foreground="{StaticResource PanelSectionLabel}" />
            <TextBlock
                Text="Subtitle appearance"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="White" />
        </StackPanel>

        <!-- Live preview (faux video gradient + centered stacked cue lines) -->
        <Border
            Grid.Row="1"
            Height="112"
            CornerRadius="8"
            Margin="0,0,0,20"
            BorderBrush="#10FFFFFF"
            BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1F2937" Offset="0.0" />
                    <GradientStop Color="#0B0F1A" Offset="0.6" />
                    <GradientStop Color="#1E293B" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel
                x:Name="PreviewStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,14"
                Spacing="4">
                <Border x:Name="PreviewBg1" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="PreviewLine1" Text="The quick brown fox"
                               HorizontalAlignment="Center" />
                </Border>
                <Border x:Name="PreviewBg2" CornerRadius="4" Padding="12,4">
                    <TextBlock x:Name="PreviewLine2" Text="jumps over the lazy dog."
                               HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Scrollable body — Text / Background / Position -->
        <ScrollViewer
            Grid.Row="2"
            MaxHeight="380"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="22" Padding="0,0,4,0">

                <!-- Text section -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="TEXT"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        CharacterSpacing="200"
                        Foreground="{StaticResource PanelSectionLabel}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Size" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="SizePillsHost" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="FontPillsHost" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Color" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="FontColorSwatchHost" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outline" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <ToggleSwitch x:Name="OutlineToggle" Grid.Column="1" OnContent="" OffContent=""
                                      Toggled="OutlineToggle_Toggled" />
                    </Grid>

                    <Grid x:Name="OutlineColorRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outline color" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="OutlineColorSwatchHost" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{StaticResource PanelDivider}" />

                <!-- Background section -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="BACKGROUND"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        CharacterSpacing="200"
                        Foreground="{StaticResource PanelSectionLabel}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Style" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="BgStylePillsHost" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Box-only rows: Opacity + Color -->
                    <Grid x:Name="BgOpacityRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Opacity" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <Grid Grid.Column="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OpacitySlider" Grid.Column="0"
                                    Minimum="0" Maximum="100" StepFrequency="5"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="OpacityValueLabel" Grid.Column="1"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#99FFFFFF" MinWidth="40"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="BgColorRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Color" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="BgColorSwatchHost" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{StaticResource PanelDivider}" />

                <!-- Position section -->
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="POSITION"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        CharacterSpacing="200"
                        Foreground="{StaticResource PanelSectionLabel}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vertical" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource PanelRowLabel}" />
                        <StackPanel Grid.Column="1" x:Name="PositionPillsHost" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: Reset button left, "saved auto" label right -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ResetButton" Grid.Column="0" Click="Reset_Click"
                    Background="Transparent" BorderThickness="0"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#B3FFFFFF" />
                    <TextBlock Text="Reset to defaults" FontSize="13" Foreground="#B3FFFFFF" />
                </StackPanel>
            </Button>
            <TextBlock Grid.Column="1"
                       Text="CHANGES SAVED AUTOMATICALLY"
                       FontSize="10"
                       CharacterSpacing="200"
                       Foreground="{StaticResource PanelFooterText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</ContentDialog>
