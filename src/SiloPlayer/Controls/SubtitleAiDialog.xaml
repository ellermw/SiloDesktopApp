<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.SubtitleAiDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    Background="#FF171717"
    Foreground="White">

    <Grid MinWidth="320" MaxWidth="440" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="DialogTitleText"
                Grid.Column="0"
                Text="Translate subtitles with AI"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="Close"
                ToolTipService.ToolTip="Close"
                Click="Close_Click">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#99FFFFFF" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="12">
            <Border
                x:Name="ModeTabs"
                Padding="4"
                CornerRadius="5"
                Background="#FF262626">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="SubtitleModeButton"
                        Grid.Column="0"
                        Content="From subtitles"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="8,6"
                        BorderThickness="0"
                        CornerRadius="4"
                        Click="SubtitleMode_Click" />
                    <Button
                        x:Name="AudioModeButton"
                        Grid.Column="1"
                        Content="From audio"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="8,6"
                        BorderThickness="0"
                        CornerRadius="4"
                        Click="AudioMode_Click" />
                </Grid>
            </Border>

            <StackPanel Spacing="5">
                <TextBlock
                    x:Name="SourceLabel"
                    Text="Translate from"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#99FFFFFF" />
                <ComboBox
                    x:Name="SourceComboBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Subtitle source" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock
                    x:Name="TargetLabel"
                    Text="Translate to"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#99FFFFFF" />
                <ComboBox
                    x:Name="TargetLanguageComboBox"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Target subtitle language" />
            </StackPanel>

            <TextBlock
                x:Name="QuotaText"
                Visibility="Collapsed"
                FontSize="11"
                TextWrapping="Wrap"
                Foreground="#5AFFFFFF" />

            <Border
                x:Name="ErrorPanel"
                Visibility="Collapsed"
                Padding="12,9"
                CornerRadius="5"
                Background="#663F0B0B">
                <TextBlock
                    x:Name="ErrorText"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="#FFFCA5A5" />
            </Border>

            <Grid ColumnSpacing="8" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressRing
                    x:Name="SubmitProgress"
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    Padding="14,7"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Close_Click" />
                <Button
                    x:Name="SubmitButton"
                    Grid.Column="2"
                    Content="Translate"
                    Padding="14,7"
                    Click="Submit_Click" />
            </Grid>

            <TextBlock
                x:Name="HelpText"
                FontSize="11"
                TextWrapping="Wrap"
                Foreground="#5AFFFFFF" />
        </StackPanel>
    </Grid>
</ContentDialog>
