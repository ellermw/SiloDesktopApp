<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.AddToCollectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add to Collection"
    PrimaryButtonText="Add"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Background="{StaticResource CardBackgroundBrush}">

    <Grid Width="480" MaxHeight="520" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="DescriptionText"
            Grid.Row="0"
            FontSize="13"
            Foreground="{StaticResource SecondaryTextBrush}"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="1"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            CornerRadius="6">
            <Grid MinHeight="180" MaxHeight="320">
                <ProgressRing
                    x:Name="LoadingRing"
                    Width="24"
                    Height="24"
                    IsActive="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <StackPanel
                    x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
                    <TextBlock
                        Text="Loading collections…"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Margin="0,38,0,0" />
                </StackPanel>
                <TextBlock
                    x:Name="EmptyText"
                    Margin="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="You don't have any manual collections yet. Create one in Collections first."
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <ScrollViewer
                    x:Name="CollectionsScroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    Visibility="Collapsed">
                    <StackPanel x:Name="GroupsPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            FontSize="12"
            Foreground="#FFFCA5A5"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
