<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.SectionRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:models="using:SiloPlayer.Core.Models.Home"
    mc:Ignorable="d"
    SizeChanged="SectionRow_SizeChanged">

    <UserControl.Resources>
        <!-- B44: Poster vs landscape cards live in DataTemplate resources and
             get swapped onto the single ItemsRepeater at runtime based on the
             section type. Removes the duplicate ScrollViewer that shipped before. -->
        <DataTemplate x:Key="PosterCardTemplate" x:DataType="models:MediaItem">
            <controls:PosterCard MediaItem="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="LandscapeCardTemplate" x:DataType="models:MediaItem">
            <controls:LandscapeCard MediaItem="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="ContinuePosterCardTemplate" x:DataType="models:MediaItem">
            <controls:LandscapeCard MediaItem="{x:Bind}" UsePosterAspect="True" />
        </DataTemplate>
        <DataTemplate x:Key="AudiobookCardTemplate" x:DataType="models:MediaItem">
            <controls:AudiobookSquareCard MediaItem="{x:Bind}" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- Web: space-y-3 (12px) between title and cards, px-4 lg:px-12 (48px side padding) -->
    <Grid
        x:Name="RootGrid"
        Margin="0,0,0,40"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current WebUI: 20px semibold title, optional pin directly beside it,
             and 20px of space before the carousel. -->
        <Grid x:Name="SectionHeader" Grid.Row="0" Margin="48,0,48,20">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="SectionTitle"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="TitleLinkBtn"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Visibility="Collapsed"
                    Click="TitleLink_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleLinkTitle"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}" />
                        <TextBlock
                            Text="View"
                            FontSize="14"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,1" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PinSectionBtn"
                    Style="{StaticResource GhostButtonStyle}"
                    Width="28" Height="28"
                    Padding="0"
                    Opacity="0"
                    Visibility="Collapsed"
                    Click="PinSection_Click">
                    <FontIcon x:Name="PinSectionIcon" Glyph="&#xE840;" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
                </Button>
            </StackPanel>
            <Button
                x:Name="ExploreAllBtn"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Visibility="Collapsed"
                Click="ExploreAll_Click">
                <TextBlock
                    Text="EXPLORE ALL"
                    FontSize="12"
                    FontWeight="SemiBold"
                    CharacterSpacing="160"
                    Foreground="{StaticResource SecondaryTextBrush}" />
            </Button>
        </Grid>

        <!-- B44: Single ScrollViewer + ItemsRepeater hosts both poster and
             landscape layouts. The ItemTemplate swaps based on section type. -->
        <!-- HorizontalScrollMode=Disabled prevents the mouse wheel from
             being captured by this horizontal ScrollViewer when the user is
             scrolling the page vertically. Horizontal movement is handled
             exclusively by the arrow buttons (hover-reveal). ChangeView
             still works programmatically with scroll mode disabled. -->
        <Grid Grid.Row="1">
            <ScrollViewer
                x:Name="CardsScrollViewer"
                IsTabStop="True"
                TabFocusNavigation="Local"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollMode="Disabled"
                ViewChanged="CardsScrollViewer_ViewChanged"
                SizeChanged="CardsScrollViewer_SizeChanged"
                KeyDown="CardsScrollViewer_KeyDown"
                PointerPressed="CardsScrollViewer_PointerPressed"
                PointerMoved="CardsScrollViewer_PointerMoved"
                PointerReleased="CardsScrollViewer_PointerReleased"
                PointerCanceled="CardsScrollViewer_PointerCanceled"
                PointerCaptureLost="CardsScrollViewer_PointerCaptureLost">

                <ItemsRepeater
                    x:Name="CardsRepeater"
                    Margin="48,0,48,0"
                    ElementPrepared="CardsRepeater_ElementPrepared">
                    <ItemsRepeater.Layout>
                        <StackLayout x:Name="CardsLayout" Orientation="Horizontal" Spacing="16" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Edge fade gradients hinting at more content. Alpha-only fade
                 (same RGB as AppBackgroundColor with alpha=0 on the
                 transparent end) — avoids the semi-transparent gray midpoint
                 that WinUI's "Transparent" keyword (#00FFFFFF) would produce
                 when interpolating against a dark color. Opacity driven from
                 code-behind in lock-step with ScrollLeftBtn/RightBtn. -->
            <Border
                x:Name="LeftFadeGradient"
                HorizontalAlignment="Left"
                Width="40"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop x:Name="LeftFadeSolid" Color="#FF101722" Offset="0.0" />
                        <GradientStop x:Name="LeftFadeClear" Color="#00101722" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border
                x:Name="RightFadeGradient"
                HorizontalAlignment="Right"
                Width="40"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                        <GradientStop x:Name="RightFadeSolid" Color="#FF101722" Offset="0.0" />
                        <GradientStop x:Name="RightFadeClear" Color="#00101722" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Current WebUI overlays carousel arrows at the left/right edges;
                 they are not part of the header action row. -->
            <Grid x:Name="ArrowsPanel" Opacity="0" IsHitTestVisible="False">
                <Button
                    x:Name="ScrollLeftBtn"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0"
                    Width="44"
                    Padding="0"
                    CornerRadius="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="ScrollLeft_Click">
                    <FontIcon Glyph="&#xE76B;" FontSize="24" Foreground="{StaticResource PrimaryTextBrush}" />
                </Button>
                <Button
                    x:Name="ScrollRightBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0"
                    Width="44"
                    Padding="0"
                    CornerRadius="0"
                    Background="Transparent"
                    BorderThickness="0"
                    IsEnabled="False"
                    Click="ScrollRight_Click">
                    <FontIcon Glyph="&#xE76C;" FontSize="24" Foreground="{StaticResource PrimaryTextBrush}" />
                </Button>
            </Grid>
        </Grid>

        <!-- F6: skeleton row shown when Items is empty during the F12
             per-section fetch. Replaced with the real ItemsRepeater content
             as soon as items arrive. -->
        <StackPanel
            x:Name="SkeletonPanel"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="16"
            Margin="48,0,48,0"
            Visibility="Collapsed" />

        <Border
            x:Name="ErrorPanel"
            Grid.Row="1"
            Margin="48,0,48,0"
            Padding="20,16"
            CornerRadius="22"
            Background="{StaticResource SurfaceBrush}"
            Visibility="Collapsed">
            <Grid>
                <TextBlock Text="This section could not be loaded right now." FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <Button Content="Retry" HorizontalAlignment="Right" Click="RetrySection_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
