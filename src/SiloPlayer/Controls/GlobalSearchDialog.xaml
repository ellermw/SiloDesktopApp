<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.GlobalSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    mc:Ignorable="d"
    Title=""
    CloseButtonText=""
    PrimaryButtonText=""
    SecondaryButtonText="">

    <ContentDialog.Resources>
        <!-- Native editing, selection and accessibility stay with TextBox;
             the palette input has no Fluent fill, underline or clear button. -->
        <ControlTemplate x:Key="QuickSearchInputTemplate" TargetType="TextBox">
            <Grid Background="{TemplateBinding Background}">
                <ScrollViewer x:Name="ContentElement"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                              IsHorizontalRailEnabled="False" IsVerticalRailEnabled="False"
                              IsTabStop="False" ZoomMode="Disabled"
                              automation:AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="PlaceholderTextContentPresenter"
                           Text="{TemplateBinding PlaceholderText}"
                           Padding="{TemplateBinding Padding}"
                           Foreground="{StaticResource TertiaryTextBrush}"
                           FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                           TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Center"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="SearchSurface" Width="464" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search input row -->
        <Grid x:Name="SearchInputRow" Grid.Row="0" ColumnSpacing="8" Padding="20,0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="16"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      VerticalAlignment="Center" />
            <TextBox
                Grid.Column="1"
                x:Name="SearchBox"
                PlaceholderText="Search library..."
                BorderThickness="0"
                Background="Transparent"
                FontSize="14" Height="48" MinHeight="0" Padding="0,14,0,14" VerticalContentAlignment="Center"
                Template="{StaticResource QuickSearchInputTemplate}"
                TextChanged="SearchBox_TextChanged" />
            <Border x:Name="EscapeHint" Grid.Column="2" CornerRadius="4"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    Background="{StaticResource SurfaceBrush}" Padding="6,2"
                    VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                <TextBlock Text="ESC" FontFamily="Consolas" FontSize="10" FontWeight="Medium"
                           LineHeight="15" LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
            <StackPanel x:Name="SeeAllHint" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                        IsHitTestVisible="False">
                <Border CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                        Background="{StaticResource SurfaceBrush}" Padding="6,2">
                    <TextBlock Text="↵" FontFamily="Consolas" FontSize="10" FontWeight="Medium"
                               LineHeight="13.3333333333" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
                <TextBlock Text="See all" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1" x:Name="ResultsDivider" Height="1"
                Background="{StaticResource BorderBrush}" Visibility="Collapsed" />

        <!-- Results panel -->
        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ResultsScroll"
                MaxHeight="352"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel Padding="8">
            <Grid x:Name="LoadingPanel" Padding="12,24" Visibility="Collapsed">
                <TextBlock Text="Searching..." FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                           TextAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>

            <!-- Empty -->
            <TextBlock x:Name="EmptyText"
                       Text="No matches"
                       FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Padding="12,24"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="Collapsed" />
                    <StackPanel x:Name="ResultsPanel" Spacing="0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" x:Name="SearchFooter" Visibility="Collapsed"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel x:Name="SearchFooterHints" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</ContentDialog>
