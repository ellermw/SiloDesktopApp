<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.GlobalSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    mc:Ignorable="d"
    Title=""
    CloseButtonText=""
    PrimaryButtonText=""
    SecondaryButtonText="">

    <ContentDialog.Resources>
        <!-- Native editing, selection and accessibility stay with TextBox;
             the palette input has no Fluent fill, underline or clear button. -->
        <ControlTemplate x:Key="QuickSearchInputTemplate" TargetType="TextBox">
            <Grid Background="{TemplateBinding Background}">
                <ScrollViewer x:Name="ContentElement"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                              IsHorizontalRailEnabled="False" IsVerticalRailEnabled="False"
                              IsTabStop="False" ZoomMode="Disabled"
                              automation:AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="PlaceholderTextContentPresenter"
                           Text="{TemplateBinding PlaceholderText}"
                           Padding="{TemplateBinding Padding}"
                           Foreground="{StaticResource TertiaryTextBrush}"
                           FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                           TextWrapping="NoWrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Center"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           IsHitTestVisible="False" />
            </Grid>
        </ControlTemplate>
    </ContentDialog.Resources>

    <Grid x:Name="SearchSurface" Width="464" MinHeight="72" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search input row -->
        <Grid Grid.Row="0" ColumnSpacing="8" Padding="20,0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="16"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      VerticalAlignment="Center" />
            <TextBox
                Grid.Column="1"
                x:Name="SearchBox"
                PlaceholderText="Search library..."
                BorderThickness="0"
                Background="Transparent"
                FontSize="14" Height="48" MinHeight="0" Padding="0,14,0,14" VerticalContentAlignment="Center"
                Template="{StaticResource QuickSearchInputTemplate}"
                TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="EscapeHint" Grid.Column="2"
                       Text="ESC"
                       FontSize="11"
                       Foreground="{StaticResource TertiaryTextBrush}"
                       CharacterSpacing="120"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1" x:Name="ResultsDivider" Height="1"
                Background="{StaticResource BorderBrush}" Visibility="Collapsed" />

        <!-- Results panel -->
        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ResultsScroll"
                MaxHeight="352"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel" Spacing="0" Padding="8" />
            </ScrollViewer>

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,20,0,20" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18" />
                <TextBlock Text="Searching..." FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Empty -->
            <TextBlock x:Name="EmptyText"
                       Text="No matches"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Padding="0,20,0,20"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="3" x:Name="SearchFooter" Visibility="Collapsed"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock x:Name="SearchFooterText"
                       Text="Press Enter to open the full search page."
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</ContentDialog>
