<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.GlobalSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    CloseButtonText=""
    PrimaryButtonText=""
    SecondaryButtonText="">

    <Grid Width="520" MinHeight="72" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search input row -->
        <Grid Grid.Row="0" ColumnSpacing="10" Padding="6,6,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15"
                      Foreground="{StaticResource SecondaryTextBrush}"
                      VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBox
                Grid.Column="1"
                x:Name="SearchBox"
                PlaceholderText="Search movies, series…"
                BorderThickness="0"
                Background="Transparent"
                FontSize="15"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown" />
            <TextBlock Grid.Column="2"
                       Text="Esc"
                       FontSize="11"
                       Foreground="{StaticResource TertiaryTextBrush}"
                       CharacterSpacing="120"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
        </Grid>

        <!-- Divider -->
        <Border Grid.Row="1" x:Name="ResultsDivider" Height="1"
                Background="{StaticResource BorderBrush}" Visibility="Collapsed" />

        <!-- Results panel -->
        <Grid Grid.Row="2">
            <ScrollViewer
                x:Name="ResultsScroll"
                MaxHeight="420"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel x:Name="ResultsPanel" Spacing="2" Padding="6" />
            </ScrollViewer>

            <!-- Loading -->
            <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="0,20,0,20" Visibility="Collapsed">
                <ProgressRing IsActive="True" Width="18" Height="18" />
                <TextBlock Text="Searching…" FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Empty -->
            <TextBlock x:Name="EmptyText"
                       Text="No results found."
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Padding="0,20,0,20"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</ContentDialog>
