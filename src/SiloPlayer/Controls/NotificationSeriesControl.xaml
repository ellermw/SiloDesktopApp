<UserControl x:Class="SiloPlayer.Controls.NotificationSeriesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:SiloPlayer.Services" SizeChanged="Control_SizeChanged">
    <StackPanel Spacing="12">
        <Grid x:Name="Toolbar" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search series" loc:Localized.Placeholder="web.notifications.series.search" AutomationProperties.Name="Search series" loc:Localized.Name="web.notifications.series.search" TextChanged="Search_Changed" MaxLength="200" MinHeight="40" />
            <ComboBox x:Name="SortCombo" Grid.Column="1" AutomationProperties.Name="Sort" loc:Localized.Name="web.notifications.series.sort" SelectionChanged="Options_Changed" MinWidth="190" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Title (A–Z)" loc:Localized.Content="web.notifications.series.sortTitleAsc" Tag="title" />
                <ComboBoxItem Content="Title (Z–A)" loc:Localized.Content="web.notifications.series.sortTitleDesc" Tag="-title" />
                <ComboBoxItem Content="Latest episode" loc:Localized.Content="web.notifications.series.sortLatestEpisode" Tag="-latest_episode_added" />
                <ComboBoxItem Content="Recently added" loc:Localized.Content="web.notifications.series.sortRecentlyAdded" Tag="-added_at" />
                <ComboBoxItem Content="Release year" loc:Localized.Content="web.notifications.series.sortReleaseYear" Tag="-year" />
            </ComboBox>
        </Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel x:Name="FilterTabs" Orientation="Horizontal" Spacing="4" AutomationProperties.Name="Filter by reason" loc:Localized.Name="web.notifications.series.filterByReason">
                <Button Content="All" loc:Localized.Content="web.notifications.inbox.filterAll" Tag="all" Click="Filter_Click" />
                <Button Content="Next Up" loc:Localized.Content="web.notifications.preferences.nextUp" Tag="next_up" Click="Filter_Click" />
                <Button Content="Favorites" loc:Localized.Content="web.notifications.preferences.favorites" Tag="favorite" Click="Filter_Click" />
                <Button Content="Watchlist" loc:Localized.Content="web.notifications.preferences.watchlist" Tag="watchlist" Click="Filter_Click" />
                <Button Content="Continue Watching" loc:Localized.Content="web.notifications.preferences.continueWatching" Tag="continue_watching" Click="Filter_Click" />
                <Button x:Name="MutedFilter" Content="Muted" loc:Localized.Content="web.notifications.series.muted" Tag="muted" Click="Filter_Click" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="TableHeader" ColumnSpacing="12" Padding="12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="208" /><ColumnDefinition Width="210" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectShown" IsThreeState="True" MinWidth="0" MinHeight="32" Click="SelectShown_Click" AutomationProperties.Name="Select all shown series" loc:Localized.Name="web.notifications.series.selectShown" />
            <TextBlock Grid.Column="1" Text="Series" loc:Localized.Text="web.notifications.series.columnSeries" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock x:Name="NotifiesHeader" Grid.Column="2" Text="Notifies for" loc:Localized.Text="web.notifications.series.columnNotifiesFor" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock x:Name="ReasonsHeader" Grid.Column="3" Text="Why" loc:Localized.Text="web.notifications.series.columnReasons" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock x:Name="NotifyHeader" Grid.Column="4" Text="Notify" loc:Localized.Text="web.notifications.series.columnNotify" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </Grid>
        <ProgressRing x:Name="SeriesBusy" Width="28" Height="28" HorizontalAlignment="Center" Visibility="Collapsed" />
        <StackPanel x:Name="SeriesErrorPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="SeriesError" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="SeriesRetry" Content="Retry" loc:Localized.Content="common.retry" HorizontalAlignment="Left" Click="Retry_Click" Style="{StaticResource OutlineButtonStyle}" />
        </StackPanel>
        <TextBlock x:Name="MutationErrorText" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        <StackPanel x:Name="SeriesRows" Spacing="0" />
        <StackPanel x:Name="SeriesEmpty" Spacing="12" Margin="0,64" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="SeriesEmptyTitle" Text="No series notify you yet" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="SeriesEmptyCaption" Text="Series you favorite, add to your watchlist, or start watching show up here." loc:Localized.Text="web.notifications.series.emptyHint" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="384" />
        </StackPanel>
        <Button x:Name="SeriesLoadMore" Content="Load more" loc:Localized.Content="web.notifications.inbox.loadMore" HorizontalAlignment="Center" Click="More_Click" Style="{StaticResource OutlineButtonStyle}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
