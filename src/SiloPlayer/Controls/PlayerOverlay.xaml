<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.PlayerOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    Background="Black"
    KeyDown="Overlay_KeyDown"
    PointerMoved="Overlay_PointerMoved"
    Tapped="Overlay_Tapped"
    IsTabStop="True">

    <UserControl.Resources>
        <!-- Cinema Glass disc styles — webui PlayerControls parity (commit 1adbcd1).
             Always live on a black video void, so tokens here are monochrome
             and independent of the app theme. -->

        <!-- Primary disc: glossy white play/pause button at cluster center. -->
        <Style x:Key="PlayerDiscPrimaryStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0A0A0B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Secondary disc: subtle glass for skip ± and prev/next episode. -->
        <Style x:Key="PlayerDiscSecondaryStyle" TargetType="Button">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#19FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#EBFFFFFF" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Utility button for bottom-rail icons (audio, subs, quality, info, PiP, fullscreen). -->
        <Style x:Key="PlayerUtilityBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#C7FFFFFF" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Black">
        <!-- Video is rendered by the mpv GPU popup window positioned over the
             XAML tree — this control hosts only the chrome overlays. -->

        <!-- Loading overlay — current WebUI keeps a solid black frame and
             exposes only the compact white spinner until first frame. -->
        <Grid x:Name="LoadingOverlay" Background="Black" Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="32" Height="32"
                          Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Mid-playback buffering spinner (transparent; 500ms debounce so
             quick cache recoveries don't flash chrome). -->
        <Grid x:Name="BufferingSpinner" Visibility="Collapsed"
              IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing IsActive="True" Width="40" Height="40" Foreground="White" />
        </Grid>

        <!-- Error overlay -->
        <Grid x:Name="ErrorOverlay" Background="#CC000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="500">
                <TextBlock x:Name="ErrorText" Foreground="#99FFFFFF" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <Button Content="Go Back" HorizontalAlignment="Center" Click="ClosePlayer_Click"
                        Foreground="White" Background="#1AFFFFFF" BorderThickness="0"
                        CornerRadius="4" Padding="16,8" />
            </StackPanel>
        </Grid>

        <!-- Skip Intro / Credits buttons (bottom right, above controls) -->
        <Button x:Name="SkipIntroButton" Content="Skip Intro" Visibility="Collapsed"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120"
            Padding="20,10" Style="{StaticResource AccentButtonStyle}" Click="SkipIntro_Click" />
        <Button x:Name="SkipCreditsButton" Content="Skip Credits" Visibility="Collapsed"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120"
            Padding="20,10" Style="{StaticResource AccentButtonStyle}" Click="SkipCredits_Click" />

        <!-- Current WebUI PlaybackInfoOverlay: grouped label/value rows in a
             compact, scrollable black glass panel. -->
        <Border x:Name="StatsOverlay" Visibility="Collapsed" Background="#D9000000"
                CornerRadius="8" Width="320" MaxHeight="620"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,48,0,0"
                Canvas.ZIndex="50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10,10,6">
                    <TextBlock Text="Playback Info" Foreground="#E6FFFFFF" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0" Click="StatsClose_Click"
                            ToolTipService.ToolTip="Close playback info"
                            AutomationProperties.Name="Close playback info">
                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#B3FFFFFF" />
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatsSectionsPanel" Padding="16,0,16,12" Spacing="12" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Top-right window chrome (minimize / close) — desktop-only since
             webui has no window-management buttons in the player. -->
        <StackPanel Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,16,16,0">
            <Button Style="{StaticResource PlayerUtilityBtnStyle}" Click="Minimize_Click"
                    ToolTipService.ToolTip="Minimize to mini bar"
                    AutomationProperties.Name="Minimize to mini bar">
                <FontIcon Glyph="&#xE921;" FontSize="13" />
            </Button>
            <Button Style="{StaticResource PlayerUtilityBtnStyle}" Click="ClosePlayer_Click"
                    ToolTipService.ToolTip="Close player"
                    AutomationProperties.Name="Close player">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
            </Button>
        </StackPanel>

        <!-- Bottom HUD (3-column: title/time left · centered cluster · utility rail right) -->
        <Grid x:Name="ControlsOverlay" VerticalAlignment="Bottom">
            <Grid.Background>
                <!-- "player-hud" gradient — strong at the bottom, fades at top. -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.0" />
                    <GradientStop Color="#8F000000" Offset="0.55" />
                    <GradientStop Color="#D1000000" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel Padding="24,40,24,20" Spacing="10">

                <!-- Multi-layer seek bar (background + buffered + progress +
                     intro/credits regions + chapter markers). Replaces the
                     WinUI Slider to match webui SeekBar.tsx visuals. -->
                <local:CustomSeekBar x:Name="SeekBar" />

                <!-- 3-column row: title cluster · playback cluster · utility rail -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: title + subtitle label + timecode -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="1" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="SubtitleLabelText"
                                       FontSize="10" CharacterSpacing="220"
                                       Foreground="#8CFFFFFF"
                                       Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"
                                       MaxWidth="400" />
                            <TextBlock x:Name="SubtitleDotSep" Text="·"
                                       Foreground="#40FFFFFF" FontSize="11"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="PositionText" Text="0:00"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#C0FFFFFF" CharacterSpacing="120" />
                            <TextBlock Text="/" Foreground="#40FFFFFF" FontSize="11" />
                            <TextBlock x:Name="DurationText" Text="0:00"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#C0FFFFFF" CharacterSpacing="120" />
                        </StackPanel>
                    </StackPanel>

                    <!-- CENTER: circle-button playback cluster -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Prev episode slot (visible only in series context) -->
                        <Button x:Name="PrevEpisodeButton"
                                Style="{StaticResource PlayerDiscSecondaryStyle}"
                                ToolTipService.ToolTip="Previous episode"
                                AutomationProperties.Name="Previous episode"
                                Click="PrevEpisode_Click"
                                Visibility="Collapsed">
                            <FontIcon Glyph="&#xE100;" FontSize="14" />
                        </Button>
                        <Border x:Name="PrevEpisodeSpacer"
                                Width="44" Height="44"
                                Background="Transparent"
                                Visibility="Collapsed" />

                        <!-- Back 10s — curved arrow + "10" overlay -->
                        <Button Style="{StaticResource PlayerDiscSecondaryStyle}"
                                Click="SkipBack_Click"
                                ToolTipService.ToolTip="Back 10s (←)"
                                AutomationProperties.Name="Back 10 seconds">
                            <Grid Width="28" Height="28">
                                <FontIcon Glyph="&#xE72C;" FontSize="26" Foreground="#EBFFFFFF" />
                                <TextBlock Text="10"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="#EBFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1,0,0" />
                            </Grid>
                        </Button>

                        <!-- Primary play/pause disc -->
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource PlayerDiscPrimaryStyle}"
                                Click="PlayPause_Click"
                                ToolTipService.ToolTip="Pause"
                                AutomationProperties.Name="Pause">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="24" Foreground="#0A0A0B" />
                        </Button>

                        <!-- Forward 30s — mirrored curved arrow + "30" overlay -->
                        <Button Style="{StaticResource PlayerDiscSecondaryStyle}"
                                Click="SkipForward_Click"
                                ToolTipService.ToolTip="Forward 30s (→)"
                                AutomationProperties.Name="Forward 30 seconds">
                            <Grid Width="28" Height="28">
                                <FontIcon Glyph="&#xE72C;" FontSize="26" Foreground="#EBFFFFFF"
                                          RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <TextBlock Text="30"
                                           FontSize="8.5" FontWeight="SemiBold"
                                           Foreground="#EBFFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,1,0,0" />
                            </Grid>
                        </Button>

                        <Border x:Name="NextEpisodeSpacer"
                                Width="44" Height="44"
                                Background="Transparent"
                                Visibility="Collapsed" />
                        <Button x:Name="NextEpisodeButton"
                                Style="{StaticResource PlayerDiscSecondaryStyle}"
                                Click="NextEpisode_Click"
                                ToolTipService.ToolTip="Next episode"
                                AutomationProperties.Name="Next episode"
                                Visibility="Collapsed">
                            <FontIcon Glyph="&#xE101;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <!-- RIGHT: utility rail -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Volume -->
                        <Button x:Name="VolumeButton" Style="{StaticResource PlayerUtilityBtnStyle}" Click="Mute_Click"
                                ToolTipService.ToolTip="Mute" AutomationProperties.Name="Mute">
                            <FontIcon x:Name="VolumeIcon" Glyph="&#xE767;" FontSize="14" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="100"
                                VerticalAlignment="Center" Margin="2,0,4,0"
                                AutomationProperties.Name="Volume"
                                ValueChanged="VolumeSlider_ValueChanged" />

                        <!-- Divider (vertical thin line, fades at top/bottom) -->
                        <Border Width="1" Height="20" VerticalAlignment="Center" Margin="4,0,4,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0.0" />
                                    <GradientStop Color="#24FFFFFF" Offset="0.2" />
                                    <GradientStop Color="#24FFFFFF" Offset="0.8" />
                                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Audio -->
                        <Button x:Name="AudioButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Audio" AutomationProperties.Name="Audio">
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout x:Name="AudioFlyout" Placement="Top" Opening="AudioFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="280" MaxWidth="360">
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="AudioListPanel" />
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Chapters (hidden if no chapters; populated in code-behind) -->
                        <Button x:Name="ChaptersButton" Style="{StaticResource PlayerUtilityBtnStyle}" Visibility="Collapsed"
                                ToolTipService.ToolTip="Chapters" AutomationProperties.Name="Chapters">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout x:Name="ChaptersFlyout" Placement="Top" Opening="ChaptersFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="280" MaxWidth="360">
                                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="ChaptersListPanel" Spacing="2" />
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Subtitles -->
                        <Button x:Name="SubtitleButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Enable captions"
                                AutomationProperties.Name="Enable captions">
                            <FontIcon Glyph="&#xED1E;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout x:Name="SubtitleFlyout" Placement="Top" Opening="SubtitleFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="300" MaxWidth="380">
                                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="SubtitleListPanel" />
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Quality -->
                        <Button x:Name="QualityButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Quality" AutomationProperties.Name="Quality">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                                <TextBlock x:Name="QualityButtonText" Text="Quality" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="QualityFlyout" Placement="Top" Opening="QualityFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="220" MaxWidth="340">
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="QualityListPanel" />
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Playback speed -->
                        <Button x:Name="SpeedButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Playback speed" AutomationProperties.Name="Playback speed">
                            <TextBlock x:Name="SpeedButtonText" Text="1×" FontSize="12" />
                            <Button.Flyout>
                                <Flyout x:Name="SpeedFlyout" Placement="Top" Opening="SpeedFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="100">
                                        <StackPanel x:Name="SpeedListPanel" />
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Sleep timer -->
                        <Button x:Name="SleepButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Sleep timer" AutomationProperties.Name="Sleep timer">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE708;" FontSize="14" />
                                <TextBlock x:Name="SleepButtonText" Text="Sleep" FontSize="12" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="SleepFlyout" Placement="Top" Opening="SleepFlyout_Opening">
                                    <Border Background="#F0000000" CornerRadius="8" Padding="0,6" MinWidth="160">
                                        <StackPanel x:Name="SleepListPanel" />
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Info (stats toggle) — active state uses amber dot underline -->
                        <Button x:Name="InfoButton" Style="{StaticResource PlayerUtilityBtnStyle}" Click="Stats_Click"
                                ToolTipService.ToolTip="Playback info (I)" AutomationProperties.Name="Playback info">
                            <Grid>
                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                                <Ellipse x:Name="InfoActiveDot"
                                         Width="4" Height="4"
                                         Fill="#E8B86E"
                                         HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                         Margin="0,0,0,2"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <!-- PiP — moves the native mpv surface into a detached,
                             always-on-top 16:9 window while playback continues. -->
                        <Button x:Name="PipButton" Style="{StaticResource PlayerUtilityBtnStyle}"
                                ToolTipService.ToolTip="Picture in Picture (P)"
                                AutomationProperties.Name="Picture in Picture"
                                Click="PipButton_Click">
                            <FontIcon Glyph="&#xE7ED;" FontSize="14" />
                        </Button>

                        <!-- Fullscreen -->
                        <Button x:Name="FullscreenButton" Style="{StaticResource PlayerUtilityBtnStyle}" Click="Fullscreen_Click"
                                ToolTipService.ToolTip="Enter fullscreen (F)"
                                AutomationProperties.Name="Enter fullscreen">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hidden legacy PlaybackInfoText kept so code-behind's UpdatePlaybackInfo()
                     still has a valid target. The info is now surfaced by the Info button → Stats overlay. -->
                <TextBlock x:Name="PlaybackInfoText" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
