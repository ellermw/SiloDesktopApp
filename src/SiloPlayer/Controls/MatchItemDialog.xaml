<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.MatchItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Match Item"
    CloseButtonText="Cancel"
    DefaultButton="None">

    <Grid MinWidth="320" MaxWidth="640" MaxHeight="720" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="0,0,4,0">
        <!-- Current item summary. The WebUI keeps this visible above the
             search form so an administrator cannot accidentally match the
             wrong item after opening more than one detail surface. -->
        <Border
            Background="{StaticResource SurfaceRaisedBrush}"
            CornerRadius="8"
            Padding="12,9">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="CurrentTitleText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="450" />
                <TextBlock
                    x:Name="CurrentYearText"
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    VerticalAlignment="Center" />
                <Border
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8,2">
                    <TextBlock
                        x:Name="CurrentTypeText"
                        FontSize="10"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Local media section (admin-only): folder/file paths for each version
             (movies) or library roots (series). Mirrors webui MediaLocations +
             FolderPathsList used inside MatchItemDialog. -->
        <StackPanel x:Name="LocalMediaSection" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="Local media" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <StackPanel x:Name="LocalMediaPanel" Spacing="6" />
            <TextBlock x:Name="LocalMediaEmpty" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- The current WebUI exposes title/year and provider identifiers as
             independent fields. Keeping them separate avoids guessing whether
             a numeric query means TMDB, TVDB, ISBN, or another provider. -->
        <Grid x:Name="VideoSearchFields" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="TitleBox"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Header="Title"
                PlaceholderText="Title"
                FontSize="13"
                CornerRadius="8"
                KeyDown="SearchField_KeyDown" />
            <TextBox
                x:Name="YearBox"
                Grid.Row="1"
                Grid.Column="0"
                Header="Year"
                PlaceholderText="Year"
                InputScope="Number"
                FontSize="13"
                CornerRadius="8"
                KeyDown="SearchField_KeyDown" />
            <TextBox
                x:Name="ImdbIdBox"
                Grid.Row="1"
                Grid.Column="1"
                Header="IMDb ID"
                PlaceholderText="tt1234567"
                FontSize="13"
                CornerRadius="8"
                KeyDown="SearchField_KeyDown" />
            <TextBox
                x:Name="TmdbIdBox"
                Grid.Row="2"
                Grid.Column="0"
                Header="TMDB ID"
                PlaceholderText="12345"
                FontSize="13"
                CornerRadius="8"
                KeyDown="SearchField_KeyDown" />
            <TextBox
                x:Name="TvdbIdBox"
                Grid.Row="2"
                Grid.Column="1"
                Header="TVDB ID"
                PlaceholderText="12345"
                FontSize="13"
                CornerRadius="8"
                KeyDown="SearchField_KeyDown" />
        </Grid>

        <StackPanel x:Name="GenericSearchFields" Spacing="10" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="GenericTitleBox"
                    Grid.Column="0"
                    Header="Title"
                    PlaceholderText="Title"
                    FontSize="13"
                    CornerRadius="8"
                    KeyDown="SearchField_KeyDown" />
                <TextBox
                    x:Name="GenericYearBox"
                    Grid.Column="1"
                    Header="Year"
                    PlaceholderText="Year"
                    InputScope="Number"
                    FontSize="13"
                    CornerRadius="8"
                    KeyDown="SearchField_KeyDown" />
            </Grid>
            <TextBlock Text="Provider IDs" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <StackPanel x:Name="ProviderIdsPanel" Spacing="8" />
            <Button
                x:Name="AddProviderIdButton"
                Width="36"
                Height="36"
                Padding="0"
                HorizontalAlignment="Left"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="AddProviderId_Click"
                AutomationProperties.Name="Add provider ID"
                ToolTipService.ToolTip="Add provider ID">
                <FontIcon Glyph="&#xE710;" FontSize="12" />
            </Button>
        </StackPanel>

        <Button
            x:Name="SearchButton"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Style="{StaticResource AccentButtonStyle}"
            Click="SearchButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon x:Name="SearchIcon" Glyph="&#xE721;" FontSize="13" />
                <TextBlock x:Name="SearchButtonText" Text="Search" />
            </StackPanel>
        </Button>

        <!-- Loading -->
        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            Visibility="Collapsed"
            Width="32" Height="32"
            HorizontalAlignment="Center" />

        <!-- Results list -->
        <StackPanel x:Name="ResultsSection" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="Results" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}" />
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel" Spacing="4" />
            </ScrollViewer>
        </StackPanel>

        <!-- Empty / no results text -->
        <TextBlock
            x:Name="EmptyText"
            Text=""
            FontSize="13"
            Foreground="{StaticResource SecondaryTextBrush}"
            HorizontalAlignment="Center"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="ApplyStatusText"
            Text=""
            FontSize="12"
            Foreground="{StaticResource ErrorBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed"
            AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        </ScrollViewer>

        <Button
            x:Name="ApplyMatchButton"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Style="{StaticResource AccentButtonStyle}"
            Content="Apply Match"
            Visibility="Collapsed"
            Click="ApplyMatch_Click" />
    </Grid>
</ContentDialog>
