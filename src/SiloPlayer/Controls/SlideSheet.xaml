<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.SlideSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    Visibility="Collapsed">

    <Grid x:Name="RootGrid">
        <!-- Dimming scrim behind the sheet — tap to dismiss. -->
        <Border
            x:Name="Scrim"
            Background="#99000000"
            Opacity="0"
            Tapped="Scrim_Tapped" />

        <!-- Sheet surface: positioned at one edge, slides in via RenderTransform. -->
        <Border
            x:Name="Sheet"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Width="420"
            Padding="20"
            RenderTransformOrigin="0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SheetTransform" X="420" />
            </Border.RenderTransform>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header row: title + close button. -->
                <Grid Grid.Row="0">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        HorizontalAlignment="Right"
                        Click="CloseButton_Click"
                        ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Host for the caller's content. -->
                <ContentPresenter
                    x:Name="ContentHost"
                    Grid.Row="1"
                    Content="{x:Bind SheetContent, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
