<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="{StaticResource PosterCardWidth}"
    Height="{StaticResource PosterCardTotalHeight}"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnCardTapped">

    <!-- Explicit Height on both the UserControl and its root Grid means
         UniformGridLayout never has to MeasureOverride the card's visual
         tree (which was triggering text-measurement on TitleText and
         SubtitleText per card per layout pass). A LoadMore adding 100
         items was forcing measurement of ~20 visible card subtrees in one
         UI-thread burst; pinning the height makes each card layout O(1). -->
    <Grid
        x:Name="RootGrid"
        Width="{StaticResource PosterCardWidth}"
        Height="{StaticResource PosterCardTotalHeight}"
        Background="Transparent"
        RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <CompositeTransform x:Name="CardHoverTransform" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="267" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Poster image area (2:3 aspect, rounded-xl = 12px).
             Scale transform lives HERE (not on the whole card) so the
             hover zoom only affects the poster, not the text below.
             Scaling the RootGrid caused overflow clipping in the
             ItemsRepeater's fixed-height cells. -->
        <Grid
            Grid.Row="0"
            CornerRadius="{StaticResource PosterCornerRadius}">

            <!-- Card background for hover -->
            <Border
                x:Name="PosterBackground"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PosterCornerRadius}" />

            <!-- Thumbhash placeholder -->
            <Image
                x:Name="ThumbhashImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- Actual poster image — scale transform for hover zoom lives here
                 (not on the parent Grid) so the image zooms INSIDE the
                 rounded clip frame, matching webui's overflow:hidden +
                 group-hover:scale-105 pattern. -->
            <Image
                x:Name="PosterImage"
                Stretch="UniformToFill"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="HoverTransform" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>

            <!-- Fallback title (webui: centered text line-clamp-3 when no
                 poster URL). Hidden when a poster loads successfully. -->
            <TextBlock
                x:Name="FallbackTitle"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxLines="3"
                MaxWidth="140"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                Padding="8" />

            <!-- Bottom gradient overlay (from-black/55) -->
            <Border VerticalAlignment="Bottom" Height="96" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="#8C000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Card overlay badges in 4 corners. Each corner is a
                 vertical StackPanel so multiple enabled overlays at the
                 same position stack nicely. Populated by
                 PosterCard.UpdateBadges() using CardOverlayService prefs. -->
            <StackPanel
                x:Name="OverlayTopLeft"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="6" />
            <StackPanel
                x:Name="OverlayTopRight"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="6" />
            <StackPanel
                x:Name="OverlayBottomLeft"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="6" />
            <StackPanel
                x:Name="OverlayBottomRight"
                Orientation="Vertical"
                Spacing="4"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="6" />

            <!-- Selection remains above artwork and configured badges. -->
            <Border
                x:Name="SelectionBadge"
                Width="34"
                Height="34"
                Margin="10"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="17"
                Background="{StaticResource AccentBrush}"
                BorderBrush="White"
                BorderThickness="2"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{StaticResource AccentForegroundBrush}" />
            </Border>

            <!-- WebUI ItemCard hover brightens the poster without adding a
                 play button, dark veil, or accent outline. -->
            <Border
                x:Name="HoverBrighten"
                CornerRadius="{StaticResource PosterCornerRadius}"
                Background="#18FFFFFF"
                Opacity="0"
                IsHitTestVisible="False" />

            <!-- Current WebUI poster menu: bottom-right, revealed on hover. -->
            <Button
                x:Name="MoreButton"
                Width="32"
                Height="32"
                MinWidth="0"
                MinHeight="0"
                Margin="0,0,10,10"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="6"
                Background="#AA000000"
                BorderBrush="#30FFFFFF"
                BorderThickness="1"
                Opacity="0"
                GotFocus="MoreButton_GotFocus"
                LostFocus="MoreButton_LostFocus"
                Click="MoreButton_Click"
                Tapped="MoreButton_Tapped">
                <FontIcon Glyph="&#xE712;" FontSize="15" Foreground="White" />
            </Button>
        </Grid>

        <!-- Text below poster (web: px-1 pt-3 = 4px side, 12px top) -->
        <StackPanel Grid.Row="1" Margin="4,12,4,0">
            <!-- Title: text-[14px] font-semibold tracking-tight -->
            <TextBlock
                x:Name="TitleText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1" />
            <TextBlock
                x:Name="EpisodeTitleText"
                FontSize="12"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                MaxLines="1"
                Margin="0,4,0,0"
                Visibility="Collapsed" />
            <!-- Year/type: text-[11px] font-medium uppercase tracking-[0.14em] -->
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                FontWeight="Medium"
                Foreground="{StaticResource SecondaryTextBrush}"
                CharacterSpacing="140"
                Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
