<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.NowListeningHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="560">
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.28" />
        <Border Background="#99101722" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#22101722" Offset="0" />
                    <GradientStop Color="#F5101722" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Margin="48,104,48,48" MaxWidth="1380" HorizontalAlignment="Left"
              ColumnDefinitions="220,*" ColumnSpacing="40" VerticalAlignment="Center">
            <Border Width="220" Height="220" CornerRadius="16"
                    Background="{StaticResource CardBackgroundBrush}">
                <Image x:Name="CoverImage" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" MaxWidth="820">
                <TextBlock Text="NOW LISTENING" FontSize="11" FontWeight="Bold"
                           CharacterSpacing="180" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="TitleText" FontSize="48" FontWeight="ExtraBold"
                           TextWrapping="Wrap" MaxLines="2" Foreground="White" />
                <TextBlock x:Name="CreditsText" FontSize="15" Foreground="#BFFFFFFF"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />

                <StackPanel Margin="0,14,0,0" Spacing="8" MaxWidth="620">
                    <Border x:Name="ProgressTrack" Height="6" CornerRadius="3"
                            Background="#33FFFFFF" SizeChanged="ProgressTrack_SizeChanged">
                        <Border x:Name="ProgressFill" Height="6" CornerRadius="3"
                                HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="PositionText" FontSize="13" Foreground="#99FFFFFF" />
                        <TextBlock x:Name="TimeLeftText" Grid.Column="1" FontSize="13"
                                   Foreground="#D9FFFFFF" />
                    </Grid>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,14,0,0">
                    <Button Style="{StaticResource AccentButtonStyle}" CornerRadius="20"
                            Padding="20,10" Click="Resume_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="ResumeText" Text="Resume" />
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="20" Padding="20,10" Background="#44FFFFFF"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Click="MoreInfo_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="White" />
                            <TextBlock Text="More Info" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
