<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.HeroCarousel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    IsTabStop="True"
    AutomationProperties.Name="Featured content"
    KeyDown="OnKeyDown"
    GotFocus="OnHeroGotFocus"
    LostFocus="OnHeroLostFocus"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <!-- Height is set in code-behind from the current WebUI contract:
         50vh below desktop, 60vh on desktop, clamped to 350-700px. -->
    <Grid
        x:Name="RootGrid"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <!-- Two stacked backdrop layers for the crossfade transition. The
             "active" one is the one currently fully visible; when a new
             item is shown we load into the inactive layer then animate the
             opacities in opposite directions. -->
        <controls:BackdropImage
            x:Name="BackdropImageA"
            AnchorY="0.2" />
        <controls:BackdropImage
            x:Name="BackdropImageB"
            AnchorY="0.2"
            Opacity="0" />

        <!-- Brightness overlay: web uses brightness(0.78), so ~22% darkening -->
        <Border Background="Black" Opacity="0.22" />

        <!-- Bottom-to-top gradient (hero-gradient) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="HeroBottomTransparent" Color="Transparent" Offset="0.0" />
                    <GradientStop x:Name="HeroBottomSoft" Color="#33101722" Offset="0.25" />
                    <GradientStop x:Name="HeroBottomMid" Color="#8C101722" Offset="0.5" />
                    <GradientStop x:Name="HeroBottomStrong" Color="#EB101722" Offset="0.8" />
                    <GradientStop x:Name="HeroBottomSolid" Color="#101722" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Current WebUI ambient glow, tinted from the active backdrop. -->
        <Border x:Name="AmbientGlowBorder" Opacity="0.08" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.8" GradientOrigin="0.5,0.8" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop x:Name="AmbientGlowColor" Color="#78AEFC" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Left-to-right gradient (hero-gradient-left) -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop x:Name="HeroLeftSolid" Color="#101722" Offset="0.0" />
                    <GradientStop x:Name="HeroLeftStrong" Color="#CC101722" Offset="0.2" />
                    <GradientStop x:Name="HeroLeftSoft" Color="#66101722" Offset="0.4" />
                    <GradientStop x:Name="HeroLeftTransparent" Color="Transparent" Offset="0.6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Vignette: combined left + bottom gradient -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop x:Name="HeroVignetteStrong" Color="#66101722" Offset="0.0" />
                    <GradientStop x:Name="HeroVignetteSoft" Color="#33101722" Offset="0.3" />
                    <GradientStop x:Name="HeroVignetteTransparent" Color="Transparent" Offset="0.6" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- WebUI home hero has border-b border-border/60 before the next
             stack item. Keep it as a 1px overlay so it survives backdrop
             crossfades without affecting hero layout height. -->
        <Border
            VerticalAlignment="Bottom"
            Height="1"
            Background="{StaticResource BorderBrush}"
            Opacity="0.6"
            IsHitTestVisible="False" />

        <!-- Content overlay -->
        <StackPanel
            x:Name="HeroContent"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Margin="48,0,0,60"
            MaxWidth="768"
            Spacing="0">

            <!-- Stacked title: a dark "shadow" copy behind the white text
                 to approximate a CSS text-shadow (WinUI TextBlock has no
                 built-in shadow). Offset 1px down/right, pure black, 60%
                 opacity — enough to keep the title readable over bright
                 backdrops without looking like a drop shadow. -->
            <!-- Eyebrow: "FEATURED — No. 01" -->
            <TextBlock
                x:Name="HeroEyebrow"
                FontSize="11"
                FontWeight="SemiBold"
                CharacterSpacing="200"
                Foreground="{StaticResource TertiaryTextBrush}"
                Margin="0,0,0,16" />

            <Grid Margin="0,0,0,16">
                <TextBlock
                    x:Name="HeroTitleShadow"
                    HorizontalAlignment="Left"
                    Style="{StaticResource DisplayTextStyle}"
                    FontSize="48"
                    FontWeight="ExtraBold"
                    TextWrapping="Wrap"
                    MaxLines="0" CharacterSpacing="-40"
                    Foreground="#99000000"
                    Margin="1,1,0,0"
                    IsHitTestVisible="False" />
                <TextBlock
                    x:Name="HeroTitle"
                    HorizontalAlignment="Left"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource DisplayTextStyle}"
                    FontSize="48"
                    FontWeight="ExtraBold"
                    TextWrapping="Wrap"
                    MaxLines="0" CharacterSpacing="-40" />
            </Grid>

            <!-- Metadata pills row: year · IMDb badge · first 3 genres.
                 Dark-glass pills matching webui .metadata-badge pattern.
                 Populated in code-behind ShowCurrentItem(). -->
            <StackPanel x:Name="HeroMetaPillsRow" Orientation="Horizontal" Spacing="0" Margin="0,0,0,20" />

            <TextBlock x:Name="HeroOverview"
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap" MaxLines="3"
                TextTrimming="CharacterEllipsis"
                LineHeight="28"
                LineStackingStrategy="BlockLineHeight"
                Margin="0,0,0,28" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- Primary CTA: Play (pill-primary) -->
                <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Padding="22.4,12.48" BorderThickness="0" UseLayoutRounding="False"
                        CornerRadius="22.56" FontSize="13.44" FontWeight="Bold"
                        Click="PlayButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" UseLayoutRounding="False">
                        <Grid x:Name="PlayButtonIcon" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="PlayButtonText" Text="Play" FontSize="13.44" FontWeight="Bold" CharacterSpacing="10" LineHeight="20.16" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" UseLayoutRounding="False" />
                    </StackPanel>
                </Button>
                <!-- Secondary CTA: More Info (pill-glass) -->
                <Button x:Name="MoreInfoButton" Padding="22.4,12.48" UseLayoutRounding="False"
                        CornerRadius="23.56" FontSize="13.44" FontWeight="Bold"
                        Background="#1FFFFFFF" BorderThickness="1"
                        Click="MoreInfoButton_Click">
                    <Button.BorderBrush><SolidColorBrush Color="{StaticResource BorderColor}" Opacity="0.5" /></Button.BorderBrush>
                    <StackPanel Orientation="Horizontal" Spacing="8" UseLayoutRounding="False">
                        <Grid x:Name="MoreInfoIcon" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="More Info" FontSize="13.44" FontWeight="Bold" CharacterSpacing="10" LineHeight="20.16" LineStackingStrategy="BlockLineHeight" Foreground="White" VerticalAlignment="Center" UseLayoutRounding="False" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Nav arrows — hover-reveal (web: lg:opacity-0 lg:group-hover:opacity-100).
             Start invisible; PointerEntered on RootGrid animates to full. -->
        <Button x:Name="PrevButton" Style="{StaticResource GhostButtonStyle}"
            AutomationProperties.Name="Previous slide"
            VerticalAlignment="Center" HorizontalAlignment="Left"
            Margin="8,0,0,0" Width="40" Height="40"
            Click="PrevButton_Click" Opacity="0">
            <FontIcon Glyph="&#xE76B;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource GhostButtonStyle}"
            AutomationProperties.Name="Next slide"
            VerticalAlignment="Center" HorizontalAlignment="Right"
            Margin="0,0,8,0" Width="40" Height="40"
            Click="NextButton_Click" Opacity="0">
            <FontIcon Glyph="&#xE76C;" FontSize="20" Foreground="{StaticResource PrimaryTextBrush}" />
        </Button>

        <!-- Slide counter + progress rail (bottom-right, replaces dots) -->
        <StackPanel
            x:Name="SlideControlsPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,20"
            Orientation="Horizontal"
            Spacing="12">
            <!-- Slide counter: "01 / 04" monospace -->
            <TextBlock
                x:Name="SlideCounterText"
                FontSize="11"
                FontWeight="Medium"
                FontFamily="Consolas"
                CharacterSpacing="120"
                Foreground="#AAFFFFFF"
                VerticalAlignment="Center" />
            <!-- Progress rail: animated fill bar (8s duration) -->
            <Border
                x:Name="ProgressRailContainer"
                Width="100"
                Height="3"
                CornerRadius="2"
                Background="#33FFFFFF"
                VerticalAlignment="Center">
                <Border
                    x:Name="ProgressRailFill"
                    HorizontalAlignment="Left"
                    Width="0"
                    Height="3"
                    CornerRadius="2"
                    Background="{StaticResource AccentBrush}" />
            </Border>
            <Button
                x:Name="PauseCarouselButton"
                Width="28"
                Height="28"
                Padding="0"
                CornerRadius="14"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Pause slideshow"
                AutomationProperties.Name="Pause slideshow"
                Click="PauseCarouselButton_Click">
                <FontIcon x:Name="PauseCarouselIcon" Glyph="&#xE769;" FontSize="12" Foreground="#CCFFFFFF" />
            </Button>
        </StackPanel>

        <!-- Dots (hidden, kept for backward compat) -->
        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
            HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,12" Spacing="8" Visibility="Collapsed" />
    </Grid>
</UserControl>
