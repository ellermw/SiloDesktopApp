<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.SubtitleSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title=""
    Background="#FF171717"
    Foreground="White">

    <Grid x:Name="DialogRoot" MinWidth="320" MaxWidth="480" MaxHeight="760" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- WebUI modal header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="DialogTitleText"
                Grid.Column="0"
                Text="Add Subtitles"
                FontSize="14"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Foreground="White" />
            <Button
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Close"
                AutomationProperties.Name="Close"
                Click="Close_Click">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#99FFFFFF" />
            </Button>
        </Grid>

        <TextBlock
            x:Name="DialogDescriptionText"
            Grid.Row="1"
            Margin="0,0,0,12"
            FontSize="12"
            Foreground="{StaticResource SecondaryTextBrush}"
            TextTrimming="CharacterEllipsis"
            Visibility="Collapsed" />

        <!-- Upload subtitle -->
        <Border
            Grid.Row="2"
            Padding="0,0,0,12"
            BorderBrush="#1AFFFFFF"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="Upload subtitle"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBlock
                        Text="Drag and drop or browse for SRT, VTT, ASS, SSA, or SUB files up to 5 MB. Language is detected automatically when possible."
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Button
                    x:Name="BrowseUploadButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="16,18"
                    Background="#0DFFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    AllowDrop="True"
                    DragOver="UploadDropTarget_DragOver"
                    Drop="UploadDropTarget_Drop"
                    Click="BrowseUploadButton_Click">
                    <StackPanel Spacing="3" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="#B3FFFFFF" />
                        <TextBlock Text="Drag and drop a subtitle file" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="or click to browse · SRT, VTT, ASS, SSA, or SUB" FontSize="11"
                                   Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="UploadLanguageComboBox"
                        TabIndex="0"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Language">
                        <ComboBoxItem Content="Arabic" Tag="ar" />
                        <ComboBoxItem Content="Bengali" Tag="bn" />
                        <ComboBoxItem Content="Bulgarian" Tag="bg" />
                        <ComboBoxItem Content="Chinese" Tag="zh" />
                        <ComboBoxItem Content="Croatian" Tag="hr" />
                        <ComboBoxItem Content="Czech" Tag="cs" />
                        <ComboBoxItem Content="Danish" Tag="da" />
                        <ComboBoxItem Content="Dutch" Tag="nl" />
                        <ComboBoxItem Content="English" Tag="en" IsSelected="True" />
                        <ComboBoxItem Content="Finnish" Tag="fi" />
                        <ComboBoxItem Content="French" Tag="fr" />
                        <ComboBoxItem Content="German" Tag="de" />
                        <ComboBoxItem Content="Greek" Tag="el" />
                        <ComboBoxItem Content="Hebrew" Tag="he" />
                        <ComboBoxItem Content="Hindi" Tag="hi" />
                        <ComboBoxItem Content="Hungarian" Tag="hu" />
                        <ComboBoxItem Content="Indonesian" Tag="id" />
                        <ComboBoxItem Content="Italian" Tag="it" />
                        <ComboBoxItem Content="Japanese" Tag="ja" />
                        <ComboBoxItem Content="Korean" Tag="ko" />
                        <ComboBoxItem Content="Malay" Tag="ms" />
                        <ComboBoxItem Content="Norwegian" Tag="no" />
                        <ComboBoxItem Content="Persian" Tag="fa" />
                        <ComboBoxItem Content="Polish" Tag="pl" />
                        <ComboBoxItem Content="Portuguese" Tag="pt" />
                        <ComboBoxItem Content="Romanian" Tag="ro" />
                        <ComboBoxItem Content="Russian" Tag="ru" />
                        <ComboBoxItem Content="Slovak" Tag="sk" />
                        <ComboBoxItem Content="Slovenian" Tag="sl" />
                        <ComboBoxItem Content="Spanish" Tag="es" />
                        <ComboBoxItem Content="Swedish" Tag="sv" />
                        <ComboBoxItem Content="Tamil" Tag="ta" />
                        <ComboBoxItem Content="Telugu" Tag="te" />
                        <ComboBoxItem Content="Thai" Tag="th" />
                        <ComboBoxItem Content="Turkish" Tag="tr" />
                        <ComboBoxItem Content="Ukrainian" Tag="uk" />
                        <ComboBoxItem Content="Vietnamese" Tag="vi" />
                    </ComboBox>

                    <ToggleSwitch
                        x:Name="UploadHearingImpairedToggle"
                        Grid.Column="1"
                        OffContent="HI"
                        OnContent="HI"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="UploadButton"
                        Grid.Column="2"
                        Content="Upload"
                        IsEnabled="False"
                        Click="UploadButton_Click" />
                </Grid>

                <TextBlock
                    x:Name="UploadFileText"
                    Text="No file selected"
                    FontSize="11"
                    Foreground="#99FFFFFF"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    x:Name="UploadStatusText"
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock
            x:Name="OnlineSearchHeading"
            Grid.Row="3"
            Text="Search online"
            Margin="0,10,0,8"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="#99FFFFFF" />

        <!-- Language picker + Search -->
        <Grid x:Name="OnlineSearchControls" Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="LanguageComboBox"
                TabIndex="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                PlaceholderText="Language">
                <ComboBoxItem Content="Arabic" Tag="ar" />
                <ComboBoxItem Content="Bengali" Tag="bn" />
                <ComboBoxItem Content="Bulgarian" Tag="bg" />
                <ComboBoxItem Content="Chinese" Tag="zh" />
                <ComboBoxItem Content="Croatian" Tag="hr" />
                <ComboBoxItem Content="Czech" Tag="cs" />
                <ComboBoxItem Content="Danish" Tag="da" />
                <ComboBoxItem Content="Dutch" Tag="nl" />
                <ComboBoxItem Content="English" Tag="en" IsSelected="True" />
                <ComboBoxItem Content="Finnish" Tag="fi" />
                <ComboBoxItem Content="French" Tag="fr" />
                <ComboBoxItem Content="German" Tag="de" />
                <ComboBoxItem Content="Greek" Tag="el" />
                <ComboBoxItem Content="Hebrew" Tag="he" />
                <ComboBoxItem Content="Hindi" Tag="hi" />
                <ComboBoxItem Content="Hungarian" Tag="hu" />
                <ComboBoxItem Content="Indonesian" Tag="id" />
                <ComboBoxItem Content="Italian" Tag="it" />
                <ComboBoxItem Content="Japanese" Tag="ja" />
                <ComboBoxItem Content="Korean" Tag="ko" />
                <ComboBoxItem Content="Malay" Tag="ms" />
                <ComboBoxItem Content="Norwegian" Tag="no" />
                <ComboBoxItem Content="Persian" Tag="fa" />
                <ComboBoxItem Content="Polish" Tag="pl" />
                <ComboBoxItem Content="Portuguese" Tag="pt" />
                <ComboBoxItem Content="Romanian" Tag="ro" />
                <ComboBoxItem Content="Russian" Tag="ru" />
                <ComboBoxItem Content="Slovak" Tag="sk" />
                <ComboBoxItem Content="Slovenian" Tag="sl" />
                <ComboBoxItem Content="Spanish" Tag="es" />
                <ComboBoxItem Content="Swedish" Tag="sv" />
                <ComboBoxItem Content="Tamil" Tag="ta" />
                <ComboBoxItem Content="Telugu" Tag="te" />
                <ComboBoxItem Content="Thai" Tag="th" />
                <ComboBoxItem Content="Turkish" Tag="tr" />
                <ComboBoxItem Content="Ukrainian" Tag="uk" />
                <ComboBoxItem Content="Vietnamese" Tag="vi" />
            </ComboBox>
            <Button
                x:Name="SearchButton"
                Grid.Column="1"
                Content="Search"
                IsEnabled="False"
                Click="SearchButton_Click" />
            <ProgressRing
                x:Name="SearchProgress"
                Grid.Column="2"
                IsActive="False"
                Width="24" Height="24" />
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,8,0,0" Spacing="6">
            <Border
                x:Name="ErrorBorder"
                Padding="10,8"
                Background="#1AEF4444"
                CornerRadius="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    FontSize="12"
                    Foreground="#FFFCA5A5"
                    TextWrapping="Wrap" />
            </Border>
            <StackPanel x:Name="WarningsPanel" Spacing="6" />
        </StackPanel>

        <!-- Results list -->
        <Grid x:Name="OnlineSearchResults" Grid.Row="6" Margin="0,8,0,0">
            <TextBlock
                x:Name="EmptyStateText"
                Text="Select a language and press Search."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="13"
                Opacity="0.7" />
            <ListView
                x:Name="ResultsList"
                MinHeight="96"
                MaxHeight="360"
                SelectionMode="None"
                IsItemClickEnabled="False" />
        </Grid>

        <!-- Status line -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="7"
            Margin="0,6,0,0"
            FontSize="11"
            Opacity="0.75" />
    </Grid>
</ContentDialog>
