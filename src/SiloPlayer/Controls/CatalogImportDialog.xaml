<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SiloPlayer.Controls.CatalogImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Import Catalog Seed"
    PrimaryButtonText="Import Catalog"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Spacing="16" Padding="0,4,8,4">

            <!-- Import Source -->
            <StackPanel Spacing="6">
                <TextBlock Text="Import Source" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <ComboBox x:Name="SourceCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="SourceCombo_SelectionChanged">
                    <ComboBoxItem Content="Local File" Tag="local_path" />
                    <ComboBoxItem Content="Local Export Job" Tag="export_job" />
                    <ComboBoxItem Content="Bucket Artifact" Tag="bucket_artifact" />
                    <ComboBoxItem Content="Remote URL" Tag="remote_url" />
                </ComboBox>
            </StackPanel>

            <!-- Local path (visible when source = local_path) -->
            <StackPanel x:Name="LocalPathSection" Spacing="6" Visibility="Visible">
                <TextBlock Text="File Path" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBox x:Name="LocalPathBox" PlaceholderText="/catalog-seeds/my-catalog.json.gz" />
                <Grid x:Name="DetectedFilesHeader">
                    <TextBlock Text="Detected Files" FontSize="12"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                            Click="RefreshLocalSources_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ComboBox x:Name="LocalSourcePicker"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Select a detected file"
                          SelectionChanged="LocalSourcePicker_SelectionChanged" />
                <TextBlock
                    Text="Enter the absolute path to a .json.gz catalog seed file on the server, or select a detected file from /catalog-seeds/."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Export job (visible when source = export_job) -->
            <StackPanel x:Name="ExportJobSection" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Completed Export" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <ComboBox x:Name="ExportJobCombo"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a completed export job" />
                <TextBlock
                    Text="Silo will load the selected seed directly from the configured operational S3 bucket."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Bucket artifact (visible when source = bucket_artifact) -->
            <StackPanel x:Name="BucketArtifactSection" Spacing="6" Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="Detected Bucket Artifacts" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                            Click="RefreshBucketSources_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ComboBox x:Name="BucketArtifactCombo"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a catalog seed from the bucket" />
                <TextBlock
                    Text="This reads any detected catalog-seeds/*.json.gz object in the private internal S3 bucket, including exports from other installs."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Remote URL (visible when source = remote_url) -->
            <StackPanel x:Name="RemoteUrlSection" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Remote URL" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBox x:Name="RemoteUrlBox"
                         PlaceholderText="https://example.com/catalog-seeds/export.json.gz" />
                <TextBlock
                    Text="Paste a public .json.gz catalog seed URL. Silo will download it server-side before importing."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Conflict Mode -->
            <StackPanel Spacing="6">
                <TextBlock Text="Conflict Mode" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <ComboBox x:Name="ConflictCombo" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Skip Existing" Tag="skip_existing" IsSelected="True" />
                    <ComboBoxItem Content="Overwrite Existing" Tag="overwrite_existing" />
                </ComboBox>
            </StackPanel>

            <!-- Path Rewrites -->
            <StackPanel Spacing="6">
                <TextBlock Text="Path Rewrites" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock
                    Text="Rewrites use prefix matching. Mapping /mnt/sharedrives/zd-storage-ceph to /media rewrites every nested library and file path under that root."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="RewritesPanel" Spacing="6" />
                <Button x:Name="AddRewriteButton" Click="AddRewrite_Click"
                        HorizontalAlignment="Left" Padding="10,6"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <TextBlock Text="Add Rewrite" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Warning note -->
            <Border
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
                <TextBlock
                    Text="Import validates the rewritten library roots before writing anything, so missing or incomplete rewrites will fail fast instead of seeding broken paths."
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextWrapping="Wrap" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
