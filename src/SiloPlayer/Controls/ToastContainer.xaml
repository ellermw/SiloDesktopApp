<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.ToastContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False">

    <!-- Stack of toasts; newest on top. IsHitTestVisible=False on the
         container so toasts don't eat clicks from content behind them;
         individual toasts set their own hit-test so the dismiss button works. -->
    <StackPanel
        x:Name="ToastStack"
        Orientation="Vertical"
        Spacing="8"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,16,20,0" />
</UserControl>
