<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SiloPlayer.Controls.ImpersonationBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Warm-gold override strip on a glass-dark surface (webui parity, commit
         73a8fea). An admin-impersonating-user indicator unmistakable without
         being alarming. Pulsing dot / "VIEWING AS" microlabel / avatar chip /
         username / "authorized by {admin}" / End session button. -->
    <Border
        Padding="20,10"
        BorderThickness="0,0,0,1"
        HorizontalAlignment="Stretch">
        <Border.Background>
            <!-- Glass-dark base with warm-gold left wash. Approximates the web's
                 `color-mix(background 94%, transparent)` + warm-gold overlay. -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1AE8B86E" Offset="0.0" />
                <GradientStop Color="#00E8B86E" Offset="0.38" />
                <GradientStop Color="#00E8B86E" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#54E8B86E" />
        </Border.BorderBrush>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- dot + label -->
                <ColumnDefinition Width="Auto" />
                <!-- chip + username -->
                <ColumnDefinition Width="*" />
                <!-- authorized by -->
                <ColumnDefinition Width="Auto" />
                <!-- end button -->
            </Grid.ColumnDefinitions>

            <!-- Pulsing dot + "VIEWING AS" microlabel -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <Grid Width="10" Height="10" VerticalAlignment="Center">
                    <!-- Static gold dot. Pulse animation is a polish follow-up. -->
                    <Ellipse Width="8" Height="8" Fill="#E8B86E"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock
                    Text="VIEWING AS"
                    FontSize="10"
                    FontWeight="SemiBold"
                    CharacterSpacing="220"
                    Foreground="#E8B86E"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Avatar chip + username -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <Border
                    Width="26" Height="26"
                    CornerRadius="6"
                    Background="#1FE8B86E"
                    BorderBrush="#52E8B86E"
                    BorderThickness="1">
                    <TextBlock
                        x:Name="InitialText"
                        Text="?"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#E8B86E"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    x:Name="ImpersonatingText"
                    Text="User"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="320" />
            </StackPanel>

            <!-- "· authorized by {admin}" -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center" Margin="0,0,0,0">
                <TextBlock Text="·" FontSize="13"
                           Foreground="{StaticResource TertiaryTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock
                    Text="authorized by"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="ImpersonatorText"
                    FontSize="12"
                    FontWeight="Medium"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="240" />
            </StackPanel>

            <!-- End session button with X icon -->
            <Button
                Grid.Column="3"
                x:Name="EndImpersonationButton"
                Background="#14FFFFFF"
                BorderBrush="#2EFFFFFF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5"
                Click="EndImpersonation_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE711;"
                        FontSize="11"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="EndSessionText"
                        Text="End session"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
