    <!-- Native WinUI template parts preserve keyboard, pointer, drag and UIA behavior.
         Adapted from Windows App SDK WinUI 1.8.260224000 generic.xaml (MIT,
         copyright Microsoft Corporation), with current WebUI track/thumb geometry. -->
    <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">16</x:Double>
