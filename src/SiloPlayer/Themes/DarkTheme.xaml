<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers">

    <!-- ===== Font Families (default: Outfit for cobalt-studio) ===== -->
    <FontFamily x:Key="ThemeFontFamily">ms-appx:///Assets/Fonts/Outfit-VariableFont_wght.ttf#Outfit</FontFamily>
    <FontFamily x:Key="ThemeDisplayFontFamily">ms-appx:///Assets/Fonts/Outfit-VariableFont_wght.ttf#Outfit</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Outfit-VariableFont_wght.ttf#Outfit</FontFamily>
    <Style TargetType="Page">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeFontFamily}" />
        <Setter Property="helpers:PageBackdrop.Enabled" Value="True" />
    </Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{ThemeResource ThemeFontFamily}" /></Style>

    <!-- ===== Background Colors (cobalt-studio theme) ===== -->
    <Color x:Key="AppBackgroundColor">#101722</Color>
    <Color x:Key="SidebarBackgroundColor">#0C131D</Color>
    <Color x:Key="CardBackgroundColor">#151E2B</Color>
    <Color x:Key="SurfaceColor">#151E2B</Color>
    <Color x:Key="SurfaceHoverColor">#1D2A3B</Color>
    <Color x:Key="SurfaceRaisedColor">#223245</Color>
    <Color x:Key="BorderColor">#28384D</Color>
    <Color x:Key="InputColor">#182231</Color>
    <Color x:Key="SidebarAccentColor">#172231</Color>
    <Color x:Key="SidebarBorderColor">#1F2A39</Color>
    <Color x:Key="SecondaryBackgroundColor">#1B2634</Color>
    <Color x:Key="AccentBackgroundColor">#203043</Color>

    <!-- ===== Text Colors ===== -->
    <Color x:Key="PrimaryTextColor">#F4F8FF</Color>
    <Color x:Key="SecondaryTextColor">#90A0B5</Color>
    <Color x:Key="TertiaryTextColor">#6E7681</Color>
    <Color x:Key="DisabledTextColor">#484F58</Color>
    <Color x:Key="SecondaryForegroundColor">#D7E2F1</Color>

    <!-- ===== Accent Colors ===== -->
    <Color x:Key="AccentColor">#78AEFC</Color>
    <Color x:Key="AmbientColor">#78AEFC</Color>
    <Color x:Key="AccentHoverColor">#8FBDFF</Color>
    <Color x:Key="AccentPressedColor">#5E9AEB</Color>
    <Color x:Key="AccentForegroundColor">#0F1722</Color>

    <!-- ===== Badge / Tag Colors ===== -->
    <Color x:Key="BadgeBackgroundColor">#331F6FEB</Color>
    <Color x:Key="BadgeTextColor">#78AEFC</Color>
    <Color x:Key="BadgeResolutionColor">#238636</Color>
    <Color x:Key="BadgeHdrColor">#DB6D28</Color>
    <Color x:Key="ErrorColor">#EF6B73</Color>
    <Color x:Key="WarningColor">#D29922</Color>

    <!-- ===== New Semantic Color Tokens (cobalt-studio defaults) ===== -->
    <Color x:Key="PopoverColor">#121A25</Color>
    <Color x:Key="PopoverForegroundColor">#F4F8FF</Color>
    <Color x:Key="CardForegroundColor">#F4F8FF</Color>
    <Color x:Key="ThemeAccentForegroundColor">#F4F8FF</Color>
    <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
    <Color x:Key="MutedColor">#151E2B</Color>
    <Color x:Key="RingColor">#78AEFC</Color>
    <Color x:Key="Chart1Color">#78AEFC</Color>
    <Color x:Key="Chart2Color">#87D2FF</Color>
    <Color x:Key="Chart3Color">#6EC7BA</Color>
    <Color x:Key="Chart4Color">#B9C7FF</Color>
    <Color x:Key="Chart5Color">#F18D8D</Color>
    <Color x:Key="SidebarForegroundColor">#F4F8FF</Color>
    <Color x:Key="SidebarPrimaryColor">#78AEFC</Color>
    <Color x:Key="SidebarPrimaryForegroundColor">#0F1722</Color>
    <Color x:Key="SidebarAccentForegroundColor">#F4F8FF</Color>
    <Color x:Key="SidebarRingColor">#78AEFC</Color>

    <!-- ===== Brushes: Backgrounds ===== -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource SidebarAccentColor}" />
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="{StaticResource AccentBackgroundColor}" />

    <!-- ===== Brushes: Text ===== -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />

    <!-- ===== Brushes: Accent ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AmbientBrush" Color="{StaticResource AmbientColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />

    <!-- ===== Brushes: Badge / Status ===== -->
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="{StaticResource BadgeBackgroundColor}" />
    <SolidColorBrush x:Key="BadgeTextBrush" Color="{StaticResource BadgeTextColor}" />
    <SolidColorBrush x:Key="BadgeResolutionBrush" Color="{StaticResource BadgeResolutionColor}" />
    <SolidColorBrush x:Key="BadgeHdrBrush" Color="{StaticResource BadgeHdrColor}" />
    <!-- Card overlay badges (resolution/HDR/audio/etc. on poster cards).
         Web parity: rgba(0,0,0,0.6) with a thin white/15 border. Must be
         opaque enough to stay legible over bright backdrops. -->
    <SolidColorBrush x:Key="CardOverlayBackgroundBrush" Color="#99000000" />
    <SolidColorBrush x:Key="CardOverlayBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <!-- Semantic: success (green-500), info (blue-400), warning already above -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />

    <!-- ===== Brushes: New Semantic Tokens ===== -->
    <SolidColorBrush x:Key="PopoverBrush" Color="{StaticResource PopoverColor}" />
    <SolidColorBrush x:Key="PopoverForegroundBrush" Color="{StaticResource PopoverForegroundColor}" />
    <SolidColorBrush x:Key="CardForegroundBrush" Color="{StaticResource CardForegroundColor}" />
    <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="{StaticResource ThemeAccentForegroundColor}" />
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="{StaticResource DestructiveForegroundColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="RingBrush" Color="{StaticResource RingColor}" />
    <SolidColorBrush x:Key="Chart1Brush" Color="{StaticResource Chart1Color}" />
    <SolidColorBrush x:Key="Chart2Brush" Color="{StaticResource Chart2Color}" />
    <SolidColorBrush x:Key="Chart3Brush" Color="{StaticResource Chart3Color}" />
    <SolidColorBrush x:Key="Chart4Brush" Color="{StaticResource Chart4Color}" />
    <SolidColorBrush x:Key="Chart5Brush" Color="{StaticResource Chart5Color}" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForegroundColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryBrush" Color="{StaticResource SidebarPrimaryColor}" />
    <SolidColorBrush x:Key="SidebarPrimaryForegroundBrush" Color="{StaticResource SidebarPrimaryForegroundColor}" />
    <SolidColorBrush x:Key="SidebarAccentForegroundBrush" Color="{StaticResource SidebarAccentForegroundColor}" />
    <SolidColorBrush x:Key="SidebarRingBrush" Color="{StaticResource SidebarRingColor}" />

    <!-- ===== Typography Sizes ===== -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeader">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>
    <x:Double x:Key="FontSizeDisplayLarge">42</x:Double>
    <x:Double x:Key="FontSizeBranding">28</x:Double>
    <x:Double x:Key="FontSizeSectionHeader">10</x:Double>
    <x:Double x:Key="FontSizeNavItem">13</x:Double>
    <x:Double x:Key="FontSizeBrandingTitle">17</x:Double>
    <x:Double x:Key="FontSizeBrandingSubtitle">10</x:Double>

    <!-- ===== Animation Durations (milliseconds) ===== -->
    <x:Double x:Key="DurationFast">150</x:Double>
    <x:Double x:Key="DurationNormal">250</x:Double>
    <x:Double x:Key="DurationSlow">400</x:Double>
    <x:Double x:Key="DurationGlacial">700</x:Double>
    <x:Double x:Key="DurationCinematic">1200</x:Double>

    <!-- ===== Spacing Constants =====
         B23: Web Card is `py-6` with children handling horizontal `px-6`.
         CardStyle uses the same 24px section inset. Specialized cards should
         use `CardVerticalPadding` + the CardHeader/Content/Footer padding
         tokens via the matching styles below. -->
    <Thickness x:Key="PagePadding">24,24,24,24</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,40</Thickness>
    <Thickness x:Key="CardPadding">24,24,24,24</Thickness>
    <Thickness x:Key="CardVerticalPadding">0,24,0,24</Thickness>
    <Thickness x:Key="CardHeaderPadding">24,0,24,0</Thickness>
    <Thickness x:Key="CardContentPadding">24,0,24,0</Thickness>
    <Thickness x:Key="CardFooterPadding">24,0,24,0</Thickness>
    <Thickness x:Key="ItemSpacing">0,0,12,0</Thickness>
    <x:Double x:Key="SidebarWidth">260</x:Double>

    <!-- Current WebUI app.css sets the radius variable to .75rem (12px) and derives
         sm/base-4, md/base-2, lg/base, xl/base+4, 2xl/base+8.
         Use the resolved product scale, not Tailwind's generic defaults. -->
    <CornerRadius x:Key="RadiusXS">2</CornerRadius>
    <CornerRadius x:Key="RadiusSM">8</CornerRadius>
    <CornerRadius x:Key="RadiusMD">10</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="Radius2XL">20</CornerRadius>
    <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

    <!-- Existing aliases re-pointed at the corrected values. -->
    <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="MediumCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="XLargeCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="XXLargeCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="ProfileCardCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="AuthCardCornerRadius">32</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="PosterCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="NavItemCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">9999</CornerRadius>

    <!-- ===== PosterCard Dimensions ===== -->
    <!-- Web UI: w-[140px] sm:w-[160px] lg:w-[185px]; aspect-[2/3] -->
    <x:Double x:Key="PosterCardWidth">178</x:Double>
    <x:Double x:Key="PosterCardHeight">267</x:Double>
    <!-- Accommodates the WebUI's optional episode-title line between series
         title and SxxExx metadata without clipping uniform grid rows. -->
    <x:Double x:Key="PosterCardTotalHeight">346</x:Double>

    <!-- ===== Text Styles ===== -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!-- F1 THEME OVERRIDES — WinUI implicit control brush table.        -->
    <!-- Without these, every Button/ComboBox/TextBox/ToggleSwitch/      -->
    <!-- Slider/ContentDialog/MenuFlyout falls back to WinUI Fluent      -->
    <!-- system colors (Windows accent blue on hover, light backgrounds  -->
    <!-- on focus, stock scrollbars). These keys are read by the default  -->
    <!-- ControlTemplate VisualStates so we can restyle hover/press/     -->
    <!-- focus without authoring full ControlTemplates.                   -->
    <!-- ================================================================ -->

    <!-- ── Button ── -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource BorderColor}" />

    <!-- ── TextBox / PasswordBox / NumberBox ── -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="{StaticResource TertiaryTextColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{StaticResource TertiaryTextColor}" />

    <!-- ── ComboBox ── -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource PopoverColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource AccentBackgroundColor}" />

    <!-- ── ToggleSwitch ── -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource AccentForegroundColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="{StaticResource PrimaryTextColor}" />

    <!-- ── Slider ── -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPointerOver" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBorderBrushPressed" Color="{StaticResource AccentColor}" />

    <!-- ── ContentDialog ── -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
    <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#80000000" />

    <!-- ── MenuFlyout ── -->
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource PopoverColor}" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
    <Thickness x:Key="MenuFlyoutItemThemePadding">8,6</Thickness>
    <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,6</Thickness>
    <Thickness x:Key="MenuFlyoutItemMargin">0</Thickness>
    <Thickness x:Key="MenuFlyoutItemPlaceholderThemeThickness">24,0,0,0</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">4</Thickness>
    <Thickness x:Key="MenuFlyoutSeparatorThemePadding">-4,4,-4,4</Thickness>
    <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="{StaticResource BorderColor}" />
    <Style TargetType="MenuFlyoutSeparator">
        <Setter Property="Padding" Value="-4,4,-4,4" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSM}" />
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="{StaticResource ThemeFontFamily}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSM}" />
    </Style>
    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMD}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ── Focus visuals ── -->
    <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="Transparent" />

    <!-- ── System accent override (affects all controls' highlight) ── -->
    <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource AccentBackgroundColor}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource AccentBackgroundColor}" />

    <!-- ── NavigationView ── -->
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource AccentBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource AppBackgroundColor}" />

    <!-- ── HyperlinkButton ── -->
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource AccentPressedColor}" />

    <!-- ===== Button Styles ===== -->
    <SolidColorBrush x:Key="WebUiPrimaryHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="WebUiSecondaryHoverBrush" Color="{StaticResource SecondaryBackgroundColor}" Opacity="0.8" />
    <SolidColorBrush x:Key="WebUiDestructiveHoverBrush" Color="{StaticResource ErrorColor}" Opacity="0.9" />
    <ControlTemplate x:Key="WebUiAccentButtonTemplate" TargetType="Button">
        <Border x:Name="WebUiRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="WebUiContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters>
                    <Setter Target="WebUiRoot.Background" Value="{StaticResource WebUiPrimaryHoverBrush}" />
