<?xml version="1.0" encoding="utf-8"?>
<Window xmlns:loc="using:SiloPlayer.Services"
    x:Class="SiloPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:SiloPlayer.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:local="using:SiloPlayer"
    mc:Ignorable="d"
    Title="Silo">

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource AppBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden"
        CharacterReceived="RootGrid_CharacterReceived"
        PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
            <Style x:Key="SettingsSidebarGroupHeaderStyle" TargetType="NavigationViewItemHeader">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="NavigationViewItemHeader">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource ThemeFontFamily}"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                                       LineHeight="15" LineStackingStrategy="BlockLineHeight" Margin="20,0,12,8"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+K opens the global search palette (webui parity). -->
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="GlobalSearchAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="NavigationBackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="K" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="AudiobookAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            CompactPaneLength="64"
            OpenPaneLength="{StaticResource SidebarWidth}"
            PaneDisplayMode="LeftCompact"
            FontSize="13"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked"
            PaneClosing="NavView_PaneClosing"
            Loaded="NavView_Loaded">

            <NavigationView.Resources>
                <!-- AppSidebar.tsx uses an 18px icon slot for every shell row. -->
                <Style TargetType="FontIcon">
                    <Setter Property="FontSize" Value="18" />
                </Style>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="MinHeight" Value="43.5" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
                <Style TargetType="NavigationViewItemHeader">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="220" />
                    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <StackPanel>
                <Grid x:Name="SidebarBrandHost" Height="96"
                      Tapped="SidebarBrandHost_Tapped"
                      IsTabStop="True"
                      KeyDown="SidebarBrandHost_KeyDown"
                      AutomationProperties.Name="Go to home" loc:Localized.Name="web.shell.sidebar.goHome">
                    <Image FlowDirection="LeftToRight"
                        x:Name="SiloWordmarkImage"
                        Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                        Width="112"
                        Height="48"
                        Stretch="Uniform"
                        HorizontalAlignment="Left"
                        Margin="20,24,0,24"
                        IsHitTestVisible="False"
                        AutomationProperties.Name="Silo">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.3" />
                        </Image.OpacityTransition>
                    </Image>
                    <Image FlowDirection="LeftToRight"
                        x:Name="SiloMarkImage"
                        Source="ms-appx:///Assets/silo-mark-transparent.png"
                        Width="36"
                        Height="36"
                        Stretch="Uniform"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="14,30,0,30"
                        Opacity="0"
                        IsHitTestVisible="False"
                        AutomationProperties.Name="Silo">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.3" />
                        </Image.OpacityTransition>
                    </Image>
                </Grid>
                <StackPanel x:Name="SettingsSidebarHeader" Visibility="Collapsed" Spacing="16" Margin="12,24,12,16" Width="236" HorizontalAlignment="Left">
                    <Button Click="SettingsSidebarBack_Click" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="8" HorizontalAlignment="Left" MinWidth="0" MinHeight="0" AutomationProperties.Name="Back to App" loc:Localized.Name="web.settings.sidebar.backToApp">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Image FlowDirection="LeftToRight" Source="ms-appx:///Assets/Icons/arrow-left.svg" Width="16" Height="16"/><TextBlock Text="Back to App" loc:Localized.Text="web.settings.sidebar.backToApp" FontSize="13"/></StackPanel>
                    </Button>
                    <TextBlock Text="Settings" loc:Localized.Text="web.shell.sidebar.settings" FontSize="22" FontWeight="ExtraBold" CharacterSpacing="-30" Margin="8,0,8,0" />
                    <Button x:Name="SettingsSidebarProfile" Click="SwitchProfile_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="12" MinWidth="0" MinHeight="0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32">
                                <Border CornerRadius="16" Background="{StaticResource SidebarAccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding Text, ElementName=ProfileInitialText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Ellipse Visibility="{Binding Visibility, ElementName=ProfileAvatarImage}"><Ellipse.Fill><ImageBrush ImageSource="{Binding ImageSource, ElementName=ProfileAvatarBrush}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center"><TextBlock Text="Current profile" loc:Localized.Text="web.settings.currentProfileLink.caption" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}"/><TextBlock Text="{Binding Text, ElementName=ProfileNameText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                            <Image FlowDirection="LeftToRight" Grid.Column="2" Source="ms-appx:///Assets/Icons/chevron-right.svg" Width="16" Height="16"/>
                        </Grid>
                    </Button>
                    <Grid>
                        <TextBox x:Name="SettingsSidebarSearch" PlaceholderText="Search settings" loc:Localized.Placeholder="web.settings.search.placeholder" TextChanged="SettingsSidebarSearch_TextChanged" AutomationProperties.Name="Search settings" loc:Localized.Name="web.settings.search.placeholder" Height="44" CornerRadius="12" Padding="36,8,12,8"/>
                        <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}"
                                  HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Home -->
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home" loc:Localized.Content="web.shell.sidebar.home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="SearchNavItem" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid MinWidth="158">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Search" loc:Localized.Text="web.shell.sidebar.search"
                                VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="6,2"
                                CornerRadius="3"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                IsHitTestVisible="False">
                                <TextBlock
                                    Text="Ctrl K"
                                    FontSize="10"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <!-- LIBRARIES section header (collapsible — click toggles library visibility) -->
                <NavigationViewItem x:Name="LibrariesHeader" SelectsOnInvoked="False"
                                    Tapped="LibrariesHeader_Tapped"
                                    KeyDown="LibrariesHeader_KeyDown"
                                    AutomationProperties.Name="Libraries" loc:Localized.Name="web.shell.sidebar.libraries"
                                    AutomationProperties.HelpText="Collapse libraries">
                    <NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ImageIcon x:Name="LibrariesChevron" Width="12" Height="12" Source="ms-appx:///Assets/Icons/chevron-down.svg"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="ShellLibrariesLabel" Grid.Column="1" Text="LIBRARIES" loc:Localized.Text="web.shell.sidebar.libraries" loc:Localized.Uppercase="True" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="220"
                                       Foreground="{StaticResource TertiaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <!-- Compact detail rail uses the same centered section
                             divider treatment as AppSidebar.tsx. -->
                        <FontIcon
                            x:Name="LibrariesCompactDividerIcon"
                            Glyph="&#x2014;"
                            FontSize="18"
                            Foreground="{StaticResource SidebarBorderBrush}"
                            Visibility="Collapsed" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Libraries inserted dynamically after this point -->

                <!-- DISCOVER section header -->
                <NavigationViewItemHeader x:Name="ShellDiscoverHeader" Content="DISCOVER" loc:Localized.Content="web.shell.sidebar.discover" loc:Localized.Uppercase="True" />

                <NavigationViewItem x:Name="RecommendationsNavItem" Content="For You" loc:Localized.Content="web.shell.sidebar.forYou" Tag="Recommendations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RequestsNavItem" Content="Requests" loc:Localized.Content="web.shell.sidebar.requests" Tag="Requests" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CalendarNavItem" Content="Calendar" loc:Localized.Content="web.shell.sidebar.calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NotificationsNavItem" Content="Notifications" loc:Localized.Content="web.shell.sidebar.notifications" Tag="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="NotificationUnreadBadge"
                            Background="{StaticResource AccentBrush}"
                            Foreground="{StaticResource AccentForegroundBrush}"
                            Margin="0,2,8,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <!-- YOUR STUFF section header -->
                <NavigationViewItemHeader x:Name="ShellYourStuffHeader" Content="YOUR STUFF" loc:Localized.Content="web.shell.sidebar.yourStuff" loc:Localized.Uppercase="True" />
                <NavigationViewItem Content="Favorites" loc:Localized.Content="web.shell.sidebar.favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" loc:Localized.Content="web.shell.sidebar.watchlist" Tag="Watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watch Party" loc:Localized.Content="web.shell.sidebar.watchParty" Tag="WatchParty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" loc:Localized.Content="web.shell.sidebar.collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" loc:Localized.Content="web.shell.sidebar.history" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" loc:Localized.Content="web.setup.features.downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Plugin-supplied user navigation is inserted below this header. -->
                <NavigationViewItemHeader x:Name="AppsHeader" Content="APPS" loc:Localized.Content="web.shell.sidebar.apps" loc:Localized.Uppercase="True" Visibility="Collapsed" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel
                    x:Name="SidebarFooterPanel"
                    Margin="0"
                    Spacing="2"
                    HorizontalAlignment="Stretch">
                    <!-- Top border separator -->
                    <Border
                        x:Name="SidebarFooterSeparator"
                        Height="1"
                        Background="{StaticResource SidebarBorderBrush}"
                        Margin="0,0,0,8"
                        Opacity="0.7" />

                    <!-- Admin (AppSidebar.tsx footer): acting admin only, directly above the profile. -->
                    <Button
                        x:Name="AdminFooterButton"
                        Visibility="Collapsed"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        MinWidth="0" MinHeight="0"
                        Padding="12"
                        Margin="12,0"
                        CornerRadius="12"
                        AutomationProperties.Name="Admin">
                        <StackPanel x:Name="AdminFooterContent" Orientation="Horizontal" Spacing="10">
                            <Viewbox x:Name="AdminFooterIconSlot" Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"
                                          Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock
                                x:Name="AdminFooterLabel"
                                Text="Admin"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.3" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Profile button with dropdown (webui: Settings + Switch Profile + Logout inside avatar dropdown) -->
                    <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button
                        x:Name="ProfileFooterButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        MinWidth="0" MinHeight="0"
                        Padding="12"
                        Margin="12,0"
                        CornerRadius="12">
                        <StackPanel x:Name="ProfileFooterContent" Orientation="Horizontal" Spacing="10">
                            <!-- Avatar -->
                            <Grid x:Name="ProfileAvatarSlot" Width="28" Height="28" Margin="-5,0,-5,0">
                            <Grid Width="28" Height="28" HorizontalAlignment="Center">
                                <Border
                                    CornerRadius="14"
                                    Background="{StaticResource AccentBrush}">
                                    <TextBlock
                                        x:Name="ProfileInitialText"
                                        Text="?"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentForegroundBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Ellipse
                                    x:Name="ProfileAvatarImage"
                                    Width="28"
                                    Height="28"
                                    Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush
                                            x:Name="ProfileAvatarBrush"
                                            Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <Border x:Name="ProfileUpdateDot" Width="7" Height="7" CornerRadius="3.5" Background="#4ADE80"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock
                                x:Name="ProfileNameText" loc:Localized.Text="web.profiles.streams.profileFallback"
                                Text="Profile"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                TextTrimming="CharacterEllipsis"
                                FontWeight="Medium">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.3" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout
                                x:Name="ProfileFooterFlyout"
                                Placement="Top"
                                Opening="ProfileFooterFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="Width" Value="320" />
                                        <Setter Property="MaxWidth" Value="320" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="Background" Value="{StaticResource PopoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <ScrollViewer x:Name="ProfileMenuScroller" loc:Localized.Direction="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="0">
                                    <!-- Avatar + name header -->
                                    <Grid ColumnSpacing="12" Margin="8,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40">
                                            <Border CornerRadius="20"
                                                    Background="{StaticResource AccentBrush}">
                                                <TextBlock x:Name="ProfileDropdownInitial" Text="?"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentForegroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse
                                                x:Name="ProfileDropdownAvatarImage"
                                                Width="40"
                                                Height="40"
                                                Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush
                                                        x:Name="ProfileDropdownAvatarBrush"
                                                        Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock x:Name="ProfileDropdownName" loc:Localized.Text="web.profiles.streams.profileFallback" Text="Profile" TextTrimming="CharacterEllipsis"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="ProfileDropdownUsername" Text="" TextTrimming="CharacterEllipsis"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Button x:Name="UpdateMenuButton" Content="Check for updates" Click="AppUpdateButton_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                            BorderThickness="0" Padding="10,10" CornerRadius="6" FontSize="13" />

                                    <!-- Theme switcher: label + five keyboard-focusable dots. -->
                                    <Grid Margin="10,4,10,6" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ShellThemeLabel"
                                            Text="THEME" loc:Localized.Text="settingsManifest.ui.theme.label" loc:Localized.Uppercase="True"
                                            FontSize="10"
                                            FontWeight="Medium"
                                            CharacterSpacing="140"
                                            Foreground="{StaticResource TertiaryTextBrush}"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            x:Name="ThemeDotsPanel"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="-4,4" />

                                    <!-- Settings -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="10,8" CornerRadius="8" MinHeight="0" Height="36"
                                            Click="Settings_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ImageIcon Width="18" Height="18" Source="ms-appx:///Assets/Icons/settings.svg" Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="Settings" loc:Localized.Text="web.shell.sidebar.settings" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="-4,4" />

                                    <!-- Switch Profile -->
                                    <Button x:Name="ProfileSwitchButton" Background="{StaticResource SidebarAccentBrush}" BorderThickness="1" BorderBrush="{StaticResource SidebarBorderBrush}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12" CornerRadius="12" MinHeight="0" Height="44" Margin="0,2,0,4"
                                            Click="SwitchProfile_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ImageIcon Width="18" Height="18" Source="ms-appx:///Assets/Icons/circle-user.svg" Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="Switch Profile" loc:Localized.Text="web.shell.sidebar.switchProfile" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Logout -->
                                    <Button x:Name="ProfileLogoutButton" Background="{StaticResource SidebarAccentBrush}" BorderThickness="1" BorderBrush="{StaticResource SidebarBorderBrush}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12" CornerRadius="12" MinHeight="0" Height="44"
                                            Click="Logout_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <ImageIcon Width="18" Height="18" Source="ms-appx:///Assets/Icons/log-out.svg" Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock Text="Logout" loc:Localized.Text="web.shell.sidebar.logout" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="UpdateAvailableButton" Grid.Column="1" Content="Update Available" Click="AppUpdateButton_Click"
                            Visibility="Collapsed" Foreground="#4ADE80" Background="Transparent" BorderThickness="0"
                            FontSize="11" FontWeight="SemiBold" CornerRadius="6" Padding="4,8" Margin="0,0,12,0"
                            VerticalAlignment="Center" AutomationProperties.Name="Update available. View changelog and update Silo." />
                    </Grid>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Current WebUI mobile shell: rounded glass header with menu,
                     brand, search, and profile access. -->
                <Border
                    x:Name="MobileShellHeader"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Margin="12,12,12,0"
                    Padding="12,8"
                    MinHeight="64"
                    CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="20">
                    <Border.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.2" />
                    </Border.TranslationTransition>
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </Border.OpacityTransition>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileMenu_Click"
                                AutomationProperties.Name="Open menu" loc:Localized.Name="web.shell.layout.openMenu">
                                <FontIcon
                                    Glyph="&#xE700;"
                                    FontSize="20"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <Button
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="MobileHome_Click"
                                AutomationProperties.Name="Home" loc:Localized.Name="web.shell.sidebar.home">
                                <Image
                                    x:Name="MobileSiloWordmarkImage"
                                    Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                                    Width="94"
                                    Height="40"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileSearch_Click"
                                AutomationProperties.Name="Search" loc:Localized.Name="web.shell.sidebar.search">
                                <FontIcon
                                    Glyph="&#xE721;"
                                    FontSize="20"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <!-- Layout.tsx narrow header: Search, Server Activity, avatar. -->
                            <controls:ServerActivityButton
                                x:Name="MobileServerActivityButton"
                                VerticalAlignment="Center" />
                            <Button
                                x:Name="MobileProfileButton"
                                Width="40"
                                Height="40"
                                Padding="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileProfile_Click"
                                AutomationProperties.Name="Playback settings">
                                <Border
                                    Width="36"
                                    Height="36"
                                    CornerRadius="12"
                                    Background="{StaticResource AccentBrush}">
                                    <TextBlock
                                        x:Name="MobileProfileInitialText"
                                        Text="?"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentForegroundBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content -->
                <Frame x:Name="ContentFrame" Grid.Row="1" CacheSize="16" />

            </Grid>
        </NavigationView>

        <!-- Desktop Server Activity (Layout.tsx: fixed end-5 top-6, z-40); the control applies the admin gate. -->
        <controls:ServerActivityButton
            x:Name="MainServerActivityButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,24,20,0"
            Canvas.ZIndex="40" />

        <!-- Layer 2: Loading overlay (shown while preparing playback) -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{StaticResource AppBackgroundBrush}">
            <!-- PlayerLoadingCover (Silo Server #3993): black, with the title's
                 backdrop dimmed under the spinner. The thumbhash paints first and
                 the picture fades in over it once loaded. -->
            <Grid x:Name="LoadingBackdropLayer" Visibility="Collapsed" Background="Black" IsHitTestVisible="False">
                <Image x:Name="LoadingBackdropPlaceholder" Stretch="UniformToFill" Opacity="0.22"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="LoadingBackdropImage" Stretch="UniformToFill" Opacity="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <!-- Loading state -->
            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <!-- The cover is a status: its label is spoken, not shown (upstream aria-label). -->
                <ProgressRing x:Name="LoadingProgressRing" IsActive="True" Width="36" Height="36"
                              Foreground="#F5F3EF" AutomationProperties.Name="Preparing playback" />
            </StackPanel>
            <!-- Error state -->
            <StackPanel x:Name="ErrorState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorTitle" Text="Media Unavailable" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorDetail" Text="" FontSize="14" MaxWidth="400" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="Go Back" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="24,10"
                        Click="ErrorDismiss_Click" />
            </StackPanel>
        </Grid>

        <!-- Layer 3: Full-window player overlay (above nav, initially hidden) -->
        <controls:PlayerOverlay x:Name="PlayerOverlayControl" Visibility="Collapsed"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:AudiobookNowListening x:Name="AudiobookNowListeningControl"
                                        Visibility="Collapsed" Canvas.ZIndex="55"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 3: Mini player bar (bottom-docked, initially hidden) -->
        <controls:MiniPlayerBar x:Name="MiniPlayerBarControl"
                                 Visibility="Collapsed"
                                 Canvas.ZIndex="60"
                                 VerticalAlignment="Bottom" />
        <controls:BufferingQualityPillControl Canvas.ZIndex="65"
                                             VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                             Margin="16,0,16,88" />

        <!-- Layer 4: Playing Next cinematic overlay — shown when an episode
             ends naturally and the series has another episode queued. Lives
             at the MainWindow level (not inside PlayerOverlay) so it stays
             visible regardless of the player chrome state. MainWindow
             subscribes to PlayerService.ShowPlayingNextRequested and flips
             this Grid's visibility + kicks off the countdown timer. -->
        <!-- Postroll Up Next card. This is shown only after true media end,
             then floats above the mini player bar with the countdown. -->
        <Grid x:Name="PlayingNextOverlay" Visibility="Collapsed" Background="#D9000000" Canvas.ZIndex="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="PlayingNextBackdrop"
                   Grid.RowSpan="2"
                   Stretch="UniformToFill"
                   Opacity="0" />
            <Border Grid.RowSpan="2" Background="#A8000000" />
            <Button x:Name="PlayingNextCloseButton"
                    Grid.RowSpan="2"
                    Canvas.ZIndex="10"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="44"
                    Height="44"
                    Padding="0"
                    CornerRadius="22"
                    Margin="0,22,22,0"
                    PointerPressed="PlayingNextClose_PointerPressed"
                    Click="PlayingNextCancel_Click"
                    AutomationProperties.Name="Close Playing Next"
                    ToolTipService.ToolTip="Close">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>

            <Grid x:Name="PlayingNextComposition" Grid.RowSpan="2" Margin="48,72,48,24" ColumnSpacing="48" LayoutUpdated="PlayingNextComposition_LayoutUpdated">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <StackPanel x:Name="PlayingNextFinishingPanel" VerticalAlignment="Center" Spacing="10">
                    <!-- The live native preview covers this slot until true EOF; then the
                         finished title's own backdrop shows here (MainWindow.PlayingNextFinishingArt.cs). -->
                    <Border x:Name="PlayingNextFinishingSlot" Height="300" Background="#101013" CornerRadius="12" SizeChanged="PlayingNextFinishingSlot_SizeChanged">
                        <Image x:Name="PlayingNextFinishingArt" Stretch="UniformToFill" Opacity="0"
                               ImageFailed="PlayingNextFinishingArt_ImageFailed"
                               AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock x:Name="PlayingNextFinishingTitle" Text="Finishing episode" FontSize="14" Foreground="#BDBAB3" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            <ScrollViewer x:Name="PlayingNextScroller" Grid.Column="1" HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel x:Name="PlayingNextColumn" MaxWidth="544" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="PlayingNextLabelText" Text="PLAYING NEXT" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="250" Foreground="#66FFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock x:Name="PlayingNextShuffleScope" FontSize="13" FontWeight="SemiBold" Foreground="#80FFFFFF"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Visibility="Collapsed" />

                    <StackPanel x:Name="PlayingNextEpisodePanel" Spacing="12">
                        <Border x:Name="PlayingNextHero" Height="306" MaxWidth="544" CornerRadius="16"
                                Background="#202733" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Image x:Name="PlayingNextPoster" Stretch="UniformToFill" Opacity="0" />
                        </Border>

                        <StackPanel x:Name="PlayingNextMetadata" HorizontalAlignment="Center" Spacing="5" MaxWidth="650">
                            <TextBlock x:Name="PlayingNextSeriesText" Text="" FontSize="24"
                                       FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextTitleText" Text="" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#EBFFFFFF"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextMetaText" Text="" FontSize="12"
                                       Foreground="#66FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextOverviewText" Text="" FontSize="13"
                                       Foreground="#80FFFFFF" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" LineHeight="19" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="PlayingNextPrimaryActions" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PlayingNextPlayNowButton" Click="PlayingNextPlayNow_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="26,0"
                            Height="46" CornerRadius="23"
                            Foreground="#141417" Background="#F5F3EF">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D8D5CF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#141417" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#141417" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="PlayingNextPlayNowText" Text="Play Now"
                                       FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        </Button>

                            <StackPanel x:Name="PlayingNextCountdownPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="48" Height="48">
                                    <ProgressRing x:Name="PlayingNextCountdownRing" Width="48" Height="48"
                                                  Minimum="0" Maximum="10" Value="10"
                                                  IsActive="True" IsIndeterminate="False" />
                                    <TextBlock x:Name="PlayingNextCountdownText" Text="10s" FontSize="13"
                                               Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="PlayingNextAutoplayToggle" Click="PlayingNextAutoplayToggle_Click"
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center"
                                Padding="12,5" CornerRadius="14">
                            <TextBlock x:Name="PlayingNextAutoplayToggleText" Text="Auto-play is on"
                                       FontSize="12" Foreground="#59FFFFFF" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PlayingNextFinishedPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0" MaxWidth="520">
                        <TextBlock x:Name="PlayingNextFinishedHeading" Text="End of playback"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="24"
                                   FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="PlayingNextFinishedDescription" Text="There are no more episodes available. Pick something else from On Deck below."
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                                   Foreground="#80FFFFFF" />
                        <Button x:Name="PlayingNextFinishedBackButton" Content="Back" Click="PlayingNextCancel_Click"
                                AutomationProperties.HelpText="This screen closes by itself after 10 seconds unless you use it."
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center"
                                Padding="24,11" Margin="0,10,0,0" CornerRadius="22" />
                        <!-- After the last episode the screen closes by itself, as Back does, unless the viewer engages with it. -->
                        <TextBlock x:Name="PlayingNextFinishedCountdownText" Visibility="Collapsed"
                                   TextAlignment="Center" FontSize="12" Foreground="#59FFFFFF"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                    <StackPanel x:Name="PlayingNextShuffleActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="PlayingNextPickAnother" Content="Pick Another" Click="PlayingNextPickAnother_Click" Style="{StaticResource OutlineButtonStyle}" CornerRadius="999" helpers:RoundedBadge.Radius="999" />
                        <Button x:Name="PlayingNextStopShuffle" Content="Stop shuffling" Click="PlayingNextStopShuffle_Click" Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
            <StackPanel x:Name="PlayingNextOnDeckSection" Visibility="Collapsed"
                        PointerMoved="PlayingNextFinishedEngaged"
                        Spacing="9" Margin="0,28,0,12">
                <Grid>
                    <TextBlock Text="ON DECK" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="120" Foreground="#66FFFFFF"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button x:Name="PlayingNextOnDeckPrev" Style="{StaticResource GhostButtonStyle}"
                                Width="30" Height="30" Padding="0" CornerRadius="15" IsEnabled="False"
                                Click="PlayingNextOnDeckPrev_Click" ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE76B;" FontSize="13" />
                        </Button>
                        <Button x:Name="PlayingNextOnDeckNext" Style="{StaticResource GhostButtonStyle}"
                                Width="30" Height="30" Padding="0" CornerRadius="15" IsEnabled="False"
                                Click="PlayingNextOnDeckNext_Click" ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE76C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="PlayingNextOnDeckScroller"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              ViewChanged="PlayingNextOnDeckScroller_ViewChanged"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsRepeater x:Name="PlayingNextOnDeckRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:PlayingNextOnDeckItem">
                                <Button Tag="{x:Bind}" Click="PlayingNextOnDeck_Click" Padding="0"
                                        Width="190" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="5">
                                        <Grid Height="107">
                                            <Border CornerRadius="8" Background="#14FFFFFF"
                                                    BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <!-- x:Bind: ItemsRepeater gives a template that uses x:Bind no DataContext, so {Binding} left this blank. -->
                                                <Image Source="{x:Bind ThumbnailSource}" Stretch="UniformToFill" />
                                            </Border>
                                            <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100"
                                                         Height="3" VerticalAlignment="Bottom"
                                                         IsIndeterminate="False" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TimeLeft}" FontSize="11" Foreground="#4DFFFFFF" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Layer 5: Toast notifications (F2) — top-right, above everything
             including the player overlay, so feedback stays visible during
             playback preparation and errors. -->
        <controls:ToastContainer x:Name="ToastHost" />
        <Button x:Name="StandaloneUpdateButton" Content="Update Available" Click="AppUpdateButton_Click" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0" Padding="12,8" CornerRadius="6"
                Foreground="#4ADE80" Background="#18251D" BorderBrush="#3A7D50" FontWeight="SemiBold"
                AutomationProperties.Name="Update available. View changelog and update Silo." />
    </Grid>
</Window>
