<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SiloPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    mc:Ignorable="d"
    Title="Silo">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+K opens the global search palette (webui parity). -->
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="GlobalSearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="{StaticResource SidebarWidth}"
            PaneDisplayMode="Left"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked"
            Loaded="NavView_Loaded">

            <NavigationView.PaneHeader>
                <StackPanel Margin="16,20,16,16">
                    <Image
                        x:Name="SiloBrandImage"
                        Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                        Width="112"
                        Height="48"
                        Stretch="Uniform"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Silo" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Home -->
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- LIBRARIES section header (collapsible — click toggles library visibility) -->
                <NavigationViewItem x:Name="LibrariesHeader" SelectsOnInvoked="False"
                                    Tapped="LibrariesHeader_Tapped">
                    <NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="LibrariesChevron" Glyph="&#xE972;" FontSize="10"
                                      Foreground="{StaticResource TertiaryTextBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="LIBRARIES" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="220"
                                       Foreground="{StaticResource TertiaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="" FontSize="0" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Libraries inserted dynamically after this point -->

                <!-- DISCOVER section header -->
                <NavigationViewItemHeader Content="DISCOVER" />
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Recommendations" Tag="Recommendations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Catalog" Tag="Catalog">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Requests" Tag="Requests">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Notifications" Tag="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- YOUR STUFF section header -->
                <NavigationViewItemHeader Content="YOUR STUFF" />
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" Tag="Watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watch Party" Tag="WatchParty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="0,0,0,8" Spacing="2">
                    <!-- Top border separator -->
                    <Border
                        Height="1"
                        Background="{StaticResource SidebarBorderBrush}"
                        Margin="12,0,12,8"
                        Opacity="0.7" />

                    <!-- Admin nav item (visible only for admin users) -->
                    <Button
                        x:Name="AdminButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        Click="Admin_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7EF;" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                Text="Admin"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Profile button with dropdown (webui: Settings + Switch Profile + Logout inside avatar dropdown) -->
                    <Button
                        x:Name="ProfileFooterButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="16,10"
                        Margin="4,0"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- Avatar -->
                            <Border
                                Width="28" Height="28"
                                CornerRadius="14"
                                Background="{StaticResource AccentBrush}">
                                <TextBlock
                                    x:Name="ProfileInitialText"
                                    Text="?"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource AccentForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                x:Name="ProfileNameText"
                                Text="Profile"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="MinWidth" Value="260" />
                                        <Setter Property="MaxWidth" Value="300" />
                                        <Setter Property="CornerRadius" Value="16" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="4">
                                    <!-- Avatar + name header -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,8,8,4">
                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{StaticResource AccentBrush}">
                                            <TextBlock x:Name="ProfileDropdownInitial" Text="?"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentForegroundBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                            <TextBlock x:Name="ProfileDropdownName" Text="Profile"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="ProfileDropdownUsername" Text=""
                                                       FontSize="11"
                                                       Foreground="{StaticResource TertiaryTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Theme switcher dots -->
                                    <StackPanel x:Name="ThemeDotsPanel" Orientation="Horizontal"
                                                Spacing="8" Margin="8,4,8,4"
                                                Visibility="Collapsed" />

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="0,4" />

                                    <!-- Settings -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="Settings_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Settings" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="0,2" />

                                    <!-- Switch Profile -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="SwitchProfile_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE748;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Switch Profile" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Logout -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="Logout_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Logout" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Impersonation banner (hidden by default) -->
                <controls:ImpersonationBanner
                    x:Name="ImpersonationBannerControl"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    EndImpersonationRequested="ImpersonationBanner_EndRequested" />

                <!-- Page content -->
                <Frame x:Name="ContentFrame" Grid.Row="1" />

                <!-- Server Activity button (overlay on top of ContentFrame). -->
                <controls:ServerActivityButton
                    x:Name="MainServerActivityButton"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,20,0" />
            </Grid>
        </NavigationView>

        <!-- Layer 2: Loading overlay (shown while preparing playback) -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{StaticResource AppBackgroundBrush}">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Preparing playback..." FontSize="16"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <!-- Error state -->
            <StackPanel x:Name="ErrorState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorTitle" Text="Media Unavailable" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorDetail" Text="" FontSize="14" MaxWidth="400" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="Go Back" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="24,10"
                        Click="ErrorDismiss_Click" />
            </StackPanel>
        </Grid>

        <!-- Layer 3: Full-window player overlay (above nav, initially hidden) -->
        <controls:PlayerOverlay x:Name="PlayerOverlayControl" Visibility="Collapsed"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 3: Mini player bar (bottom-docked, initially hidden) -->
        <controls:MiniPlayerBar x:Name="MiniPlayerBarControl"
                                 Visibility="Collapsed"
                                 Canvas.ZIndex="60"
                                 VerticalAlignment="Bottom" />

        <!-- Layer 4: Playing Next cinematic overlay — shown when an episode
             ends naturally and the series has another episode queued. Lives
             at the MainWindow level (not inside PlayerOverlay) so it stays
             visible regardless of the player chrome state. MainWindow
             subscribes to PlayerService.ShowPlayingNextRequested and flips
             this Grid's visibility + kicks off the countdown timer. -->
        <!-- Postroll Up Next card. This is shown only after true media end,
             then floats above the mini player bar with the countdown. -->
        <Grid x:Name="PlayingNextOverlay" Visibility="Collapsed" Background="#D9000000" Canvas.ZIndex="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="PlayingNextBackdrop"
                   Grid.RowSpan="3"
                   Stretch="UniformToFill"
                   Opacity="0.22" />
            <Border Grid.RowSpan="3" Background="#A8000000" />
            <Button x:Name="PlayingNextCloseButton"
                    Grid.RowSpan="3"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="44"
                    Height="44"
                    Padding="0"
                    CornerRadius="22"
                    Margin="0,22,22,0"
                    Click="PlayingNextCancel_Click">
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>

            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="#F0141418" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="14" Padding="28,22,28,22"
                    MaxWidth="760" Margin="0,0,0,148">
            <StackPanel Spacing="18">
                <TextBlock Text="PLAYING NEXT" FontSize="12" FontWeight="SemiBold"
                           CharacterSpacing="200" Foreground="#78AEFC"
                           HorizontalAlignment="Center" />

                <Grid ColumnSpacing="24" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="320" Height="180" CornerRadius="12"
                            Background="#202733" VerticalAlignment="Center">
                        <Image x:Name="PlayingNextPoster" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" MaxWidth="400">
                        <TextBlock x:Name="PlayingNextSeriesText" Text="" FontSize="13"
                                   Foreground="#9CA3AF" />
                        <TextBlock x:Name="PlayingNextTitleText" Text="" FontSize="24"
                                   FontWeight="SemiBold" Foreground="White"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PlayingNextOverviewText" Text="" FontSize="13"
                                   Foreground="#D1D5DB" TextWrapping="Wrap" MaxLines="4"
                                   TextTrimming="CharacterEllipsis" LineHeight="20" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="PlayingNextCountdownPanel" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Grid Width="54" Height="54">
                            <Border CornerRadius="27"
                                    BorderBrush="#78AEFC"
                                    BorderThickness="2"
                                    Background="#1A78AEFC" />
                            <TextBlock x:Name="PlayingNextCountdownText"
                                       Text="10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Auto-play countdown"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#E5E7EB" />
                            <TextBlock Text="Starts the next episode automatically"
                                       FontSize="11"
                                       Foreground="#9CA3AF" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Per-button theme resource overrides so WinUI's
                         PointerOver / Pressed visual states use OUR palette
                         instead of the system accent. F1 theme gap workaround. -->
                    <Button x:Name="PlayingNextPlayNowButton" Click="PlayingNextPlayNow_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="24,0"
                            Height="44" CornerRadius="22"
                            Foreground="{StaticResource AccentForegroundBrush}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource AccentHoverColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource AccentPressedColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AccentForegroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AccentForegroundColor}" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="PlayingNextPlayNowText" Text="Play next in 10"
                                       FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlayingNextCancelButton" Click="PlayingNextCancel_Click"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="24,0"
                            Height="44" CornerRadius="22"
                            Foreground="{StaticResource PrimaryTextBrush}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource SurfaceHoverColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource PrimaryTextColor}" />
                        </Button.Resources>
                        <TextBlock Text="Cancel" FontSize="14" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
                <Button x:Name="PlayingNextAutoplayToggle"
                        Click="PlayingNextAutoplayToggle_Click"
                        Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="12,6"
                        CornerRadius="14">
                    <TextBlock x:Name="PlayingNextAutoplayToggleText"
                               Text="Auto-play is on"
                               FontSize="12"
                               Foreground="#9CA3AF" />
                </Button>
            </StackPanel>
            </Border>
        </Grid>

        <!-- Layer 5: Toast notifications (F2) — top-right, above everything
             including the player overlay, so feedback stays visible during
             playback preparation and errors. -->
        <controls:ToastContainer x:Name="ToastHost" />
    </Grid>
</Window>
