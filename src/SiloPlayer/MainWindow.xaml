<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SiloPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SiloPlayer.Controls"
    xmlns:converters="using:SiloPlayer.Converters"
    xmlns:local="using:SiloPlayer"
    mc:Ignorable="d"
    Title="Silo">

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource AppBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden"
        CharacterReceived="RootGrid_CharacterReceived"
        PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <converters:UrlToImageSourceConverter x:Key="UrlToImage" />
        </Grid.Resources>
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+K opens the global search palette (webui parity). -->
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="GlobalSearchAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="NavigationBackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="K" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="M" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="P" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="E" Invoked="AudiobookAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="AudiobookAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            CompactPaneLength="64"
            OpenPaneLength="{StaticResource SidebarWidth}"
            PaneDisplayMode="LeftCompact"
            FontSize="13"
            Background="{StaticResource AppBackgroundBrush}"
            ItemInvoked="NavView_ItemInvoked"
            PaneClosing="NavView_PaneClosing"
            Loaded="NavView_Loaded">

            <NavigationView.Resources>
                <!-- AppSidebar.tsx uses an 18px icon slot for every shell row. -->
                <Style TargetType="FontIcon">
                    <Setter Property="FontSize" Value="18" />
                </Style>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Medium" />
                    <Setter Property="MinHeight" Value="42" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                </Style>
                <Style TargetType="NavigationViewItemHeader">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="CharacterSpacing" Value="220" />
                    <Setter Property="Foreground" Value="{StaticResource TertiaryTextBrush}" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.PaneHeader>
                <Grid x:Name="SidebarBrandHost" Height="96"
                      Tapped="SidebarBrandHost_Tapped"
                      IsTabStop="True"
                      KeyDown="SidebarBrandHost_KeyDown"
                      AutomationProperties.Name="Go to home">
                    <Image
                        x:Name="SiloWordmarkImage"
                        Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                        Width="112"
                        Height="48"
                        Stretch="Uniform"
                        HorizontalAlignment="Left"
                        Margin="20,24,0,24"
                        IsHitTestVisible="False"
                        AutomationProperties.Name="Silo">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.3" />
                        </Image.OpacityTransition>
                    </Image>
                    <Image
                        x:Name="SiloMarkImage"
                        Source="ms-appx:///Assets/silo-mark-transparent.png"
                        Width="36"
                        Height="36"
                        Stretch="Uniform"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="14,30,0,30"
                        Opacity="0"
                        IsHitTestVisible="False"
                        AutomationProperties.Name="Silo">
                        <Image.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.3" />
                        </Image.OpacityTransition>
                    </Image>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <!-- Home -->
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="Home"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- LIBRARIES section header (collapsible — click toggles library visibility) -->
                <NavigationViewItem x:Name="LibrariesHeader" SelectsOnInvoked="False"
                                    Tapped="LibrariesHeader_Tapped"
                                    KeyDown="LibrariesHeader_KeyDown"
                                    AutomationProperties.Name="Libraries"
                                    AutomationProperties.HelpText="Collapse libraries">
                    <NavigationViewItem.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="LibrariesChevron" Glyph="&#xE972;" FontSize="10"
                                      Foreground="{StaticResource TertiaryTextBrush}"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="LIBRARIES" FontSize="10" FontWeight="SemiBold"
                                       CharacterSpacing="220"
                                       Foreground="{StaticResource TertiaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <!-- Compact detail rail uses the same centered section
                             divider treatment as AppSidebar.tsx. -->
                        <FontIcon
                            x:Name="LibrariesCompactDividerIcon"
                            Glyph="&#x2014;"
                            FontSize="18"
                            Foreground="{StaticResource SidebarBorderBrush}"
                            Visibility="Collapsed" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Libraries inserted dynamically after this point -->

                <!-- DISCOVER section header -->
                <NavigationViewItemHeader Content="DISCOVER" />
                <NavigationViewItem x:Name="SearchNavItem" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <Grid MinWidth="158">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Search"
                                VerticalAlignment="Center" />
                            <Border
                                Grid.Column="1"
                                Padding="6,2"
                                CornerRadius="3"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                IsHitTestVisible="False">
                                <TextBlock
                                    Text="Ctrl K"
                                    FontSize="10"
                                    FontWeight="Medium"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Border>
                        </Grid>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RecommendationsNavItem" Content="Recommendations" Tag="Recommendations">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE735;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RequestsNavItem" Content="Requests" Tag="Requests" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CalendarNavItem" Content="Calendar" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NotificationsNavItem" Content="Notifications" Tag="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="NotificationUnreadBadge"
                            Background="{StaticResource AccentBrush}"
                            Foreground="{StaticResource AccentForegroundBrush}"
                            Margin="0,2,8,0"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <!-- YOUR STUFF section header -->
                <NavigationViewItemHeader Content="YOUR STUFF" />
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watchlist" Tag="Watchlist">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Watch Party" Tag="WatchParty">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Collections" Tag="Collections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Plugin-supplied user navigation is inserted below this header. -->
                <NavigationViewItemHeader x:Name="AppsHeader" Content="APPS" Visibility="Collapsed" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel
                    x:Name="SidebarFooterPanel"
                    Margin="0"
                    Spacing="2"
                    HorizontalAlignment="Stretch">
                    <!-- Top border separator -->
                    <Border
                        x:Name="SidebarFooterSeparator"
                        Height="1"
                        Background="{StaticResource SidebarBorderBrush}"
                        Margin="0,0,0,8"
                        Opacity="0.7" />

                    <!-- Admin nav item (visible only for admin users) -->
                    <Button
                        x:Name="AdminButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12"
                        Margin="12,0"
                        CornerRadius="12"
                        Visibility="Collapsed"
                        Click="Admin_Click">
                        <StackPanel x:Name="AdminButtonContent" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7EF;" FontSize="18" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock
                                x:Name="AdminButtonLabel"
                                Text="Admin"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.3" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Profile button with dropdown (webui: Settings + Switch Profile + Logout inside avatar dropdown) -->
                    <Button
                        x:Name="ProfileFooterButton"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12"
                        Margin="12,0"
                        CornerRadius="12">
                        <StackPanel x:Name="ProfileFooterContent" Orientation="Horizontal" Spacing="10">
                            <!-- Avatar -->
                            <Grid Width="28" Height="28">
                                <Border
                                    CornerRadius="14"
                                    Background="{StaticResource AccentBrush}">
                                    <TextBlock
                                        x:Name="ProfileInitialText"
                                        Text="?"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentForegroundBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Ellipse
                                    x:Name="ProfileAvatarImage"
                                    Width="28"
                                    Height="28"
                                    Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush
                                            x:Name="ProfileAvatarBrush"
                                            Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock
                                x:Name="ProfileNameText"
                                Text="Profile"
                                Foreground="{StaticResource PrimaryTextBrush}"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="Medium">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.3" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout
                                x:Name="ProfileFooterFlyout"
                                Placement="Top"
                                Opening="ProfileFooterFlyout_Opening">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="MinWidth" Value="260" />
                                        <Setter Property="MaxWidth" Value="300" />
                                        <Setter Property="CornerRadius" Value="16" />
                                        <Setter Property="Background" Value="{StaticResource PopoverBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel Spacing="4">
                                    <!-- Avatar + name header -->
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,8,8,4">
                                        <Grid Width="36" Height="36">
                                            <Border CornerRadius="18"
                                                    Background="{StaticResource AccentBrush}">
                                                <TextBlock x:Name="ProfileDropdownInitial" Text="?"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentForegroundBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Ellipse
                                                x:Name="ProfileDropdownAvatarImage"
                                                Width="36"
                                                Height="36"
                                                Visibility="Collapsed">
                                                <Ellipse.Fill>
                                                    <ImageBrush
                                                        x:Name="ProfileDropdownAvatarBrush"
                                                        Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Spacing="0">
                                            <TextBlock x:Name="ProfileDropdownName" Text="Profile"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                            <TextBlock x:Name="ProfileDropdownUsername" Text=""
                                                       FontSize="11"
                                                       Foreground="{StaticResource TertiaryTextBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Theme switcher: label + five keyboard-focusable dots. -->
                                    <Grid Margin="10,4,10,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="THEME"
                                            FontSize="10"
                                            FontWeight="Medium"
                                            CharacterSpacing="140"
                                            Foreground="{StaticResource TertiaryTextBrush}"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            x:Name="ThemeDotsPanel"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="0,4" />

                                    <!-- Settings -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="Settings_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Settings" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.5" Margin="0,2" />

                                    <!-- Switch Profile -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="SwitchProfile_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE748;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Switch Profile" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Logout -->
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="12,10" CornerRadius="10"
                                            Click="Logout_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="Logout" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Current WebUI mobile shell: rounded glass header with menu,
                     brand, search, admin activity, and profile access. -->
                <Border
                    x:Name="MobileShellHeader"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Margin="12,12,12,0"
                    Padding="12,8"
                    MinHeight="64"
                    CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SidebarBorderBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="20">
                    <Border.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.2" />
                    </Border.TranslationTransition>
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </Border.OpacityTransition>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileMenu_Click"
                                AutomationProperties.Name="Open menu">
                                <FontIcon
                                    Glyph="&#xE700;"
                                    FontSize="20"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <Button
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="MobileHome_Click"
                                AutomationProperties.Name="Home">
                                <Image
                                    x:Name="MobileSiloWordmarkImage"
                                    Source="ms-appx:///Assets/silo-wordmark-sidebar.png"
                                    Width="94"
                                    Height="40"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileSearch_Click"
                                AutomationProperties.Name="Search">
                                <FontIcon
                                    Glyph="&#xE721;"
                                    FontSize="20"
                                    Foreground="{StaticResource SecondaryTextBrush}" />
                            </Button>
                            <controls:ServerActivityButton
                                x:Name="MobileServerActivityButton"
                                HideWhenEmpty="True" />
                            <Button
                                x:Name="MobileProfileButton"
                                Width="40"
                                Height="40"
                                Padding="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                Click="MobileProfile_Click"
                                AutomationProperties.Name="Playback settings">
                                <Border
                                    Width="36"
                                    Height="36"
                                    CornerRadius="12"
                                    Background="{StaticResource AccentBrush}">
                                    <TextBlock
                                        x:Name="MobileProfileInitialText"
                                        Text="?"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource AccentForegroundBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Impersonation banner (hidden by default) -->
                <controls:ImpersonationBanner
                    x:Name="ImpersonationBannerControl"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    EndImpersonationRequested="ImpersonationBanner_EndRequested" />

                <!-- Page content -->
                <Frame x:Name="ContentFrame" Grid.Row="2" CacheSize="16" />

                <!-- Server Activity button (overlay on top of ContentFrame). -->
                <controls:ServerActivityButton
                    x:Name="MainServerActivityButton"
                    HideWhenEmpty="True"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,20,0" />
            </Grid>
        </NavigationView>

        <!-- Layer 2: Loading overlay (shown while preparing playback) -->
        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{StaticResource AppBackgroundBrush}">
            <!-- Loading state -->
            <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="48" Height="48" />
                <TextBlock Text="Preparing playback..." FontSize="16"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <!-- Error state -->
            <StackPanel x:Name="ErrorState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#FF6B6B" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorTitle" Text="Media Unavailable" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorDetail" Text="" FontSize="14" MaxWidth="400" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"
                           TextAlignment="Center" />
                <Button Content="Go Back" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="24,10"
                        Click="ErrorDismiss_Click" />
            </StackPanel>
        </Grid>

        <!-- Layer 3: Full-window player overlay (above nav, initially hidden) -->
        <controls:PlayerOverlay x:Name="PlayerOverlayControl" Visibility="Collapsed"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <controls:AudiobookNowListening x:Name="AudiobookNowListeningControl"
                                        Visibility="Collapsed" Canvas.ZIndex="55"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Layer 3: Mini player bar (bottom-docked, initially hidden) -->
        <controls:MiniPlayerBar x:Name="MiniPlayerBarControl"
                                 Visibility="Collapsed"
                                 Canvas.ZIndex="60"
                                 VerticalAlignment="Bottom" />

        <!-- Layer 4: Playing Next cinematic overlay — shown when an episode
             ends naturally and the series has another episode queued. Lives
             at the MainWindow level (not inside PlayerOverlay) so it stays
             visible regardless of the player chrome state. MainWindow
             subscribes to PlayerService.ShowPlayingNextRequested and flips
             this Grid's visibility + kicks off the countdown timer. -->
        <!-- Postroll Up Next card. This is shown only after true media end,
             then floats above the mini player bar with the countdown. -->
        <Grid x:Name="PlayingNextOverlay" Visibility="Collapsed" Background="#D9000000" Canvas.ZIndex="50">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image x:Name="PlayingNextBackdrop"
                   Grid.RowSpan="2"
                   Stretch="UniformToFill"
                   Opacity="0.22" />
            <Border Grid.RowSpan="2" Background="#A8000000" />
            <Button x:Name="PlayingNextCloseButton"
                    Grid.RowSpan="2"
                    Canvas.ZIndex="10"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="44"
                    Height="44"
                    Padding="0"
                    CornerRadius="22"
                    Margin="0,22,22,0"
                    PointerPressed="PlayingNextClose_PointerPressed"
                    Click="PlayingNextCancel_Click"
                    AutomationProperties.Name="Close Playing Next"
                    ToolTipService.ToolTip="Close">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Escape" />
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE711;" FontSize="16" />
            </Button>

            <ScrollViewer Grid.Row="0" HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto" Padding="24,22,24,18">
                <StackPanel MaxWidth="820" HorizontalAlignment="Center" Spacing="12">
                    <TextBlock x:Name="PlayingNextLabelText" Text="PLAYING NEXT" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="250" Foreground="#66FFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />

                    <StackPanel x:Name="PlayingNextEpisodePanel" Spacing="12">
                        <Border x:Name="PlayingNextHero" Height="400" MaxWidth="820" CornerRadius="16"
                                Background="#202733" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <Image x:Name="PlayingNextPoster" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Spacing="5" MaxWidth="650">
                            <TextBlock x:Name="PlayingNextSeriesText" Text="" FontSize="18"
                                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextTitleText" Text="" FontSize="16"
                                       FontWeight="SemiBold" Foreground="#EBFFFFFF"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextMetaText" Text="" FontSize="12"
                                       Foreground="#66FFFFFF" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PlayingNextOverviewText" Text="" FontSize="13"
                                       Foreground="#80FFFFFF" TextWrapping="Wrap" MaxLines="2"
                                       TextTrimming="CharacterEllipsis" LineHeight="19" TextAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="PlayingNextPlayNowButton" Click="PlayingNextPlayNow_Click"
                            Style="{StaticResource AccentButtonStyle}" Padding="26,0"
                            Height="46" CornerRadius="23"
                            Foreground="{StaticResource AccentForegroundBrush}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" />
                            </Button.KeyboardAccelerators>
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource AccentHoverColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource AccentPressedColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource AccentForegroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource AccentForegroundColor}" />
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock x:Name="PlayingNextPlayNowText" Text="Play Now"
                                       FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        </Button>

                            <StackPanel x:Name="PlayingNextCountdownPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="48" Height="48">
                                    <ProgressRing x:Name="PlayingNextCountdownRing" Width="48" Height="48"
                                                  Minimum="0" Maximum="10" Value="10"
                                                  IsActive="True" IsIndeterminate="False" />
                                    <TextBlock x:Name="PlayingNextCountdownText" Text="10s" FontSize="13"
                                               Foreground="#80FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="PlayingNextAutoplayToggle" Click="PlayingNextAutoplayToggle_Click"
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center"
                                Padding="12,5" CornerRadius="14">
                            <TextBlock x:Name="PlayingNextAutoplayToggleText" Text="Auto-play is on"
                                       FontSize="12" Foreground="#59FFFFFF" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="PlayingNextFinishedPanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0" MaxWidth="520">
                        <TextBlock x:Name="PlayingNextFinishedHeading" Text="End of playback"
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="24"
                                   FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="There are no more episodes available. Pick something else from On Deck below."
                                   TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                                   Foreground="#80FFFFFF" />
                        <Button Content="Back" Click="PlayingNextCancel_Click"
                                Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Center"
                                Padding="24,11" Margin="0,10,0,0" CornerRadius="22" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="PlayingNextOnDeckSection" Grid.Row="1" Visibility="Collapsed"
                        Spacing="9" Margin="24,0,24,18">
                <Grid>
                    <TextBlock Text="ON DECK" FontSize="11" FontWeight="SemiBold"
                               CharacterSpacing="120" Foreground="#66FFFFFF"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button x:Name="PlayingNextOnDeckPrev" Style="{StaticResource GhostButtonStyle}"
                                Width="30" Height="30" Padding="0" CornerRadius="15" IsEnabled="False"
                                Click="PlayingNextOnDeckPrev_Click" ToolTipService.ToolTip="Previous">
                            <FontIcon Glyph="&#xE76B;" FontSize="13" />
                        </Button>
                        <Button x:Name="PlayingNextOnDeckNext" Style="{StaticResource GhostButtonStyle}"
                                Width="30" Height="30" Padding="0" CornerRadius="15" IsEnabled="False"
                                Click="PlayingNextOnDeckNext_Click" ToolTipService.ToolTip="Next">
                            <FontIcon Glyph="&#xE76C;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="PlayingNextOnDeckScroller"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              ViewChanged="PlayingNextOnDeckScroller_ViewChanged"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
                    <ItemsRepeater x:Name="PlayingNextOnDeckRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:PlayingNextOnDeckItem">
                                <Button Tag="{x:Bind}" Click="PlayingNextOnDeck_Click" Padding="0"
                                        Width="190" Background="Transparent" BorderThickness="0"
                                        HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="5">
                                        <Grid Height="107">
                                            <Border CornerRadius="8" Background="#14FFFFFF"
                                                    BorderBrush="#10FFFFFF" BorderThickness="1">
                                                <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                            </Border>
                                            <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100"
                                                         Height="3" VerticalAlignment="Bottom"
                                                         IsIndeterminate="False" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="#66FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TimeLeft}" FontSize="11" Foreground="#4DFFFFFF" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- Layer 5: Toast notifications (F2) — top-right, above everything
             including the player overlay, so feedback stays visible during
             playback preparation and errors. -->
        <controls:ToastContainer x:Name="ToastHost" />
    </Grid>
</Window>
