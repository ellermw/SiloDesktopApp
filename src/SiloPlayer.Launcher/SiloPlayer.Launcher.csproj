<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained><PublishTrimmed>false</PublishTrimmed><PublishReadyToRun>false</PublishReadyToRun>
    <Version>1.2.515</Version><FileVersion>1.2.515.0</FileVersion><AssemblyVersion>1.2.515.0</AssemblyVersion>
    <AssemblyName>SiloPlayer.Launcher</AssemblyName>
    <Description>Silo Desktop Player stable launcher</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../SiloPlayer/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../SiloPlayer.Core/SiloPlayer.Core.csproj" /></ItemGroup>
</Project>
