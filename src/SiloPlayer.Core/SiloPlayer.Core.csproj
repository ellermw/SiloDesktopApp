<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SiloPlayer.Tests" />
    <!-- Links EventAccessTransportTests.cs and runs it against the published assembly. -->
    <InternalsVisibleTo Include="SiloPlayer.PlaybackIntegrationTests" />
    <EmbeddedResource Include="Models\Settings\device-settings.json" />
    <!-- Offline interface catalogs generated by tools/SiloTranslationsImport; never edited by hand. -->
    <EmbeddedResource Include="Localization\Generated\*.json" LogicalName="SiloPlayer.Core.Localization.Generated.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
