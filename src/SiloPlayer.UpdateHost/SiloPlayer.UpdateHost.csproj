<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework><TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><PlatformTarget>x64</PlatformTarget><WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>../SiloPlayer/app.manifest</ApplicationManifest><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed><PublishReadyToRun>false</PublishReadyToRun><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <Version>1.2.1660</Version><FileVersion>1.2.1660.0</FileVersion><AssemblyVersion>1.2.1660.0</AssemblyVersion>
    <ApplicationIcon>../SiloPlayer/Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <!-- The host needs only the update code. Compiling it in, instead of referencing all of
         SiloPlayer.Core, keeps a second copy of Core and its catalogs out of every update. -->
    <Compile Include="../SiloPlayer.Core/Services/Updates/**/*.cs;../SiloPlayer.Core/Models/Updates/**/*.cs" LinkBase="SiloPlayer.Core" />
  </ItemGroup>
</Project>
