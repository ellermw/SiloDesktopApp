{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "decisions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["fixed", "no_changes", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_index",
          "disposition",
          "reason",
          "evidence",
          "validation"
        ],
        "properties": {
          "finding_index": {
            "type": "integer",
            "minimum": 1
          },
          "disposition": {
            "type": "string",
            "enum": ["fixed", "already_fixed", "false_positive", "blocked"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
