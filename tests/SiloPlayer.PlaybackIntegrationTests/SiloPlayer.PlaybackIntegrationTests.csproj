<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>../../src/SiloPlayer/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <Reference Include="SiloPlayer"><HintPath>$(SiloPlayerAssemblyDirectory)/SiloPlayer.dll</HintPath></Reference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
    <!-- Execute the same socket/keepalive regression against the actual installer assembly. -->
    <Compile Include="../SiloPlayer.Tests/EventAccessTransportTests.cs" Link="EventAccessTransportTests.cs" />
    <Compile Include="../SiloPlayer.Tests/PlaybackApiV2Tests.cs" Link="PlaybackApiV2Tests.cs" />
  </ItemGroup>
</Project>
