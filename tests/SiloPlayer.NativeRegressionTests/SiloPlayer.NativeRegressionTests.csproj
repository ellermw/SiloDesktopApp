<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>../../src/SiloPlayer/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(PickerRed)' == 'true'">$(DefineConstants);PICKER_RED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <!-- Match the published app's native Canvas activation dependency;
         resolving its managed wrapper alone cannot activate Win2D. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Reference Include="SiloPlayer">
      <HintPath>$(SiloPlayerAssemblyDirectory)/SiloPlayer.dll</HintPath>
    </Reference>
    <!-- The app reads every catalog but English from Localization\ beside the host
         (MessageCatalog.LooseDirectoryName); they are not inside SiloPlayer.dll. -->
    <None Include="../../src/SiloPlayer.Core/Localization/Generated/*.json" Exclude="../../src/SiloPlayer.Core/Localization/Generated/catalog-manifest.json;../../src/SiloPlayer.Core/Localization/Generated/en.json"
          Link="Localization/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
